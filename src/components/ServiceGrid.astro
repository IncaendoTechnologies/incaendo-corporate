---
// Home "Services & solutions" grid: one shared Card (md, elevated, lift)
// per service, from homepageServices.
import Card from './ui/Card.astro'
import CardIcon from './ui/CardIcon.astro'
import { homepageServices } from '../data/site-content.js'
---

<div class="service-grid service-grid-home reveal" data-reveal-stagger>
  {homepageServices.map((service) => {
    const Icon = service.icon
    return (
      <Card
        as="article"
        look="elevated"
        effect="lift"
        class="service-card service-card-featured"
        id={service.id ?? service.href.split('#')[1]}
        data-reveal-item
      >
        <div class="service-card-top">
          <span class="service-number">{service.number}</span>
          <CardIcon>
            <Icon strokeWidth={1.6} />
          </CardIcon>
        </div>
        <div class="service-card-copy">
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <ul class="service-points">
            {service.points.map((point) => (
              <li>{point}</li>
            ))}
          </ul>
        </div>
        <a
          class="service-card-explore"
          href={service.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Explore ${service.title}`}
        >
          <span>Explore</span>
          <span class="link-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </Card>
    )
  })}
</div>
