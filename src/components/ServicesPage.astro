    background: #df9574;
  }
  .software-sidebar i {
    margin-top: 0.4rem;
    border-radius: 50%;
    background: #dfe8ee;
  }
  .software-workspace {
    display: grid;
    min-width: 0;
    gap: 0.7rem;
    padding-left: 0.8rem;
