---
import { roleDescriptions } from '../data/team.js'

const { member, index = 0 } = Astro.props
const description = member.description ?? roleDescriptions[member.designation]
const initials = member.name
  .trim()
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part[0])
  .join('')
  .toUpperCase()
const tones = ['clay', 'blue', 'navy', 'sage']
const tone = tones[index % tones.length]
let linkedinUrl = 'https://www.linkedin.com/'
let hasConfirmedLinkedin = false
try {
  const candidate = new URL(member.linkedin)
  if (
    candidate.protocol === 'https:' &&
    ['linkedin.com', 'www.linkedin.com'].includes(candidate.hostname) &&
    candidate.pathname.startsWith('/in/')
  ) {
    linkedinUrl = candidate.href
    hasConfirmedLinkedin = true
  }
} catch {}
---

<article
  class="team-profile"
  data-team-member
  data-team-category={member.group}
  data-team-name={member.name.toLowerCase()}
  data-team-role={member.designation.toLowerCase()}
>
  <div
    class={`team-avatar team-avatar-${tone} ${member.image ? 'has-photo' : ''}`}
    aria-hidden={member.image ? undefined : 'true'}
    role={member.image ? 'img' : undefined}
    aria-label={
      member.image ? `${member.name} — ${member.designation}` : undefined
    }
  >
    {member.image ? (
      <img
        src={member.image}
        alt={member.name}
        loading="lazy"
        width="800"
        height="1000"
      />
    ) : member.avatar ? (
      <img src={member.avatar} alt="" loading="lazy" width="400" height="500" />
    ) : (
      <span>{initials}</span>
    )}
  </div>
  <div class="team-profile-copy">
    <div>
      <h3>{member.name}</h3>
      <p>{member.designation}</p>
    </div>
    {linkedinUrl && (
      <a
        class="team-profile-linkedin"
        href={linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={
          hasConfirmedLinkedin
            ? `View ${member.name}'s LinkedIn profile`
            : `LinkedIn placeholder link for ${member.name}`
        }
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="#0A66C2"
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451c.979 0 1.778-.773 1.778-1.729V1.73C24 .774 23.205 0 22.225 0z"
          />
        </svg>
      </a>
    )}
  </div>
  {/* Description temporarily hidden as requested - kept commented for future use */}
  {/* {description && <p class="team-profile-description">{description}</p>} */}
</article>

<style>
  .team-profile {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: var(--radius-medium);
    background: linear-gradient(145deg, #fff 0%, #fbf9f6 100%);
    transition:
      transform 240ms var(--ease-out),
      border-color 240ms ease,
      box-shadow 240ms ease;
  }

  .team-profile:hover {
    transform: translateY(-3px);
    border-color: rgb(168 65 33 / 32%);
    box-shadow: 0 14px 34px rgb(16 27 45 / 8%);
  }

  .team-avatar {
    display: grid;
    width: 100%;
    aspect-ratio: 4 / 5;
    flex: 0 0 auto;
    place-items: center;
    overflow: hidden;
    border: 1px solid rgb(16 27 45 / 7%);
    border-radius: calc(var(--radius-medium) - 0.25rem);
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    word-spacing: 0.04em;
  }

  .team-avatar-clay {
    background: #f3e4dc;
    color: var(--color-orange-dark);
  }

  .team-avatar-blue {
    background: #e5edf2;
    color: #315878;
  }

  .team-avatar-navy {
    background: #e6eaf0;
    color: var(--color-navy);
  }

  .team-avatar-sage {
    background: #e8eee8;
    color: #42624f;
  }

  .team-avatar.has-photo {
    background: #ffffff;
  }

  .team-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
  }

  .team-profile-copy {
    display: flex;
    min-height: 4.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 0.85rem 0.35rem 0.35rem;
    min-width: 0;
  }

  .team-profile-copy > div {
    min-width: 0;
  }

  .team-profile h3 {
    margin: 0 0 0.3rem;
    overflow-wrap: anywhere;
    color: var(--color-navy);
    font-size: 0.97rem;
    font-weight: 650;
    letter-spacing: -0.035em;
    word-spacing: 0.035em;
    line-height: 1.35;
  }

  .team-profile p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .team-profile .team-profile-description {
    margin: 0.55rem 0.25rem 0.2rem;
    color: var(--color-body);
    font-size: 0.8rem;
    line-height: 1.55;
  }

  .team-profile-linkedin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    flex: 0 0 auto;
    border-radius: 6px;
    background: transparent;
    transition:
      transform 200ms ease,
      opacity 200ms ease;
  }

  .team-profile-linkedin svg {
    width: 1.65rem;
    height: 1.65rem;
    display: block;
    border-radius: 4px;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .team-profile-linkedin:hover {
    transform: translateY(-2px);
  }

  .team-profile-linkedin:hover svg {
    filter: drop-shadow(0 3px 6px rgba(10, 102, 194, 0.4));
  }

  @media (prefers-reduced-motion: reduce) {
    .team-profile {
      transition: none;
    }

    .team-profile:hover {
      transform: none;
    }
  }
</style>
