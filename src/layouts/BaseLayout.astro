---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ContactModal from '../components/ContactModal.astro'
import heroVisual from '../assets/hero-orbit.png'
import introLogo from '../assets/Modern Blue and Orange iN Logo.png'

const {
  title = 'Incaendo | Software Development & Technology',
  description = 'Incaendo is a software development and technology company with 15 years of industry experience.',
  openGraphType = 'website',
} = Astro.props
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '')
const canonicalUrl = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).href
  : undefined
const socialImage = siteUrl ? new URL(heroVisual.src, siteUrl).href : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    <script is:inline>
      try {
        const introSeen = sessionStorage.getItem('incaendo-brand-intro-seen')
        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches
        if (!introSeen && !reducedMotion) {
          sessionStorage.setItem('incaendo-brand-intro-seen', 'true')
          document.documentElement.dataset.brandIntro = 'playing'
        }
      } catch {
        // If storage or scripting is unavailable, keep the site unobstructed.
      }
    </script>
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content="Incaendo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site-intro" data-site-intro aria-hidden="true" inert>
      <div class="site-intro-content">
        <div class="site-intro-visual">
          <span
            class="site-intro-particle is-orange"
            style="--x: -132px; --y: -58px; --delay: 690ms"
          ></span>
          <span
            class="site-intro-particle is-blue"
            style="--x: 130px; --y: -72px; --delay: 760ms"
          ></span>
          <span
            class="site-intro-particle is-orange"
            style="--x: -154px; --y: 16px; --delay: 820ms"
          ></span>
          <span
            class="site-intro-particle is-blue"
            style="--x: 151px; --y: 20px; --delay: 880ms"
          ></span>
          <span
            class="site-intro-particle is-blue"
            style="--x: -112px; --y: 78px; --delay: 740ms"
          ></span>
          <span
            class="site-intro-particle is-orange"
            style="--x: 115px; --y: 82px; --delay: 800ms"
          ></span>
          <img
            class="site-intro-logo"
            src={introLogo.src}
            width={introLogo.width}
            height={introLogo.height}
            alt=""
            decoding="async"
          />
        </div>
        <p class="site-intro-tagline">
          <span aria-hidden="true"></span>Ideas into digital solutions.
        </p>
      </div>
    </div>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <ContactModal />
    <script>
      import '../scripts/motion.js'
      import '../scripts/ai-showcase.js'
      import '../scripts/site-intro.js'
    </script>
  </body>
</html>
