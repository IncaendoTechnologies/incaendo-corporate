  .dp-enter {
    opacity: 1;
    transform-box: fill-box;
    transform-origin: center;
  }

  .delivery-live-scene.is-active .dp-enter {
    animation: dp-enter 560ms var(--ease-out) both;
  }

  .delivery-live-scene.is-active .dp-enter-two {
    animation-delay: 90ms;
  }

  .delivery-live-scene.is-active .dp-enter-three {
    animation-delay: 180ms;
  }

  .delivery-live-scene.is-active .dp-enter-four {
    animation-delay: 270ms;
  }

  .delivery-live-scene.is-active .dp-enter-core,
  .delivery-live-scene.is-active .dp-enter-score {
    animation-delay: 360ms;
  }

  .delivery-live-scene.is-active .dp-enter-alert {
    animation-delay: 420ms;
  }

  @keyframes dp-enter {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .delivery-live-scene.is-active .dp-link-soft {
    animation: dp-dash 7s linear infinite;
  }

  @keyframes dp-dash {
    to {
      stroke-dashoffset: -72;
    }
  }

  .delivery-live-scene.is-active .dp-flow-a,
  .delivery-live-scene.is-active .dp-flow-c {
    animation: dp-flow-forward 2.8s ease-in-out infinite;
  }

  .delivery-live-scene.is-active .dp-flow-b,
  .delivery-live-scene.is-active .dp-flow-d {
    animation: dp-flow-forward-alt 3.2s ease-in-out infinite;
  }

  .delivery-live-scene.is-active .dp-flow-c {
    animation: dp-flow-reverse 2.8s ease-in-out infinite;
  }

  .delivery-live-scene.is-active .dp-flow-d {
    animation: dp-flow-reverse 3.2s ease-in-out infinite;
  }

  .delivery-live-scene.is-active .dp-flow-e,
  .delivery-live-scene.is-active .dp-flow-f {
    animation: dp-flow-short 2.5s ease-in-out infinite;
  }

  .delivery-live-scene.is-active .dp-arch-flow {
    animation: dp-arch-rise 2.8s ease-in-out infinite;
  }

  @keyframes dp-arch-rise {
    0%,
    100% {
      opacity: 0.35;
      transform: translateY(0) scale(0.8);
    }
    50% {
      opacity: 1;
      transform: translateY(-42px) scale(1.12);
    }
  }

  @keyframes dp-flow-forward {
    0%,
    100% {
      opacity: 0.45;
      transform: translate(0, 0) scale(0.8);
    }
    50% {
      opacity: 1;
      transform: translate(44px, 21px) scale(1.15);
    }
  }

  @keyframes dp-flow-forward-alt {
    0%,
    100% {
      opacity: 0.4;
      transform: translate(0, 0) scale(0.8);
    }
    50% {
      opacity: 1;
      transform: translate(43px, -23px) scale(1.15);
    }
  }

  @keyframes dp-flow-reverse {
    0%,
    100% {
      opacity: 0.4;
      transform: translate(0, 0) scale(0.8);
    }
    50% {
      opacity: 1;
      transform: translate(-43px, 20px) scale(1.15);
    }
  }

  @keyframes dp-flow-short {
    0%,
    100% {
      opacity: 0.4;
      transform: translate(0, 0) scale(0.8);
    }
    50% {
      opacity: 1;
      transform: translate(18px, 0) scale(1.1);
    }
  }

  .delivery-live-scene.is-active .dp-core-halo {
    animation: dp-core-pulse 4.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes dp-core-pulse {
    50% {
      opacity: 0.55;
      transform: scale(1.08);
    }
  }

  .delivery-live-scene.is-active .dp-goal-core {
    animation: dp-core-lift 4.8s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes dp-core-lift {
    50% {
      transform: translateY(-2px);
    }
  }

  .delivery-live-scene.is-active .dp-pipeline-flow,
  .delivery-live-scene.is-active .dp-deploy-flow {
    animation: dp-particle-travel 1.8s ease-in-out infinite;
  }

  .delivery-live-scene.is-active .dp-pipeline-flow-two,
  .delivery-live-scene.is-active .dp-deploy-flow-b {
    animation-delay: 0.35s;
  }

  .delivery-live-scene.is-active .dp-pipeline-flow-three,
  .delivery-live-scene.is-active .dp-deploy-flow-c {
    animation-delay: 0.7s;
  }

  @keyframes dp-particle-travel {
    0%,
    100% {
      opacity: 0.35;
      transform: translateX(0) scale(0.8);
    }
    50% {
      opacity: 1;
      transform: translateX(18px) scale(1.12);
    }
  }

  .delivery-live-scene.is-active .dp-qa-progress {
    animation: dp-progress-in 700ms var(--ease-out) both;
  }

  .delivery-live-scene.is-active .dp-qa-progress-two {
    animation-delay: 120ms;
  }

  .delivery-live-scene.is-active .dp-qa-progress-three {
    animation-delay: 240ms;
  }

  .delivery-live-scene.is-active .dp-qa-progress-four {
    animation-delay: 360ms;
  }

  @keyframes dp-progress-in {
    from {
      transform: scaleX(0.03);
    }
  }

  .delivery-live-scene.is-active .dp-score-ring {
    animation: dp-score-draw 900ms var(--ease-out) both;
    animation-delay: 450ms;
  }

  @keyframes dp-score-draw {
    from {
      stroke-dashoffset: 195;
    }
    to {
      stroke-dashoffset: 15;
    }
  }

  .delivery-live-scene.is-active .dp-spark-line {
    animation: dp-spark-draw 1.4s var(--ease-out) both;
    animation-delay: 420ms;
  }

  @keyframes dp-spark-draw {
    from {
      stroke-dashoffset: 180;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .delivery-live-scene.is-active .dp-spark-dot {
    animation: dp-spark-pulse 2.8s ease-in-out infinite;
    animation-delay: 1.8s;
  }

  @keyframes dp-spark-pulse {
    50% {
      opacity: 0.4;
      transform: scale(0.75);
    }
  }

  @keyframes dp-alert {
    0%,
    82%,
    100% {
      opacity: 0.65;
      transform: scale(1);
    }
    90% {
      opacity: 1;
      transform: scale(1.35);
    }
  }

  .delivery-live-scene.is-active .dp-deploy-feedback {
    animation: dp-feedback-flow 6s linear infinite;
  }

  @keyframes dp-feedback-flow {
    to {
      stroke-dashoffset: 80;
    }
  }

  .delivery-live-scene.is-active .dp-feedback-arrow {
    animation: dp-feedback-pulse 3s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes dp-feedback-pulse {
    50% {
      opacity: 0.45;
    }
  }

  @media (max-width: 1023px) {
    .delivery-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .delivery-navigation-label {
      margin: 0 0 0.6rem 0.15rem;
    }

    .delivery-step-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.35rem;
    }

    .delivery-step-list::before {
      top: 1.2rem;
      right: 8%;
      bottom: auto;
      left: 8%;
      width: auto;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgb(168 65 33 / 35%),
        rgb(84 123 157 / 16%)
      );
    }

    .delivery-step {
      display: flex;
      min-height: 4.8rem;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.42rem;
      padding: 0.35rem 0.25rem 0.45rem;
      border-radius: 12px;
      text-align: center;
    }

    .delivery-step-copy {
      display: block;
      width: 100%;
    }

    .delivery-step-copy strong {
      display: block;
      font-size: 0.7rem;
    }

    .delivery-step-copy > span {
      display: none;
    }

    .delivery-step-full {
      display: none;
    }

    .delivery-step-short {
      display: inline;
    }

    .delivery-step-arrow {
      display: none;
    }

    .delivery-step-number {
      z-index: 1;
      width: 2rem;
      height: 2rem;
    }

    .delivery-step-list::before {
      left: 8%;
    }

    .delivery-collaboration-note,
    .delivery-collaboration-rule {
      display: none;
    }

    .delivery-collaboration {
      grid-column: 1;
    }

    .delivery-process.is-ready .delivery-live-visual {
      min-height: 320px;
    }

    .delivery-detail-grid {
      gap: 1rem;
    }

    .delivery-controls {
      grid-template-columns: minmax(92px, 0.9fr) minmax(100px, 1.2fr) minmax(
          92px,
          0.9fr
        );
      gap: 0.6rem;
      padding-inline: 1rem;
    }

    .delivery-process.is-ready .delivery-controls {
      padding-inline: 0;
    }
  }

  @media (max-width: 700px) {
    .delivery-process {
      padding-block: 2.5rem;
    }

    .delivery-intro {
      margin-bottom: 1.4rem;
    }

    .delivery-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .delivery-navigation-label {
      margin-left: 0.15rem;
      margin-bottom: 0.6rem;
    }

    .delivery-step-list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 0.28rem;
    }

    .delivery-step-list::before {
      top: 1.2rem;
      right: 8%;
      bottom: auto;
      left: 8%;
      width: auto;
      height: 1px;
      background: linear-gradient(
        90deg,
        rgb(168 65 33 / 35%),
        rgb(84 123 157 / 16%)
      );
    }

    .delivery-step {
      display: flex;
      min-height: 4.8rem;
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.42rem;
      padding: 0.35rem 0.12rem 0.45rem;
      border-radius: 12px;
      text-align: center;
    }

    .delivery-step:hover {
      transform: translateY(-2px) scale(1.015);
    }

    .delivery-step-number {
      z-index: 1;
      width: 2rem;
      height: 2rem;
      background: #faf9f7;
      font-size: 0.6rem;
    }

    .delivery-step-copy {
      display: block;
      width: 100%;
    }

    .delivery-step-copy strong {
      display: block;
      font-size: 0.61rem;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .delivery-step-copy > span {
      display: none;
    }

    .delivery-step-full {
      display: none;
    }

    .delivery-step-short {
