---
const capabilities = [
  {
    id: 'problem',
    number: '01',
    title: 'Define the Problem',
    detail: 'Identify the business problem, objectives, and success criteria.',
    caption:
      'Map the business need to clear objectives and criteria for success.',
  },
  {
    id: 'data',
    number: '02',
    title: 'Prepare the Data',
    detail: 'Collect, validate, clean, and structure relevant data.',
    caption:
      'Prepare reliable, relevant data before it enters model development.',
  },
  {
    id: 'model',
    number: '03',
    title: 'Build & Train Models',
    detail:
      'Develop or select suitable AI/ML models and evaluate their performance.',
    caption:
      'Train or select a model, then evaluate it against the problem criteria.',
  },
  {
    id: 'deploy',
    number: '04',
    title: 'Integrate & Deploy',
    detail:
      'Integrate the solution into business workflows and deploy it responsibly.',
    caption:
      'Connect the evaluated solution to real workflows with responsible deployment.',
  },
  {
    id: 'monitor',
    number: '05',
    title: 'Monitor & Improve',
    detail:
      'Track accuracy, reliability, outcomes, and continuously improve the solution.',
    caption:
      'Monitor quality, reliability, and outcomes to guide ongoing improvement.',
  },
]
