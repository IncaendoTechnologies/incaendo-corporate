    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ai-demo-label {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }
  .ai-demo-label i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 0 4px rgb(90 128 108 / 10%);
  }
  .ai-demo-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .ai-demo-arrow {
    display: grid;
    width: 30px;
    height: 30px;
    place-items: center;
    padding: 0;
    border: 1px solid #e3ded6;
    border-radius: 50%;
    background: #fff;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      border-color 200ms ease,
      color 200ms ease,
      background-color 200ms ease;
  }
  .ai-demo-arrow svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
  .ai-demo-arrow:hover,
  .ai-demo-arrow:focus-visible {
    border-color: var(--color-orange);
    background: #fff6f0;
    color: var(--color-orange-dark);
  }
  .ai-demo-arrow:disabled {
    cursor: default;
    opacity: 0.35;
  }
  .ai-demo-arrow:disabled:hover {
    border-color: #e3ded6;
    background: #fff;
    color: var(--color-ink);
  }
  .ai-demo-swipe-hint {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin: 0.6rem 0 0;
    color: var(--color-muted);
    font-size: 0.74rem;
    font-weight: 600;
  }
  .ai-demo-swipe-hint span {
    color: var(--color-orange-dark);
  }
  /* The whole panel can be swiped (touch) or dragged (mouse) sideways. */
  [data-workflow-demo] {
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }
  [data-workflow-demo].is-swiping,
  [data-workflow-demo].is-swiping * {
    cursor: grabbing;
  }
  .ai-demo-count {
    white-space: nowrap;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }
  .ai-demo-count b {
    color: #a0a8b1;
    font-weight: 500;
  }
  .ai-demo-progress {
    height: 2px;
    margin-top: 0.55rem;
    overflow: hidden;
    border-radius: 999px;
    background: #ece9e4;
  }
  .ai-demo-progress span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-orange), var(--color-blue));
    transform: scaleX(0.2);
    transform-origin: left;
    transition: transform 360ms var(--ease-out);
  }

  .ai-state-stage {
    display: grid;
    flex: 1;
    margin-top: 1rem;
  }
  .ai-state-card {
    display: grid;
    grid-area: 1 / 1;
    grid-template-rows: auto 1fr;
    gap: 1.2rem;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 280ms ease,
      transform 280ms var(--ease-out),
      visibility 280ms;
  }
  .ai-state-card.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .ai-state-kicker {
    display: block;
    color: var(--color-orange-dark);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.11em;
  }
  .ai-state-head h4 {
    margin: 0.45rem 0 0.6rem;
    color: var(--color-ink);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    word-spacing: 0.045em;
    line-height: 1.2;
  }
  .ai-state-head p {
    max-width: 920px;
    margin: 0;
    color: var(--color-body);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* Diagram primitives */
  .dg {
    display: grid;
    align-items: center;
    align-self: center;
    min-width: 0;
  }
  .dg-node {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgb(16 27 45 / 11%);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 10px 26px -22px rgb(16 27 45 / 40%);
  }
  .dg-node--tech {
    border-color: rgb(84 123 157 / 24%);
    background: #f3f7fa;
  }
  .dg-node--active {
    border-color: rgb(201 84 43 / 34%);
    background: #fffaf6;
    box-shadow:
      0 0 0 4px rgb(201 84 43 / 6%),
      0 10px 26px -22px rgb(168 65 33 / 45%);
  }
  .dg-node--core {
    border-color: transparent;
    background: linear-gradient(
      150deg,
      var(--color-navy-soft),
      var(--color-navy)
    );
    box-shadow: 0 16px 32px -20px rgb(16 27 45 / 60%);
    color: #fff;
  }
  .ai-state-card.is-active .dg-node {
    animation: dg-node-in 420ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 70ms);
  }
  .dg-tag {
    color: var(--color-blue);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1.3;
  }
  .dg-node--active .dg-tag {
    color: var(--color-orange-dark);
  }
  .dg-node--core .dg-tag {
    color: #f2b79f;
  }
  .dg-title {
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .dg-node--core .dg-title {
    color: #fff;
  }
  .dg-text {
    margin: 0;
    color: var(--color-body);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .dg-node--core .dg-text {
    color: rgb(255 255 255 / 78%);
  }
  .dg-quote {
    margin: 0;
    padding: 0.6rem 0.7rem;
    border-radius: 10px 10px 10px 3px;
    background: #f6f3ee;
    color: var(--color-ink);
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.45;
  }

  .dg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-chips li {
    padding: 0.32rem 0.6rem;
    border: 1px solid rgb(16 27 45 / 10%);
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .dg-chips--blocks li {
    border-radius: 8px;
  }
  .dg-chips li.is-accent {
    border-color: rgb(84 123 157 / 30%);
    background: #eaf0f5;
    color: #2f5677;
  }
  .dg-node--core .dg-chips li {
    border-color: rgb(255 255 255 / 16%);
    background: rgb(255 255 255 / 7%);
    color: #fff;
  }
  .dg-chips--scan li {
    animation: dg-chip-scan 3.6s ease-in-out infinite;
  }
  .dg-chips--scan li:nth-child(2) {
    animation-delay: 1.2s;
  }
  .dg-chips--scan li:nth-child(3) {
    animation-delay: 2.4s;
  }

  .dg-spec {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
  }
  .dg-spec div {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid rgb(201 84 43 / 12%);
  }
  .dg-spec div:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .dg-spec dt {
    color: var(--color-orange-dark);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dg-spec dd {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
    line-height: 1.4;
  }

  .dg-files {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-files li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.45rem;
    border: 1px solid #eeece8;
    border-radius: 9px;
    background: #fff;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
  }
  .dg-files i {
    display: grid;
    min-width: 30px;
    height: 22px;
    flex: none;
    place-items: center;
    border-radius: 6px;
    background: #f8eee8;
    color: var(--color-orange-dark);
    font-size: 0.66rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .dg-files i.is-blue {
    background: #eaf0f5;
    color: var(--color-blue);
  }
  .dg-files i.is-sand {
    background: #f5f0e4;
    color: #806a3f;
  }
  .dg-tools i {
    min-width: 22px;
    font-size: 0.78rem;
  }

  .dg-stages {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: stage;
  }
  .dg-stages li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
    line-height: 1.35;
    counter-increment: stage;
  }
  .dg-stages li::before {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: var(--color-orange);
    color: #fff;
    content: '✓';
    font-size: 0.65rem;
    font-weight: 800;
  }
  .ai-state-card.is-active .dg-stages li::before {
    animation: dg-check-in 360ms var(--ease-out) both;
  }
  .ai-state-card.is-active .dg-stages li:nth-child(1)::before {
    animation-delay: 380ms;
  }
  .ai-state-card.is-active .dg-stages li:nth-child(2)::before {
    animation-delay: 620ms;
  }
  .ai-state-card.is-active .dg-stages li:nth-child(3)::before {
    animation-delay: 860ms;
  }
  .dg-chunks {
    display: flex;
    gap: 4px;
    margin-top: 0.2rem;
  }
  .dg-chunks span {
    height: 8px;
    flex: 1;
    border-radius: 3px;
    background: rgb(201 84 43 / 22%);
  }
  .dg-chunks span:nth-child(2) {
    flex: 1.6;
    background: rgb(201 84 43 / 38%);
  }
  .dg-chunks span:nth-child(3) {
    flex: 0.8;
  }
  .dg-chunks span:nth-child(4) {
    flex: 1.3;
    background: rgb(84 123 157 / 30%);
  }

  .dg-vectors {
    display: grid;
    gap: 0.25rem;
  }
  .dg-vectors code {
    overflow: hidden;
    padding: 0.22rem 0.4rem;
    border-radius: 6px;
    background: #fff;
    color: #2f5677;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dg-db {
    width: 42px;
    height: 42px;
    fill: #fff;
    stroke: var(--color-blue);
    stroke-linecap: round;
    stroke-width: 1.6;
  }
  .ai-state-card.is-active .dg-db {
    animation: dg-db-glow 2.4s ease-in-out 1.6s infinite;
  }

  .dg-matches {
    display: grid;
    gap: 0.45rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-matches li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30%;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 550;
  }
  .dg-matches i {
    display: block;
    width: var(--w);
    height: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-blue), #8fb0cb);
    transform-origin: left;
  }
  .ai-state-card.is-active .dg-matches i {
    animation: dg-bar-in 600ms var(--ease-out) 500ms both;
  }

  .dg-typing {
    display: inline-flex;
    gap: 3px;
    margin-left: 0.2rem;
    vertical-align: middle;
  }
  .dg-typing i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #f2b79f;
    animation: dg-typing 1.2s ease-in-out infinite;
  }
  .dg-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .dg-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }

  .dg-checks {
    display: grid;
    gap: 0.38rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-checks li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
    line-height: 1.35;
  }
  .dg-checks li::before {
    color: var(--color-green);
    content: '✓';
    font-weight: 800;
  }
  .dg-checks li.is-flag::before {
    color: var(--color-orange);
    content: '→';
  }

  .dg-result,
  .dg-approval {
    justify-self: start;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .dg-result {
    background: #eef4ef;
    color: #315d45;
  }
  .dg-approval {
    position: relative;
    border: 1px solid rgb(201 84 43 / 35%);
    background: #fff;
    color: var(--color-orange-dark);
  }
  .dg-approval::before {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--color-orange);
    animation: dg-pulse 2s ease-in-out infinite;
    content: '';
    vertical-align: 1px;
  }

  /* Connectors: horizontal by default; is-left, is-down and is-up change direction */
  .dg-link {
    position: relative;
    height: 2px;
    align-self: center;
    margin-inline: 6px;
    background: rgb(201 84 43 / 38%);
    color: var(--color-orange);
  }
  .dg-link::after {
    position: absolute;
    top: 50%;
    right: 0;
    bottom: auto;
    left: auto;
    width: 8px;
    height: 8px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    content: '';
    transform: translate(0, -50%) rotate(45deg);
  }
  .dg-link i {
    position: absolute;
    inset: 0;
    animation: dg-travel-right 2.2s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  .dg-link i::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border: 2px solid currentColor;
    border-radius: 50%;
    background: #fff8f4;
    box-shadow: 0 0 0 4px rgb(201 84 43 / 12%);
    content: '';
  }
  .dg-link.is-left::after {
    right: auto;
    left: 0;
    transform: translate(0, -50%) rotate(-135deg);
  }
  .dg-link.is-left i {
    animation-name: dg-travel-left;
  }
  .dg-link.is-left i::before {
    left: 100%;
  }
  .dg-link.is-down,
  .dg-link.is-up {
    width: 2px;
    height: auto;
    min-height: 24px;
    align-self: stretch;
    justify-self: center;
    margin: 6px 0;
  }
  .dg-link.is-down::after {
    top: auto;
    right: auto;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 0) rotate(135deg);
  }
  .dg-link.is-down i {
    animation-name: dg-travel-down;
  }
  .dg-link.is-down i::before {
    top: 0;
    left: 50%;
  }
  .dg-link.is-up::after {
    top: 0;
    right: auto;
    bottom: auto;
    left: 50%;
    transform: translate(-50%, 0) rotate(-45deg);
  }
  .dg-link.is-up i {
    animation-name: dg-travel-up;
  }
  .dg-link.is-up i::before {
    top: 100%;
    left: 50%;
  }
  .dg-link em {
    position: absolute;
    bottom: 8px;
    left: 50%;
    color: var(--color-muted);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 650;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .dg-duplex {
    display: grid;
    align-self: center;
    gap: 30px;
    padding-block: 18px;
  }
  .dg-duplex .dg-link {
    margin-inline: 4px;
  }
  .dg-duplex .dg-link.is-left {
    background: rgb(84 123 157 / 40%);
    color: var(--color-blue);
  }
  .dg-duplex .dg-link.is-left i::before {
    background: #f3f7fa;
    box-shadow: 0 0 0 4px rgb(84 123 157 / 12%);
  }
  .dg-duplex .dg-link.is-left em {
    top: 8px;
    bottom: auto;
  }

  /* Step layouts */
  .dg-understand {
    grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr) 48px minmax(
        0,
        1.1fr
      );
  }
  .dg-prepare {
    grid-template-columns:
      minmax(0, 1.05fr) 36px minmax(0, 1.2fr) 36px minmax(0, 0.95fr)
      36px minmax(0, 0.95fr);
  }
  .dg-design {
    grid-template-areas:
      'query l1 retrieve l2 vector'
      '. . . . l3'
      'eval l5 llm l4 prompt';
    grid-template-columns: minmax(0, 1fr) 46px minmax(0, 1fr) 46px minmax(
        0,
        1fr
      );
    align-items: stretch;
  }
  .dg-design > .dg-link:not(.is-down) {
    align-self: center;
  }
  .dg-a-query {
    grid-area: query;
  }
  .dg-a-retrieve {
    grid-area: retrieve;
  }
  .dg-a-vector {
    grid-area: vector;
  }
  .dg-a-prompt {
    grid-area: prompt;
  }
  .dg-a-llm {
    grid-area: llm;
  }
  .dg-design .dg-a-eval {
    grid-area: eval;
  }
  .dg-design .dg-a-l1 {
    grid-area: l1;
  }
  .dg-design .dg-a-l2 {
    grid-area: l2;
  }
  .dg-design .dg-a-l3 {
    grid-area: l3;
  }
  .dg-design .dg-a-l4 {
    grid-area: l4;
  }
  .dg-design .dg-a-l5 {
    grid-area: l5;
  }
  .dg-connect {
    grid-template-columns:
      minmax(0, 1fr) 62px minmax(0, 1.05fr) 56px minmax(0, 1fr)
      50px minmax(0, 0.95fr);
    align-items: stretch;
  }
  .dg-improve {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.85fr);
    gap: 1rem;
    align-items: stretch;
  }
  .dg-loop {
    position: relative;
    display: grid;
    grid-template-areas:
      'eval l1 monitor'
      'l4 hub l2'
      'iterate l3 feedback';
    grid-template-columns: minmax(0, 1fr) 54px minmax(0, 1fr);
    grid-template-rows: auto 52px auto;
    align-items: stretch;
  }
  .dg-loop .dg-a-eval {
    grid-area: eval;
  }
  .dg-a-monitor {
    grid-area: monitor;
  }
  .dg-a-feedback {
    grid-area: feedback;
  }
  .dg-a-iterate {
    grid-area: iterate;
  }
  .dg-loop .dg-a-l1 {
    grid-area: l1;
  }
  .dg-loop .dg-a-l2 {
    grid-area: l2;
  }
  .dg-loop .dg-a-l3 {
    grid-area: l3;
  }
  .dg-loop .dg-a-l4 {
    grid-area: l4;
  }
  .dg-loop-hub {
    display: grid;
    width: 42px;
    height: 42px;
    grid-area: hub;
    place-self: center;
    place-items: center;
    border: 1px solid rgb(201 84 43 / 25%);
    border-radius: 50%;
    background: #fff;
    color: var(--color-orange);
  }
  .dg-loop-hub svg {
    width: 22px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    animation: dg-spin 9s linear infinite;
  }
  .dg-signals ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dg-signals-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .dg-signals-head small {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: var(--surface-subtle);
    color: var(--color-muted);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .dg-signals li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem 0.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid #f0eeeb;
