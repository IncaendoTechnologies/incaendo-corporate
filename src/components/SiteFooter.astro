---
/*
 * Site footer: the design system `SiteFooter` (inc-footer), markup and copy
 * as in the design system. The .inc-shell wrapper lets its container
 * queries switch to four columns from 1024px. Styles come from
 * src/styles/incaendo/components.css.
 */
import { Image } from 'astro:assets'
import logoReversed from '../assets/incaendo-logo-reversed.png'
import { homepageServices } from '../data/site-content.js'

const currentYear = new Date().getFullYear()

// Footer columns, one job each: what we do (Services), who we are
// (Company), where to get help and the legal pages, and how to reach us.
const companyLinks = [
  { href: '/ai-technology', label: 'AI' },
  { href: '/projects', label: 'Projects' },
  { href: '/teams', label: 'Teams' },
  { href: '/insights', label: 'Insights' },
  // Goes to the Contact page; the popup is for in-page calls to action.
  { href: '/contact', label: 'Contact us', contactPage: true },
]

const helpLinks = [
  { href: '/careers', label: 'Careers' },
  // Help and legal pages open in a new tab, as they always have.
  { href: '/faq', label: 'FAQ', newTab: true },
  { href: '/privacy-policy', label: 'Privacy Policy', newTab: true },
  { href: '/terms-and-conditions', label: 'Terms & Conditions', newTab: true },
]

const mapUrl =
  'https://www.google.com/maps/dir/?api=1&destination=TigerCubs%2C%20B-9%2C%20B%20Block%2C%20Sector%202%2C%20Noida%2C%20UP%20201301'
---

<div class="inc-shell">
  <footer class="inc-footer">
    <div class="site-container">
      <div class="inc-footer-grid site-footer-grid">
        <div class="inc-footer-brand">
          <a href="/" aria-label="Incaendo home">
            <Image
              src={logoReversed}
              width={348}
              alt="Incaendo Technologies"
              loading="lazy"
            />
          </a>
          <p>
            Web platforms, mobile apps, AI agents and cloud infrastructure for
            startups, SMEs and enterprises, since 2012.
          </p>
        </div>

        <nav aria-label="Services">
          <p class="inc-footer-heading">Services</p>
          <ul>
            {homepageServices.map((service) => (
              <li>
                <a class="inc-footer-link" href={service.href}>
                  {service.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label="Company">
          <p class="inc-footer-heading">Company</p>
          <ul>
            {companyLinks.map((link) => (
              <li>
                <a
                  class="inc-footer-link"
                  href={link.href}
                  data-contact-page-link={link.contactPage ? '' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label="Help and legal">
          <p class="inc-footer-heading">Help &amp; legal</p>
          <ul>
            {helpLinks.map((link) => (
              <li>
                <a
                  class="inc-footer-link"
                  href={link.href}
                  target={link.newTab ? '_blank' : undefined}
                  rel={link.newTab ? 'noopener noreferrer' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="inc-footer-contact">
          <p class="inc-footer-heading">Get in touch</p>
          <address>
            Incaendo Technologies Private Limited
            <br />
            <a
              class="inc-footer-link"
              href={mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="First Floor, B-9, B Block, Sector 2, Noida, UP 201301, India (opens Google Maps in a new tab)"
            >
              First Floor, B-9, B Block, Sector 2<br />
              Noida, UP – 201301, India
            </a>
          </address>
          <p class="footer-email">
            <a class="inc-footer-link" href="mailto:info@incaendo.com">
              info@incaendo.com
            </a>
          </p>
          <div class="inc-footer-social">
            <a
              href="https://www.linkedin.com/company/incaendo-technologies-pvt-ltd-/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Incaendo on LinkedIn"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="is-solid"
                aria-hidden="true"
              >
                <path d="M2.5 9h4v12h-4zM4.5 2.8a2.2 2.2 0 1 1 0 4.4 2.2 2.2 0 0 1 0-4.4zM9 9h3.8v1.7h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.7 4.8 6.1V21h-4v-5.5c0-1.4 0-3.1-1.9-3.1-1.9 0-2.2 1.5-2.2 3V21H9z"></path>
              </svg>
            </a>
            <a
              href="https://www.instagram.com/incaendo_technologies/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Incaendo on Instagram"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
            </a>
            <a
              href="https://www.facebook.com/Incaendo/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Incaendo on Facebook"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="is-solid"
                aria-hidden="true"
              >
                <path d="M14 22v-8h2.8l.4-3.3H14V8.6c0-.9.3-1.6 1.6-1.6h1.7V4.2c-.3 0-1.3-.1-2.5-.1-2.5 0-4.1 1.5-4.1 4.2v2.4H8v3.3h2.7v8z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="inc-footer-legal">
        <span>© {currentYear} Incaendo Technologies Private Limited</span>
      </div>
    </div>
  </footer>
</div>

<style>
  /* Matches the design system preview: the email sits 12px below the
     address. */
  .footer-email {
    margin: var(--space-3) 0 0;
  }

  /* Column headings: a little larger than the design system's 12px, with a
     short orange rule set a little below them. */
  .inc-footer-heading {
    position: relative;
    margin-bottom: 1.4rem;
    padding-bottom: 0.75rem;
    font-size: 14px;
    line-height: 20px;
    opacity: 0.9;
  }
  .inc-footer-heading::after {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 32px;
    height: 2px;
    border-radius: 2px;
    background: var(--orange);
    content: '';
  }

  /* Social links under Get in touch, as solid orange circles. */
  .inc-footer-contact .inc-footer-social {
    margin-top: var(--space-4);
  }
  .inc-footer-social a {
    border-color: var(--orange);
    background: var(--orange);
    color: #fff;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }
  /* Bolder strokes so the white icons read clearly on orange. */
  .inc-footer-social svg {
    width: 20px;
    height: 20px;
    stroke-width: 2.25;
  }
  .inc-footer-social svg.is-solid {
    stroke: none;
  }
  .inc-footer-social a:hover,
  .inc-footer-social a:focus-visible {
    border-color: var(--orange-text);
    background: var(--orange-text);
    transform: translateY(-2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .inc-footer-social a {
      transition: none;
    }
    .inc-footer-social a:hover {
      transform: none;
    }
  }

  /* Five columns on wide screens: brand, Services, Company, Help & legal,
     Get in touch (from 1200px). Narrower: brand on its own row, the three link groups
     side by side, contact details below. Phones: two columns, with the
     longer Services labels across the full width. */
  .inc-footer-grid.site-footer-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  /* Below the five-column width, brand and contact take full rows (the
     design system lets them share a row from 1024px). */
  .site-footer-grid > .inc-footer-brand,
  .site-footer-grid > .inc-footer-contact {
    grid-column: 1 / -1;
  }
  @container (min-width: 1200px) {
    .site-footer-grid > .inc-footer-brand,
    .site-footer-grid > .inc-footer-contact {
      grid-column: auto;
    }
  }

  @container (min-width: 1200px) {
    .inc-footer-grid.site-footer-grid {
      grid-template-columns: 1.45fr 1.25fr 0.8fr 1fr 1.35fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 1023px) {
    .inc-footer-brand img {
      height: 32px;
      width: auto;
    }
  }

  @container (max-width: 599px) {
    .inc-footer-grid.site-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .inc-footer-grid.site-footer-grid > nav[aria-label='Services'] {
      grid-column: 1 / -1;
    }
  }
</style>
