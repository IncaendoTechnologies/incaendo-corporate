---
/**
 * Illustrative architecture diagram for one step of the AI practical-path
 * roadmap (AIPracticalPath.astro). The parent card (.ai-state-card) gets
 * .is-active when its step is selected; that starts these animations.
 *
 * name: 'understand' | 'prepare' | 'design' | 'connect' | 'improve'
 */
const { name } = Astro.props
---

{name === 'understand' && (
  <div class="dg dg-flow dg-understand">
    <div class="dg-node" style="--i: 0">
      <span class="dg-tag">USER INPUT</span>
      <b class="dg-title">Business request</b>
      <p class="dg-quote">
        “Customers keep asking if they can change a delivery address. Can AI
        help our support team?”
      </p>
    </div>
    <span class="dg-link" style="--d: 0s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--core" style="--i: 1">
      <span class="dg-tag">LLM-BASED ANALYSIS</span>
      <b class="dg-title">Interpret the need</b>
      <ul class="dg-chips dg-chips--scan">
        <li>User intent</li>
        <li>Context extraction</li>
        <li>Constraint check</li>
      </ul>
    </div>
    <span class="dg-link" style="--d: 1.1s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--active" style="--i: 2">
      <span class="dg-tag">SOLUTION REQUIREMENTS</span>
      <dl class="dg-spec">
        <div>
          <dt>Goal</dt>
          <dd>Faster, consistent answers</dd>
        </div>
        <div>
          <dt>Context</dt>
          <dd>Order status, delivery policy</dd>
        </div>
        <div>
          <dt>Limits</dt>
          <dd>Approved sources only</dd>
        </div>
        <div>
          <dt>Outcome</dt>
          <dd>Exceptions go to a person</dd>
        </div>
      </dl>
    </div>
  </div>
)}

{name === 'prepare' && (
  <div class="dg dg-flow dg-prepare">
    <div class="dg-node" style="--i: 0">
      <span class="dg-tag">RAW SOURCES</span>
      <ul class="dg-files">
        <li>
          <i>PDF</i> Delivery policy
        </li>
        <li>
          <i class="is-blue">DOC</i> Help articles
        </li>
        <li>
          <i class="is-sand">CSV</i> Support tickets
        </li>
      </ul>
    </div>
    <span class="dg-link" style="--d: 0s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--active" style="--i: 1">
      <span class="dg-tag">DATA PREPROCESSING</span>
      <ol class="dg-stages">
        <li>Clean &amp; de-duplicate</li>
        <li>Validate, remove sensitive data</li>
        <li>Chunk into passages</li>
      </ol>
      <span class="dg-chunks" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </span>
    </div>
    <span class="dg-link" style="--d: 0.7s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--tech" style="--i: 2">
      <span class="dg-tag">EMBEDDINGS</span>
      <b class="dg-title">Text → vectors</b>
      <span class="dg-vectors" aria-hidden="true">
        <code>[0.12, −0.48, …]</code>
        <code>[0.67, 0.05, …]</code>
        <code>[−0.21, 0.74, …]</code>
      </span>
      <p class="dg-text">Captures meaning, not just keywords.</p>
    </div>
    <span class="dg-link" style="--d: 1.4s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--tech" style="--i: 3">
      <span class="dg-tag">VECTOR DATABASE</span>
      <svg class="dg-db" viewBox="0 0 40 40" aria-hidden="true">
        <ellipse cx="20" cy="9" rx="13" ry="4.5" />
        <path d="M7 9v22c0 2.5 5.8 4.5 13 4.5s13-2 13-4.5V9M7 16.5c0 2.5 5.8 4.5 13 4.5s13-2 13-4.5M7 24c0 2.5 5.8 4.5 13 4.5s13-2 13-4.5" />
      </svg>
      <p class="dg-text">Indexed passages, ready for retrieval.</p>
    </div>
  </div>
)}

{name === 'design' && (
  <div class="dg dg-flow dg-design">
    <div class="dg-node dg-a-query" style="--i: 0">
      <span class="dg-tag">USER QUERY</span>
      <p class="dg-quote">“Can I change my delivery address?”</p>
    </div>
    <span class="dg-link dg-a-l1" style="--d: 0s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--tech dg-a-retrieve" style="--i: 1">
      <span class="dg-tag">RETRIEVAL · RAG</span>
      <b class="dg-title">Search approved knowledge</b>
      <p class="dg-text">Finds passages related to the query.</p>
    </div>
    <span class="dg-link dg-a-l2" style="--d: 0.5s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--tech dg-a-vector" style="--i: 2">
      <span class="dg-tag">VECTOR DATABASE</span>
      <ul class="dg-matches">
        <li>
          <span>Delivery policy §2</span>
          <i style="--w: 92%"></i>
        </li>
        <li>
          <span>Address change FAQ</span>
          <i style="--w: 74%"></i>
        </li>
        <li>
          <span>Shipping times</span>
          <i style="--w: 38%"></i>
        </li>
      </ul>
    </div>
    <span class="dg-link is-down dg-a-l3" style="--d: 1s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-a-prompt" style="--i: 3">
      <span class="dg-tag">PROMPT + CONTEXT</span>
      <ul class="dg-chips dg-chips--blocks">
        <li>Instructions</li>
        <li>User query</li>
        <li class="is-accent">Retrieved passages</li>
      </ul>
    </div>
    <span class="dg-link is-left dg-a-l4" style="--d: 1.5s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--core dg-a-llm" style="--i: 4">
      <span class="dg-tag">LLM</span>
      <b class="dg-title">Generate a grounded response</b>
      <p class="dg-text">
        Drafts an answer that cites the policy
        <span class="dg-typing" aria-hidden="true">
          <i></i>
          <i></i>
          <i></i>
        </span>
      </p>
    </div>
    <span class="dg-link is-left dg-a-l5" style="--d: 2s" aria-hidden="true">
      <i></i>
    </span>
    <div class="dg-node dg-node--active dg-a-eval" style="--i: 5">
      <span class="dg-tag">EVALUATION</span>
      <ul class="dg-checks">
        <li>Grounded in sources</li>
        <li>Follows policy</li>
        <li class="is-flag">Unsure? Route to a person</li>
      </ul>
    </div>
  </div>
)}

{name === 'connect' && (
  <div class="dg dg-flow dg-connect">
    <div class="dg-node" style="--i: 0">
      <span class="dg-tag">BUSINESS APP · CRM</span>
      <b class="dg-title">Support ticket</b>
      <p class="dg-text">New request arrives.</p>
      <span class="dg-result">✓ Reply &amp; case note saved</span>
    </div>
    <span class="dg-duplex" aria-hidden="true">
      <span class="dg-link" style="--d: 0s">
        <i></i>
        <em>request</em>
      </span>
      <span class="dg-link is-left" style="--d: 2.2s">
        <i></i>
        <em>update</em>
      </span>
    </span>
    <div class="dg-node dg-node--tech" style="--i: 1">
      <span class="dg-tag">API + ORCHESTRATION</span>
      <b class="dg-title">Integration layer</b>
      <p class="dg-text">Permissions, routing, and each workflow step.</p>
      <span class="dg-approval">Human approval</span>
    </div>
    <span class="dg-duplex" aria-hidden="true">
      <span class="dg-link" style="--d: 0.55s">
        <i></i>
        <em>task</em>
      </span>
      <span class="dg-link is-left" style="--d: 1.65s">
        <i></i>
        <em>draft</em>
      </span>
    </span>
    <div class="dg-node dg-node--core" style="--i: 2">
      <span class="dg-tag">AI AGENT · LLM SERVICE</span>
      <b class="dg-title">Plans the next action</b>
      <p class="dg-text">Chooses which tools to call.</p>
    </div>
    <span class="dg-duplex" aria-hidden="true">
      <span class="dg-link" style="--d: 1.1s">
        <i></i>
        <em>call</em>
      </span>
      <span class="dg-link is-left" style="--d: 1.35s">
        <i></i>
        <em>data</em>
      </span>
    </span>
    <div class="dg-node" style="--i: 3">
      <span class="dg-tag">TOOLS</span>
      <ul class="dg-files dg-tools">
        <li>
          <i class="is-blue">⌗</i> Order system
        </li>
        <li>
          <i class="is-blue">?</i> Knowledge base
        </li>
        <li>
          <i class="is-blue">@</i> Email
        </li>
      </ul>
    </div>
  </div>
)}

{name === 'improve' && (
  <div class="dg dg-improve">
    <div class="dg-loop">
      <div class="dg-node dg-node--active dg-a-eval" style="--i: 0">
        <span class="dg-tag">EVALUATION</span>
        <b class="dg-title">Quality checks</b>
        <p class="dg-text">Review sampled responses against sources.</p>
      </div>
      <span class="dg-link dg-a-l1" style="--d: 0s" aria-hidden="true">
        <i></i>
      </span>
      <div class="dg-node dg-node--tech dg-a-monitor" style="--i: 1">
        <span class="dg-tag">MONITORING</span>
        <b class="dg-title">Reliability signals</b>
        <p class="dg-text">Errors, escalations, response times.</p>
      </div>
      <span
        class="dg-link is-down dg-a-l2"
        style="--d: 0.55s"
        aria-hidden="true"
      >
        <i></i>
      </span>
      <span class="dg-loop-hub" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M19.5 12a7.5 7.5 0 0 1-12.8 5.3M4.5 12a7.5 7.5 0 0 1 12.8-5.3" />
          <path d="M17.5 3.5v3.3h-3.3M6.5 20.5v-3.3h3.3" />
        </svg>
      </span>
      <div class="dg-node dg-a-feedback" style="--i: 2">
        <span class="dg-tag">FEEDBACK</span>
        <b class="dg-title">People’s input</b>
        <p class="dg-text">Team ratings and user corrections.</p>
      </div>
      <span
        class="dg-link is-left dg-a-l3"
        style="--d: 1.1s"
        aria-hidden="true"
      >
        <i></i>
      </span>
      <div class="dg-node dg-node--core dg-a-iterate" style="--i: 3">
        <span class="dg-tag">ITERATE</span>
        <b class="dg-title">Refine &amp; redeploy</b>
        <p class="dg-text">Update prompts, data, or workflow.</p>
      </div>
      <span class="dg-link is-up dg-a-l4" style="--d: 1.65s" aria-hidden="true">
        <i></i>
      </span>
    </div>
    <div class="dg-node dg-signals" style="--i: 4">
      <div class="dg-signals-head">
        <span class="dg-tag">SIGNALS TO REVIEW</span>
        <small>Illustrative</small>
      </div>
      <ul>
        <li>
          <span>Response quality</span>
          <em class="is-good">On track</em>
        </li>
        <li>
          <span>Source grounding</span>
          <em class="is-check">Check samples</em>
        </li>
        <li>
          <span>Escalation themes</span>
          <em class="is-watch">New pattern</em>
        </li>
        <li>
          <span>Team feedback</span>
          <em class="is-good">Collected</em>
        </li>
      </ul>
      <p class="dg-text">Qualitative indicators, not live data.</p>
    </div>
  </div>
)}

<style>
  .dg {
    display: grid;
    align-items: center;
    align-self: center;
    min-width: 0;
  }
  .dg-node {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgb(15 33 54 / 11%);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-1);
  }
  .dg-node--tech {
    border-color: rgb(84 123 157 / 24%);
    background: #f3f7fa;
  }
  .dg-node--active {
    border-color: rgb(194 76 18 / 34%);
    background: #fffaf6;
    box-shadow: var(--shadow-1);
  }
  .dg-node--core {
    border-color: transparent;
    background: linear-gradient(
      150deg,
      var(--color-navy-soft),
      var(--color-navy)
    );
    box-shadow: var(--shadow-1);
    color: #fff;
  }
  :global(.ai-state-card.is-active) .dg-node {
    animation: dg-node-in 420ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 70ms);
  }
  .dg-tag {
    color: var(--color-blue);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.3;
  }
  .dg-node--active .dg-tag {
    color: var(--color-orange-text);
  }
  .dg-node--core .dg-tag {
    color: #f2b79f;
  }
  .dg-title {
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .dg-node--core .dg-title {
    color: #fff;
  }
  .dg-text {
    margin: 0;
    color: var(--color-body);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .dg-node--core .dg-text {
    color: rgb(255 255 255 / 78%);
  }
  .dg-quote {
    margin: 0;
    padding: 0.6rem 0.7rem;
    border-radius: var(--radius-md) var(--radius-md) var(--radius-md)
      var(--radius-sm);
    background: #f6f3ee;
    color: var(--color-ink);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.45;
  }
  .dg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-chips li {
    padding: 0.32rem 0.6rem;
    border: 1px solid rgb(15 33 54 / 10%);
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .dg-chips--blocks li {
    border-radius: var(--radius-md);
  }
  .dg-chips li.is-accent {
    border-color: rgb(84 123 157 / 30%);
    background: #eaf0f5;
    color: #2f5677;
  }
  .dg-node--core .dg-chips li {
    border-color: rgb(255 255 255 / 16%);
    background: rgb(255 255 255 / 7%);
    color: #fff;
  }
  .dg-chips--scan li {
    animation: dg-chip-scan 3.6s ease-in-out infinite;
  }
  .dg-chips--scan li:nth-child(2) {
    animation-delay: 1.2s;
  }
  .dg-chips--scan li:nth-child(3) {
    animation-delay: 2.4s;
  }
  .dg-spec {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
  }
  .dg-spec div {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid rgb(194 76 18 / 12%);
  }
  .dg-spec div:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .dg-spec dt {
    color: var(--color-orange-text);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dg-spec dd {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .dg-files {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-files li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.45rem;
    border: 1px solid #eeece8;
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .dg-files i {
    display: grid;
    min-width: 30px;
    height: 22px;
    flex: none;
    place-items: center;
    border-radius: var(--radius-md);
    background: #f8eee8;
    color: var(--color-orange-text);
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .dg-files i.is-blue {
    background: #eaf0f5;
    color: var(--color-blue);
  }
  .dg-files i.is-sand {
    background: #f5f0e4;
    color: #806a3f;
  }
  .dg-tools i {
    min-width: 22px;
    font-size: 0.78rem;
  }
  .dg-stages {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: stage;
  }
  .dg-stages li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.35;
    counter-increment: stage;
  }
  .dg-stages li::before {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: var(--color-orange);
    color: #fff;
    content: '✓';
    font-size: 0.75rem;
    font-weight: 800;
  }
  :global(.ai-state-card.is-active) .dg-stages li::before {
    animation: dg-check-in 360ms var(--ease-out) both;
  }
  :global(.ai-state-card.is-active) .dg-stages li:nth-child(1)::before {
    animation-delay: 380ms;
  }
  :global(.ai-state-card.is-active) .dg-stages li:nth-child(2)::before {
    animation-delay: 620ms;
  }
  :global(.ai-state-card.is-active) .dg-stages li:nth-child(3)::before {
    animation-delay: 860ms;
  }
  .dg-chunks {
    display: flex;
    gap: 4px;
    margin-top: 0.2rem;
  }
  .dg-chunks span {
    height: 8px;
    flex: 1;
    border-radius: var(--radius-sm);
    background: rgb(194 76 18 / 22%);
  }
  .dg-chunks span:nth-child(2) {
    flex: 1.6;
    background: rgb(194 76 18 / 38%);
  }
  .dg-chunks span:nth-child(3) {
    flex: 0.8;
  }
  .dg-chunks span:nth-child(4) {
    flex: 1.3;
    background: rgb(84 123 157 / 30%);
  }
  .dg-vectors {
    display: grid;
    gap: 0.25rem;
  }
  .dg-vectors code {
    overflow: hidden;
    padding: 0.22rem 0.4rem;
    border-radius: var(--radius-md);
    background: #fff;
    color: #2f5677;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dg-db {
    width: 42px;
    height: 42px;
    fill: #fff;
    stroke: var(--color-blue);
    stroke-linecap: round;
    stroke-width: 1.6;
  }
  :global(.ai-state-card.is-active) .dg-db {
    animation: dg-db-glow 2.4s ease-in-out 1.6s infinite;
  }
  .dg-matches {
    display: grid;
    gap: 0.45rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-matches li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30%;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .dg-matches i {
    display: block;
    width: var(--w);
    height: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-blue), #8fb0cb);
    transform-origin: left;
  }
  :global(.ai-state-card.is-active) .dg-matches i {
    animation: grow-x 600ms var(--ease-out) 500ms both;
  }
  .dg-typing {
    display: inline-flex;
    gap: 3px;
    margin-left: 0.2rem;
    vertical-align: middle;
  }
  .dg-typing i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #f2b79f;
    animation: dg-typing 1.2s ease-in-out infinite;
  }
  .dg-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .dg-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }
  .dg-checks {
    display: grid;
    gap: 0.38rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-checks li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .dg-checks li::before {
    color: var(--color-green);
    content: '✓';
    font-weight: 800;
  }
  .dg-checks li.is-flag::before {
    color: var(--color-orange-text);
    content: '→';
  }
  .dg-result,
  .dg-approval {
    justify-self: start;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .dg-result {
    background: #eef4ef;
