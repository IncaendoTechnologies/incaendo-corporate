---
const {
  title,
  description,
  index,
  tone = 'light',
  className = '',
} = Astro.props
---

<section class={`page-intro page-intro-${tone} hero-system hero-system--text ${className}`}>
  <div class="site-container page-intro-inner hero-system__inner">
    <div class="page-intro-copy hero-system__copy">
      <h1 class="hero-system__title">{title}</h1>
      <p class="page-intro-description hero-system__description">{description}</p>
    </div>
    {index && <span class="page-index hero-system__index">{index}</span>}
  </div>
</section>
