---
import { HUBSPOT_SUBMIT_URL } from '../scripts/hubspot-form.js'

const { idPrefix = 'contact' } = Astro.props
const endpoint = HUBSPOT_SUBMIT_URL
const fieldId = (suffix) => `${idPrefix}-${suffix}`
---

<form
  class="contact-form"
  data-contact-form
  data-endpoint={endpoint}
  data-hs-do-not-collect="true"
  novalidate
>
  <div class="row gx-3 gy-3 form-grid">
    <div class="form-field col-md-6">
      <label for={fieldId('name')}>
        Full name <span aria-hidden="true">*</span>
      </label>
      <input
        id={fieldId('name')}
        name="name"
        autocomplete="name"
        required
        aria-invalid="false"
        aria-describedby={fieldId('name-error')}
      />
      <span
        class="form-field-error"
        id={fieldId('name-error')}
        data-error-for="name"
        hidden
      ></span>
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('email')}>
        Work email <span aria-hidden="true">*</span>
      </label>
      <input
        id={fieldId('email')}
        name="email"
        type="email"
        autocomplete="email"
        required
        aria-invalid="false"
        aria-describedby={fieldId('email-error')}
      />
      <span
        class="form-field-error"
        id={fieldId('email-error')}
        data-error-for="email"
        hidden
      ></span>
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('company')}>
        Company name <span class="form-optional">(optional)</span>
      </label>
      <input
        id={fieldId('company')}
        name="company"
        autocomplete="organization"
      />
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('phone')}>
        Phone number <span class="form-optional">(optional)</span>
      </label>
      <input
        id={fieldId('phone')}
        name="phone"
        type="tel"
        autocomplete="tel"
      />
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('topic')}>
        Service <span aria-hidden="true">*</span>
      </label>
      <select
        id={fieldId('topic')}
        name="topic"
        required
        aria-invalid="false"
        aria-describedby={fieldId('topic-error')}
      >
        <option value="" selected disabled>
          Select a service
        </option>
        <option>Custom Software</option>
        <option>AI &amp; Automation</option>
        <option>Web Applications</option>
        <option>Mobile Apps</option>
        <option>Enterprise Solutions</option>
        <option>Cloud &amp; Data</option>
        <option>Other</option>
      </select>
      <span
        class="form-field-error"
        id={fieldId('topic-error')}
        data-error-for="topic"
        hidden
      ></span>
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('budget')}>
        Project budget <span class="form-optional">(optional)</span>
      </label>
      <select id={fieldId('budget')} name="budget">
        <option value="" selected>
          Select a range
        </option>
        <option>Under ₹5 lakh</option>
        <option>₹5–15 lakh</option>
        <option>₹15–50 lakh</option>
        <option>Above ₹50 lakh</option>
        <!-- Value must match the HubSpot project_budget option exactly. -->
        <option value="- Prefer to discuss">Prefer to discuss</option>
      </select>
    </div>
    <div class="form-field col-12">
      <label for={fieldId('message')}>
        Project details <span aria-hidden="true">*</span>
      </label>
      <textarea
        id={fieldId('message')}
        name="message"
        rows="4"
        required
        placeholder="What are you planning, and what would a useful outcome look like?"
        aria-invalid="false"
        aria-describedby={fieldId('message-error')}
      ></textarea>
      <span
        class="form-field-error"
        id={fieldId('message-error')}
        data-error-for="message"
        hidden
      ></span>
    </div>
  </div>

  <div class="contact-consent">
    <label class="contact-privacy-consent" for={fieldId('privacy')}>
      <input
        id={fieldId('privacy')}
        name="privacyConsent"
        type="checkbox"
        required
        aria-invalid="false"
        aria-describedby={fieldId('privacy-error')}
      />
      <span>
        I agree to the <a href="/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and understand my
        details will be used to respond to this enquiry.
      </span>
    </label>
    <span
      class="form-field-error contact-consent-error"
      id={fieldId('privacy-error')}
      data-error-for="privacyConsent"
      hidden
    ></span>
  </div>

  <!-- Spam honeypot: invisible to people, often filled by bots. -->
  <div class="contact-form-hp" aria-hidden="true">
    <label for={fieldId('website')}>Website</label>
    <input
      id={fieldId('website')}
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="form-submit-row">
    <button class="button button-primary" type="submit">
      <span
        class="form-submit-spinner"
        data-submit-spinner
        aria-hidden="true"
        hidden
      ></span>
      <span data-submit-label>Send project inquiry</span>
      <span aria-hidden="true" data-submit-arrow>↗</span>
    </button>
    <p>
      {endpoint ? (
        <>
          Fields marked <span aria-hidden="true">*</span> are required.
        </>
      ) : (
        <>
          Online sending isn’t set up yet. You can also email{' '}
          <a href="mailto:info@incaendo.com">info@incaendo.com</a>.
        </>
      )}
    </p>
  </div>
</form>

<script>
  import {
    buildHubSpotPayload,
    describeHubSpotError,
    SUBMIT_FAILED_MESSAGE,
  } from '../scripts/hubspot-form.js'
  import { showToast } from '../scripts/toast.js'

  function initializeContactForms() {
    const forms = Array.from(
      document.querySelectorAll('[data-contact-form]'),
    ).filter((f) => f instanceof HTMLFormElement)

    forms.forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return
      if (form.dataset.initialized === 'true') return
      form.dataset.initialized = 'true'

      const submitLabel = form.querySelector('[data-submit-label]')
      const submitSpinner = form.querySelector('[data-submit-spinner]')
      const submitArrow = form.querySelector('[data-submit-arrow]')
      const originalButtonText = submitLabel?.textContent ?? 'Send project inquiry'

      // Submission feedback is shown as a toast (src/scripts/toast.js);
      // field validation stays inline next to each field. The submit button
      // stays locked for the toast's full lifetime as well as the request.
      const FEEDBACK_MS = 3000
      let dismissToast = () => {}
      const notifySuccess = () => {
        dismissToast()
        dismissToast = showToast({
          type: 'success',
          title: 'Inquiry sent successfully!',
          description:
            'Thank you for reaching out. Our team will get back to you soon.',
          duration: FEEDBACK_MS,
        })
      }
      const notifyError = (description = SUBMIT_FAILED_MESSAGE) => {
        dismissToast()
        dismissToast = showToast({
          type: 'error',
          title: 'Unable to send your inquiry',
          description,
          duration: FEEDBACK_MS,
        })
      }

      const setSending = (sending) => {
        if (submitLabel) {
          submitLabel.textContent = sending ? 'Sending…' : originalButtonText
        }
        if (submitSpinner instanceof HTMLElement) submitSpinner.hidden = !sending
        if (submitArrow instanceof HTMLElement) submitArrow.hidden = sending
      }

      const setFieldError = (name, message = '') => {
        const field = form.elements.namedItem(name)
        const error = form.querySelector(`[data-error-for="${name}"]`)
        if (!(field instanceof HTMLElement) || !(error instanceof HTMLElement)) return

        const hasError = Boolean(message)
        field.setAttribute('aria-invalid', String(hasError))
        error.textContent = message
        error.hidden = !hasError
      }

      const validate = () => {
        const formEl = form.elements
        const nameField = formEl.namedItem('name')
        const emailField = formEl.namedItem('email')
        const topicField = formEl.namedItem('topic')
        const messageField = formEl.namedItem('message')
        const privacyField = formEl.namedItem('privacyConsent')

        const nameVal = nameField instanceof HTMLInputElement ? nameField.value.trim() : ''
        const emailVal = emailField instanceof HTMLInputElement ? emailField.value.trim() : ''
        const emailValid = emailField instanceof HTMLInputElement ? emailField.validity.valid : false
        const topicVal = topicField instanceof HTMLSelectElement || topicField instanceof HTMLInputElement ? topicField.value : ''
        const messageVal = messageField instanceof HTMLTextAreaElement || messageField instanceof HTMLInputElement ? messageField.value.trim() : ''
        const privacyChecked = privacyField instanceof HTMLInputElement ? privacyField.checked : false

        const errors = {
          name: nameVal ? '' : 'Enter your full name.',
          email: !emailVal
            ? 'Enter your work email.'
            : emailValid
              ? ''
              : 'Enter a valid email address.',
          topic: topicVal
            ? ''
            : 'Choose the service you need help with.',
          message: messageVal
            ? ''
            : 'Tell us a little about your project.',
          privacyConsent: privacyChecked
            ? ''
            : 'Please confirm before continuing.',
        }

        Object.entries(errors).forEach(([name, message]) =>
          setFieldError(name, message),
        )
        return errors
      }

      form.addEventListener('input', (event) => {
        if (event.target instanceof HTMLElement) {
          const name = event.target.getAttribute('name')
          if (name && event.target.getAttribute('aria-invalid') === 'true') {
            setFieldError(name)
          }
        }
      })
      form.addEventListener('change', (event) => {
        if (event.target instanceof HTMLElement) {
          const name = event.target.getAttribute('name')
          if (name && event.target.getAttribute('aria-invalid') === 'true') {
            setFieldError(name)
          }
        }
      })

      let isSubmitting = false

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (isSubmitting) return
        validate()
        const firstInvalid = form.querySelector('[aria-invalid="true"]')
        if (firstInvalid instanceof HTMLElement) {
          firstInvalid.focus()
          return
        }

        const endpoint = form.dataset.endpoint?.trim() ?? ''
        if (!endpoint) {
          notifyError(
            'Online sending isn’t set up yet. Please email info@incaendo.com.',
          )
          return
        }

        let target
        try {
          target = new URL(endpoint, window.location.href)
          if (target.protocol !== 'https:')
            throw new Error('A secure endpoint is required.')
        } catch {
          notifyError(
            'Online sending isn’t available right now. Please email info@incaendo.com.',
          )
          return
        }

        // Read values before disabling controls: disabled fields are
        // excluded from FormData.
        const formData = new FormData(form)
        const honeypot = formData.get('website')
        const payload = buildHubSpotPayload(formData)

        const controls = Array.from(
          form.querySelectorAll('input, select, textarea, button'),
        ).filter((c) => 'disabled' in c)
        isSubmitting = true
        let succeeded = false
        controls.forEach((control) => {
          control.disabled = true
        })
        setSending(true)
        dismissToast()
        // Lifecycle events (bubbling) let a container such as the contact
        // modal react without coupling to this component:
        //   contact-form:pending  -> request in flight
        //   contact-form:settled  -> response handled, toast shown
        //   contact-form:complete -> toast lifecycle done, button unlocked
        const emit = (name) =>
          form.dispatchEvent(
            new CustomEvent(`contact-form:${name}`, {
              bubbles: true,
              detail: { success: succeeded },
            }),
          )
        emit('pending')

        try {
          // Bot filled the hidden field: don't forward it, but don't tip it off.
          if (typeof honeypot === 'string' && honeypot.trim()) {
            form.reset()
            succeeded = true
            notifySuccess()
            return
          }

          let response
          try {
            response = await fetch(target.href, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            })
          } catch {
            notifyError()
            return
          }

          if (!response.ok) {
            // Keep everything the visitor typed; only flag what HubSpot rejected.
            const { fieldErrors } = await describeHubSpotError(response)
            Object.entries(fieldErrors).forEach(([name, fieldMessage]) =>
              setFieldError(name, fieldMessage),
            )
            notifyError()
            return
          }

          form.reset()
          form.querySelectorAll('[aria-invalid="true"]').forEach((field) => {
            field.setAttribute('aria-invalid', 'false')
          })
          form.querySelectorAll('.form-field-error').forEach((error) => {
            if (error instanceof HTMLElement) {
              error.textContent = ''
              error.hidden = true
            }
          })
          succeeded = true
          notifySuccess()
        } catch {
          notifyError()
        } finally {
          // Every path above has shown a toast. Fields come back right away
          // (values are kept on failure); the submit button and the
          // duplicate-submit guard stay locked until the toast has run.
          const submitButton = form.querySelector('button[type="submit"]')
          controls.forEach((control) => {
            if (control !== submitButton) control.disabled = false
          })
          setSending(false)
          emit('settled')
          // If HubSpot rejected specific fields, move focus to the first one.
          const rejected = form.querySelector('[aria-invalid="true"]')
          if (rejected instanceof HTMLElement) rejected.focus()

          await new Promise((resolve) => window.setTimeout(resolve, FEEDBACK_MS))
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false
          }
          isSubmitting = false
          emit('complete')
        }
      })
    })
  }

  initializeContactForms()
  document.addEventListener('astro:page-load', initializeContactForms)
</script>

<style>
  .form-field-error[hidden],
  .form-submit-spinner[hidden],
  [data-submit-arrow][hidden] {
    display: none !important;
  }

  .form-submit-spinner {
    display: inline-block;
    width: 1em;
    height: 1em;
    flex: 0 0 auto;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: form-submit-spin 0.7s linear infinite;
  }

  @keyframes form-submit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .form-submit-spinner {
      animation-duration: 2s;
    }
  }


  /* Off-screen rather than display:none so naive bots still see and fill it. */
  .contact-form-hp {
    position: absolute !important;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>
