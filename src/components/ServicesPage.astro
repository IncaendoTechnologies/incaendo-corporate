    width: 42%;
    height: 6px;
    border-radius: 4px;
    background: #e7c7b4;
  }
  .web-stats span {
    width: 75%;
    height: 4px;
    border-radius: 4px;
    background: #e5eaed;
  }
  .web-chart {
    position: relative;
    height: 63px;
    overflow: hidden;
    border: 1px solid #e9ecee;
    border-radius: 5px;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 15px,
      #edf0f2 16px 17px
    );
  }
  .web-chart > div {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    height: 100%;
    align-items: end;
    justify-content: space-around;
