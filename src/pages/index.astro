---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import SectionHeading from '../components/SectionHeading.astro'
import ServiceGrid from '../components/ServiceGrid.astro'
import FAQList from '../components/FAQList.astro'
import AICapabilityShowcase from '../components/AICapabilityShowcase.astro'
import ClientLogoMarquee from '../components/ClientLogoMarquee.astro'
import ReviewMarquee from '../components/ReviewMarquee.astro'
import IndustriesPower from '../components/IndustriesPower.astro'
import SaaSProducts from '../components/SaaSProducts.astro'
import HomeInsights from '../components/HomeInsights.astro'
import HomeProjects from '../components/HomeProjects.astro'
import HomeHeroDevices from '../components/HomeHeroDevices.astro'
import HomeAiExperience from '../components/HomeAiExperience.astro'
import HomeAiClosingCta from '../components/HomeAiClosingCta.astro'
import { pages } from '../data/site-content.js'
import award01 from '../assets/award 01.png'
import award02 from '../assets/award 02.png'
import award03 from '../assets/award 03.png'

// Keep the original AI showcase available for quick restoration while the
// business-focused homepage experience is active.
const SHOW_LEGACY_AI_SECTION = false
---

<BaseLayout title={pages.home.title} description={pages.home.description}>
  <main id="main-content" class="home-page">
    <section class="hero-section hero-system hero-system--split hero-system--feature">
      <div class="site-container hero-layout hero-system__inner">
        <div class="hero-copy hero-system__copy reveal">
          <h1 class="hero-system__title">
            <span class="hero-headline-line">
              Engineering <span class="hero-headline-accent hero-system__accent">Digital</span>
            </span>
            <span class="hero-headline-line">
              <span class="hero-headline-accent hero-system__accent">Solutions</span> that Move
            </span>
            <span class="hero-headline-line">Businesses Forward.</span>
          </h1>
          <p class="hero-description hero-system__description">
            <span class="hero-description-line">
              With 15+ years of experience, we build reliable software, scalable
              cloud platforms,
            </span>{' '}
            <span class="hero-description-line">
              and practical AI solutions that help businesses simplify complex
              workflows and turn ideas into
            </span>{' '}
            <span class="hero-description-line">
              measurable outcomes. We focus on secure, maintainable technology
              designed around real business needs.
            </span>
          </p>
          <div class="hero-actions hero-system__actions">
            <a
              class="button button-primary"
              href="/contact#project-inquiry"
              data-open-contact-modal
            >
              Discuss your project <span aria-hidden="true">↗</span>
            </a>
            <a
              class="button button-outline"
              href="/projects"
              target="_blank"
              rel="noopener noreferrer"
            >
              Explore our work <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <HomeHeroDevices />
      </div>
    </section>
    <ClientLogoMarquee />

    <section
      class="section section-services"
      id="services"
      aria-labelledby="services-heading"
    >
      <div class="site-container">
        <SectionHeading
          headingId="services-heading"
          reveal={true}
          eyebrow="Services & solutions"
          title="Technology Services for the "
          titleAccent="Work Ahead."
          description="From applied AI and custom software to web, mobile, enterprise, and cloud data solutions, Incaendo helps teams turn complex needs into reliable digital products."
          link="/services"
          linkLabel="View all services"
          target="_blank"
          rel="noopener noreferrer"
        />
        <ServiceGrid variant="home" />
      </div>
    </section>

    {SHOW_LEGACY_AI_SECTION ? (
      <section
        class="section section-intro-block"
        id="ai-highlight"
        aria-labelledby="ai-heading"
      >
        <div class="site-container">
          <AICapabilityShowcase />
        </div>
      </section>
    ) : (
      <HomeAiExperience />
    )}

    <HomeAiClosingCta />

    <ReviewMarquee />

    <section class="awards-section" aria-labelledby="awards-heading">
      <div class="site-container awards-content">
        <div class="awards-intro reveal" data-awards-intro>
          <p class="eyebrow">Recognition &amp; partnerships</p>
          <h2 id="awards-heading">
            Recognised for Partnerships{' '}
            <span class="hero-title-accent">that Deliver Lasting Value.</span>
          </h2>
          <p class="awards-intro-copy">
            Strong technology is built on trust, collaboration, and consistent
            delivery. Our industry recognitions reflect the partnerships behind
            our work and our commitment to creating meaningful business
            outcomes.
          </p>
        </div>
        <div class="awards-grid reveal" data-reveal-stagger>
          <article class="award-card" data-reveal-item>
            <div class="award-image-frame">
              <Image
                src={award01}
                alt="Gold globe trophy for the 2014 Business Partnership Award, with Domino’s Pizza, Jubilant FoodWorks, and Dunkin’ Donuts logos on its plaque."
                class="award-image"
                loading="lazy"
              />
            </div>
            <p class="award-caption">
              <strong>Business Partnership Award</strong>
              <span>2014 · Trophy</span>
            </p>
          </article>
          <article class="award-card" data-reveal-item>
            <div class="award-image-frame">
              <Image
                src={award02}
                alt="Framed 2014 Business Partnership Award plaque featuring Domino’s Pizza, Jubilant FoodWorks, and Dunkin’ Donuts logos."
                class="award-image"
                loading="lazy"
              />
            </div>
            <p class="award-caption">
              <strong>Business Partnership Award</strong>
              <span>2014 · Plaque</span>
            </p>
          </article>
          <article class="award-card" data-reveal-item>
            <div class="award-image-frame">
              <Image
                src={award03}
                alt="Gold star trophy for the 2013 Business Partnership Award, with Domino’s Pizza, Jubilant FoodWorks, and Dunkin’ Donuts logos on its plaque."
                class="award-image"
                loading="lazy"
              />
            </div>
            <p class="award-caption">
              <strong>Business Partnership Award</strong>
              <span>2013 · Trophy</span>
            </p>
          </article>
        </div>
      </div>
    </section>

    <HomeInsights />

    <IndustriesPower />

    <HomeProjects />

    <SaaSProducts />

