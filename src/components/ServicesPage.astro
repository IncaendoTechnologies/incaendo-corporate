    padding-top: 0.4rem;
    border-top: 1px solid #edf0f2;
  }
  .mobile-mobile-nav i {
    width: 12px;
    height: 5px;
    border-radius: 4px;
    background: #d9e1e6;
  }
  .mobile-mobile-nav i:first-child {
    background: #c9542b;
  }
  .mobile-caption {
    position: absolute;
    right: 0;
    bottom: -0.25rem;
    left: 0;
    color: var(--color-muted);
    font-size: 0.58rem;
    text-align: center;
  }
  .enterprise-map {
    position: relative;
    width: min(100%, 500px);
    min-height: 260px;
    align-self: center;
  }
  .enterprise-map svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
