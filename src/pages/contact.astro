---
import { Image } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import ContactForm from '../components/ContactForm.astro'
import { pages } from '../data/site-content.js'
import contactHeroImage from '../assets/contact-hero-project-journey.jpg'

const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT ?? ''
---

<BaseLayout title={pages.contact.title} description={pages.contact.description}>
  <main id="main-content" class="contact-page">
    <section class="contact-hero hero-system hero-system--split hero-system--feature" aria-labelledby="contact-hero-heading">
      <div class="site-container contact-hero-grid hero-system__inner">
        <div class="contact-hero-copy hero-system__copy reveal">
          <h1 id="contact-hero-heading" class="hero-system__title">
            The Next Good Decision Starts with <span class="hero-system__accent">a Conversation.</span>
          </h1>
          <p class="contact-hero-description hero-system__description">
            Bring us the challenge, the ambition, or the question your team is
            working through. We’ll help you find a useful place to start.
          </p>
          <div class="contact-hero-actions hero-system__actions">
            <a class="button button-primary" href="#project-inquiry">
              Tell us about your project <span aria-hidden="true">↘</span>
            </a>
            <a class="contact-hero-email" href="mailto:info@incaendo.com">
              Or email us directly <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="contact-hero-steps hero-system__support">
            <span class="hero-system__support-label" id="contact-hero-steps-label">
              What happens next
            </span>
            <ol aria-labelledby="contact-hero-steps-label">
              <li><span aria-hidden="true">01</span>Share your requirements</li>
              <li><span aria-hidden="true">02</span>We understand your goals and constraints</li>
              <li><span aria-hidden="true">03</span>We discuss the right next steps</li>
            </ol>
          </div>
        </div>
        <div class="contact-hero-feature hero-system__visual reveal">
        <figure class="contact-hero-visual hero-system__motion">
          <div class="contact-hero-stage">
            <Image
              src={contactHeroImage}
              alt=""
              aria-hidden="true"
              widths={[560, 840, 1024, 1600]}
              sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1100px) 48vw, 680px"
              quality={92}
              loading="eager"
              class="contact-hero-backdrop"
            />
            <Image
              src={contactHeroImage}
              alt="Incaendo project journey workspace with laptop showing project overview dashboard, branded mug, notebook, and collaboration milestones: Consult with experts, Discuss your idea, Get a tech plan, Build & launch together, and Ongoing support"
              widths={[560, 840, 1024, 1600]}
              sizes="(max-width: 760px) calc(100vw - 2rem), (max-width: 1100px) 48vw, 680px"
              quality={92}
              loading="eager"
              fetchpriority="high"
              class="contact-hero-image hero-system__image"
            />
          </div>
        </figure>
          <a class="contact-hero-card contact-hero-card--email" href="mailto:info@incaendo.com">
            <span class="contact-hero-card-icon" aria-hidden="true">@</span>
            <span>
              <small>Business enquiries</small>
              <strong>info@incaendo.com</strong>
            </span>
          </a>
          <div class="contact-hero-card contact-hero-card--office">
            <span class="contact-hero-card-icon" aria-hidden="true">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <span>
              <small>Our office</small>
              <strong>Sector 2, Noida</strong>
            </span>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-workspace" aria-labelledby="contact-form-heading">
      <div
        class="site-container contact-workspace-heading reveal"
        id="project-inquiry"
      >
        <p class="eyebrow">PROJECT INQUIRY</p>
        <h2 id="contact-form-heading">
          Let’s Make the First Conversation Useful.
        </h2>
        <p>
          A little context is enough to get started. We’ll take it from there.
        </p>
      </div>
      <div class="site-container contact-workspace-grid">
        <aside
          class="contact-direct-panel reveal"
          aria-labelledby="contact-direct-heading"
        >
          <div class="contact-direct-heading">
            <p class="eyebrow eyebrow-light">DIRECT CONTACT</p>
            <h2 id="contact-direct-heading">Prefer to Talk Directly?</h2>
            <p>Reach the Incaendo team or find our office in Noida.</p>
          </div>
          <a class="contact-direct-email" href="mailto:info@incaendo.com">
            <span class="contact-detail-symbol" aria-hidden="true">
              @
            </span>
            <span>
              <small>BUSINESS ENQUIRIES</small>
              <strong>info@incaendo.com</strong>
            </span>
            <span class="contact-detail-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
          <div class="contact-direct-address">
            <span
              class="contact-detail-symbol contact-pin-symbol"
              aria-hidden="true"
            >
              ⌖
            </span>
            <div>
              <small>OFFICE</small>
              <address>
                TigerCubs, B-9, B Block, Sector 2,
                <br />
                Noida, UP – 201301
              </address>
              <a
                href="https://www.google.com/maps/dir/?api=1&destination=TigerCubs%2C%20B-9%2C%20B%20Block%2C%20Sector%202%2C%20Noida%2C%20UP%20201301"
                target="_blank"
                rel="noopener noreferrer"
              >
                Get directions <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <div class="contact-map-frame">
            <iframe
              title="Map showing Incaendo Technologies office in Sector 2, Noida"
              src="https://maps.google.com/maps?q=TigerCubs%2C%20B-9%2C%20B%20Block%2C%20Sector%202%2C%20Noida%2C%20UP%20201301&output=embed"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
            <a
              class="contact-map-open"
              href="https://www.google.com/maps/dir/?api=1&destination=TigerCubs%2C%20B-9%2C%20B%20Block%2C%20Sector%202%2C%20Noida%2C%20UP%20201301"
              target="_blank"
              rel="noopener noreferrer"
            >
              Open map <span aria-hidden="true">↗</span>
            </a>
          </div>
        </aside>
        <div class="contact-form-card reveal">
          <ContactForm endpoint={contactEndpoint} />
        </div>
      </div>
    </section>

    <section
      class="contact-followthrough"
      aria-labelledby="contact-next-heading"
    >
      <div class="site-container contact-followthrough-inner">
        <div class="contact-followthrough-intro reveal">
          <p class="eyebrow">WHAT HAPPENS NEXT</p>
          <h2 id="contact-next-heading">A Clear Start, Together.</h2>
        </div>
        <ol class="contact-followthrough-grid reveal" data-reveal-stagger>
          <li class="contact-followthrough-step" data-reveal-item>
            <span>01</span>
            <p>Share your requirements.</p>
          </li>
          <li class="contact-followthrough-step" data-reveal-item>
            <span>02</span>
            <p>We understand your goals and constraints.</p>
          </li>
          <li class="contact-followthrough-step" data-reveal-item>
            <span>03</span>
            <p>We discuss the right next steps.</p>
          </li>
        </ol>
      </div>
    </section>
  </main>
</BaseLayout>
