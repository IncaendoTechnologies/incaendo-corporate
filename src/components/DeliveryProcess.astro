  }

  .delivery-feedback-arrow {
    stroke: var(--color-orange-dark);
    stroke-width: 1.6;
  }

  .delivery-panel-content {
    padding: clamp(1.35rem, 2.6vw, 2rem) clamp(1.25rem, 3.2vw, 2.5rem) 1.5rem;
  }

  .delivery-panel-heading {
    max-width: 710px;
  }

  .delivery-stage-label {
    display: inline-block;
    margin-bottom: 0.55rem;
    color: var(--color-orange-dark);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .delivery-panel-heading h3 {
    margin-bottom: 0.55rem;
    color: var(--color-navy);
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    font-weight: var(--type-heading-weight);
    letter-spacing: -0.05em;
    line-height: 1.16;
  }

  .delivery-panel-heading p {
    max-width: 670px;
    margin-bottom: 1.4rem;
    color: var(--color-body);
    font-size: 0.91rem;
    line-height: 1.65;
  }

  .delivery-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--delivery-line);
  }

  .delivery-detail-grid h4 {
    margin-bottom: 0.7rem;
    color: var(--color-navy-soft);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .delivery-detail-grid ul {
    display: grid;
    gap: 0.52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .delivery-detail-grid li {
    position: relative;
    padding-left: 1rem;
    color: var(--color-body);
    font-size: 0.77rem;
    line-height: 1.45;
  }

  .delivery-detail-grid li::before {
    position: absolute;
    top: 0.48em;
    left: 0;
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid rgb(84 123 157 / 60%);
    border-radius: 50%;
    background: rgb(84 123 157 / 12%);
    content: '';
  }

  .delivery-deliverables li::before {
    border-color: rgb(168 65 33 / 65%);
    background: rgb(168 65 33 / 12%);
  }

  .delivery-controls {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(100px, 1fr) minmax(130px, 1.3fr) minmax(
        100px,
        1fr
      );
    align-items: center;
    gap: 1rem;
    padding: 0.2rem 0 0.1rem;
  }

  .delivery-control-button {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgb(16 27 45 / 11%);
    border-radius: 10px;
    background: #fff;
    color: var(--color-navy);
    cursor: pointer;
    font-size: 0.74rem;
    font-weight: 650;
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms var(--ease-out),
      background-color 220ms var(--ease-out),
      color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }

  .delivery-control-button:not(:disabled):hover {
    transform: translateY(-2px);
    border-color: rgb(168 65 33 / 40%);
    box-shadow: 0 7px 17px rgb(16 27 45 / 8%);
    color: var(--color-orange-dark);
  }

  .delivery-control-button:focus-visible {
    outline: 3px solid #e1784f;
    outline-offset: 3px;
  }

  .delivery-control-button:disabled {
    background: #f7f6f3;
    color: #a2a8ad;
    cursor: not-allowed;
    opacity: 0.75;
  }

  .delivery-control-next {
    border-color: var(--color-navy);
    background: var(--color-navy);
    color: #fff;
  }

  .delivery-control-next:not(:disabled):hover {
    border-color: var(--color-orange-dark);
    background: var(--color-orange-dark);
    color: #fff;
  }

  .delivery-progress-wrap {
    min-width: 0;
  }

  .delivery-progress-copy {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    color: var(--color-muted);
    font-size: 0.59rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .delivery-progress-copy span:first-child {
    color: var(--color-navy-soft);
    font-variant-numeric: tabular-nums;
  }

  .delivery-progress-track {
    height: 4px;
    overflow: hidden;
    border-radius: 99px;
    background: rgb(84 123 157 / 14%);
  }

  .delivery-progress-track > span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--color-blue),
      var(--color-orange-dark)
    );
    transform: scaleX(0.2);
    transform-origin: left center;
    transition: transform 400ms var(--ease-out);
  }

  .delivery-collaboration {
    display: flex;
    grid-column: 2;
    align-items: center;
    gap: 0.85rem;
    margin-top: -0.15rem;
    padding: 0.72rem 0.9rem;
    border: 1px solid rgb(84 123 157 / 15%);
    border-radius: 14px;
    background: rgb(255 255 255 / 55%);
  }

  .delivery-collaboration-icon {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(84 123 157 / 18%);
    border-radius: 50%;
    background: rgb(84 123 157 / 8%);
    color: var(--color-blue);
