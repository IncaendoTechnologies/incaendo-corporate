<script>
  const workflow = document.querySelector('[data-ai-workflow]')

  if (workflow) {
    const tabs = [...workflow.querySelectorAll('[data-workflow-tab]')]
    const panels = [...workflow.querySelectorAll('[data-workflow-panel]')]
    const scenes = [...workflow.querySelectorAll('[data-workflow-scene]')]
    const count = workflow.querySelector('[data-stage-count]')
    const footer = workflow.querySelector('[data-stage-footer]')
    const progress = workflow.querySelector('[data-workflow-progress]')

    function selectStage(tab, moveFocus = false) {
      const selected = tab.dataset.workflowTab
      const index = tabs.indexOf(tab)

      tabs.forEach((item) => {
        const active = item === tab
        item.setAttribute('aria-selected', String(active))
        item.tabIndex = active ? 0 : -1
      })
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.workflowPanel !== selected
      })
      scenes.forEach((scene) => {
        const active = scene.dataset.workflowScene === selected
        scene.classList.toggle('is-active', active)
        scene.hidden = !active
        scene.setAttribute('aria-hidden', String(!active))
      })

      const stageCount = `${String(index + 1).padStart(2, '0')} / 05`
      count.textContent = stageCount
      footer.textContent = stageCount
      progress.style.transform = `scaleX(${(index + 1) / tabs.length})`
      if (moveFocus) tab.focus()
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => selectStage(tab))
      tab.addEventListener('keydown', (event) => {
        const current = tabs.indexOf(tab)
        let next
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight')
          next = (current + 1) % tabs.length
        else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft')
          next = (current - 1 + tabs.length) % tabs.length
        else if (event.key === 'Home') next = 0
        else if (event.key === 'End') next = tabs.length - 1
        if (next === undefined) return
        event.preventDefault()
        selectStage(tabs[next], true)
      })
    })
  }
</script>

