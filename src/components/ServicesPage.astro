  .software-workspace-top span {
    width: 38%;
    height: 7px;
    border-radius: 8px;
    background: #dce4e9;
  }
  .software-workspace-top i {
    width: 17px;
    height: 17px;
    border-radius: 50%;
    background: #f3e7de;
  }
  .software-module {
    display: grid;
    min-width: 0;
    gap: 0.35rem;
    padding: 0.55rem;
    border: 1px solid #e6e9eb;
    border-radius: 7px;
    background: #fbfcfc;
