---
const stages = [
  {
    number: '01',
    title: 'Discover',
    navTitle: 'Discover',
    label: 'Understand the challenge',
    description:
      'We start by understanding your business objectives, users, existing systems, and constraints before deciding what the solution should be.',
    activities: [
      'Stakeholder discussions and discovery workshops',
      'Requirements gathering and workflow mapping',
      'Business objectives, constraints, and success metrics',
    ],
    deliverables: [
      'Discovery brief',
      'Prioritised requirements',
      'Agreed project scope',
    ],
    visual: 'discover',
    visualLabel: 'Business context map',
  },
  {
    number: '02',
    title: 'Define & Design',
    navTitle: 'Define',
    label: 'Plan the right solution',
    description:
      'We turn requirements into clear user journeys, intuitive interfaces, and a practical technical architecture your team can review with confidence.',
    activities: [
      'User journeys, wireframes, and UI/UX design',
      'Technical architecture and technology selection',
      'Prototype reviews and design validation',
    ],
    deliverables: [
      'Approved design direction',
      'Technical architecture plan',
      'Delivery roadmap',
    ],
    visual: 'design',
    visualLabel: 'Solution blueprint',
  },
  {
    number: '03',
    title: 'Build & Integrate',
    navTitle: 'Build',
    label: 'Engineer the solution',
    description:
      'We develop in focused iterations, connect relevant systems, and share regular progress so the product takes shape with your feedback in view.',
    activities: [
      'Structured development sprints',
      'API, platform, and third-party integrations',
      'Code reviews, working demos, and progress feedback',
    ],
    deliverables: [
      'Working product features',
      'Integrated systems',
      'Sprint updates and demonstrable progress',
    ],
    visual: 'build',
    visualLabel: 'Engineering pipeline',
  },
  {
    number: '04',
    title: 'Validate & Refine',
    navTitle: 'Validate',
    label: 'Quality before release',
    description:
      'We test the solution against its requirements and refine it with the intended users before it is released into the environments where it will be used.',
    activities: [
      'Functional and regression testing',
      'Security, performance, and usability checks',
      'User acceptance testing and issue resolution',
    ],
    deliverables: [
      'Test results',
      'Resolved defects',
      'Release-readiness confirmation',
    ],
    visual: 'validate',
    visualLabel: 'Quality checks',
  },
  {
    number: '05',
    title: 'Launch & Evolve',
    navTitle: 'Launch',
    label: 'Deliver lasting value',
    description:
      'We plan and support the production release, monitor how the product performs, and shape improvements around real feedback and business needs.',
    activities: [
      'Deployment planning and release checks',
      'Production monitoring and issue resolution',
      'Continuous improvements and future enhancements',
    ],
    deliverables: [
      'Production release',
      'Appropriate handover documentation',
      'Improvement roadmap',
    ],
    visual: 'launch',
    visualLabel: 'Release & monitoring',
  },
]
---

<section
  class="delivery-process"
  id="delivery-process"
  aria-labelledby="delivery-process-heading"
  data-delivery-process
>
  <div class="site-container delivery-process-container">
    <header class="delivery-intro">
      <p class="eyebrow">Our delivery process</p>
      <h2 id="delivery-process-heading">
        From bold ideas to <span>real-world impact.</span>
      </h2>
      <p class="delivery-intro-copy">
        A transparent, collaborative process that turns complex challenges into
        reliable digital solutions.
      </p>
    </header>

    <div class="delivery-layout">
      <nav class="delivery-navigation" aria-label="Delivery stages">
        <p class="delivery-navigation-label">A clear path forward</p>
        <div
          class="delivery-step-list"
          role="tablist"
          aria-label="Select a delivery stage"
          aria-orientation="vertical"
          data-delivery-tabs
        >
          {stages.map((stage, index) => (
            <button
              class="delivery-step"
              id={`delivery-tab-${stage.number}`}
              type="button"
              role="tab"
              aria-controls={`delivery-panel-${stage.number}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-delivery-tab
              data-stage-index={index}
            >
              <span class="delivery-step-number" aria-hidden="true">
                {stage.number}
              </span>
              <span class="delivery-step-copy">
                <strong>
                  <span class="delivery-step-full">{stage.title}</span>
                  <span class="delivery-step-short">{stage.navTitle}</span>
                </strong>
                <span>{stage.label}</span>
              </span>
              <span class="delivery-step-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        </div>
      </nav>

      <div class="delivery-workspace">
        <div
          class="delivery-live-visual"
          data-delivery-live-visual
          aria-hidden="true"
        >
          <div class="delivery-visual-meta">
            <span class="delivery-visual-label">
              <span class="delivery-visual-pulse" />
              <span data-delivery-visual-label>Discovery network</span>
            </span>
            <span class="delivery-visual-count" data-delivery-visual-count>
              01 / 05
            </span>
          </div>
          <div class="delivery-scene-stage" data-delivery-scene-stage />
        </div>
        {stages.map((stage, index) => (
          <article
            class="delivery-panel"
            id={`delivery-panel-${stage.number}`}
            role="tabpanel"
            aria-labelledby={`delivery-tab-${stage.number}`}
            tabindex="0"
            data-delivery-panel
            data-stage-index={index}
            data-visual-label={stage.visualLabel}
            hidden={index !== 0}
          >
            <div class="delivery-visual" aria-hidden="true">
              <div class="delivery-visual-meta">
                <span class="delivery-visual-label">
                  <span class="delivery-visual-pulse" />
                  {stage.visualLabel}
                </span>
                <span class="delivery-visual-count">{stage.number} / 05</span>
              </div>

              {stage.visual === 'discover' && (
                <svg
                  class="delivery-scene"
                  viewBox="0 0 400 270"
                  fill="none"
                  focusable="false"
                >
                  <path class="dp-link" d="M146 74 172 98m-26 66 26-24m82-66-26 24m26 66-26-24" />
                  <path class="dp-link-soft" d="M146 74 172 98m-26 66 26-24m82-66-26 24m26 66-26-24" />
                  <circle class="dp-flow dp-flow-a" cx="146" cy="74" r="3.5" />
                  <circle class="dp-flow dp-flow-b" cx="146" cy="164" r="3.5" />
                  <circle class="dp-flow dp-flow-c" cx="254" cy="74" r="3.5" />
                  <circle class="dp-flow dp-flow-d" cx="254" cy="164" r="3.5" />
                  <g class="dp-goal-core dp-enter dp-enter-core">
                    <circle class="dp-core-halo" cx="200" cy="119" r="52" />
                    <circle class="dp-core-ring" cx="200" cy="119" r="43" />
                    <rect class="dp-core-card" x="158" y="83" width="84" height="72" rx="16" />
                    <path class="dp-goal-icon" transform="translate(-120 -52)" d="M320 144v25m-12-12h24m-19-10 7 5 7-5" />
                    <text class="dp-core-title" x="200" y="133" text-anchor="middle">BUSINESS</text>
                    <text class="dp-core-title" x="200" y="146" text-anchor="middle">GOALS</text>
                  </g>
                  <g class="dp-discovery-card dp-enter dp-enter-one">
                    <rect class="dp-card" x="6" y="18" width="140" height="70" rx="12" />
                    <circle class="dp-icon-disc" cx="26" cy="38" r="10" />
                    <path class="dp-icon" transform="translate(-25 -52)" d="M47 91a4 4 0 1 1 8 0m-10 6c1-4 11-4 12 0m-6-15v2" />
                    <circle class="dp-card-status" cx="130" cy="34" r="3" />
                    <text class="dp-heading" x="18" y="64">STAKEHOLDERS</text>
                    <text class="dp-copy" x="18" y="80">People · users · teams</text>
                  </g>
                  <g class="dp-discovery-card dp-enter dp-enter-two">
                    <rect class="dp-card" x="6" y="150" width="140" height="70" rx="12" />
                    <circle class="dp-icon-disc" cx="26" cy="170" r="10" />
                    <path class="dp-icon" transform="translate(-25 -52)" d="M47 218h8m-8 4h8m-8 4h5" />
                    <circle class="dp-card-status" cx="130" cy="166" r="3" />
                    <text class="dp-heading" x="18" y="196">REQUIREMENTS</text>
                    <text class="dp-copy" x="18" y="212">Needs · workflows</text>
                  </g>
                  <g class="dp-discovery-card dp-enter dp-enter-three">
                    <rect class="dp-card" x="254" y="18" width="140" height="70" rx="12" />
                    <circle class="dp-icon-disc dp-icon-disc-accent" cx="274" cy="38" r="10" />
                    <path class="dp-icon dp-icon-accent" transform="translate(-213 -52)" d="M482 94v-5l5-4 5 4v5m-7 0v-4h4v4" />
                    <circle class="dp-card-status dp-card-status-accent" cx="378" cy="34" r="3" />
                    <text class="dp-heading" x="266" y="64">SUCCESS METRICS</text>
                    <text class="dp-copy" x="266" y="80">Outcomes · measures</text>
                  </g>
                  <g class="dp-discovery-card dp-enter dp-enter-four">
                    <rect class="dp-card" x="254" y="150" width="140" height="70" rx="12" />
                    <circle class="dp-icon-disc" cx="274" cy="170" r="10" />
                    <path class="dp-icon" transform="translate(-213 -52)" d="M483 218h8m-8 4h5m-5 4h8" />
                    <circle class="dp-card-status" cx="378" cy="166" r="3" />
                    <text class="dp-heading" x="266" y="196">CONSTRAINTS</text>
                    <text class="dp-copy" x="266" y="212">Systems · time · risk</text>
                  </g>
                  <text class="dp-kicker" x="200" y="254" text-anchor="middle">ALIGN THE CONTEXT BEFORE DEFINING THE SOLUTION</text>
                </svg>
              )}

              {stage.visual === 'design' && (
                <svg
                  class="delivery-scene"
                  viewBox="0 0 400 270"
                  fill="none"
                  focusable="false"
                >
                  <path class="dp-link" d="M90 130h18m182 0h18" />
                  <path class="dp-link-soft" d="M90 130h18m182 0h18" />
                  <g class="dp-enter dp-enter-one">
                    <rect class="dp-card dp-requirements" x="2" y="70" width="88" height="120" rx="12" />
                    <text class="dp-heading" x="13" y="92">BUSINESS</text>
                    <text class="dp-heading" x="13" y="105">INPUT</text>
                    <circle class="dp-check" cx="16" cy="124" r="3" /><text class="dp-copy" x="24" y="127.5">User needs</text>
                    <circle class="dp-check" cx="16" cy="144" r="3" /><text class="dp-copy" x="24" y="147.5">Workflows</text>
                    <circle class="dp-check" cx="16" cy="164" r="3" /><text class="dp-copy" x="24" y="167.5">Constraints</text>
                    <rect class="dp-progress-track" x="13" y="177" width="66" height="4" rx="2" />
                    <rect class="dp-progress-fill dp-progress-requirements" x="13" y="177" width="66" height="4" rx="2" />
                  </g>
                  <g class="dp-enter dp-enter-two">
                    <rect class="dp-architecture" x="108" y="14" width="182" height="230" rx="14" />
                    <text class="dp-heading dp-heading-lg" x="122" y="37">SOLUTION BLUEPRINT</text>
                    <text class="dp-copy" x="122" y="51">Reviewed system layers</text>
                    <rect class="dp-layer" x="120" y="62" width="158" height="32" rx="8" />
                    <rect class="dp-layer dp-layer-accent" x="120" y="100" width="158" height="32" rx="8" />
                    <rect class="dp-layer" x="120" y="138" width="158" height="32" rx="8" />
                    <rect class="dp-layer" x="120" y="176" width="158" height="32" rx="8" />
                    <path class="dp-layer-icon" transform="translate(-105 -55.5)" d="M232 123h18v21h-18zm4 4h10m-10 5h10" />
                    <path class="dp-layer-icon dp-layer-icon-accent" transform="translate(-207 -12.5)" d="M335 121h16v15h-16zm3 4h10m-10 4h7" />
                    <ellipse class="dp-layer-icon" transform="translate(-105 -38)" cx="241" cy="185" rx="9" ry="4" /><path class="dp-layer-icon" transform="translate(-105 -38)" d="M232 185v13c0 5 18 5 18 0v-13m-18 6c0 5 18 5 18 0" />
                    <path class="dp-layer-icon" transform="translate(-208 5)" d="M335 187h18m-9-8v16m0-8 9-8m-9 8 9 8" />
                    <text class="dp-layer-title" x="152" y="76">UI / UX</text>
                    <text class="dp-layer-copy" x="152" y="88">User journeys</text>
                    <text class="dp-layer-title" x="152" y="114">API / SERVICES</text>
                    <text class="dp-layer-copy" x="152" y="126">API contracts</text>
                    <text class="dp-layer-title" x="152" y="152">DATA</text>
                    <text class="dp-layer-copy" x="152" y="164">Data models</text>
                    <text class="dp-layer-title" x="152" y="190">INTEGRATIONS</text>
                    <text class="dp-layer-copy" x="152" y="202">Connected tools</text>
                    <rect class="dp-blueprint-foot" x="120" y="214" width="158" height="20" rx="10" />
                    <circle class="dp-card-status" cx="133" cy="224" r="3" />
                    <text class="dp-foot-label" x="142" y="227">READY FOR REVIEW</text>
                  </g>
                  <g class="dp-enter dp-enter-three">
                    <rect class="dp-card dp-output" x="308" y="70" width="88" height="120" rx="12" />
                    <circle class="dp-output-halo" cx="352" cy="99" r="16" />
                    <path class="dp-output-icon" transform="translate(-195 -32)" d="M536 131h22m-22 7h22m-18-14h14" />
                    <text class="dp-heading" x="352" y="138" text-anchor="middle">PROPOSED</text>
                    <text class="dp-heading" x="352" y="151" text-anchor="middle">SOLUTION</text>
                    <text class="dp-copy" x="352" y="172" text-anchor="middle">Plan → prototype</text>
                  </g>
                  <circle class="dp-flow dp-flow-e" cx="90" cy="130" r="3.5" />
                  <circle class="dp-flow dp-flow-f" cx="290" cy="130" r="3.5" />
                  <text class="dp-kicker" x="200" y="262" text-anchor="middle">REQUIREMENTS BECOME A REVIEWABLE SYSTEM PLAN</text>
                </svg>
              )}

              {stage.visual === 'build' && (
                <svg
                  class="delivery-scene"
                  viewBox="0 0 400 270"
                  fill="none"
                  focusable="false"
                >
                  <path class="dp-link" d="M95 104h14m84 0h14m84 0h14" />
                  <path class="dp-link-soft" d="M95 104h14m84 0h14m84 0h14" />
                  <g class="dp-pipeline-card dp-enter dp-enter-one">
                    <rect class="dp-card" x="11" y="40" width="84" height="128" rx="12" />
                    <text class="dp-heading dp-heading-lg" x="22" y="62">CODE</text>
                    <text class="dp-copy" x="22" y="76">Components</text>
                    <rect class="dp-code-screen" x="22" y="86" width="62" height="40" rx="6" />
                    <path class="dp-code-glyph" transform="translate(-18 -60)" d="m53 159-5 4 5 4m10-8 5 4-5 4m11 0 6-9" />
                    <path class="dp-code-line" d="M30 114h28m-28 5h40" />
                    <circle class="dp-card-status" cx="82" cy="54" r="3" />
                    <text class="dp-micro" x="22" y="156">BUILDING</text>
                  </g>
                  <g class="dp-pipeline-card dp-enter dp-enter-two">
                    <rect class="dp-card" x="109" y="40" width="84" height="128" rx="12" />
                    <text class="dp-heading dp-heading-lg" x="120" y="62">API</text>
                    <text class="dp-copy" x="120" y="76">Services</text>
                    <rect class="dp-service-node" x="120" y="92" width="30" height="20" rx="6" />
                    <rect class="dp-service-node dp-service-node-accent" x="156" y="92" width="28" height="20" rx="6" />
                    <text class="dp-micro dp-node-label" x="135" y="105" text-anchor="middle">CORE</text>
                    <text class="dp-micro dp-node-label" x="170" y="105" text-anchor="middle">API</text>
                    <path class="dp-mini-link" d="M150 102h6" />
                    <path class="dp-code-line" d="M120 126h50" />
                    <circle class="dp-card-status" cx="180" cy="126" r="3" />
                    <text class="dp-micro" x="120" y="156">CONNECTED</text>
                  </g>
                  <g class="dp-pipeline-card dp-enter dp-enter-three">
                    <rect class="dp-card" x="207" y="40" width="84" height="128" rx="12" />
                    <text class="dp-heading dp-heading-lg" x="218" y="62">DATA</text>
                    <text class="dp-copy" x="218" y="76">Integrations</text>
                    <ellipse class="dp-db" cx="240" cy="96" rx="20" ry="6" />
                    <path class="dp-db" d="M220 96v22c0 8 40 8 40 0v-22" />
                    <path class="dp-db-line" d="M220 107c0 8 40 8 40 0" />
                    <path class="dp-mini-link" d="M260 96h10" />
                    <circle class="dp-integration-dot" cx="275" cy="96" r="4.5" />
                    <text class="dp-micro" x="218" y="156">SYNCED</text>
                  </g>
                  <g class="dp-pipeline-card dp-enter dp-enter-four">
                    <rect class="dp-product-card" x="305" y="40" width="84" height="128" rx="12" />
                    <text class="dp-heading dp-heading-lg" x="316" y="62">PRODUCT</text>
                    <text class="dp-copy" x="316" y="76">Application</text>
                    <rect class="dp-app-window" x="316" y="86" width="62" height="44" rx="6" />
                    <path class="dp-app-top" d="M316 96h62" />
                    <circle class="dp-app-dot" cx="323" cy="91" r="2" /><circle class="dp-app-dot dp-app-dot-accent" cx="330" cy="91" r="2" />
                    <rect class="dp-app-module" x="322" y="102" width="20" height="22" rx="3" />
                    <rect class="dp-app-module dp-app-module-accent" x="347" y="102" width="25" height="8" rx="3" />
                    <path class="dp-app-line" d="M347 115h24m-24 6h16" />
                    <text class="dp-micro dp-micro-ready" x="316" y="156">WORKING</text>
                  </g>
                  <path class="dp-arrow-head" d="m104 100 5 4-5 4m98-8 5 4-5 4m98-8 5 4-5 4" />
                  <circle class="dp-pipeline-flow dp-pipeline-flow-one" cx="95" cy="104" r="3.5" />
                  <circle class="dp-pipeline-flow dp-pipeline-flow-two" cx="193" cy="104" r="3.5" />
                  <circle class="dp-pipeline-flow dp-pipeline-flow-three" cx="291" cy="104" r="3.5" />
                  <rect class="dp-sprint-track" x="11" y="190" width="378" height="34" rx="12" />
                  <text class="dp-heading" x="24" y="211">SPRINT 04</text>
                  <rect class="dp-progress-track" x="104" y="204" width="150" height="6" rx="3" />
                  <rect class="dp-progress-fill dp-sprint-progress" x="104" y="204" width="150" height="6" rx="3" />
                  <text class="dp-foot-label" x="268" y="210">INTEGRATING</text>
                  <circle class="dp-card-status" cx="374" cy="207" r="3" />
                </svg>
              )}

              {stage.visual === 'validate' && (
                <svg
                  class="delivery-scene"
                  viewBox="0 0 400 270"
                  fill="none"
                  focusable="false"
                >
                  <rect class="dp-qa-dashboard" x="6" y="14" width="388" height="238" rx="16" />
                  <text class="dp-heading dp-heading-lg" x="22" y="40">QUALITY GATES</text>
                  <text class="dp-copy" x="22" y="55">Illustrative test run · sample data</text>
                  <rect class="dp-run-badge" x="266" y="26" width="116" height="22" rx="11" />
                  <circle class="dp-card-status" cx="279" cy="37" r="3" />
                  <text class="dp-foot-label" x="287" y="40">RELEASE REVIEW</text>
                  <g class="dp-qa-card dp-enter dp-enter-one">
                    <rect class="dp-card" x="22" y="68" width="118" height="64" rx="10" />
                    <circle class="dp-qa-check" cx="38" cy="86" r="7" />
                    <path class="dp-qa-mark" d="m34.5 86 2.5 2.5 4.5-5" />
                    <text class="dp-heading" x="50" y="90">FUNCTIONAL</text>
                    <text class="dp-copy" x="32" y="110">User flows</text>
                    <text class="dp-qa-status" x="130" y="110" text-anchor="end">PASS</text>
                    <rect class="dp-qa-track" x="32" y="119" width="98" height="5" rx="2.5" />
                    <rect class="dp-qa-progress dp-qa-progress-one" x="32" y="119" width="98" height="5" rx="2.5" />
                  </g>
                  <g class="dp-qa-card dp-enter dp-enter-two">
                    <rect class="dp-card" x="148" y="68" width="118" height="64" rx="10" />
                    <circle class="dp-qa-check" cx="164" cy="86" r="7" />
                    <path class="dp-qa-mark" d="m160.5 86 2.5 2.5 4.5-5" />
                    <text class="dp-heading" x="176" y="90">INTEGRATION</text>
                    <text class="dp-copy" x="158" y="110">API contracts</text>
                    <text class="dp-qa-status" x="256" y="110" text-anchor="end">PASS</text>
                    <rect class="dp-qa-track" x="158" y="119" width="98" height="5" rx="2.5" />
                    <rect class="dp-qa-progress dp-qa-progress-two" x="158" y="119" width="98" height="5" rx="2.5" />
                  </g>
                  <g class="dp-qa-card dp-enter dp-enter-three">
                    <rect class="dp-card" x="22" y="140" width="118" height="64" rx="10" />
                    <circle class="dp-qa-review" cx="38" cy="158" r="7" />
                    <path class="dp-qa-mark-review" d="M38 154.5v4m0 2.5v.5" />
                    <text class="dp-heading" x="50" y="162">PERFORMANCE</text>
                    <text class="dp-copy" x="32" y="182">Load profile</text>
                    <text class="dp-qa-status dp-qa-status-review" x="130" y="182" text-anchor="end">REVIEW</text>
                    <rect class="dp-qa-track" x="32" y="191" width="98" height="5" rx="2.5" />
                    <rect class="dp-qa-progress dp-qa-progress-three" x="32" y="191" width="98" height="5" rx="2.5" />
                  </g>
                  <g class="dp-qa-card dp-enter dp-enter-four">
                    <rect class="dp-card" x="148" y="140" width="118" height="64" rx="10" />
                    <circle class="dp-qa-check" cx="164" cy="158" r="7" />
                    <path class="dp-qa-mark" d="m160.5 158 2.5 2.5 4.5-5" />
                    <text class="dp-heading" x="176" y="162">SECURITY</text>
                    <text class="dp-copy" x="158" y="182">Access + data</text>
                    <text class="dp-qa-status" x="256" y="182" text-anchor="end">PASS</text>
                    <rect class="dp-qa-track" x="158" y="191" width="98" height="5" rx="2.5" />
                    <rect class="dp-qa-progress dp-qa-progress-four" x="158" y="191" width="98" height="5" rx="2.5" />
                  </g>
                  <g class="dp-quality-score dp-enter dp-enter-score">
                    <rect class="dp-score-panel" x="274" y="68" width="108" height="136" rx="10" />
                    <text class="dp-score-caption" x="328" y="88" text-anchor="middle">OVERALL QUALITY</text>
