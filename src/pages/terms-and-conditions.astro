---
import BaseLayout from '../layouts/BaseLayout.astro'
import { pages } from '../data/site-content.js'
---

<BaseLayout title={pages.terms.title} description={pages.terms.description}>
  <main id="main-content" class="legal-page">
    <!-- =========================
         HERO
    ========================= -->
    <section class="legal-hero" aria-labelledby="terms-hero-heading">
      <div class="legal-hero-glow" aria-hidden="true"></div>

      <div class="site-container legal-hero-wrap">
        <div class="legal-hero-left">
          <div class="legal-hero-label">
            <span aria-hidden="true"></span>
            Our Terms
          </div>

          <h1 id="terms-hero-heading">
            Terms &<br />
            <em>Conditions.</em>
          </h1>

          <p class="legal-hero-desc">
            These terms explain the rules and conditions that apply when you
            access and use Incaendo's website, products and technology services.
          </p>

          <div class="legal-hero-points">
            <div class="legal-hero-point">
              <span class="point-bullet" aria-hidden="true"></span>
              Clear Terms
            </div>
            <div class="legal-hero-point">
              <span class="point-bullet" aria-hidden="true"></span>
              Responsible Use
            </div>
            <div class="legal-hero-point">
              <span class="point-bullet" aria-hidden="true"></span>
              Business Transparency
            </div>
          </div>

          <div class="legal-hero-actions">
            <a class="button button-primary" href="/contact">
              Talk To Our Team
            </a>
            <a class="button button-secondary" href="/">
              Back To Website
            </a>
          </div>
        </div>

        <div class="legal-hero-visual" aria-hidden="true">
          <div class="legal-glass-frame">
            <div class="legal-browser-top">
              <span class="browser-dot"></span>
              <span class="browser-dot"></span>
              <span class="browser-dot"></span>
            </div>

            <div class="legal-mockup-card">
              <div class="mockup-top">
                <span class="mockup-mini-label">Incaendo Policy</span>
                <span class="mockup-check">✓</span>
              </div>

              <h3>Terms & Conditions</h3>
              <p>
                Clear information about the terms that apply to using Incaendo's
                website and services.
              </p>

              <div class="mockup-lines">
                <span class="mockup-line"></span>
                <span class="mockup-line"></span>
                <span class="mockup-line"></span>
                <span class="mockup-line"></span>
                <span class="mockup-line"></span>
              </div>

              <div class="mockup-status">
                <span>Terms of Use</span>
                <strong>Active</strong>
              </div>
            </div>
          </div>

          <div class="floating-badge badge-top">
            <small>Our Commitment</small>
            <strong>Clarity • Trust • Transparency</strong>
          </div>

          <div class="floating-badge badge-bottom">
            <small>Terms Status</small>
            <strong>Business Terms Active</strong>
          </div>
        </div>
      </div>

      <div class="site-container">
        <div class="legal-hero-tags" aria-label="Key Topics">
          <span class="hero-tag">Terms of Use</span>
          <span class="hero-tag">User Responsibilities</span>
          <span class="hero-tag">Service Terms</span>
          <span class="hero-tag">Business Policies</span>
          <span class="hero-tag">Transparency</span>
        </div>
      </div>
    </section>

    <!-- =========================
         TERMS CONTENT
    ========================= -->
    <section class="legal-content-section" aria-labelledby="terms-main-heading">
      <div class="site-container legal-document-container">
        <div class="legal-document-card">
          <!-- INTRO -->
          <div class="legal-intro">
            <span class="company-subheading">
              Incaendo Technologies Pvt. Ltd.
            </span>
            <h2 id="terms-main-heading">Terms & Conditions</h2>
            <p class="updated-date">
              <strong>Last Updated: September 2026</strong>
            </p>

            <p>
              These Terms & Conditions govern your access to and use of the
              Incaendo website and the services provided by Incaendo
              Technologies Pvt. Ltd.
            </p>

            <p>
              By accessing our website, submitting an enquiry, or engaging with
              our services, you acknowledge that you have read and understood
              these Terms & Conditions.
            </p>
          </div>

          <!-- 01 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">01</span>
              About Incaendo
            </h2>
            <p>
              Incaendo Technologies Pvt. Ltd. is a technology and digital
              solutions company providing services to businesses and
              organizations.
            </p>
            <p>Our services may include:</p>
            <ul>
              <li>Software Development</li>
              <li>Web Development</li>
              <li>Mobile App Development</li>
              <li>AI & Automation</li>
              <li>CRM Solutions</li>
              <li>LMS Solutions</li>
              <li>Cloud & Data Solutions</li>
              <li>Technology Consulting and related services</li>
            </ul>
          </div>

          <!-- 02 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">02</span>
              Website Use
            </h2>
            <p>
              You may use the Incaendo website for lawful purposes and in
              accordance with these Terms & Conditions.
            </p>
            <p>You agree not to:</p>
            <ul>
              <li>Use the website for unlawful or fraudulent purposes</li>
              <li>Attempt to gain unauthorized access to our systems</li>
              <li>Interfere with the operation or security of the website</li>
              <li>Copy or reproduce website content without permission</li>
              <li>
                Use the website to distribute harmful or malicious material
              </li>
              <li>Misrepresent your identity or relationship with Incaendo</li>
            </ul>
          </div>

          <!-- 03 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">03</span>
              Our Services
            </h2>
            <p>
              The exact scope, features, timelines, deliverables,
              responsibilities, and pricing for a project will depend on the
              requirements agreed between Incaendo and the client.
            </p>
            <p>
              Information about our services displayed on the website is
              provided for general informational purposes and does not
              automatically constitute a binding offer or contract.
            </p>
            <div class="legal-highlight">
              Project-specific terms may be defined separately through
              proposals, quotations, statements of work, service agreements, or
              other written agreements.
            </div>
          </div>

          <!-- 04 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">04</span>
              Project Requirements
            </h2>
            <p>
              Clients are responsible for providing accurate and complete
              information required for their project.
            </p>
            <p>
              Delays caused by missing information, approvals, content,
              credentials, assets, feedback, or other client-side dependencies
              may affect project timelines.
            </p>
            <p>
              Any changes to the agreed project scope may require additional
              discussion, time, resources, or charges.
            </p>
          </div>

          <!-- 05 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">05</span>
              Pricing & Payments
            </h2>
            <p>
              Pricing for Incaendo services is generally based on the
              requirements and scope of the specific project.
            </p>
            <p>
              Payment schedules, advance payments, milestones, applicable taxes,
              and other commercial terms may be specified in the relevant
              proposal, quotation, invoice, or agreement.
            </p>
            <p>
              Unless otherwise agreed in writing, work may be affected if
              required payments are delayed or remain outstanding.
            </p>
          </div>

          <!-- 06 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">06</span>
              Intellectual Property
            </h2>
            <p>
              Intellectual property ownership for project deliverables will
              depend on the specific agreement between Incaendo and the client.
            </p>
            <p>
              Unless otherwise agreed, Incaendo may retain ownership of its
              pre-existing tools, frameworks, libraries, processes, reusable
              components, methodologies, and other materials developed
              independently of the project.
            </p>
            <p>
              Third-party software, libraries, platforms, APIs, fonts, images,
              or other materials remain subject to their respective licenses and
              terms.
            </p>
          </div>

          <!-- 07 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">07</span>
              Client Content & Materials
            </h2>
            <p>
              Clients may provide text, images, logos, documents, data, software
              access, credentials, or other materials required for a project.
            </p>
            <p>
              The client is responsible for ensuring that it has the necessary
              rights, permissions, and licenses to provide such materials to
              Incaendo for use in the project.
            </p>
            <p>
              Incaendo is not responsible for claims arising from
              client-provided materials where the client did not have the
              necessary rights to use them.
            </p>
          </div>

          <!-- 08 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">08</span>
              Third-Party Services
            </h2>
            <p>
              Certain projects may depend on third-party platforms, hosting
              providers, APIs, payment gateways, cloud services, software tools,
              app stores, or other external services.
            </p>
            <p>
              The availability, pricing, features, policies, and performance of
              such third-party services are controlled by their respective
              providers.
            </p>
            <p>
              Incaendo cannot guarantee the uninterrupted availability or
              continued functionality of third-party services.
            </p>
          </div>

          <!-- 09 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">09</span>
              Website Content
            </h2>
            <p>
              We make reasonable efforts to keep the information on our website
              useful and up to date.
            </p>
            <p>
              However, website content may change from time to time and may
              contain general information about our services, technologies,
              industries, or capabilities.
            </p>
            <p>
              Website content should not be treated as a guarantee of a
              particular project outcome, result, timeline, performance level,
              or business result.
            </p>
          </div>

          <!-- 10 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">10</span>
              Confidentiality
            </h2>
            <p>
              We understand that clients may share confidential business and
              project information with us during discussions or while working on
              a project.
            </p>
            <p>
              Such information will be handled responsibly and used primarily
              for the purpose for which it was provided, subject to any separate
              confidentiality agreement between the parties.
            </p>
          </div>

          <!-- 11 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">11</span>
              Privacy
            </h2>
            <p>
              Your use of the Incaendo website is also subject to our Privacy
              Policy, which explains how we collect, use, and protect
              information.
            </p>
            <p>
              Please review our Privacy Policy for more information about our
              data handling practices.
            </p>
          </div>

          <!-- 12 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">12</span>
              Service Availability
            </h2>
            <p>
              We aim to keep our website and services available and functional,
              but we cannot guarantee uninterrupted access at all times.
            </p>
            <p>
              Website availability may be affected by maintenance, technical
              issues, hosting problems, internet outages, third-party services,
              security incidents, or circumstances outside our reasonable
              control.
            </p>
          </div>

          <!-- 13 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">13</span>
              Limitation of Liability
            </h2>
            <p>
              To the extent permitted by applicable law, Incaendo will not be
              responsible for indirect, incidental, special, consequential, or
              business losses arising from the use of our website or services.
            </p>
            <p>
              This includes, where applicable, loss of data, revenue, profits,
              business opportunities, or business interruption.
            </p>
            <p>
              Any limitations relating to a specific project may also be
              governed by the applicable client agreement or statement of work.
            </p>
          </div>

          <!-- 14 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">14</span>
              Indemnification
            </h2>
            <p>
              To the extent permitted by applicable law, you agree to use our
              website and services responsibly and not to use them in a way that
              violates applicable laws, third-party rights, or these Terms &
              Conditions.
            </p>
            <p>
              Where applicable, you may be responsible for claims arising from
              your unlawful use of the website, misuse of services, or materials
              supplied by you.
            </p>
          </div>

          <!-- 15 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">15</span>
              Suspension or Termination
            </h2>
            <p>
              We may restrict, suspend, or terminate access to our website or
              certain services where reasonably necessary, including in cases of
              misuse, security concerns, unlawful activity, or violation of
              applicable terms.
            </p>
            <p>
              Project-specific termination rights and obligations may be defined
              separately in the applicable agreement with the client.
            </p>
          </div>

          <!-- 16 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">16</span>
              Changes to These Terms
            </h2>
            <p>
              We may update these Terms & Conditions from time to time to
              reflect changes in our services, business practices, technology,
              or applicable legal requirements.
            </p>
            <p>
              When changes are made, the updated version will be published on
              this page along with a revised
              <strong>Last Updated</strong> date.
            </p>
            <p>
              Your continued use of the website after an update means that you
              acknowledge the updated terms.
            </p>
          </div>

          <!-- 17 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">17</span>
              Governing Law
            </h2>
            <p>
              These Terms & Conditions shall be interpreted and governed in
              accordance with the applicable laws of India, subject to any
              specific contractual terms agreed between Incaendo and its
              clients.
            </p>
            <p>
              Any disputes relating to a specific project may be addressed
              according to the dispute-resolution terms contained in the
              applicable agreement.
            </p>
          </div>

          <!-- 18 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">18</span>
              Contact Us
            </h2>
            <p>
              If you have questions about these Terms & Conditions, our
              services, or any project-related terms, you can contact the
              Incaendo team.
            </p>
          </div>

          <!-- CONTACT CARD -->
          <div class="legal-contact-card">
            <span class="contact-badge">Terms & Support</span>
            <h2>Need clarification about our terms?</h2>
            <p>
              Our team is available to discuss our services, project
              requirements, commercial terms, and any questions you may have
              before starting a project with Incaendo.
            </p>

            <div class="contact-grid">
              <div class="contact-grid-item">
                <strong>Email:</strong>
                <a href="mailto:info@incaendo.com">info@incaendo.com</a>
              </div>
              <div class="contact-grid-item">
                <strong>Company:</strong>
                <span>Incaendo Technologies Pvt. Ltd.</span>
              </div>
              <div class="contact-grid-item">
                <strong>Address:</strong>
                <span>
                  First Floor, B-9, B Block, Sector 2, Noida, Uttar Pradesh –
                  201301
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .legal-page {
    background-color: var(--color-paper);
    min-height: 100vh;
  }

  /* =========================
     HERO
  ========================= */
  .legal-hero {
    position: relative;
    padding-top: calc(var(--site-header-height) + 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    background:
      radial-gradient(
        circle at 78% 30%,
        rgba(35, 132, 197, 0.22),
        transparent 28%
      ),
      radial-gradient(
        circle at 15% 80%,
        rgba(201, 84, 43, 0.15),
        transparent 28%
      ),
      linear-gradient(135deg, #030b12 0%, #071a2b 55%, #081f31 100%);
    color: var(--color-white);
    overflow: hidden;
  }

  .legal-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
    pointer-events: none;
  }

  .legal-hero-glow {
    position: absolute;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: rgba(35, 132, 197, 0.15);
    filter: blur(90px);
    right: -100px;
    top: -120px;
    pointer-events: none;
  }

  .legal-hero-wrap {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 992px) {
    .legal-hero-wrap {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4.5rem;
    }
  }

  .legal-hero-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.25rem;
    color: #69baf3;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .legal-hero-label span {
    width: 24px;
    height: 2px;
    background: #58b5f4;
    display: block;
  }

  .legal-hero-left h1 {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5.2vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.04em;
    word-spacing: 0.04em;
    margin-bottom: 1.5rem;
    color: var(--color-white);
  }

  .legal-hero-left h1 em {
    font-style: normal;
    color: #8ed0ff;
  }

  .legal-hero-desc {
    font-size: clamp(1.05rem, 1.4vw, 1.22rem);
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 2rem;
    max-width: 620px;
  }

  .legal-hero-points {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
  }

  .legal-hero-point {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  .point-bullet {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #58b5f4;
    box-shadow: 0 0 10px rgba(88, 181, 244, 0.8);
  }

  .legal-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  .button-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    border: 1px solid rgba(255, 255, 255, 0.2);
    text-decoration: none;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .button-secondary:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.35);
    color: var(--color-white);
    transform: translateY(-1px);
  }

  /* Mockup illustration */
  .legal-hero-visual {
    position: relative;
    display: none;
  }

  @media (min-width: 992px) {
    .legal-hero-visual {
      display: block;
    }
  }

  .legal-glass-frame {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    padding: 1.25rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(10px);
  }

  .legal-browser-top {
    display: flex;
    gap: 6px;
    margin-bottom: 1rem;
  }

  .browser-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .legal-mockup-card {
    background: #ffffff;
    border-radius: 12px;
    padding: 1.5rem;
    color: var(--color-ink);
  }

  .mockup-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .mockup-mini-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-orange);
  }

  .mockup-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #eef8f1;
    color: #2e8b57;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .legal-mockup-card h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    color: var(--color-ink);
  }

  .legal-mockup-card p {
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .mockup-lines {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 1.25rem;
  }

  .mockup-line {
    height: 5px;
    background: #edf1f5;
    border-radius: 4px;
    display: block;
  }

  .mockup-line:nth-child(1) {
    width: 92%;
  }
  .mockup-line:nth-child(2) {
    width: 85%;
  }
  .mockup-line:nth-child(3) {
    width: 96%;
  }
  .mockup-line:nth-child(4) {
    width: 70%;
  }
  .mockup-line:nth-child(5) {
    width: 55%;
  }

  .mockup-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }

  .mockup-status span {
    color: var(--color-muted);
  }

  .mockup-status strong {
    color: #2e8b57;
  }

  .floating-badge {
    position: absolute;
    background: rgba(16, 27, 45, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    padding: 0.6rem 1rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
  }

  .floating-badge small {
    display: block;
    font-size: 0.68rem;
    color: #8ed0ff;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .floating-badge strong {
    font-size: 0.82rem;
    color: #ffffff;
    font-weight: 600;
  }

  .badge-top {
    top: -15px;
    left: -20px;
  }

  .badge-bottom {
    bottom: -15px;
    right: -15px;
  }

  .legal-hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-tag {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 0.78rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  /* =========================
     CONTENT
  ========================= */
  .legal-content-section {
