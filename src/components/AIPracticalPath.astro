    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.25s ease;
    animation: overviewCardIn 0.55s var(--ease-out) both;
    animation-delay: calc(var(--card-i, 0) * 80ms + 100ms);
  }

  .ai-overview-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 3px;
    background: #ea580c;
    border-radius: 0 0 3px 3px;
    opacity: 0;
    transform: scaleX(0.4);
    transition: all 0.25s ease;
  }

  @keyframes overviewCardIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-overview-card:hover,
  .ai-overview-card:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(234, 88, 12, 0.45);
    box-shadow: 0 14px 28px -6px rgba(234, 88, 12, 0.14), 0 4px 10px rgba(15, 23, 42, 0.04);
    outline: none;
  }

  .ai-overview-card:hover .ai-overview-card-title {
    color: var(--color-orange-dark);
  }

  .ai-overview-card.is-active {
    border-color: #ea580c;
    background: linear-gradient(180deg, #ffffff 0%, #fff9f6 100%);
    transform: translateY(-4px);
    box-shadow: 0 16px 36px -6px rgba(234, 88, 12, 0.22), 0 0 0 1px rgba(234, 88, 12, 0.18);
  }

  .ai-overview-card.is-active::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .ai-overview-card.is-active .ai-overview-card-title {
    color: var(--color-orange-dark);
  }

  .ai-overview-icon-wrap {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    position: relative;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-overview-card:hover .ai-overview-icon-wrap {
    transform: scale(1.1);
  }

  .ai-step-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ai-overview-card-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-navy);
    line-height: 1.3;
    text-align: center;
    transition: color 0.2s ease;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }

  /* Connector Bridge Between Cards */
  .ai-overview-bridge {
    position: relative;
    flex: 1 1 36px;
    min-width: 24px;
    max-width: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2px;
    margin-top: 51px;
    align-self: flex-start;
    z-index: 2;
    pointer-events: none;
  }

  .ai-bridge-line {
    position: absolute;
    left: -4px;
    right: -4px;
    top: 0;
    height: 2px;
    background: repeating-linear-gradient(
      to right,
      #ea580c,
      #ea580c 4px,
      transparent 4px,
      transparent 8px
    );
    opacity: 0.65;
  }

  .ai-bridge-node {
    position: relative;
    z-index: 3;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.8px solid #ea580c;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 8px rgba(234, 88, 12, 0.45);
  }

  .ai-bridge-dot {
    width: 3.5px;
    height: 3.5px;
    border-radius: 50%;
    background: #ea580c;
    animation: bridgeDotPulse 2.4s ease-in-out infinite;
  }

  @keyframes bridgeDotPulse {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50% { transform: scale(1.35); opacity: 1; filter: drop-shadow(0 0 4px #ea580c); }
  }

  /* =========================================================
     Dynamic Visual Effects & SVG Micro-Animations
     ========================================================= */

  /* --- Card 1: Understand the Need (Bullseye Radar Sonar Waves & Arrow Strike) --- */
  .target-ambient-aura {
    transform-origin: 32px 34px;
    animation: targetAuraPulse 3s ease-in-out infinite;
  }
  @keyframes targetAuraPulse {
    0%, 100% { opacity: 0.55; transform: scale(0.95); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  .target-sonar-ring {
    transform-origin: 32px 34px;
    animation: targetSonarExpand 2.8s cubic-bezier(0.1, 0.6, 0.3, 1) infinite;
  }
  .target-sonar-ring.sonar-2 {
    animation-delay: 1.4s;
  }
  @keyframes targetSonarExpand {
    0% {
      r: 8px;
      opacity: 0.9;
      stroke-width: 2px;
    }
    100% {
      r: 26px;
      opacity: 0;
      stroke-width: 0.5px;
    }
  }

  .target-pulse-ring {
    transform-origin: 32px 34px;
    animation: targetPulseRing 2.6s ease-in-out infinite;
  }
  @keyframes targetPulseRing {
    0%, 100% { transform: scale(1); filter: drop-shadow(0 0 0 rgba(220, 38, 38, 0)); }
    50% { transform: scale(1.05); filter: drop-shadow(0 0 5px rgba(220, 38, 38, 0.5)); }
  }

  .target-arrow-rig {
    transform-origin: 32px 34px;
    animation: arrowStrikeVibrate 3.2s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }
  @keyframes arrowStrikeVibrate {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    18% {
      transform: translate(2.5px, -2.5px) rotate(2deg);
    }
    24% {
      transform: translate(-1.2px, 1.2px) rotate(-1.2deg);
    }
    30% {
      transform: translate(0.6px, -0.6px) rotate(0.6deg);
    }
    38% {
      transform: translate(0, 0) rotate(0deg);
    }
  }

  .arrow-tip-glow {
    animation: arrowTipFlash 3.2s ease-in-out infinite;
  }
  @keyframes arrowTipFlash {
    0%, 18%, 38%, 100% { fill: #7f1d1d; }
    24% { fill: #ff5722; filter: drop-shadow(0 0 6px #ff5722); }
  }

  /* --- Card 2: Gather the Right Information (Scanning Magnifier & Data Stream) --- */
  .magnifier-active-scanner {
    transform-origin: 41px 27px;
    animation: magSearchLoop 4.5s ease-in-out infinite;
  }
  @keyframes magSearchLoop {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(-12px, -3px) rotate(-6deg);
    }
    50% {
      transform: translate(-10px, 9px) rotate(4deg);
    }
    75% {
      transform: translate(-2px, 5px) rotate(-2deg);
    }
  }

  .mag-glass-glow {
    animation: magLensGlow 3s ease-in-out infinite;
  }
  @keyframes magLensGlow {
    0%, 100% { opacity: 0.65; }
    50% { opacity: 1; filter: drop-shadow(0 0 6px rgba(56, 189, 248, 0.6)); }
  }

  .mag-reticle-dot {
    transform-origin: 41px 27px;
    animation: reticlePulse 2s ease-in-out infinite;
  }
  @keyframes reticlePulse {
    0%, 100% { transform: scale(1); opacity: 0.45; }
    50% { transform: scale(1.45); opacity: 1; filter: drop-shadow(0 0 3px #ea580c); }
  }

  .doc-line-1 { animation: docLineGlow 3s ease-in-out infinite 0.2s; }
  .doc-line-2 { animation: docLineGlow 3s ease-in-out infinite 0.6s; }
  .doc-line-3 { animation: docLineGlow 3s ease-in-out infinite 1s; }
  @keyframes docLineGlow {
    0%, 100% { stroke: #0284c7; stroke-width: 2.4; }
    50% { stroke: #38bdf8; stroke-width: 2.8; filter: drop-shadow(0 0 3px #38bdf8); }
  }

  .doc-bar-1 {
    transform-origin: 21.6px 46px;
    animation: docBarDance 2.4s ease-in-out infinite 0s;
  }
  .doc-bar-2 {
    transform-origin: 26.6px 46px;
    animation: docBarDance 2.4s ease-in-out infinite 0.3s;
  }
  .doc-bar-3 {
    transform-origin: 31.6px 46px;
    animation: docBarDance 2.4s ease-in-out infinite 0.6s;
  }
  @keyframes docBarDance {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(1.4); }
  }

  /* --- Card 3: Choose the Right AI Solution (AI Chip Core Glow & Circuit Signals) --- */
  .chip-energy-aura {
    transform-origin: 33px 33px;
    animation: chipAuraBreath 3s ease-in-out infinite;
  }
  @keyframes chipAuraBreath {
    0%, 100% { transform: scale(0.92); opacity: 0.4; }
    50% { transform: scale(1.15); opacity: 0.95; }
  }

  .chip-core-glow {
    transform-origin: 33px 33px;
    animation: chipCoreBreathe 2.8s ease-in-out infinite;
  }
  @keyframes chipCoreBreathe {
    0%, 100% {
      filter: drop-shadow(0 3px 8px rgba(234, 88, 12, 0.4));
      transform: scale(1);
    }
    50% {
      filter: drop-shadow(0 6px 18px rgba(234, 88, 12, 0.8));
      transform: scale(1.03);
    }
  }

  .chip-ai-label {
    animation: aiTextShimmer 2.8s ease-in-out infinite;
  }
  @keyframes aiTextShimmer {
    0%, 100% { fill: #ffffff; }
    50% { fill: #fff7ed; filter: drop-shadow(0 0 4px #ea580c); }
  }

  .signal-dot {
    animation: signalFlowPulse 2s ease-in-out infinite;
  }
  .dot-t1, .dot-l1, .dot-r1, .dot-b1 { animation-delay: 0s; }
  .dot-t2, .dot-l2, .dot-r2, .dot-b2 { animation-delay: 1s; }
  @keyframes signalFlowPulse {
    0%, 100% { opacity: 0.25; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.45); filter: drop-shadow(0 0 4px #ffffff); }
  }

  /* --- Card 4: Connect Your Workflow (Gear Rotation & Accordion Stack Floating) --- */
  .workflow-gear {
    transform-origin: 48px 24px;
    animation: gearSmoothSpin 8s linear infinite;
  }
  @keyframes gearSmoothSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .stack-layer.layer-top {
    animation: layerFloatTop 3.6s ease-in-out infinite;
  }
  .stack-layer.layer-middle {
    animation: layerFloatMid 3.6s ease-in-out infinite;
  }
  @keyframes layerFloatTop {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3.5px); }
  }
  @keyframes layerFloatMid {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-1.8px); }
  }

  /* --- Card 5: Improve with Results (Metric Bars Surge & Soaring Arrow) --- */
  .metric-bar-item {
    transform-box: fill-box;
    transform-origin: bottom;
    animation: barSurgeBounce 2.5s ease-in-out infinite;
  }
  .metric-bar-item.bar-1 { animation-delay: 0s; }
  .metric-bar-item.bar-2 { animation-delay: 0.22s; }
  .metric-bar-item.bar-3 { animation-delay: 0.44s; }
  .metric-bar-item.bar-4 { animation-delay: 0.66s; }
  @keyframes barSurgeBounce {
    0%, 100% { transform: scaleY(1); }
    40% { transform: scaleY(1.24); filter: brightness(1.15); }
    60% { transform: scaleY(0.95); }
  }

  .growth-arrow-soar {
    animation: arrowSoarGlide 2.8s ease-in-out infinite;
  }
  @keyframes arrowSoarGlide {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(2.5px, -3.2px); filter: drop-shadow(0 0 5px rgba(220, 38, 38, 0.45)); }
  }

  .beacon-pulse {
    transform-origin: 55px 7px;
    animation: beaconFlash 2.8s ease-in-out infinite;
  }
  @keyframes beaconFlash {
    0%, 100% { transform: scale(0.8); opacity: 0.35; }
    50% { transform: scale(1.6); opacity: 0.95; }
  }

  /* --- Universal Twinkling Sparkles --- */
  .sparkle-ray {
    animation: sparkleTwinkle 2.2s ease-in-out infinite;
  }
  @keyframes sparkleTwinkle {
    0%, 100% { opacity: 0.35; transform: scale(0.85) rotate(0deg); }
    50% { opacity: 1; transform: scale(1.25) rotate(8deg); filter: drop-shadow(0 0 3px #ea580c); }
  }

  /* Responsive Layouts */
  @media (max-width: 991px) {
    .ai-overview-row {
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
    }
    .ai-overview-card {
      flex: 1 1 calc(33.333% - 1rem);
      max-width: 210px;
      min-width: 155px;
      min-height: 148px;
    }
    .ai-overview-bridge {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .ai-overview-row {
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    .ai-overview-card {
      width: 100%;
      max-width: 320px;
      min-height: auto;
      padding: 1.15rem 1rem;
    }
    .ai-overview-bridge {
      display: flex;
      width: 24px;
      height: 28px;
      margin-top: 0;
      align-self: center;
    }
    .ai-bridge-line {
      left: 50%;
      right: auto;
      top: 0;
      bottom: 0;
      width: 2px;
      height: 100%;
      background: repeating-linear-gradient(
        to bottom,
        #ea580c,
        #ea580c 4px,
        transparent 4px,
        transparent 8px
      );
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .target-ambient-aura,
    .target-sonar-ring,
    .target-pulse-ring,
    .target-arrow-rig,
    .arrow-tip-glow,
    .magnifier-active-scanner,
    .mag-glass-glow,
    .mag-reticle-dot,
    .doc-line-1,
    .doc-line-2,
    .doc-line-3,
    .doc-bar-1,
    .doc-bar-2,
    .doc-bar-3,
    .chip-energy-aura,
    .chip-core-glow,
    .chip-ai-label,
    .signal-dot,
    .workflow-gear,
    .stack-layer,
    .metric-bar-item,
    .growth-arrow-soar,
    .beacon-pulse,
    .sparkle-ray,
    .bridge-dot,
    .ai-overview-card {
      animation: none !important;
      transform: none !important;
    }
  }

  .ai-workflow-layout {
    display: flex;
    justify-content: center;
    width: 100%;
    position: relative;
  }
  .ai-workflow-hidden-inputs {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }
  .ai-workflow-steps {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .ai-workflow-legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .ai-workflow-step {
    position: relative;
    display: grid;
    min-height: 64px;
    flex: 1;
    grid-template-columns: 36px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 16px;
    background: transparent;
    cursor: pointer;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .ai-workflow-step:hover {
    background: rgb(255 255 255 / 55%);
  }
  .ai-workflow-step input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .ai-step-number {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid rgb(16 27 45 / 12%);
    border-radius: 12px;
    background: #fff;
    color: var(--color-body);
    font-size: 0.78rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    transition:
      color 200ms ease,
      background 200ms ease,
      border-color 200ms ease;
  }
  .ai-step-copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .ai-step-copy strong {
    color: var(--color-ink);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .ai-step-copy small {
    color: var(--color-body);
    font-size: 0.87rem;
    line-height: 1.45;
  }
  .ai-step-arrow {
    align-self: start;
    margin-top: 0.2rem;
    color: #a8afb7;
    font-size: 0.9rem;
    transition:
      color 200ms ease,
      transform 200ms ease;
  }
  .ai-workflow-step:has(input:checked) {
    border-color: rgb(201 84 43 / 24%);
    background: #fff;
    box-shadow: 0 10px 28px -20px rgb(16 27 45 / 30%);
  }
  .ai-workflow-step:has(input:checked)::before {
    position: absolute;
    top: 0.8rem;
    bottom: 0.8rem;
    left: -1px;
    width: 3px;
    border-radius: 999px;
    background: var(--color-orange);
    content: '';
  }
  .ai-workflow-step:has(input:checked) .ai-step-number {
    border-color: transparent;
    background: var(--color-orange);
    color: #fff;
  }
  .ai-workflow-step:has(input:checked) .ai-step-arrow {
    color: var(--color-orange);
    transform: translate(1px, -1px);
  }
  .ai-workflow-step:has(input:focus-visible) {
    outline: 3px solid #e1784f;
    outline-offset: 3px;
  }

  .ai-workflow-demo {
    display: flex;
    min-width: 0;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    flex-direction: column;
    overflow: hidden;
    padding: clamp(1.6rem, 2.8vw, 2.5rem);
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: var(--radius-large);
    background: linear-gradient(165deg, #fffdfb 0%, #fbf8f4 60%, #f8f3ed 100%);
    box-shadow:
      0 1px 2px rgb(16 27 45 / 4%),
      0 20px 48px -20px rgb(16 27 45 / 20%);
    container: ai-demo / inline-size;
  }
  .ai-demo-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .ai-demo-label {
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }
  .ai-demo-label i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 0 4px rgb(90 128 108 / 10%);
  }
  .ai-demo-count {
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
  }
  .ai-demo-count b {
    color: #a0a8b1;
    font-weight: 500;
  }
  .ai-demo-progress {
    height: 2px;
    margin-top: 0.55rem;
    overflow: hidden;
    border-radius: 999px;
    background: #ece9e4;
  }
  .ai-demo-progress span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-orange), var(--color-blue));
    transform: scaleX(0.2);
    transform-origin: left;
    transition: transform 360ms var(--ease-out);
  }

  .ai-state-stage {
    display: grid;
    flex: 1;
    margin-top: 1rem;
  }
  .ai-state-card {
    display: grid;
    grid-area: 1 / 1;
    grid-template-rows: auto 1fr;
    gap: 1.2rem;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition:
      opacity 280ms ease,
      transform 280ms var(--ease-out),
      visibility 280ms;
  }
  .ai-state-card.is-active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .ai-state-kicker {
    display: block;
    color: var(--color-orange-dark);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.11em;
  }
  .ai-state-head h4 {
    margin: 0.45rem 0 0.6rem;
    color: var(--color-ink);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    word-spacing: 0.045em;
    line-height: 1.2;
  }
  .ai-state-head p {
    max-width: 920px;
    margin: 0;
    color: var(--color-body);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  /* Diagram primitives */
  .dg {
    display: grid;
    align-items: center;
    align-self: center;
    min-width: 0;
  }
  .dg-node {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    min-width: 0;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgb(16 27 45 / 11%);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 10px 26px -22px rgb(16 27 45 / 40%);
  }
  .dg-node--tech {
    border-color: rgb(84 123 157 / 24%);
    background: #f3f7fa;
  }
  .dg-node--active {
    border-color: rgb(201 84 43 / 34%);
    background: #fffaf6;
    box-shadow:
      0 0 0 4px rgb(201 84 43 / 6%),
      0 10px 26px -22px rgb(168 65 33 / 45%);
  }
  .dg-node--core {
    border-color: transparent;
    background: linear-gradient(
      150deg,
      var(--color-navy-soft),
      var(--color-navy)
    );
    box-shadow: 0 16px 32px -20px rgb(16 27 45 / 60%);
    color: #fff;
  }
  .ai-state-card.is-active .dg-node {
    animation: dg-node-in 420ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 70ms);
  }
  .dg-tag {
    color: var(--color-blue);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
    line-height: 1.3;
  }
  .dg-node--active .dg-tag {
    color: var(--color-orange-dark);
  }
  .dg-node--core .dg-tag {
    color: #f2b79f;
  }
  .dg-title {
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .dg-node--core .dg-title {
    color: #fff;
  }
  .dg-text {
    margin: 0;
    color: var(--color-body);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .dg-node--core .dg-text {
    color: rgb(255 255 255 / 78%);
  }
  .dg-quote {
    margin: 0;
    padding: 0.6rem 0.7rem;
    border-radius: 10px 10px 10px 3px;
    background: #f6f3ee;
    color: var(--color-ink);
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.45;
  }

  .dg-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.15rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-chips li {
    padding: 0.32rem 0.6rem;
    border: 1px solid rgb(16 27 45 / 10%);
    border-radius: 999px;
    background: #fff;
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .dg-chips--blocks li {
    border-radius: 8px;
  }
  .dg-chips li.is-accent {
    border-color: rgb(84 123 157 / 30%);
    background: #eaf0f5;
    color: #2f5677;
  }
  .dg-node--core .dg-chips li {
    border-color: rgb(255 255 255 / 16%);
    background: rgb(255 255 255 / 7%);
    color: #fff;
  }
  .dg-chips--scan li {
    animation: dg-chip-scan 3.6s ease-in-out infinite;
  }
  .dg-chips--scan li:nth-child(2) {
    animation-delay: 1.2s;
  }
  .dg-chips--scan li:nth-child(3) {
    animation-delay: 2.4s;
  }

  .dg-spec {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
  }
  .dg-spec div {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid rgb(201 84 43 / 12%);
  }
  .dg-spec div:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .dg-spec dt {
    color: var(--color-orange-dark);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .dg-spec dd {
    margin: 0;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
    line-height: 1.4;
  }

  .dg-files {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-files li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.45rem;
    border: 1px solid #eeece8;
    border-radius: 9px;
    background: #fff;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
  }
  .dg-files i {
    display: grid;
    min-width: 30px;
    height: 22px;
    flex: none;
    place-items: center;
    border-radius: 6px;
    background: #f8eee8;
    color: var(--color-orange-dark);
    font-size: 0.66rem;
    font-style: normal;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .dg-files i.is-blue {
    background: #eaf0f5;
    color: var(--color-blue);
  }
  .dg-files i.is-sand {
    background: #f5f0e4;
    color: #806a3f;
  }
  .dg-tools i {
    min-width: 22px;
    font-size: 0.78rem;
  }

  .dg-stages {
    display: grid;
    gap: 0.4rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: stage;
  }
  .dg-stages li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    align-items: center;
    gap: 0.45rem;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
    line-height: 1.35;
    counter-increment: stage;
  }
  .dg-stages li::before {
    display: grid;
    width: 20px;
    height: 20px;
    place-items: center;
    border-radius: 50%;
    background: var(--color-orange);
    color: #fff;
    content: '✓';
    font-size: 0.65rem;
    font-weight: 800;
  }
  .ai-state-card.is-active .dg-stages li::before {
    animation: dg-check-in 360ms var(--ease-out) both;
  }
  .ai-state-card.is-active .dg-stages li:nth-child(1)::before {
    animation-delay: 380ms;
  }
  .ai-state-card.is-active .dg-stages li:nth-child(2)::before {
    animation-delay: 620ms;
  }
  .ai-state-card.is-active .dg-stages li:nth-child(3)::before {
    animation-delay: 860ms;
  }
  .dg-chunks {
    display: flex;
    gap: 4px;
    margin-top: 0.2rem;
  }
  .dg-chunks span {
    height: 8px;
    flex: 1;
    border-radius: 3px;
    background: rgb(201 84 43 / 22%);
  }
  .dg-chunks span:nth-child(2) {
    flex: 1.6;
    background: rgb(201 84 43 / 38%);
  }
  .dg-chunks span:nth-child(3) {
    flex: 0.8;
  }
  .dg-chunks span:nth-child(4) {
    flex: 1.3;
    background: rgb(84 123 157 / 30%);
  }

  .dg-vectors {
    display: grid;
    gap: 0.25rem;
  }
  .dg-vectors code {
    overflow: hidden;
    padding: 0.22rem 0.4rem;
    border-radius: 6px;
    background: #fff;
    color: #2f5677;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .dg-db {
    width: 42px;
    height: 42px;
    fill: #fff;
    stroke: var(--color-blue);
    stroke-linecap: round;
    stroke-width: 1.6;
  }
  .ai-state-card.is-active .dg-db {
    animation: dg-db-glow 2.4s ease-in-out 1.6s infinite;
  }

  .dg-matches {
    display: grid;
    gap: 0.45rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-matches li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30%;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 550;
  }
  .dg-matches i {
    display: block;
    width: var(--w);
    height: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--color-blue), #8fb0cb);
    transform-origin: left;
  }
  .ai-state-card.is-active .dg-matches i {
    animation: dg-bar-in 600ms var(--ease-out) 500ms both;
  }

  .dg-typing {
    display: inline-flex;
    gap: 3px;
    margin-left: 0.2rem;
    vertical-align: middle;
  }
  .dg-typing i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #f2b79f;
    animation: dg-typing 1.2s ease-in-out infinite;
  }
  .dg-typing i:nth-child(2) {
    animation-delay: 0.15s;
  }
  .dg-typing i:nth-child(3) {
    animation-delay: 0.3s;
  }

  .dg-checks {
    display: grid;
    gap: 0.38rem;
    margin: 0.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .dg-checks li {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
    line-height: 1.35;
  }
  .dg-checks li::before {
    color: var(--color-green);
    content: '✓';
    font-weight: 800;
  }
  .dg-checks li.is-flag::before {
    color: var(--color-orange);
    content: '→';
  }

  .dg-result,
  .dg-approval {
    justify-self: start;
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .dg-result {
    background: #eef4ef;
    color: #315d45;
  }
  .dg-approval {
    position: relative;
    border: 1px solid rgb(201 84 43 / 35%);
    background: #fff;
    color: var(--color-orange-dark);
  }
  .dg-approval::before {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--color-orange);
    animation: dg-pulse 2s ease-in-out infinite;
    content: '';
    vertical-align: 1px;
  }

  /* Connectors: horizontal by default; is-left, is-down and is-up change direction */
  .dg-link {
    position: relative;
    height: 2px;
    align-self: center;
    margin-inline: 6px;
    background: rgb(201 84 43 / 38%);
    color: var(--color-orange);
  }
  .dg-link::after {
    position: absolute;
    top: 50%;
    right: 0;
    bottom: auto;
    left: auto;
    width: 8px;
    height: 8px;
    border-top: 2px solid currentColor;
    border-right: 2px solid currentColor;
    content: '';
    transform: translate(0, -50%) rotate(45deg);
  }
  .dg-link i {
    position: absolute;
    inset: 0;
    animation: dg-travel-right 2.2s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }
  .dg-link i::before {
    position: absolute;
    top: 50%;
    left: 0;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border: 2px solid currentColor;
    border-radius: 50%;
    background: #fff8f4;
    box-shadow: 0 0 0 4px rgb(201 84 43 / 12%);
    content: '';
  }
  .dg-link.is-left::after {
    right: auto;
    left: 0;
    transform: translate(0, -50%) rotate(-135deg);
  }
  .dg-link.is-left i {
    animation-name: dg-travel-left;
  }
  .dg-link.is-left i::before {
    left: 100%;
  }
  .dg-link.is-down,
  .dg-link.is-up {
    width: 2px;
    height: auto;
    min-height: 24px;
    align-self: stretch;
    justify-self: center;
    margin: 6px 0;
  }
  .dg-link.is-down::after {
    top: auto;
    right: auto;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 0) rotate(135deg);
  }
  .dg-link.is-down i {
    animation-name: dg-travel-down;
  }
  .dg-link.is-down i::before {
    top: 0;
    left: 50%;
  }
  .dg-link.is-up::after {
    top: 0;
    right: auto;
    bottom: auto;
    left: 50%;
    transform: translate(-50%, 0) rotate(-45deg);
  }
  .dg-link.is-up i {
    animation-name: dg-travel-up;
  }
  .dg-link.is-up i::before {
    top: 100%;
    left: 50%;
  }
  .dg-link em {
    position: absolute;
    bottom: 8px;
    left: 50%;
    color: var(--color-muted);
    font-size: 0.68rem;
    font-style: normal;
    font-weight: 650;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .dg-duplex {
    display: grid;
    align-self: center;
    gap: 30px;
    padding-block: 18px;
  }
  .dg-duplex .dg-link {
    margin-inline: 4px;
  }
  .dg-duplex .dg-link.is-left {
    background: rgb(84 123 157 / 40%);
    color: var(--color-blue);
  }
  .dg-duplex .dg-link.is-left i::before {
    background: #f3f7fa;
    box-shadow: 0 0 0 4px rgb(84 123 157 / 12%);
  }
  .dg-duplex .dg-link.is-left em {
    top: 8px;
    bottom: auto;
  }

  /* Step layouts */
  .dg-understand {
    grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr) 48px minmax(
        0,
        1.1fr
      );
  }
  .dg-prepare {
    grid-template-columns:
      minmax(0, 1.05fr) 36px minmax(0, 1.2fr) 36px minmax(0, 0.95fr)
      36px minmax(0, 0.95fr);
  }
  .dg-design {
    grid-template-areas:
      'query l1 retrieve l2 vector'
      '. . . . l3'
      'eval l5 llm l4 prompt';
    grid-template-columns: minmax(0, 1fr) 46px minmax(0, 1fr) 46px minmax(
        0,
        1fr
      );
    align-items: stretch;
  }
  .dg-design > .dg-link:not(.is-down) {
    align-self: center;
  }
  .dg-a-query {
    grid-area: query;
  }
  .dg-a-retrieve {
    grid-area: retrieve;
  }
  .dg-a-vector {
    grid-area: vector;
  }
  .dg-a-prompt {
    grid-area: prompt;
  }
  .dg-a-llm {
    grid-area: llm;
  }
  .dg-design .dg-a-eval {
    grid-area: eval;
  }
  .dg-design .dg-a-l1 {
    grid-area: l1;
  }
  .dg-design .dg-a-l2 {
    grid-area: l2;
  }
  .dg-design .dg-a-l3 {
    grid-area: l3;
  }
  .dg-design .dg-a-l4 {
    grid-area: l4;
  }
  .dg-design .dg-a-l5 {
    grid-area: l5;
  }
  .dg-connect {
    grid-template-columns:
      minmax(0, 1fr) 62px minmax(0, 1.05fr) 56px minmax(0, 1fr)
      50px minmax(0, 0.95fr);
    align-items: stretch;
  }
  .dg-improve {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.85fr);
    gap: 1rem;
    align-items: stretch;
  }
  .dg-loop {
    position: relative;
    display: grid;
    grid-template-areas:
      'eval l1 monitor'
      'l4 hub l2'
      'iterate l3 feedback';
    grid-template-columns: minmax(0, 1fr) 54px minmax(0, 1fr);
    grid-template-rows: auto 52px auto;
    align-items: stretch;
  }
  .dg-loop .dg-a-eval {
    grid-area: eval;
  }
  .dg-a-monitor {
    grid-area: monitor;
  }
  .dg-a-feedback {
    grid-area: feedback;
  }
  .dg-a-iterate {
    grid-area: iterate;
  }
  .dg-loop .dg-a-l1 {
    grid-area: l1;
  }
  .dg-loop .dg-a-l2 {
    grid-area: l2;
  }
  .dg-loop .dg-a-l3 {
    grid-area: l3;
  }
  .dg-loop .dg-a-l4 {
    grid-area: l4;
  }
  .dg-loop-hub {
    display: grid;
    width: 42px;
    height: 42px;
    grid-area: hub;
    place-self: center;
    place-items: center;
    border: 1px solid rgb(201 84 43 / 25%);
    border-radius: 50%;
    background: #fff;
    color: var(--color-orange);
  }
  .dg-loop-hub svg {
    width: 22px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    animation: dg-spin 9s linear infinite;
  }
  .dg-signals ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .dg-signals-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .dg-signals-head small {
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: var(--surface-subtle);
    color: var(--color-muted);
    font-size: 0.66rem;
    font-weight: 700;
  }
  .dg-signals li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.3rem 0.5rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid #f0eeeb;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
  }
  .dg-signals em {
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-style: normal;
    font-weight: 700;
    white-space: nowrap;
  }
  .dg-signals em.is-good {
    background: #eef4ef;
    color: #315d45;
  }
  .dg-signals em.is-check {
    background: #eaf0f5;
    color: #2f5677;
  }
  .dg-signals em.is-watch {
    background: #f8eee8;
    color: var(--color-orange-dark);
  }
  .dg-signals > .dg-text {
    color: var(--color-muted);
    font-size: 0.74rem;
  }

  /* Active step fallback without JavaScript */
  .ai-workflow-layout:has(#workflow-understand:checked)
    [data-flow-state='understand'],
  .ai-workflow-layout:has(#workflow-prepare:checked)
    [data-flow-state='prepare'],
  .ai-workflow-layout:has(#workflow-design:checked) [data-flow-state='design'],
  .ai-workflow-layout:has(#workflow-connect:checked)
    [data-flow-state='connect'],
  .ai-workflow-layout:has(#workflow-improve:checked)
    [data-flow-state='improve'] {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .ai-workflow-layout:has(#workflow-understand:checked)
    [data-flow-state]:not([data-flow-state='understand']),
  .ai-workflow-layout:has(#workflow-prepare:checked)
    [data-flow-state]:not([data-flow-state='prepare']),
  .ai-workflow-layout:has(#workflow-design:checked)
    [data-flow-state]:not([data-flow-state='design']),
  .ai-workflow-layout:has(#workflow-connect:checked)
    [data-flow-state]:not([data-flow-state='connect']),
  .ai-workflow-layout:has(#workflow-improve:checked)
    [data-flow-state]:not([data-flow-state='improve']) {
    opacity: 0;
    visibility: hidden;
  }
  .ai-workflow-layout:has(#workflow-prepare:checked) .ai-demo-progress span {
    transform: scaleX(0.4);
  }
  .ai-workflow-layout:has(#workflow-design:checked) .ai-demo-progress span {
    transform: scaleX(0.6);
  }
  .ai-workflow-layout:has(#workflow-connect:checked) .ai-demo-progress span {
    transform: scaleX(0.8);
  }
  .ai-workflow-layout:has(#workflow-improve:checked) .ai-demo-progress span {
    transform: scaleX(1);
  }

  /* Pause looping diagram motion while the section is off screen */
  [data-ai-experience][data-ai-paused='true'] .ai-workflow-demo *,
  [data-ai-experience][data-ai-paused='true'] .ai-workflow-demo *::before {
    animation-play-state: paused;
  }

  /* Mid-width panel: slimmer connectors keep step 4's seven columns inside */
  @container ai-demo (max-width: 800px) {
    .dg-connect {
      grid-template-columns:
        minmax(0, 1fr) 50px minmax(0, 1.05fr) 42px minmax(0, 1fr)
        40px minmax(0, 0.95fr);
    }
  }

  /* Narrow diagram panel: flows stack vertically */
  @container ai-demo (max-width: 640px) {
    .dg {
      align-self: start;
    }
    .dg-flow {
      grid-template-areas: none;
      grid-template-columns: minmax(0, 1fr);
      align-items: stretch;
    }
    .dg-flow > .dg-node,
    .dg-flow > .dg-link {
      grid-area: auto;
    }
    .dg-flow > .dg-link,
    .dg-duplex > .dg-link {
      width: 2px;
      height: auto;
      min-height: 26px;
      align-self: stretch;
      justify-self: center;
      margin: 5px 0;
    }
    .dg-flow > .dg-link::after,
    .dg-duplex > .dg-link:first-child::after {
      top: auto;
      right: auto;
      bottom: 0;
      left: 50%;
      transform: translate(-50%, 0) rotate(135deg);
    }
    .dg-flow > .dg-link i,
    .dg-duplex > .dg-link:first-child i {
      animation-name: dg-travel-down;
    }
    .dg-flow > .dg-link i::before,
    .dg-duplex > .dg-link:first-child i::before {
      top: 0;
      left: 50%;
    }
    .dg-duplex {
      display: flex;
      justify-content: center;
      gap: 6.5rem;
      padding: 0;
    }
    .dg-duplex > .dg-link {
      min-height: 34px;
    }
    .dg-duplex > .dg-link:last-child::after {
      top: 0;
      bottom: auto;
      left: 50%;
      transform: translate(-50%, 0) rotate(-45deg);
    }
    .dg-duplex > .dg-link:last-child i {
      animation-name: dg-travel-up;
    }
    .dg-duplex > .dg-link:last-child i::before {
      top: 100%;
      left: 50%;
    }
    .dg-duplex .dg-link em,
    .dg-duplex .dg-link.is-left em {
      top: 50%;
      bottom: auto;
      left: 12px;
      transform: translateY(-50%);
    }
    .dg-node {
      padding: 0.7rem 0.8rem;
    }
    .dg-improve {
      grid-template-columns: minmax(0, 1fr);
    }
    .dg-loop {
      grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr);
      grid-template-rows: auto 46px auto;
    }
    .dg-loop .dg-node {
      padding: 0.65rem;
    }
    .dg-vectors code:nth-child(3) {
      display: none;
    }
  }

  .ai-reveal {
    opacity: 1;
    transform: none;
  }
  [data-ai-experience][data-motion-ready] .ai-reveal {
    transition:
      opacity 550ms var(--ease-out),
      transform 550ms var(--ease-out);
  }
  [data-ai-experience][data-motion-ready] .ai-reveal:not(.is-visible) {
    opacity: 0;
    transform: translateY(14px);
  }

  @keyframes dg-node-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.98);
    }
