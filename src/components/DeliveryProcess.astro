<script>
  function setupDeliveryProcess() {
    document.querySelectorAll('[data-delivery-process]').forEach((root) => {
      if (root.dataset.deliveryReady === 'true') return
      root.dataset.deliveryReady = 'true'

      const tabs = [...root.querySelectorAll('[data-delivery-tab]')]
      const panels = [...root.querySelectorAll('[data-delivery-panel]')]
      const currentLabel = root.querySelector('[data-delivery-current]')
      const progress = root.querySelector('[data-delivery-progress]')
      const progressFill = root.querySelector('[data-delivery-progress-fill]')
      const previous = root.querySelector('[data-delivery-previous]')
      const next = root.querySelector('[data-delivery-next]')
      const tabList = root.querySelector('[data-delivery-tabs]')
      const sceneStage = root.querySelector('[data-delivery-scene-stage]')
      const visualLabel = root.querySelector('[data-delivery-visual-label]')
      const visualCount = root.querySelector('[data-delivery-visual-count]')
      const horizontalLayout = window.matchMedia('(max-width: 1023px)')
      const controller = new AbortController()
      let activeIndex = 0

      const scenes = panels.map((panel, index) => {
        const source = panel.querySelector('.delivery-visual')
        const scene = source?.querySelector('svg')
        if (!scene) return null

        // Keep the SVG's viewBox proportions so diagrams remain legible at every panel size.
        scene.setAttribute('preserveAspectRatio', 'xMidYMid meet')
        scene.classList.add('delivery-live-scene')
        scene.dataset.deliveryVisual = String(index)
        scene.classList.toggle('is-active', index === activeIndex)
        scene.setAttribute('aria-hidden', String(index !== activeIndex))
        sceneStage.append(scene)
        source.remove()
        return scene
      })

      root.classList.add('is-ready')

      function updateTabOrientation() {
        tabList.setAttribute(
          'aria-orientation',
          horizontalLayout.matches ? 'horizontal' : 'vertical',
        )
      }

      updateTabOrientation()
      horizontalLayout.addEventListener('change', updateTabOrientation, {
        signal: controller.signal,
      })

      function selectStage(index, focusTab = false) {
        if (index < 0 || index >= tabs.length || index === activeIndex) return
        activeIndex = index

        tabs.forEach((tab, tabIndex) => {
          const selected = tabIndex === activeIndex
          tab.setAttribute('aria-selected', String(selected))
          tab.tabIndex = selected ? 0 : -1
          if (focusTab && selected) tab.focus()
        })

        panels.forEach((panel, panelIndex) => {
          panel.hidden = panelIndex !== activeIndex
          panel.classList.remove('is-entering')
        })

        const activePanel = panels[activeIndex]
        void activePanel.offsetWidth
        activePanel.classList.add('is-entering')

        scenes.forEach((scene, sceneIndex) => {
          if (!scene) return
          const selected = sceneIndex === activeIndex
          scene.classList.toggle('is-active', selected)
          scene.setAttribute('aria-hidden', String(!selected))
        })

        const stageNumber = String(activeIndex + 1).padStart(2, '0')
        const activeVisual = panels[activeIndex].dataset.visualLabel
        currentLabel.textContent = `Stage ${stageNumber} of 05`
        visualCount.textContent = `${stageNumber} / 05`
        visualLabel.textContent = activeVisual || 'Delivery stage'
        progress.setAttribute('aria-valuenow', String(activeIndex + 1))
        progress.setAttribute(
          'aria-valuetext',
          `Stage ${activeIndex + 1} of ${tabs.length}`,
        )
        progressFill.style.transform = `scaleX(${(activeIndex + 1) / tabs.length})`
        previous.disabled = activeIndex === 0
        next.disabled = activeIndex === tabs.length - 1
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectStage(index), {
          signal: controller.signal,
        })
      })

      tabList.addEventListener(
        'keydown',
        (event) => {
          const currentIndex = tabs.indexOf(document.activeElement)
          let nextIndex = currentIndex

          if (event.key === 'ArrowDown' || event.key === 'ArrowRight') {
            nextIndex = (currentIndex + 1) % tabs.length
          } else if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') {
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length
          } else if (event.key === 'Home') {
            nextIndex = 0
          } else if (event.key === 'End') {
            nextIndex = tabs.length - 1
          } else {
            return
          }

          event.preventDefault()
          selectStage(nextIndex, true)
        },
        { signal: controller.signal },
      )

      previous.addEventListener('click', () => selectStage(activeIndex - 1), {
        signal: controller.signal,
      })
      next.addEventListener('click', () => selectStage(activeIndex + 1), {
        signal: controller.signal,
      })

      root._cleanupDeliveryProcess = () => {
        controller.abort()
        delete root.dataset.deliveryReady
        delete root._cleanupDeliveryProcess
      }
    })
  }

  function cleanupDeliveryProcess() {
    document.querySelectorAll('[data-delivery-process]').forEach((root) => {
      root._cleanupDeliveryProcess?.()
    })
  }

  setupDeliveryProcess()
  document.addEventListener('astro:page-load', setupDeliveryProcess)
  document.addEventListener('astro:before-swap', cleanupDeliveryProcess)
</script>

