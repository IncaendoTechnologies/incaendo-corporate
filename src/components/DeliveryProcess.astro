---
const stages = [
  {
    number: '01',
    title: 'Discover',
    navTitle: 'Discover',
    label: 'Understand the challenge',
    description:
      'We start by understanding your business objectives, users, existing systems, and constraints before deciding what the solution should be.',
    activities: [
      'Stakeholder discussions and discovery workshops',
      'Requirements gathering and workflow mapping',
      'Business objectives, constraints, and success metrics',
    ],
    deliverables: [
      'Discovery brief',
      'Prioritised requirements',
      'Agreed project scope',
    ],
    visual: 'discover',
    visualLabel: 'Business context map',
  },
  {
    number: '02',
    title: 'Define & Design',
    navTitle: 'Define',
    label: 'Plan the right solution',
    description:
      'We turn requirements into clear user journeys, intuitive interfaces, and a practical technical architecture your team can review with confidence.',
    activities: [
      'User journeys, wireframes, and UI/UX design',
      'Technical architecture and technology selection',
      'Prototype reviews and design validation',
    ],
    deliverables: [
      'Approved design direction',
      'Technical architecture plan',
      'Delivery roadmap',
    ],
    visual: 'design',
    visualLabel: 'Solution blueprint',
  },
  {
    number: '03',
    title: 'Build & Integrate',
    navTitle: 'Build',
    label: 'Engineer the solution',
    description:
      'We develop in focused iterations, connect relevant systems, and share regular progress so the product takes shape with your feedback in view.',
    activities: [
      'Structured development sprints',
      'API, platform, and third-party integrations',
      'Code reviews, working demos, and progress feedback',
    ],
    deliverables: [
      'Working product features',
      'Integrated systems',
      'Sprint updates and demonstrable progress',
    ],
    visual: 'build',
    visualLabel: 'Engineering pipeline',
  },
  {
    number: '04',
    title: 'Validate & Refine',
    navTitle: 'Validate',
    label: 'Quality before release',
    description:
      'We test the solution against its requirements and refine it with the intended users before it is released into the environments where it will be used.',
    activities: [
      'Functional and regression testing',
      'Security, performance, and usability checks',
      'User acceptance testing and issue resolution',
    ],
    deliverables: [
      'Test results',
      'Resolved defects',
      'Release-readiness confirmation',
    ],
    visual: 'validate',
    visualLabel: 'Quality checks',
  },
  {
    number: '05',
    title: 'Launch & Evolve',
    navTitle: 'Launch',
    label: 'Deliver lasting value',
    description:
      'We plan and support the production release, monitor how the product performs, and shape improvements around real feedback and business needs.',
    activities: [
      'Deployment planning and release checks',
      'Production monitoring and issue resolution',
      'Continuous improvements and future enhancements',
    ],
    deliverables: [
      'Production release',
      'Appropriate handover documentation',
      'Improvement roadmap',
    ],
    visual: 'launch',
    visualLabel: 'Release & monitoring',
  },
]
---

<section
  class="delivery-process"
  id="delivery-process"
  aria-labelledby="delivery-process-heading"
  data-delivery-process
>
  <div class="site-container delivery-process-container">
    <header class="delivery-intro">
      <p class="eyebrow">Our delivery process</p>
      <h2 id="delivery-process-heading">
        From bold ideas to <span>real-world impact.</span>
      </h2>
      <p class="delivery-intro-copy">
        A transparent, collaborative process that turns complex challenges into
        reliable digital solutions.
      </p>
    </header>

    <div class="delivery-layout">
      <nav class="delivery-navigation" aria-label="Delivery stages">
        <p class="delivery-navigation-label">A clear path forward</p>
        <div
          class="delivery-step-list"
          role="tablist"
          aria-label="Select a delivery stage"
          aria-orientation="vertical"
          data-delivery-tabs
        >
          {stages.map((stage, index) => (
            <button
              class="delivery-step"
              id={`delivery-tab-${stage.number}`}
              type="button"
              role="tab"
              aria-controls={`delivery-panel-${stage.number}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-delivery-tab
              data-stage-index={index}
            >
              <span class="delivery-step-number" aria-hidden="true">
                {stage.number}
              </span>
              <span class="delivery-step-copy">
                <strong>
                  <span class="delivery-step-full">{stage.title}</span>
                  <span class="delivery-step-short">{stage.navTitle}</span>
                </strong>
                <span>{stage.label}</span>
              </span>
              <span class="delivery-step-arrow" aria-hidden="true">
                ↗
              </span>
            </button>
          ))}
        </div>
      </nav>

      <div class="delivery-workspace">
        <div
          class="delivery-live-visual"
          data-delivery-live-visual
          aria-hidden="true"
        >
          <div class="delivery-visual-meta">
            <span class="delivery-visual-label">
              <span class="delivery-visual-pulse" />
              <span data-delivery-visual-label>Discovery network</span>
            </span>
            <span class="delivery-visual-count" data-delivery-visual-count>
              01 / 05
            </span>
          </div>
          <div class="delivery-scene-stage" data-delivery-scene-stage />
        </div>
        {stages.map((stage, index) => (
          <article
            class="delivery-panel"
            id={`delivery-panel-${stage.number}`}
            role="tabpanel"
            aria-labelledby={`delivery-tab-${stage.number}`}
            tabindex="0"
            data-delivery-panel
            data-stage-index={index}
            data-visual-label={stage.visualLabel}
            hidden={index !== 0}
          >
            <div class="delivery-visual" aria-hidden="true">
              <div class="delivery-visual-meta">
                <span class="delivery-visual-label">
                  <span class="delivery-visual-pulse" />
                  {stage.visualLabel}
                </span>
                <span class="delivery-visual-count">{stage.number} / 05</span>
              </div>

              {stage.visual === 'discover' && (
                <svg
                  class="delivery-scene"
                  viewBox="0 0 640 330"
                  fill="none"
                  focusable="false"
                >
                  <path class="dp-link" d="M174 100 260 140m-86 92 86-45m120-47 86-40m-86 85 86 41" />
                  <path class="dp-link-soft" d="M174 100 260 140m-86 92 86-45m120-47 86-40m-86 85 86 41" />
                  <circle class="dp-flow dp-flow-a" cx="174" cy="100" r="3.5" />
                  <circle class="dp-flow dp-flow-b" cx="174" cy="232" r="3.5" />
                  <circle class="dp-flow dp-flow-c" cx="466" cy="92" r="3.5" />
                  <circle class="dp-flow dp-flow-d" cx="466" cy="233" r="3.5" />
                  <g class="dp-discovery-card dp-enter dp-enter-one">
                    <rect class="dp-card" x="30" y="65" width="144" height="72" rx="13" />
                    <circle class="dp-icon-disc" cx="51" cy="90" r="10" />
                    <path class="dp-icon" d="M47 91a4 4 0 1 1 8 0m-10 6c1-4 11-4 12 0m-6-15v2" />
                    <text class="dp-heading" x="68" y="88">STAKEHOLDERS</text>
                    <text class="dp-copy" x="47" y="116">People · users · teams</text>
                    <circle class="dp-card-status" cx="158" cy="80" r="3" />
                  </g>
                  <g class="dp-discovery-card dp-enter dp-enter-two">
                    <rect class="dp-card" x="30" y="197" width="144" height="72" rx="13" />
                    <circle class="dp-icon-disc" cx="51" cy="222" r="10" />
                    <path class="dp-icon" d="M47 218h8m-8 4h8m-8 4h5" />
                    <text class="dp-heading" x="68" y="220">REQUIREMENTS</text>
                    <text class="dp-copy" x="47" y="248">Needs · workflows · scope</text>
                    <circle class="dp-card-status" cx="158" cy="212" r="3" />
                  </g>
                  <g class="dp-discovery-card dp-enter dp-enter-three">
                    <rect class="dp-card" x="466" y="65" width="144" height="72" rx="13" />
                    <circle class="dp-icon-disc dp-icon-disc-accent" cx="487" cy="90" r="10" />
                    <path class="dp-icon" d="M482 94v-5l5-4 5 4v5m-7 0v-4h4v4" />
                    <text class="dp-heading" x="504" y="88">SUCCESS METRICS</text>
                    <text class="dp-copy" x="483" y="116">Outcomes · measures</text>
                    <circle class="dp-card-status dp-card-status-accent" cx="594" cy="80" r="3" />
                  </g>
                  <g class="dp-discovery-card dp-enter dp-enter-four">
                    <rect class="dp-card" x="466" y="197" width="144" height="72" rx="13" />
                    <circle class="dp-icon-disc" cx="487" cy="222" r="10" />
                    <path class="dp-icon" d="M483 218h8m-8 4h5m-5 4h8" />
                    <text class="dp-heading" x="504" y="220">CONSTRAINTS</text>
                    <text class="dp-copy" x="483" y="248">Systems · time · risk</text>
                    <circle class="dp-card-status" cx="594" cy="212" r="3" />
                  </g>
                  <g class="dp-goal-core dp-enter dp-enter-core">
                    <circle class="dp-core-halo" cx="320" cy="166" r="67" />
                    <circle class="dp-core-ring" cx="320" cy="166" r="51" />
                    <rect class="dp-core-card" x="265" y="124" width="110" height="84" rx="20" />
                    <path class="dp-goal-icon" d="M320 144v25m-12-12h24m-19-10 7 5 7-5" />
                    <text class="dp-core-title" x="320" y="181" text-anchor="middle">BUSINESS</text>
                    <text class="dp-core-title" x="320" y="197" text-anchor="middle">GOALS</text>
                  </g>
                  <text class="dp-kicker" x="320" y="291" text-anchor="middle">ALIGN THE CONTEXT BEFORE DEFINING THE SOLUTION</text>
                </svg>
              )}

              {stage.visual === 'design' && (
                <svg
                  class="delivery-scene"
                  viewBox="0 0 640 330"
                  fill="none"
                  focusable="false"
                >
                  <path class="dp-link" d="M157 151h23v-31h24m-24 31v69h24m225-100h28v69h-28m28 0v-69h28" />
                  <path class="dp-link-soft" d="M157 151h23v-31h24m-24 31v69h24m225-100h28v69h-28m28 0v-69h28" />
                  <circle class="dp-flow dp-flow-a" cx="157" cy="151" r="3.5" />
                  <circle class="dp-flow dp-flow-b" cx="204" cy="220" r="3.5" />
                  <circle class="dp-flow dp-flow-c" cx="433" cy="151" r="3.5" />
                  <g class="dp-enter dp-enter-one">
                    <rect class="dp-card dp-requirements" x="28" y="94" width="129" height="116" rx="13" />
                    <text class="dp-heading" x="43" y="116">BUSINESS INPUT</text>
                    <circle class="dp-check" cx="46" cy="139" r="3" /><text class="dp-copy" x="56" y="142">User needs</text>
                    <circle class="dp-check" cx="46" cy="160" r="3" /><text class="dp-copy" x="56" y="163">Workflows</text>
                    <circle class="dp-check" cx="46" cy="181" r="3" /><text class="dp-copy" x="56" y="184">Constraints</text>
                    <rect class="dp-progress-track" x="43" y="195" width="98" height="3" rx="1.5" />
                    <rect class="dp-progress-fill dp-progress-requirements" x="43" y="195" width="98" height="3" rx="1.5" />
                  </g>
                  <g class="dp-enter dp-enter-two">
                    <rect class="dp-architecture" x="204" y="58" width="229" height="207" rx="16" />
                    <text class="dp-heading" x="220" y="80">SOLUTION BLUEPRINT</text>
                    <text class="dp-copy" x="220" y="94">Reviewed system layers</text>
                    <path class="dp-arch-spine" d="M316 118v112" />
                    <rect class="dp-layer" x="220" y="108" width="90" height="49" rx="9" />
                    <rect class="dp-layer dp-layer-accent" x="322" y="108" width="95" height="49" rx="9" />
                    <rect class="dp-layer" x="220" y="171" width="90" height="49" rx="9" />
                    <rect class="dp-layer" x="322" y="171" width="95" height="49" rx="9" />
                    <path class="dp-layer-icon" d="M232 123h18v21h-18zm4 4h10m-10 5h10" />
                    <path class="dp-layer-icon" d="M335 121h16v15h-16zm3 4h10m-10 4h7" />
                    <ellipse class="dp-layer-icon" cx="241" cy="185" rx="9" ry="4" /><path class="dp-layer-icon" d="M232 185v13c0 5 18 5 18 0v-13m-18 6c0 5 18 5 18 0" />
                    <path class="dp-layer-icon" d="M335 187h18m-9-8v16m0-8 9-8m-9 8 9 8" />
                    <text class="dp-layer-title" x="258" y="131">UI / UX</text>
                    <text class="dp-layer-copy" x="258" y="144">User journeys</text>
                    <text class="dp-layer-title" x="360" y="131">API / SERVICES</text>
                    <text class="dp-layer-copy" x="360" y="144">API contracts</text>
                    <text class="dp-layer-title" x="258" y="193">DATA</text>
                    <text class="dp-layer-copy" x="258" y="206">Data models</text>
                    <text class="dp-layer-title" x="360" y="193">INTEGRATIONS</text>
                    <text class="dp-layer-copy" x="360" y="206">Connected tools</text>
                    <circle class="dp-layer-node" cx="316" cy="165" r="4" />
                    <rect class="dp-blueprint-foot" x="220" y="232" width="197" height="19" rx="9.5" />
                    <circle class="dp-card-status" cx="232" cy="241.5" r="3" />
                    <text class="dp-foot-label" x="242" y="245">ARCHITECTURE READY FOR REVIEW</text>
                  </g>
                  <g class="dp-enter dp-enter-three">
                    <rect class="dp-card dp-output" x="483" y="94" width="129" height="116" rx="13" />
                    <circle class="dp-output-halo" cx="547" cy="133" r="20" />
                    <path class="dp-output-icon" d="M536 131h22m-22 7h22m-18-14h14" />
                    <text class="dp-heading" x="547" y="168" text-anchor="middle">PROPOSED</text>
                    <text class="dp-heading" x="547" y="184" text-anchor="middle">SOLUTION</text>
                    <text class="dp-copy" x="547" y="198" text-anchor="middle">Plan → prototype</text>
                  </g>
                  <circle class="dp-flow dp-flow-e" cx="183" cy="120" r="3.5" />
                  <circle class="dp-flow dp-flow-f" cx="433" cy="189" r="3.5" />
                  <circle class="dp-flow dp-arch-flow" cx="457" cy="185" r="3.5" />
                  <text class="dp-kicker" x="320" y="291" text-anchor="middle">REQUIREMENTS BECOME A REVIEWABLE SYSTEM PLAN</text>
                </svg>
              )}

              {stage.visual === 'build' && (
                <svg
                  class="delivery-scene"
                  viewBox="0 0 640 330"
                  fill="none"
                  focusable="false"
                >
                  <path class="dp-link" d="M151 157h25m126 0h24m126 0h24" />
                  <path class="dp-link-soft" d="M151 157h25m126 0h24m126 0h24" />
                  <g class="dp-pipeline-card dp-enter dp-enter-one">
                    <rect class="dp-card" x="25" y="99" width="126" height="119" rx="14" />
                    <text class="dp-heading" x="40" y="119">CODE</text>
                    <text class="dp-copy" x="40" y="133">Components</text>
                    <rect class="dp-code-screen" x="40" y="146" width="96" height="42" rx="7" />
                    <path class="dp-code-glyph" d="m53 159-5 4 5 4m10-8 5 4-5 4m11 0 6-9" />
                    <path class="dp-code-line" d="M50 179h37m-37 5h54" />
                    <circle class="dp-card-status" cx="134" cy="113" r="3" />
                    <text class="dp-micro" x="40" y="205">BUILDING</text>
                  </g>
                  <g class="dp-pipeline-card dp-enter dp-enter-two">
                    <rect class="dp-card" x="176" y="99" width="126" height="119" rx="14" />
                    <text class="dp-heading" x="191" y="119">API</text>
                    <text class="dp-copy" x="191" y="133">Services</text>
                    <rect class="dp-service-node" x="192" y="149" width="40" height="20" rx="6" />
                    <rect class="dp-service-node dp-service-node-accent" x="247" y="149" width="40" height="20" rx="6" />
                    <text class="dp-micro" x="212" y="162" text-anchor="middle">CORE</text>
                    <text class="dp-micro" x="267" y="162" text-anchor="middle">API</text>
                    <path class="dp-mini-link" d="M232 159h15" />
                    <path class="dp-code-line" d="M192 184h91" />
                    <circle class="dp-card-status" cx="285" cy="185" r="3" />
                    <text class="dp-micro" x="191" y="205">CONNECTED</text>
                  </g>
                  <g class="dp-pipeline-card dp-enter dp-enter-three">
                    <rect class="dp-card" x="327" y="99" width="126" height="119" rx="14" />
                    <text class="dp-heading" x="342" y="119">DATA</text>
                    <text class="dp-copy" x="342" y="133">Integrations</text>
                    <ellipse class="dp-db" cx="389" cy="153" rx="28" ry="8" />
                    <path class="dp-db" d="M361 153v25c0 11 56 11 56 0v-25" />
                    <path class="dp-db-line" d="M361 165c0 11 56 11 56 0m-56 8c0 11 56 11 56 0" />
                    <circle class="dp-integration-dot" cx="432" cy="153" r="5" />
                    <path class="dp-mini-link" d="M417 153h10" />
                    <text class="dp-micro" x="342" y="205">SYNCED</text>
                  </g>
                  <g class="dp-pipeline-card dp-enter dp-enter-four">
                    <rect class="dp-product-card" x="478" y="99" width="137" height="119" rx="14" />
                    <text class="dp-heading" x="493" y="119">APPLICATION</text>
                    <rect class="dp-app-window" x="493" y="132" width="107" height="57" rx="8" />
                    <path class="dp-app-top" d="M493 145h107" />
                    <circle class="dp-app-dot" cx="503" cy="139" r="2.5" /><circle class="dp-app-dot dp-app-dot-accent" cx="512" cy="139" r="2.5" />
                    <rect class="dp-app-module" x="502" y="153" width="35" height="26" rx="4" />
                    <rect class="dp-app-module dp-app-module-accent" x="543" y="153" width="47" height="11" rx="4" />
                    <path class="dp-app-line" d="M543 171h39m-39 6h27" />
                    <text class="dp-micro dp-micro-ready" x="493" y="205">WORKING PRODUCT</text>
                  </g>
                  <path class="dp-arrow-head" d="m168 153 7 4-7 4m126-8 7 4-7 4m126-8 7 4-7 4" />
                  <circle class="dp-pipeline-flow dp-pipeline-flow-one" cx="151" cy="157" r="4" />
                  <circle class="dp-pipeline-flow dp-pipeline-flow-two" cx="302" cy="157" r="4" />
                  <circle class="dp-pipeline-flow dp-pipeline-flow-three" cx="453" cy="157" r="4" />
                  <rect class="dp-sprint-track" x="25" y="242" width="590" height="34" rx="12" />
                  <text class="dp-heading" x="42" y="263">SPRINT 04</text>
                  <rect class="dp-progress-track" x="148" y="255" width="310" height="6" rx="3" />
                  <rect class="dp-progress-fill dp-sprint-progress" x="148" y="255" width="205" height="6" rx="3" />
                  <text class="dp-foot-label" x="477" y="263">FEATURES INTEGRATING</text>
                  <circle class="dp-card-status" cx="596" cy="259" r="3" />
                </svg>
              )}

              {stage.visual === 'validate' && (
                <svg
                  class="delivery-scene"
                  viewBox="0 0 640 330"
                  fill="none"
                  focusable="false"
                >
                  <rect class="dp-qa-dashboard" x="30" y="52" width="580" height="231" rx="17" />
                  <text class="dp-heading" x="50" y="76">QUALITY GATES</text>
                  <text class="dp-copy" x="50" y="91">Illustrative test run · sample data</text>
                  <rect class="dp-run-badge" x="465" y="64" width="123" height="23" rx="11.5" />
                  <circle class="dp-card-status" cx="480" cy="75.5" r="3" />
                  <text class="dp-foot-label" x="490" y="79">RELEASE REVIEW</text>
                  <g class="dp-qa-card dp-enter dp-enter-one">
                    <rect class="dp-card" x="50" y="108" width="178" height="62" rx="10" />
                    <circle class="dp-qa-check dp-qa-check-one" cx="69" cy="128" r="8" />
                    <path class="dp-qa-mark" d="m65 128 3 3 5-6" />
                    <text class="dp-heading" x="84" y="129">FUNCTIONAL</text>
                    <text class="dp-copy" x="64" y="153">User flows</text>
                    <rect class="dp-qa-track" x="119" y="149" width="91" height="5" rx="2.5" />
                    <rect class="dp-qa-progress dp-qa-progress-one" x="119" y="149" width="91" height="5" rx="2.5" />
                    <text class="dp-qa-status" x="211" y="129" text-anchor="end">PASS</text>
                  </g>
                  <g class="dp-qa-card dp-enter dp-enter-two">
                    <rect class="dp-card" x="240" y="108" width="178" height="62" rx="10" />
                    <circle class="dp-qa-check dp-qa-check-two" cx="259" cy="128" r="8" />
                    <path class="dp-qa-mark" d="m255 128 3 3 5-6" />
                    <text class="dp-heading dp-qa-long-heading" x="274" y="129">INTEGRATION</text>
                    <text class="dp-copy" x="254" y="153">API contracts</text>
                    <rect class="dp-qa-track" x="338" y="149" width="66" height="5" rx="2.5" />
                    <rect class="dp-qa-progress dp-qa-progress-two" x="338" y="149" width="66" height="5" rx="2.5" />
                    <text class="dp-qa-status" x="401" y="129" text-anchor="end">PASS</text>
                  </g>
                  <g class="dp-qa-card dp-enter dp-enter-three">
                    <rect class="dp-card" x="50" y="181" width="178" height="62" rx="10" />
                    <circle class="dp-qa-review" cx="69" cy="201" r="8" />
                    <path class="dp-qa-mark-review" d="M69 197v5m0 3v.5" />
                    <text class="dp-heading dp-qa-long-heading" x="84" y="202">PERFORMANCE</text>
                    <text class="dp-copy" x="64" y="226">Load profile</text>
                    <rect class="dp-qa-track" x="119" y="222" width="91" height="5" rx="2.5" />
                    <rect class="dp-qa-progress dp-qa-progress-three" x="119" y="222" width="91" height="5" rx="2.5" />
                    <text class="dp-qa-status dp-qa-status-review" x="211" y="202" text-anchor="end">REVIEW</text>
                  </g>
                  <g class="dp-qa-card dp-enter dp-enter-four">
                    <rect class="dp-card" x="240" y="181" width="178" height="62" rx="10" />
                    <circle class="dp-qa-check dp-qa-check-four" cx="259" cy="201" r="8" />
                    <path class="dp-qa-mark" d="m255 201 3 3 5-6" />
                    <text class="dp-heading" x="274" y="202">SECURITY</text>
                    <text class="dp-copy" x="254" y="226">Access + data</text>
                    <rect class="dp-qa-track" x="338" y="222" width="66" height="5" rx="2.5" />
                    <rect class="dp-qa-progress dp-qa-progress-four" x="338" y="222" width="66" height="5" rx="2.5" />
                    <text class="dp-qa-status" x="401" y="202" text-anchor="end">PASS</text>
                  </g>
                  <g class="dp-quality-score dp-enter dp-enter-score">
                    <rect class="dp-score-panel" x="434" y="108" width="154" height="135" rx="12" />
