    border-color: #eed7c8;
    background: #fff8f3;
  }
  .software-module-highlight i {
    background: #f0d8c7 !important;
  }
  .software-board-caption {
    position: absolute;
    right: 1rem;
    bottom: 0.75rem;
    color: var(--color-muted);
    font-size: 0.57rem;
  }
  .software-board-caption b,
  .browser-caption b {
    color: var(--color-orange);
  }
  .web-browser {
    width: min(100%, 470px);
    align-self: center;
    overflow: hidden;
    border: 1px solid #d9dfe4;
    border-radius: 11px;
    background: #fff;
    box-shadow: 0 18px 35px rgb(16 27 45 / 9%);
