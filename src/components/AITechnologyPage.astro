    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: var(--radius-large);
    background: #fff;
    box-shadow:
      0 1px 2px rgb(16 27 45 / 4%),
      0 14px 32px -12px rgb(16 27 45 / 12%),
      0 42px 80px -28px rgb(16 27 45 / 16%);
  }
  .workflow-visual-shell {
    position: relative;
    padding: 1.15rem 1.3rem 1rem;
    border-bottom: 1px solid rgb(16 27 45 / 7%);
    background:
      radial-gradient(ellipse at 92% 0%, rgb(201 84 43 / 9%), transparent 42%),
      radial-gradient(
        ellipse at 0% 100%,
        rgb(84 123 157 / 10%),
        transparent 46%
      ),
      linear-gradient(165deg, #fffdfa 0%, #faf6f0 55%, #f6f0e8 100%);
    color: var(--color-ink);
  }
  .workflow-visual-shell::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(16 27 45 / 4.5%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(16 27 45 / 4.5%) 1px, transparent 1px);
    background-size: 32px 32px;
    content: '';
    mask-image: radial-gradient(ellipse at center, black, transparent 74%);
    pointer-events: none;
  }
  .workflow-visual-heading {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.8rem;
    color: var(--color-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .workflow-visual-heading > span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .workflow-visual-heading > span:first-child::before {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 0 3.5px rgb(201 84 43 / 14%);
    content: '';
  }
  .workflow-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.28rem 0.62rem;
    border: 1px solid rgb(90 128 108 / 22%);
    border-radius: 999px;
    background: rgb(255 255 255 / 80%);
    box-shadow: 0 2px 8px rgb(16 27 45 / 5%);
    color: var(--color-green);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  .workflow-live i {
    width: 6px;
    height: 6px;
    background: var(--color-green);
    box-shadow: 0 0 0 3.5px rgb(90 128 108 / 16%);
  }
  .workflow-scenes {
    position: relative;
    z-index: 1;
    margin-top: 0.6rem;
  }
  .workflow-scene {
    position: relative;
    display: grid;
    min-height: 358px;
    align-content: center;
    justify-items: center;
    padding-bottom: 1.5rem;
    animation: ai-scene-enter 350ms var(--ease-out) both;
  }
  .workflow-scene[hidden] {
    display: none;
  }
  .scene-corner-label {
    position: absolute;
    right: 0;
    bottom: 0;
    color: rgb(16 27 45 / 38%);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  /* Shared card surface for scene elements */
  .source-file,
  .source-boundary,
  .retrieval-query,
  .retrieval-result,
  .reasoning-context span,
  .reasoning-output,
  .validation-list > div,
  .workflow-ticket {
    border: 1px solid rgb(16 27 45 / 8%);
    background: #fff;
    box-shadow:
      0 1px 2px rgb(16 27 45 / 4%),
      0 8px 20px -10px rgb(16 27 45 / 14%);
  }
  .source-boundary small,
  .retrieval-query small,
  .reasoning-context small,
  .reasoning-output small,
  .validation-side small,
  .workflow-destination small {
    color: var(--color-orange-dark);
    font-size: 0.66rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }

  .scene-source-stack {
    display: grid;
    width: min(80%, 420px);
    gap: 0.4rem;
  }
  .source-file {
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) 1.1rem;
    align-items: center;
    gap: 0.75rem;
    padding: 0.48rem 0.8rem;
    border-radius: 10px;
  }
  .source-file > i {
    display: grid;
    width: 2.5rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgb(84 123 157 / 24%);
    border-radius: 6px;
    background: rgb(84 123 157 / 8%);
    color: var(--color-blue);
    font-size: 0.66rem;
    font-style: normal;
    font-weight: 750;
    letter-spacing: 0.06em;
  }
  .source-file:nth-child(2) > i {
    border-color: rgb(201 84 43 / 24%);
    background: rgb(201 84 43 / 7%);
    color: var(--color-orange-dark);
  }
  .source-file span {
    display: grid;
    min-width: 0;
    gap: 0.12rem;
  }
  .source-file b {
    overflow: hidden;
    color: var(--color-ink);
    font-size: 0.88rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .source-file small {
    color: var(--color-muted);
    font-size: 0.76rem;
  }
  .source-file > em {
    color: var(--color-green);
    font-size: 0.96rem;
    font-style: normal;
    font-weight: 700;
  }
  .scene-connector {
    position: relative;
    display: flex;
    width: min(50%, 220px);
    height: 24px;
    align-items: center;
    justify-content: center;
  }
  .scene-connector span {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(50% - 1px);
    width: 1px;
    background: rgb(84 123 157 / 40%);
  }
  .scene-connector span:last-child {
    background: rgb(201 84 43 / 45%);
  }
  .scene-connector i {
    z-index: 1;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 0 3.5px rgb(201 84 43 / 16%);
    animation: ai-packet 1.5s ease-in-out infinite;
  }
  .source-boundary {
    display: grid;
    width: min(68%, 350px);
    justify-items: center;
    gap: 0.26rem;
    padding: 0.55rem 0.9rem;
    border-color: rgb(201 84 43 / 22%);
    border-radius: 10px;
    background: linear-gradient(180deg, #fff, #fdf6f1);
    text-align: center;
  }
  .source-boundary strong {
    font-size: 0.92rem;
    font-weight: 650;
  }
  .source-boundary em {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-style: normal;
  }
  .boundary-meter {
    display: flex;
    gap: 0.22rem;
  }
  .boundary-meter i {
    width: 17px;
    height: 4px;
    border-radius: 4px;
    background: var(--color-orange);
  }
  .boundary-meter i:last-child {
    background: rgb(16 27 45 / 10%);
  }

  .retrieval-query {
    width: min(90%, 520px);
    padding: 0.62rem 0.9rem;
    border-color: rgb(201 84 43 / 22%);
    border-radius: 10px;
  }
  .retrieval-query p {
    margin: 0.25rem 0 0.45rem;
    color: var(--color-ink);
    font-size: 0.92rem;
    font-weight: 550;
  }
  .retrieval-query > span {
    color: var(--color-blue);
    font-size: 0.76rem;
    font-weight: 550;
  }
  .retrieval-results {
    display: grid;
    width: min(90%, 520px);
    gap: 0.34rem;
    margin-top: 0.45rem;
  }
  .retrieval-result {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr) 2.4rem;
    align-items: center;
    gap: 0.65rem;
    padding: 0.38rem 0.65rem;
    border-radius: 8px;
  }
  .result-selected {
    border-color: rgb(201 84 43 / 26%);
  }
  .retrieval-result > span {
    color: var(--color-muted);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }
  .retrieval-result > div {
    display: grid;
    min-width: 0;
    gap: 0.14rem;
  }
  .retrieval-result b {
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 600;
  }
  .retrieval-result small {
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .retrieval-result > strong {
    color: var(--color-ink);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .retrieval-result i {
    display: block;
    width: 100%;
    height: 3px;
    margin-top: 0.15rem;
    overflow: hidden;
    border-radius: 3px;
    background: rgb(16 27 45 / 7%);
  }
  .retrieval-result i em {
    display: block;
    width: 94%;
    height: 100%;
    border-radius: inherit;
    background: var(--color-orange);
  }
  .retrieval-result:nth-child(2) i em {
    width: 81%;
    background: var(--color-blue);
  }
  .retrieval-result:nth-child(3) i em {
    width: 72%;
    background: var(--color-blue);
  }

  .workflow-scene[data-workflow-scene='reasoning']:not([hidden]) {
    grid-template-columns: minmax(0, 0.9fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.4rem);
  }
  .reasoning-context {
    display: grid;
    justify-self: stretch;
    gap: 0.45rem;
  }
  .reasoning-context span {
    padding: 0.42rem 0.6rem;
    border-radius: 6px;
    color: var(--color-body);
    font-size: 0.74rem;
    line-height: 1.35;
  }
  .reasoning-core {
    position: relative;
    width: 156px;
    height: 156px;
  }
  .reasoning-core-orbit {
    position: absolute;
    inset: 8px 26px;
    border: 1px solid rgb(84 123 157 / 38%);
    border-radius: 50%;
    transform: rotate(32deg);
    animation: ai-orbit 14s linear infinite;
  }
  .reasoning-core-center {
    position: absolute;
    inset: 40px;
    display: grid;
    place-content: center;
    justify-items: center;
    border: 1px solid rgb(201 84 43 / 20%);
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff, #f6ece3);
    box-shadow:
      0 0 0 6px rgb(201 84 43 / 6%),
      0 12px 26px -10px rgb(16 27 45 / 22%);
  }
  .reasoning-core-center b {
    color: var(--color-ink);
    font-size: 1.36rem;
    letter-spacing: -0.08em;
  }
  .reasoning-core-center small {
    color: var(--color-orange-dark);
    font-size: 0.62rem;
    font-weight: 750;
    letter-spacing: 0.12em;
  }
  .reasoning-token {
    position: absolute;
    top: 6px;
    left: 75px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 0 3px rgb(201 84 43 / 16%);
  }
  .token-b {
    top: auto;
    bottom: 13px;
    left: auto;
    right: 4px;
    background: var(--color-blue);
    box-shadow: 0 0 0 3px rgb(84 123 157 / 16%);
  }
  .reasoning-output {
    display: grid;
    justify-self: stretch;
    gap: 0.4rem;
    padding: 0.7rem;
    border-radius: 10px;
  }
  .reasoning-output b {
    font-size: 0.82rem;
    font-weight: 600;
  }
  .reasoning-output i {
    width: 100%;
    height: 4px;
    border-radius: 4px;
    background: rgb(16 27 45 / 9%);
  }
  .reasoning-output i:nth-of-type(2) {
    width: 74%;
  }
  .reasoning-output i:nth-of-type(3) {
    width: 88%;
  }
  .reasoning-output span {
    color: var(--color-green);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .workflow-scene[data-workflow-scene='validation']:not([hidden]),
  .workflow-scene[data-workflow-scene='workflow']:not([hidden]) {
    grid-template-columns: minmax(0, 1fr) minmax(120px, 0.36fr);
    align-items: center;
    gap: clamp(0.9rem, 2.4vw, 1.6rem);
  }
  .validation-list {
    display: grid;
    width: 100%;
    max-width: 420px;
    justify-self: center;
    gap: 0.42rem;
  }
  .validation-list > div {
    display: grid;
    grid-template-columns: 1.3rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.55rem;
    padding: 0.58rem 0.75rem;
    border-radius: 8px;
  }
  .validation-list > div > span {
    color: var(--color-muted);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }
  .validation-list b {
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
  }
  .validation-list i {
    padding: 0.16rem 0.45rem;
    border-radius: 999px;
    background: rgb(90 128 108 / 10%);
    color: var(--color-green);
    font-size: 0.64rem;
    font-style: normal;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-align: center;
  }
  .validation-list > .validation-review {
    border-color: rgb(201 84 43 / 26%);
    background: linear-gradient(180deg, #fff, #fdf6f1);
  }
  .validation-review i {
    background: rgb(201 84 43 / 10%);
    color: var(--color-orange-dark);
  }
  .validation-side {
    display: grid;
    justify-items: center;
    gap: 0.38rem;
    text-align: center;
  }
  .validation-seal {
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 1px solid rgb(90 128 108 / 30%);
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 6px rgb(90 128 108 / 8%),
      0 10px 22px -10px rgb(16 27 45 / 22%);
    color: var(--color-green);
    font-size: 1.26rem;
    font-weight: 700;
  }
  .validation-side small {
    margin-top: 0.3rem;
  }
  .validation-side strong {
    font-size: 0.82rem;
  }
  .validation-side p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .workflow-ticket {
    width: 100%;
    max-width: 380px;
    justify-self: center;
    padding: 0.85rem 0.95rem;
    border-radius: 12px;
    box-shadow:
      0 1px 2px rgb(16 27 45 / 4%),
      0 14px 30px -12px rgb(16 27 45 / 18%);
    color: var(--color-ink);
  }
  .ticket-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.08em;
  }
  .ticket-state {
    color: var(--color-green);
  }
  .workflow-ticket h4 {
    margin: 0.6rem 0 0.25rem;
    font-size: 0.94rem;
    font-weight: 650;
  }
  .workflow-ticket > p {
    margin: 0;
    color: var(--color-body);
    font-size: 0.76rem;
    line-height: 1.5;
  }
  .ticket-source {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.55rem;
    color: var(--color-blue);
    font-size: 0.72rem;
  }
  .ticket-source span {
    display: grid;
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: rgb(84 123 157 / 12%);
    font-size: 0.68rem;
    font-weight: 700;
  }
  .ticket-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.6rem;
    margin-top: 0.7rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.72rem;
  }
  .ticket-actions span {
    color: var(--color-muted);
  }
  .ticket-actions b {
    color: var(--color-orange-dark);
    font-weight: 700;
  }
  .workflow-destination {
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    text-align: center;
  }
  .destination-icon {
    display: grid;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.3rem;
    place-items: center;
    border: 1px solid rgb(201 84 43 / 26%);
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 6px rgb(201 84 43 / 7%),
      0 10px 22px -10px rgb(16 27 45 / 22%);
    color: var(--color-orange-dark);
    font-size: 1.26rem;
  }
  .workflow-destination strong {
    font-size: 0.82rem;
  }
  .workflow-destination > span {
    max-width: 130px;
    color: var(--color-muted);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .workflow-details {
    padding: 1.1rem 1.45rem 0.95rem;
  }
  .workflow-panel {
    animation: ai-panel-in 300ms var(--ease-out) both;
  }
  .workflow-panel[hidden] {
    display: none;
  }
  .workflow-panel-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .workflow-panel-title > span {
    flex: none;
    color: var(--color-orange-dark);
    font-size: 0.72rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  .workflow-panel h3 {
    margin: 0;
    font-size: 1.26rem;
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .workflow-description {
    max-width: 720px;
    margin: 0.5rem 0 0.8rem;
    color: var(--color-body);
    font-size: 0.9rem;
    line-height: 1.62;
  }
  .workflow-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 1.3rem;
  }
  .workflow-detail-grid small {
    color: var(--color-muted);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  .workflow-detail-grid ul {
    display: grid;
    gap: 0.36rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  .workflow-detail-grid li {
    position: relative;
    padding-left: 0.9rem;
    color: var(--color-ink);
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .workflow-detail-grid li::before {
    position: absolute;
    top: 0.46rem;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-orange-dark);
    content: '';
  }
  .workflow-output {
    padding: 0.55rem 0.8rem;
    border: 1px solid rgb(201 84 43 / 16%);
    border-radius: 10px;
    background: linear-gradient(180deg, #fffdfa, #fbf5ef);
  }
  .workflow-output p {
    margin: 0.28rem 0 0;
    color: var(--color-ink);
    font-size: 0.82rem;
    font-weight: 550;
    line-height: 1.4;
  }
  .workflow-progress {
    display: grid;
    grid-template-columns: auto minmax(60px, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.85rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  .workflow-progress > span:last-child {
    color: var(--color-orange-dark);
    font-variant-numeric: tabular-nums;
  }
  .workflow-progress-track {
    height: 4px;
    overflow: hidden;
    border-radius: 4px;
    background: rgb(16 27 45 / 8%);
  }
  .workflow-progress-track i {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--color-orange),
      var(--color-orange-dark)
    );
    transform: scaleX(0.2);
    transform-origin: left;
    transition: transform 350ms var(--ease-out);
  }

  .ai-applications {
    background: #f0ede8;
  }
  .application-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid #dcd8d1;
    border-left: 1px solid #dcd8d1;
  }
  .application-item {
    min-height: 235px;
    padding: 1.2rem 1.25rem 1.1rem;
    border-right: 1px solid #dcd8d1;
    border-bottom: 1px solid #dcd8d1;
    background: rgb(255 255 255 / 22%);
    transition: background 220ms ease;
  }
  .application-item:hover {
    background: rgb(255 255 255 / 62%);
  }
  .application-topline {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
    color: var(--color-orange-dark);
    font-size: 0.55rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  .application-index {
    color: #ada59c;
  }
  .application-item h3 {
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.035em;
  }
  .application-item > p {
    margin-bottom: 0.85rem;
    color: var(--color-body);
    font-size: 0.75rem;
    line-height: 1.56;
  }
  .application-value {
    padding-top: 0.65rem;
    border-top: 1px solid rgb(16 27 45 / 10%);
  }
  .application-value span {
    color: var(--color-muted);
    font-size: 0.5rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }
  .application-value p {
    margin: 0.2rem 0 0;
    color: var(--color-ink);
    font-size: 0.67rem;
    line-height: 1.5;
  }

  .ai-enterprise {
    background: #fbfaf8;
  }
  .enterprise-layout {
    display: grid;
