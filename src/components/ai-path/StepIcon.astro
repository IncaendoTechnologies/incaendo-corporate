      </filter>
    </defs>
    {/* Dynamically Surging Metric Growth Bars */}
    <g filter="url(#bars-3d-shadow)" class="metric-bars-group">
      <g class="metric-bar-item bar-1">
        <rect
          x="13"
          y="39"
          width="7"
          height="15"
          rx="2"
          fill="url(#bar-3d-grad)"
        />
        <line
          x1="15"
          y1="41"
          x2="15"
          y2="52"
          stroke="#ff8c70"
          stroke-width="1.2"
          stroke-linecap="round"
          opacity="0.6"
        />
      </g>
      <g class="metric-bar-item bar-2">
        <rect
          x="23"
