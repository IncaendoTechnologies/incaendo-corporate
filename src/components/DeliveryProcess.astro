  .delivery-node-card,
  .delivery-screen,
  .delivery-blueprint-panel,
  .delivery-code-panel,
  .delivery-api-card,
  .delivery-product-panel,
  .delivery-qa-panel,
  .delivery-release-card,
  .delivery-monitor-card,
  .delivery-feedback-card {
    fill: rgb(255 255 255 / 90%);
    stroke: rgb(16 27 45 / 10%);
    stroke-width: 1;
  }

  .delivery-node-card,
  .delivery-screen,
  .delivery-code-panel,
  .delivery-api-card,
  .delivery-release-card,
  .delivery-monitor-card,
  .delivery-feedback-card {
    filter: drop-shadow(0 5px 9px rgb(16 27 45 / 6%));
  }

  .delivery-node-line,
  .delivery-blueprint-line,
  .delivery-release-line {
    stroke: rgb(84 123 157 / 33%);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .delivery-node-dot,
  .delivery-screen-dot,
  .delivery-window-dot {
    fill: var(--color-blue);
  }

  .delivery-dot-blue {
    fill: var(--color-blue);
  }

  .delivery-dot-orange,
  .delivery-window-dot-orange {
    fill: var(--color-orange-dark);
  }

  .delivery-svg-label {
