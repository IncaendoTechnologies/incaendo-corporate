          />
          <circle
            class="ai-node-core"
            r="3.5"
            fill="#e04c24"
            stroke="#ffffff"
            stroke-width="1.5"
          />
        </g>
        <g id="ai-node-2" class="ai-fiber-node" filter="url(#ai-node-glow)">
