    height: 1.75rem;
    flex: 0 0 auto;
    margin-left: auto;
    background: var(--delivery-line);
  }

  .delivery-collaboration-note {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  /* Delivery stage diagrams */
  .dp-card,
  .dp-architecture,
  .dp-qa-dashboard,
  .dp-score-panel,
  .dp-monitor-panel,
  .dp-production-card,
  .dp-product-card,
