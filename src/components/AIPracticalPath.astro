---
import StepIcon from './ai-path/StepIcon.astro'

const workflowSteps = [
  {
    id: 'understand',
    number: '01',
    title: 'Understand the business',
    detail: 'Start with the challenge and the outcome that matters.',
  },
  {
    id: 'prepare',
    number: '02',
    title: 'Prepare the inputs',
    detail: 'Bring relevant information together and check its quality.',
  },
  {
    id: 'design',
    number: '03',
    title: 'Design the AI solution',
    detail: 'Choose an agent, model, or automation approach for the need.',
  },
  {
    id: 'connect',
    number: '04',
    title: 'Connect the workflow',
    detail: 'Fit the solution into the tools and decisions people already use.',
  },
  {
    id: 'improve',
    number: '05',
    title: 'Measure and improve',
    detail: 'Review quality and outcomes, then decide what to refine.',
  },
]
---

<section
  class="ai-path"
  aria-labelledby="ai-practical-path-title"
  data-ai-experience
>
  <div class="ai-workflow ai-reveal" id="ai-practical-path">
    <div class="site-container">
      <div class="ai-workflow-heading ai-workflow-heading-centered">
        <div class="ai-workflow-title-wrap">
          <p class="eyebrow">5-STEP IMPLEMENTATION ROADMAP</p>
          <h2 id="ai-practical-path-title">
            From Strategic Business Needs{' '}
            <br class="ai-workflow-heading-break" />
            to Measurable{' '}
            <span>
              <span class="ai-nowrap">AI-Powered</span> Outcomes.
            </span>
          </h2>
        </div>
      </div>

      <!-- Five Connected Animated SVG Cards -->
      <div
        class="ai-practical-overview"
        aria-label="Five practical steps from need to outcome"
      >
        <!-- Interactive hint for client engagement -->
        <div class="ai-cards-hint-wrap" aria-hidden="true">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 15l6 6m-6-6v4.5m0-4.5h4.5M3 12a9 9 0 1 1 18 0 9 9 0 0 1-18 0z"></path>
          </svg>
          <span>Click any step to inspect its live architecture below</span>
        </div>

        <div class="ai-overview-row">
          <!-- Card 1: Understand the Need -->
          <article
            class="ai-overview-card is-active"
            style="--card-i: 0;"
            data-target-step="understand"
            tabindex="0"
            role="button"
            aria-label="Step 01: Understand the Need"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="understand" />
            </div>
            <h3 class="ai-overview-card-title">Understand the Need</h3>
          </article>

          <!-- Connector 1 -->
          <div class="ai-overview-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-node">
              <span class="ai-bridge-dot"></span>
            </span>
          </div>

          <!-- Card 2: Gather the Right Information -->
          <article
            class="ai-overview-card"
            style="--card-i: 1;"
            data-target-step="prepare"
            tabindex="0"
            role="button"
            aria-label="Step 02: Gather the Right Information"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="prepare" />
            </div>
            <h3 class="ai-overview-card-title">Gather the Right Information</h3>
          </article>

          <!-- Connector 2 -->
          <div class="ai-overview-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-node">
              <span class="ai-bridge-dot"></span>
            </span>
          </div>

          <!-- Card 3: Choose the Right AI Solution -->
          <article
            class="ai-overview-card"
            style="--card-i: 2;"
            data-target-step="design"
            tabindex="0"
            role="button"
            aria-label="Step 03: Choose the Right AI Solution"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="design" />
            </div>
            <h3 class="ai-overview-card-title">Choose the Right AI Solution</h3>
          </article>

          <!-- Connector 3 -->
          <div class="ai-overview-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-node">
              <span class="ai-bridge-dot"></span>
            </span>
          </div>

          <!-- Card 4: Connect Your Workflow -->
          <article
            class="ai-overview-card"
            style="--card-i: 3;"
            data-target-step="connect"
            tabindex="0"
            role="button"
            aria-label="Step 04: Connect Your Workflow"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="connect" />
            </div>
            <h3 class="ai-overview-card-title">Connect Your Workflow</h3>
          </article>

          <!-- Connector 4 -->
          <div class="ai-overview-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-node">
              <span class="ai-bridge-dot"></span>
            </span>
          </div>

          <!-- Card 5: Improve with Results -->
          <article
            class="ai-overview-card"
            style="--card-i: 4;"
            data-target-step="improve"
            tabindex="0"
            role="button"
            aria-label="Step 05: Improve with Results"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="improve" />
            </div>
            <h3 class="ai-overview-card-title">Improve with Results</h3>
          </article>
        </div>
      </div>

      <div class="ai-workflow-layout" data-active-step="understand">
        <!-- Visually hidden radio inputs to preserve state management across steps -->
        <div class="ai-workflow-hidden-inputs" aria-hidden="true">
          {workflowSteps.map((step, index) => (
            <input
              id={`workflow-${step.id}`}
              type="radio"
              name="ai-workflow-step"
              value={step.id}
              checked={index === 0}
              tabindex="-1"
            />
          ))}
        </div>

        <div class="ai-workflow-demo" data-workflow-demo>
          <div class="ai-demo-topline">
            <span class="ai-demo-label">
              <i aria-hidden="true"></i> ILLUSTRATIVE ARCHITECTURE
            </span>
            <span class="ai-demo-nav">
              <button
                type="button"
                class="ai-demo-arrow"
                aria-label="Previous step"
                data-step-prev
              >
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M10 3 5 8l5 5"></path>
                </svg>
              </button>
              <span class="ai-demo-count" aria-live="polite" data-step-count>
                01 <b>/</b> 05
              </span>
              <button
                type="button"
                class="ai-demo-arrow"
                aria-label="Next step"
                data-step-next
              >
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="m6 3 5 5-5 5"></path>
                </svg>
              </button>
            </span>
          </div>
          <div class="ai-demo-progress" aria-hidden="true">
            <span data-step-progress></span>
          </div>
          <p class="ai-demo-swipe-hint" aria-hidden="true">
            <span>←</span> Swipe or drag to change step <span>→</span>
          </p>

          <div class="ai-state-stage" aria-live="polite" aria-atomic="true">
            <article
              class="ai-state-card is-active"
              data-flow-state="understand"
            >
              <header class="ai-state-head">
                <span class="ai-state-kicker">
                  01 · UNDERSTAND THE BUSINESS
                </span>
                <h4>Interpret the Request, then Define What Success Means.</h4>
                <p>
                  LLM-based analysis connects business requests with goals,
                  context, and constraints, helping teams identify the right
                  solution and focus on meaningful outcomes.
                </p>
              </header>
              <div class="dg dg-flow dg-understand">
                <div class="dg-node" style="--i: 0">
                  <span class="dg-tag">USER INPUT</span>
                  <b class="dg-title">Business request</b>
                  <p class="dg-quote">
                    “Customers keep asking if they can change a delivery
                    address. Can AI help our support team?”
                  </p>
                </div>
                <span class="dg-link" style="--d: 0s" aria-hidden="true">
                  <i></i>
                </span>
                <div class="dg-node dg-node--core" style="--i: 1">
                  <span class="dg-tag">LLM-BASED ANALYSIS</span>
                  <b class="dg-title">Interpret the need</b>
                  <ul class="dg-chips dg-chips--scan">
                    <li>User intent</li>
                    <li>Context extraction</li>
                    <li>Constraint check</li>
                  </ul>
                </div>
                <span class="dg-link" style="--d: 1.1s" aria-hidden="true">
                  <i></i>
                </span>
                <div class="dg-node dg-node--active" style="--i: 2">
                  <span class="dg-tag">SOLUTION REQUIREMENTS</span>
                  <dl class="dg-spec">
                    <div>
                      <dt>Goal</dt>
                      <dd>Faster, consistent answers</dd>
                    </div>
                    <div>
                      <dt>Context</dt>
                      <dd>Order status, delivery policy</dd>
                    </div>
                    <div>
                      <dt>Limits</dt>
                      <dd>Approved sources only</dd>
                    </div>
                    <div>
                      <dt>Outcome</dt>
                      <dd>Exceptions go to a person</dd>
                    </div>
                  </dl>
                </div>
              </div>
            </article>

            <article class="ai-state-card" data-flow-state="prepare">
              <header class="ai-state-head">
                <span class="ai-state-kicker">02 · PREPARE THE INPUTS</span>
                <h4>
                  Turn Raw Business Information into Searchable Knowledge.
                </h4>
                <p>
                  Data processing and retrieval organize relevant business
                  information, helping AI deliver more useful responses and
                  reducing time spent searching across scattered sources.
                </p>
              </header>
              <div class="dg dg-flow dg-prepare">
                <div class="dg-node" style="--i: 0">
                  <span class="dg-tag">RAW SOURCES</span>
                  <ul class="dg-files">
                    <li>
                      <i>PDF</i> Delivery policy
                    </li>
                    <li>
                      <i class="is-blue">DOC</i> Help articles
                    </li>
                    <li>
                      <i class="is-sand">CSV</i> Support tickets
                    </li>
                  </ul>
                </div>
                <span class="dg-link" style="--d: 0s" aria-hidden="true">
                  <i></i>
                </span>
                <div class="dg-node dg-node--active" style="--i: 1">
                  <span class="dg-tag">DATA PREPROCESSING</span>
                  <ol class="dg-stages">
                    <li>Clean &amp; de-duplicate</li>
                    <li>Validate, remove sensitive data</li>
                    <li>Chunk into passages</li>
                  </ol>
                  <span class="dg-chunks" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                  </span>
                </div>
                <span class="dg-link" style="--d: 0.7s" aria-hidden="true">
                  <i></i>
                </span>
                <div class="dg-node dg-node--tech" style="--i: 2">
                  <span class="dg-tag">EMBEDDINGS</span>
                  <b class="dg-title">Text → vectors</b>
                  <span class="dg-vectors" aria-hidden="true">
                    <code>[0.12, −0.48, …]</code>
                    <code>[0.67, 0.05, …]</code>
                    <code>[−0.21, 0.74, …]</code>
                  </span>
                  <p class="dg-text">Captures meaning, not just keywords.</p>
                </div>
                <span class="dg-link" style="--d: 1.4s" aria-hidden="true">
                  <i></i>
                </span>
                <div class="dg-node dg-node--tech" style="--i: 3">
                  <span class="dg-tag">VECTOR DATABASE</span>
                  <svg class="dg-db" viewBox="0 0 40 40" aria-hidden="true">
                    <ellipse cx="20" cy="9" rx="13" ry="4.5" />
                    <path d="M7 9v22c0 2.5 5.8 4.5 13 4.5s13-2 13-4.5V9M7 16.5c0 2.5 5.8 4.5 13 4.5s13-2 13-4.5M7 24c0 2.5 5.8 4.5 13 4.5s13-2 13-4.5" />
                  </svg>
                  <p class="dg-text">Indexed passages, ready for retrieval.</p>
                </div>
              </div>
            </article>

            <article class="ai-state-card" data-flow-state="design">
              <header class="ai-state-head">
                <span class="ai-state-kicker">03 · DESIGN THE AI SOLUTION</span>
                <h4>Retrieve the Right Context, Generate, then Check It.</h4>
                <p>
                  LLMs and RAG can deliver more relevant, context-aware
                  responses, helping businesses improve customer decisions and
                  uncover opportunities for sales growth.
                </p>
              </header>
              <div class="dg dg-flow dg-design">
                <div class="dg-node dg-a-query" style="--i: 0">
                  <span class="dg-tag">USER QUERY</span>
                  <p class="dg-quote">“Can I change my delivery address?”</p>
                </div>
                <span
                  class="dg-link dg-a-l1"
                  style="--d: 0s"
                  aria-hidden="true"
                >
                  <i></i>
                </span>
                <div class="dg-node dg-node--tech dg-a-retrieve" style="--i: 1">
                  <span class="dg-tag">RETRIEVAL · RAG</span>
                  <b class="dg-title">Search approved knowledge</b>
                  <p class="dg-text">Finds passages related to the query.</p>
                </div>
                <span
                  class="dg-link dg-a-l2"
                  style="--d: 0.5s"
                  aria-hidden="true"
                >
                  <i></i>
                </span>
                <div class="dg-node dg-node--tech dg-a-vector" style="--i: 2">
                  <span class="dg-tag">VECTOR DATABASE</span>
                  <ul class="dg-matches">
                    <li>
                      <span>Delivery policy §2</span>
                      <i style="--w: 92%"></i>
                    </li>
                    <li>
                      <span>Address change FAQ</span>
                      <i style="--w: 74%"></i>
                    </li>
                    <li>
                      <span>Shipping times</span>
                      <i style="--w: 38%"></i>
                    </li>
                  </ul>
                </div>
                <span
                  class="dg-link is-down dg-a-l3"
                  style="--d: 1s"
                  aria-hidden="true"
                >
                  <i></i>
                </span>
                <div class="dg-node dg-a-prompt" style="--i: 3">
                  <span class="dg-tag">PROMPT + CONTEXT</span>
                  <ul class="dg-chips dg-chips--blocks">
                    <li>Instructions</li>
                    <li>User query</li>
                    <li class="is-accent">Retrieved passages</li>
                  </ul>
                </div>
                <span
                  class="dg-link is-left dg-a-l4"
                  style="--d: 1.5s"
                  aria-hidden="true"
                >
                  <i></i>
                </span>
                <div class="dg-node dg-node--core dg-a-llm" style="--i: 4">
                  <span class="dg-tag">LLM</span>
                  <b class="dg-title">Generate a grounded response</b>
                  <p class="dg-text">
                    Drafts an answer that cites the policy
                    <span class="dg-typing" aria-hidden="true">
                      <i></i>
                      <i></i>
                      <i></i>
                    </span>
                  </p>
                </div>
                <span
                  class="dg-link is-left dg-a-l5"
                  style="--d: 2s"
                  aria-hidden="true"
                >
                  <i></i>
                </span>
                <div class="dg-node dg-node--active dg-a-eval" style="--i: 5">
                  <span class="dg-tag">EVALUATION</span>
                  <ul class="dg-checks">
                    <li>Grounded in sources</li>
                    <li>Follows policy</li>
                    <li class="is-flag">Unsure? Route to a person</li>
                  </ul>
                </div>
              </div>
            </article>

            <article class="ai-state-card" data-flow-state="connect">
              <header class="ai-state-head">
                <span class="ai-state-kicker">04 · CONNECT THE WORKFLOW</span>
                <h4>Plug AI into the Systems Your Team Already Uses.</h4>
                <p>
                  APIs and AI agents automate connected workflows, helping teams
                  reduce repetitive effort, manage operating costs, and use
                  resources more efficiently.
                </p>
              </header>
              <div class="dg dg-flow dg-connect">
                <div class="dg-node" style="--i: 0">
                  <span class="dg-tag">BUSINESS APP · CRM</span>
                  <b class="dg-title">Support ticket</b>
                  <p class="dg-text">New request arrives.</p>
                  <span class="dg-result">✓ Reply &amp; case note saved</span>
                </div>
                <span class="dg-duplex" aria-hidden="true">
                  <span class="dg-link" style="--d: 0s">
                    <i></i>
                    <em>request</em>
                  </span>
                  <span class="dg-link is-left" style="--d: 2.2s">
                    <i></i>
                    <em>update</em>
                  </span>
                </span>
                <div class="dg-node dg-node--tech" style="--i: 1">
                  <span class="dg-tag">API + ORCHESTRATION</span>
                  <b class="dg-title">Integration layer</b>
                  <p class="dg-text">
                    Permissions, routing, and each workflow step.
                  </p>
                  <span class="dg-approval">Human approval</span>
                </div>
                <span class="dg-duplex" aria-hidden="true">
                  <span class="dg-link" style="--d: 0.55s">
                    <i></i>
                    <em>task</em>
                  </span>
                  <span class="dg-link is-left" style="--d: 1.65s">
                    <i></i>
                    <em>draft</em>
                  </span>
                </span>
                <div class="dg-node dg-node--core" style="--i: 2">
                  <span class="dg-tag">AI AGENT · LLM SERVICE</span>
                  <b class="dg-title">Plans the next action</b>
                  <p class="dg-text">Chooses which tools to call.</p>
                </div>
                <span class="dg-duplex" aria-hidden="true">
                  <span class="dg-link" style="--d: 1.1s">
                    <i></i>
                    <em>call</em>
                  </span>
                  <span class="dg-link is-left" style="--d: 1.35s">
                    <i></i>
                    <em>data</em>
                  </span>
                </span>
                <div class="dg-node" style="--i: 3">
                  <span class="dg-tag">TOOLS</span>
                  <ul class="dg-files dg-tools">
                    <li>
                      <i class="is-blue">⌗</i> Order system
                    </li>
                    <li>
                      <i class="is-blue">?</i> Knowledge base
                    </li>
                    <li>
                      <i class="is-blue">@</i> Email
                    </li>
                  </ul>
                </div>
              </div>
            </article>

            <article class="ai-state-card" data-flow-state="improve">
              <header class="ai-state-head">
                <span class="ai-state-kicker">05 · MEASURE &amp; IMPROVE</span>
                <h4>Check Quality, Watch the Signals, and Keep Refining.</h4>
                <p>
                  Monitoring business outcomes helps identify efficiency gains,
                  cost-saving opportunities, and ways to improve profitability
                  and sustainable revenue growth.
                </p>
              </header>
              <div class="dg dg-improve">
                <div class="dg-loop">
                  <div class="dg-node dg-node--active dg-a-eval" style="--i: 0">
                    <span class="dg-tag">EVALUATION</span>
                    <b class="dg-title">Quality checks</b>
                    <p class="dg-text">
                      Review sampled responses against sources.
                    </p>
                  </div>
                  <span
                    class="dg-link dg-a-l1"
                    style="--d: 0s"
                    aria-hidden="true"
                  >
                    <i></i>
                  </span>
                  <div
                    class="dg-node dg-node--tech dg-a-monitor"
                    style="--i: 1"
                  >
                    <span class="dg-tag">MONITORING</span>
                    <b class="dg-title">Reliability signals</b>
                    <p class="dg-text">Errors, escalations, response times.</p>
                  </div>
                  <span
                    class="dg-link is-down dg-a-l2"
                    style="--d: 0.55s"
                    aria-hidden="true"
                  >
                    <i></i>
                  </span>
                  <span class="dg-loop-hub" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <path d="M19.5 12a7.5 7.5 0 0 1-12.8 5.3M4.5 12a7.5 7.5 0 0 1 12.8-5.3" />
                      <path d="M17.5 3.5v3.3h-3.3M6.5 20.5v-3.3h3.3" />
                    </svg>
                  </span>
                  <div class="dg-node dg-a-feedback" style="--i: 2">
                    <span class="dg-tag">FEEDBACK</span>
                    <b class="dg-title">People’s input</b>
                    <p class="dg-text">Team ratings and user corrections.</p>
                  </div>
                  <span
                    class="dg-link is-left dg-a-l3"
                    style="--d: 1.1s"
                    aria-hidden="true"
                  >
                    <i></i>
                  </span>
                  <div
                    class="dg-node dg-node--core dg-a-iterate"
                    style="--i: 3"
                  >
                    <span class="dg-tag">ITERATE</span>
                    <b class="dg-title">Refine &amp; redeploy</b>
                    <p class="dg-text">Update prompts, data, or workflow.</p>
                  </div>
                  <span
                    class="dg-link is-up dg-a-l4"
                    style="--d: 1.65s"
                    aria-hidden="true"
                  >
                    <i></i>
                  </span>
                </div>
                <div class="dg-node dg-signals" style="--i: 4">
                  <div class="dg-signals-head">
                    <span class="dg-tag">SIGNALS TO REVIEW</span>
                    <small>Illustrative</small>
                  </div>
                  <ul>
                    <li>
                      <span>Response quality</span>
                      <em class="is-good">On track</em>
                    </li>
                    <li>
                      <span>Source grounding</span>
                      <em class="is-check">Check samples</em>
                    </li>
                    <li>
                      <span>Escalation themes</span>
                      <em class="is-watch">New pattern</em>
                    </li>
                    <li>
                      <span>Team feedback</span>
                      <em class="is-good">Collected</em>
                    </li>
                  </ul>
                  <p class="dg-text">Qualitative indicators, not live data.</p>
                </div>
              </div>
            </article>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/home-ai-experience.js'

  function setupPracticalCardSync() {
    const cards = Array.from(
      document.querySelectorAll('.ai-overview-card[data-target-step]'),
    ).filter((el) => el instanceof HTMLElement)
    if (!cards.length) return

    const updateActiveCard = (activeId) => {
      if (!activeId) return
      cards.forEach((card) => {
        if (card instanceof HTMLElement) {
          const isMatch = card.getAttribute('data-target-step') === activeId
          card.classList.toggle('is-active', isMatch)
          card.setAttribute('aria-pressed', isMatch ? 'true' : 'false')
        }
      })
    }

    const scrollToFitSection = () => {
      const cardsWrap = document.querySelector('.ai-practical-overview')
      const demoCard = document.querySelector('.ai-workflow-demo')
      if (
        !(cardsWrap instanceof HTMLElement) ||
        !(demoCard instanceof HTMLElement)
      )
        return

      const cardsRect = cardsWrap.getBoundingClientRect()
      const demoRect = demoCard.getBoundingClientRect()
      const vh = window.innerHeight

      // Check if both cards and demo are already comfortably framed
      const isCardsTopVisible = cardsRect.top >= 5 && cardsRect.top <= 80
      const isDemoBottomVisible =
        demoRect.bottom <= vh - 10 && demoRect.bottom >= vh * 0.6
      if (isCardsTopVisible && isDemoBottomVisible) {
        return
      }

      // Frame the interactive cards and the full visual layout together
      const blockTop = cardsRect.top + window.scrollY
      const blockBottom = demoRect.bottom + window.scrollY
      const blockHeight = blockBottom - blockTop

      let targetScrollY
      if (blockHeight <= vh - 20) {
        // Position cards near the top with a subtle margin so the entire visual demo card fits fully below
        const topGap = Math.min(20, Math.max(10, (vh - blockHeight) * 0.2))
        targetScrollY = blockTop - topGap
      } else if (window.matchMedia('(max-width: 640px)').matches) {
        // Phones: bring the top of the architecture panel into view so the
        // change the visitor just asked for is what they see.
        targetScrollY = demoRect.top + window.scrollY - 12
      } else {
        // If vertical viewport is tighter, ensure the bottom of the visual demo card is fully visible
        targetScrollY = blockBottom - vh + 16
      }

      window.scrollTo({
        top: Math.max(0, Math.round(targetScrollY)),
        behavior: 'smooth',
      })
    }

    cards.forEach((card) => {
      if (card instanceof HTMLElement) {
        const activate = () => {
          const stepId = card.getAttribute('data-target-step')
          if (!stepId) return
          const input = document.getElementById(`workflow-${stepId}`)
          if (input instanceof HTMLInputElement && !input.checked) {
            input.checked = true
            input.dispatchEvent(new Event('change', { bubbles: true }))
          }
          updateActiveCard(stepId)
          scrollToFitSection()
        }
        card.addEventListener('click', activate)
        card.addEventListener('keydown', (e) => {
          if (e instanceof KeyboardEvent) {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault()
              activate()
            }
          }
        })
      }
    })

    const radios = Array.from(
      document.querySelectorAll('input[name="ai-workflow-step"]'),
    ).filter((el) => el instanceof HTMLInputElement)
    radios.forEach((radio) => {
      radio.addEventListener('change', (e) => {
        if (e.target instanceof HTMLInputElement && e.target.checked) {
          updateActiveCard(e.target.value)
        }
      })
    })

    const checked = document.querySelector(
      'input[name="ai-workflow-step"]:checked',
    )
    if (checked instanceof HTMLInputElement) {
      updateActiveCard(checked.value)
    }
  }

  // Swipe (touch) or drag (mouse) the architecture panel sideways, or use
  // the arrow buttons, to move to the previous or next step without
  // scrolling back up to the step list.
  function setupWorkflowSwipe() {
    const demo = document.querySelector('[data-workflow-demo]')
    if (!(demo instanceof HTMLElement) || demo.dataset.swipeReady) return
    demo.dataset.swipeReady = 'true'
    const stage = demo.querySelector('.ai-state-stage')
    const radios = Array.from(
      document.querySelectorAll('input[name="ai-workflow-step"]'),
    ).filter((el) => el instanceof HTMLInputElement)
    const prevButton = demo.querySelector('[data-step-prev]')
    const nextButton = demo.querySelector('[data-step-next]')
    if (!(stage instanceof HTMLElement) || !radios.length) return

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const currentIndex = () =>
      Math.max(
        0,
        radios.findIndex((r) => r.checked),
      )
    const activeCard = () => stage.querySelector('.ai-state-card.is-active')

    const updateArrows = () => {
      const index = currentIndex()
      if (prevButton instanceof HTMLButtonElement)
        prevButton.disabled = index === 0
      if (nextButton instanceof HTMLButtonElement)
        nextButton.disabled = index === radios.length - 1
    }

    // direction: 1 = next, -1 = previous
    const goTo = (index, direction) => {
      const radio = radios[index]
      if (!radio || radio.checked) return false
      radio.checked = true
      radio.dispatchEvent(new Event('change', { bubbles: true }))
      const card = activeCard()
      if (card instanceof HTMLElement && !reducedMotion.matches) {
        card.animate(
          [
            { opacity: 0, translate: `${direction * 48}px 0` },
            { opacity: 1, translate: '0 0' },
          ],
          { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
        )
      }
      return true
    }

    prevButton?.addEventListener('click', () => goTo(currentIndex() - 1, -1))
    nextButton?.addEventListener('click', () => goTo(currentIndex() + 1, 1))
    radios.forEach((radio) => radio.addEventListener('change', updateArrows))
    updateArrows()

    let pointerId: number | null = null
    let startX = 0
    let startY = 0
    let startTime = 0
    let dragging = false
    let suppressClick = false

    const setOffset = (px) => {
      const card = activeCard()
      if (!(card instanceof HTMLElement)) return
      card.style.translate = px ? `${px}px 0` : ''
      card.style.opacity = px
        ? String(Math.max(0.35, 1 - Math.abs(px) / 400))
        : ''
    }

    demo.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return
      if (event.target instanceof Element && event.target.closest('button'))
        return
      pointerId = event.pointerId
      startX = event.clientX
      startY = event.clientY
      startTime = event.timeStamp
      dragging = false
    })

    demo.addEventListener('pointermove', (event) => {
      if (event.pointerId !== pointerId) return
      const dx = event.clientX - startX
      const dy = event.clientY - startY
      if (!dragging) {
        if (Math.abs(dy) > 8 && Math.abs(dy) > Math.abs(dx)) {
          pointerId = null // vertical: let the page scroll
          return
        }
        if (Math.abs(dx) < 8) return
        dragging = true
        demo.setPointerCapture(event.pointerId)
        demo.classList.add('is-swiping')
      }
      // Resist at the first and last step.
      const index = currentIndex()
      const atEdge =
        (dx > 0 && index === 0) || (dx < 0 && index === radios.length - 1)
      setOffset(atEdge ? dx * 0.25 : dx * 0.6)
    })

    const endSwipe = (event) => {
      if (event.pointerId !== pointerId) return
      pointerId = null
      if (!dragging) return
      dragging = false
      suppressClick = true
      demo.classList.remove('is-swiping')
      const dx = event.clientX - startX
      const fast = Math.abs(dx) / Math.max(event.timeStamp - startTime, 1) > 0.5
      const card = activeCard()
      const offset = card instanceof HTMLElement ? card.style.translate : ''
      setOffset(0)
      const direction = dx < 0 ? 1 : -1
      const changed =
        (Math.abs(dx) > 60 || (fast && Math.abs(dx) > 25)) &&
        goTo(currentIndex() + direction, direction)
      // Not enough to change step: ease the card back into place.
      if (
        !changed &&
        offset &&
        card instanceof HTMLElement &&
        !reducedMotion.matches
      ) {
        card.animate([{ translate: offset }, { translate: '0 0' }], {
          duration: 260,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        })
      }
    }
    demo.addEventListener('pointerup', endSwipe)
    demo.addEventListener('pointercancel', endSwipe)
    demo.addEventListener(
      'click',
      (event) => {
        if (!suppressClick) return
        suppressClick = false
        event.preventDefault()
        event.stopPropagation()
      },
      true,
    )
    demo.addEventListener('dragstart', (event) => event.preventDefault())

    // Trackpad: a sideways two-finger swipe (or Shift + wheel) changes the
    // step once per gesture. Vertical wheel still scrolls the page.
    let wheelTotal = 0
    let wheelLocked = false
    let wheelTimer = 0
    demo.addEventListener(
      'wheel',
      (event) => {
        const dx = event.shiftKey && !event.deltaX ? event.deltaY : event.deltaX
        if (Math.abs(dx) <= Math.abs(event.shiftKey ? 0 : event.deltaY)) return
        event.preventDefault()
        clearTimeout(wheelTimer)
        // The gesture ends after a short pause; then another one can count.
        wheelTimer = window.setTimeout(() => {
          wheelTotal = 0
          wheelLocked = false
        }, 180)
        if (wheelLocked) return
        wheelTotal += dx
        if (Math.abs(wheelTotal) > 60) {
          const direction = wheelTotal > 0 ? 1 : -1
          goTo(currentIndex() + direction, direction)
          wheelLocked = true
        }
      },
      { passive: false },
    )
  }

  setupPracticalCardSync()
  setupWorkflowSwipe()
  document.addEventListener('astro:page-load', () => {
    setupPracticalCardSync()
    setupWorkflowSwipe()
  })
</script>

