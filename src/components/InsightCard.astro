---
import InsightArtwork from './InsightArtwork.astro'
import { Image } from 'astro:assets'

const { article, variant = 'standard', thumbnail } = Astro.props
const image = thumbnail ?? article.image?.src
const categoryKey = article.category
  .toLocaleLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')
---

<article
  class:list={['insight-card', `insight-card-${variant}`]}
  data-insight-card
  data-insight-category={categoryKey}
  data-reveal-item={variant !== 'hero' ? '' : undefined}
>
  <a
    class="insight-card-art-link"
    href={`/insights/${article.slug}/`}
    aria-label={`Read article: ${article.title}`}
  >
    {image ? (
      <Image
        class="insight-photo"
        src={image}
        alt=""
        widths={[480, 800, 1200]}
        sizes={
          variant === 'lead'
            ? '(max-width: 700px) 100vw, 640px'
            : '(max-width: 600px) 100vw, (max-width: 1050px) 50vw, 400px'
        }
        loading="lazy"
        decoding="async"
      />
    ) : (
      <InsightArtwork
        variant={article.variant}
        title={`Illustration for ${article.title}`}
        prefix={article.slug}
      />
    )}
    {variant === 'hero' && (
      <span class="insight-featured-stamp">EDITORIAL DRAFT</span>
    )}
  </a>
  <div class="insight-card-content">
    <div class="insight-card-kicker">
      <span>{article.category}</span>
      {variant === 'hero' && (
        <span class="insight-card-index">FIELD NOTE / 001</span>
      )}
    </div>
    <h2>
      <a href={`/insights/${article.slug}/`}>{article.title}</a>
    </h2>
    <p class="insight-card-excerpt">{article.excerpt}</p>
    <div class="insight-card-footer">
      <p>
        Draft · date to be confirmed <span aria-hidden="true">·</span> Estimated{' '}
        {article.readMinutes} min read
      </p>
      <a class="insight-read-link" href={`/insights/${article.slug}/`}>
        Read article <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</article>

<style>
  .insight-card {
    display: flex;
    height: 100%;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-medium);
    background: linear-gradient(145deg, #fff 0%, #fbf9f6 100%);
    transition:
      transform 280ms var(--ease-out),
      border-color 280ms ease,
      box-shadow 280ms ease;
  }

  .insight-card:hover {
    transform: translateY(-4px);
    border-color: rgb(168 65 33 / 32%);
    box-shadow: 0 18px 42px rgb(16 27 45 / 9%);
  }

  .insight-card[hidden] {
    display: none !important;
  }

  .insight-card-art-link {
    position: relative;
    display: block;
    flex: 0 0 auto;
    overflow: hidden;
    aspect-ratio: 18 / 11;
    background: #edf1f2;
    color: inherit;
  }

  .insight-card-art-link > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .insight-card-art-link :global(.insight-art) {
    transition: transform 450ms var(--ease-out);
  }

  .insight-card:hover .insight-card-art-link :global(.insight-art) {
    transform: scale(1.025);
  }

  .insight-card:hover .insight-card-art-link > :global(img) {
    transform: scale(1.025);
  }

  .insight-featured-stamp {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid rgb(255 255 255 / 35%);
    background: rgb(16 27 45 / 88%);
    color: #fff;
    font-size: 0.57rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .insight-card-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    padding: 1.2rem 1.2rem 1.1rem;
  }

  .insight-card-kicker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem 0.75rem;
    color: var(--color-orange-dark);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .insight-card-index {
    color: #939ba4;
    font-size: 0.56rem;
  }

  .insight-card h2 {
    margin: 0.7rem 0 0.6rem;
    font-size: var(--type-card-heading-size);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.28;
  }

  .insight-card h2 a {
    transition: color 180ms ease;
  }

  .insight-card h2 a:hover {
    color: var(--color-orange-dark);
  }

  .insight-card-excerpt {
    margin: 0;
    color: var(--color-body);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .insight-card-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid #ece9e4;
  }

  .insight-card-footer > p {
    margin: 0;
    color: #8a929d;
    font-size: 0.62rem;
    line-height: 1.45;
  }

  .insight-read-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-ink);
    font-size: 0.7rem;
    font-weight: 650;
  }

  .insight-read-link span {
    color: var(--color-orange-dark);
    transition: transform 180ms var(--ease-out);
  }

  .insight-read-link:hover span {
    transform: translate(2px, -2px);
  }

  .insight-card-lead {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    align-items: stretch;
    min-height: 340px;
    border-color: rgb(16 27 45 / 9%);
    box-shadow: 0 16px 44px rgb(16 27 45 / 7%);
  }

  .insight-card-lead .insight-card-art-link {
    height: 100%;
    min-height: 340px;
    aspect-ratio: auto;
  }

  .insight-card-lead .insight-card-art-link > :global(img) {
    position: absolute;
    inset: 0;
  }

  .insight-card-lead .insight-card-art-link :global(.insight-art) {
    height: 100%;
    min-height: 340px;
    aspect-ratio: auto;
  }

  .insight-card-lead .insight-card-content {
    justify-content: center;
    padding: clamp(1.35rem, 3vw, 2.25rem);
  }

  .insight-card-lead h2 {
    max-width: 600px;
    font-size: clamp(1.45rem, 2vw, 2rem);
  }

  .insight-card-featured .insight-card-content {
    min-height: 220px;
  }

  @media (max-width: 700px) {
    .insight-card-lead {
      display: flex;
      min-height: 0;
      flex-direction: column;
    }

    .insight-card-lead .insight-card-art-link {
      height: auto;
      min-height: 0;
      aspect-ratio: 18 / 11;
    }

    .insight-card-lead .insight-card-art-link :global(.insight-art) {
      height: auto;
      min-height: 0;
      aspect-ratio: 18 / 11;
    }

    .insight-card-featured .insight-card-content {
      min-height: 0;
    }
  }

  @media (max-width: 600px) {
    .insight-card-content,
    .insight-card-lead .insight-card-content {
      padding: 1rem;
    }

    .insight-card-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .insight-card,
    .insight-card-art-link :global(.insight-art),
    .insight-card-art-link > :global(img),
    .insight-read-link span {
      transition: none;
    }

    .insight-card:hover,
    .insight-card:hover .insight-card-art-link :global(.insight-art),
    .insight-card:hover .insight-card-art-link > :global(img),
    .insight-read-link:hover span {
      transform: none;
    }
  }
</style>
