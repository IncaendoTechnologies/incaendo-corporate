      class="section section-projects"
      aria-labelledby="projects-heading"
    >
      <div class="site-container">
        <SectionHeading
          eyebrow="Selected work"
          title="The work should speak for itself."
          description="We’re preparing clear, client-approved stories that show the challenge, the thinking, and the result."
          link="/projects"
          linkLabel="Visit projects"
        />
        <div class="project-empty reveal">
          <div class="project-empty-graphic" aria-hidden="true">
            <span class="project-line project-line-one"></span>
            <span class="project-line project-line-two"></span>
            <span class="project-line project-line-three"></span>
            <span class="project-node project-node-one"></span>
            <span class="project-node project-node-two"></span>
            <span class="project-node project-node-three"></span>
          </div>
          <div class="project-empty-copy">
