    stroke-width: 3;
  }

  .delivery-blueprint-node {
    fill: #fff;
    stroke: var(--color-blue);
    stroke-width: 2;
  }

  .delivery-blueprint-node-accent {
    fill: var(--color-orange-dark);
    stroke: #fff;
  }

  .delivery-blueprint-link {
    stroke: rgb(84 123 157 / 45%);
