---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import heroVisual from '../assets/hero-orbit.png'

const {
  title = 'Incaendo | Software Development & Technology',
  description = 'Incaendo is a software development and technology company with 15 years of industry experience.',
  openGraphType = 'website',
} = Astro.props
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '')
const canonicalUrl = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).href
  : undefined
const socialImage = siteUrl ? new URL(heroVisual.src, siteUrl).href : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content="Incaendo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>
      import '../scripts/motion.js'
      import '../scripts/ai-showcase.js'
    </script>
  </body>
</html>
