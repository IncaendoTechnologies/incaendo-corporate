---
/* AI-assisted software development: an approved heading and lead,
   followed by an exact symmetrical 3D AI visualization showcase featuring
   the authentic 3D AI cube from the master design directly on the warm
   page background, compact proportions, exact fibers design with glowing
   nodes, synchronized signal particles, and interactive hover effects. */
import {
  BarChart3,
  CodeXml,
  Layers,
  MessageSquareText,
  Settings,
  Terminal,
} from 'lucide-react'

const capabilitiesLeft = [
  {
    title: 'Vibe Coding',
    desc: 'Turn ideas into early working prototypes',
    icon: CodeXml,
    idx: 0,
  },
  {
    title: 'AI-Assisted Engineering',
    desc: 'Build, test, and refine software with AI support',
    icon: Settings,
    idx: 1,
  },
  {
    title: 'Agentic AI & Automation',
    desc: 'Coordinate multi-step tasks and workflows',
    icon: Layers,
    idx: 2,
  },
]

const capabilitiesRight = [
  {
    title: 'Prompt Engineering',
    desc: 'Translate business needs into clear AI instructions',
    icon: Terminal,
    idx: 3,
  },
  {
    title: 'Large Language Models (LLMs)',
    desc: 'Power intelligent conversations and knowledge',
    icon: MessageSquareText,
    idx: 4,
  },
  {
    title: 'Machine Learning (ML)',
    desc: 'Find patterns and make data-driven predictions',
    icon: BarChart3,
    idx: 5,
  },
]
---

<section
  class="aidev section"
  id="ai-assisted-development"
  aria-labelledby="ai-dev-title"
  data-aidev
>
  <div class="site-container">
    <div class="aidev-heading">
      <div class="aidev-title-wrap">
        <p class="eyebrow">AI-ASSISTED SOFTWARE DEVELOPMENT</p>
        <h2 id="ai-dev-title">
          When Engineering <span>Meets AI</span>, Your Product{' '}
          <br class="aidev-heading-break" />
          <span>Goes Beyond</span> the Ordinary.
        </h2>
      </div>
      <p class="aidev-lead">
        AI helps us take your idea to working software sooner, speeding up
        prototyping, coding, testing and routine development work.{' '}
        <br class="aidev-lead-break" />
        Speed never replaces engineering: experienced engineers design the
        architecture, review every change and decide what ships,{' '}
        <br class="aidev-lead-break" />
        so your software is secure, reliable, maintainable and ready to grow
        with your business.
      </p>
    </div>

    <!-- Exact 3D AI Visualization Section (Compact, Balanced Composition) -->
    <div class="ai-vis-section" id="ai-vis-root" data-aidev-vis>
      <!-- SVG Fibers & Glowing Nodes Overlay -->
      <svg
        class="ai-vis-svg"
        id="ai-vis-svg"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <filter
            id="ai-particle-glow"
            x="-80%"
            y="-80%"
            width="260%"
            height="260%"
          >
            <feGaussianBlur stdDeviation="3.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter
            id="ai-line-glow"
            x="-20%"
            y="-20%"
            width="140%"
            height="140%"
          >
            <feGaussianBlur stdDeviation="1.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          <filter
            id="ai-node-glow"
            x="-50%"
            y="-50%"
            width="200%"
            height="200%"
          >
            <feGaussianBlur stdDeviation="2.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <!-- 6 Thin Glowing Fiber Paths (Rendered cleanly without objectBoundingBox clipping) -->
        <path id="ai-fiber-0" class="ai-fiber-path" fill="none" />
        <path id="ai-fiber-1" class="ai-fiber-path" fill="none" />
        <path id="ai-fiber-2" class="ai-fiber-path" fill="none" />
        <path id="ai-fiber-3" class="ai-fiber-path" fill="none" />
        <path id="ai-fiber-4" class="ai-fiber-path" fill="none" />
        <path id="ai-fiber-5" class="ai-fiber-path" fill="none" />

        <!-- 6 Glowing Fiber Circular Nodes (Matching Exact Reference Design) -->
        <g id="ai-node-0" class="ai-fiber-node" filter="url(#ai-node-glow)">
          <circle
            class="ai-node-halo"
            r="8"
            fill="rgba(224, 76, 36, 0.15)"
            stroke="rgba(224, 76, 36, 0.45)"
            stroke-width="1.2"
          />
          <circle
            class="ai-node-core"
            r="3.5"
            fill="#e04c24"
            stroke="#ffffff"
            stroke-width="1.5"
          />
        </g>
        <g id="ai-node-1" class="ai-fiber-node" filter="url(#ai-node-glow)">
          <circle
            class="ai-node-halo"
            r="8"
            fill="rgba(224, 76, 36, 0.15)"
            stroke="rgba(224, 76, 36, 0.45)"
