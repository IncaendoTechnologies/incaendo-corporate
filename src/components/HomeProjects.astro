---
import { Image } from 'astro:assets'
import { projects } from '../data/projects.js'

const featuredNames = [
  'Tomo',
  "Domino's",
  'Good Morning Italia',
  'Credit Convey',
  'Spritz',
  'Fliplearn',
]
const featuredProjects = featuredNames
  .map((name) => projects.find((project) => project.name === name))
  .filter(Boolean)

const projectHref = (project) =>
  `/projects/#project-${projects.indexOf(project) + 1}-heading`
---

<section class="home-projects-section" aria-labelledby="home-projects-heading">
  <div class="site-container home-projects-content">
    <div class="home-projects-intro reveal">
      <div>
        <p class="eyebrow">Selected projects</p>
        <h2 id="home-projects-heading">
          Different challenges.{' '}
          <span class="hero-title-accent">Thoughtful digital work.</span>
        </h2>
        <p class="section-intro">
          Explore products and platforms across commerce, mobile experiences,
          and publishing—each shaped around a different audience and business
          context.
        </p>
      </div>
      <a class="button button-primary" href="/projects/">
        Explore all projects <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div
      class="home-projects-carousel reveal"
      data-project-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label="Selected projects"
      tabindex="0"
    >
      <div class="home-projects-stage" aria-live="off" aria-atomic="false">
        {featuredProjects.map((project, index) => (
          <article
            class:list={[
              'home-project-slide',
              index === 0 && 'is-active',
              index === 1 && 'is-preview',
            ]}
            data-project-slide
            data-state={
              index === 0 ? 'active' : index === 1 ? 'preview' : 'hidden'
            }
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${featuredProjects.length}: ${project.name}`}
            aria-hidden={index === 0 ? undefined : 'true'}
            inert={index !== 0}
          >
            <a
              class="home-project-image"
              href={projectHref(project)}
              aria-label={`Explore ${project.name} project overview`}
              tabindex={index === 0 ? undefined : '-1'}
            >
              <Image
                src={project.image}
                alt={project.alt}
                width={1100}
                sizes="(max-width: 760px) 92vw, (max-width: 1100px) 48vw, 560px"
                loading={index <= 1 ? 'eager' : 'lazy'}
              />
              <span class="home-project-image-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')} /{' '}
                {String(featuredProjects.length).padStart(2, '0')}
              </span>
            </a>
            <div class="home-project-copy">
              <p class="home-project-category">{project.category}</p>
              <h3>{project.name}</h3>
              <p class="home-project-description">{project.overview}</p>
              <a class="home-project-link" href={projectHref(project)}>
                View project overview{' '}
                <span class="link-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="home-projects-controls">
        <div
          class="home-projects-pagination"
          role="group"
          aria-label="Choose a project slide"
        >
          {featuredProjects.map((project, index) => (
            <button
              class:list={[
                'home-project-indicator',
                index === 0 && 'is-active',
              ]}
              type="button"
              data-project-indicator
              aria-label={`Show project ${index + 1} of ${featuredProjects.length}: ${project.name}`}
              aria-current={index === 0 ? 'true' : undefined}
              aria-pressed={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? '0' : '-1'}
            >
              <span aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <div class="home-projects-arrows">
          <button
            class="home-project-arrow"
            type="button"
            data-project-previous
            aria-label="Show previous project"
          >
            <svg
              class="home-project-arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path d="M19 12H5M12 19l-7-7 7-7"></path>
            </svg>
          </button>
          <button
            class="home-project-arrow"
            type="button"
            data-project-next
            aria-label="Show next project"
          >
            <svg
              class="home-project-arrow-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector('[data-project-carousel]')

  if (carousel instanceof HTMLElement) {
    /** @type {HTMLElement[]} */
    const slides = Array.from(
      carousel.querySelectorAll('[data-project-slide]'),
    ).filter((el) => el instanceof HTMLElement)
    /** @type {HTMLElement[]} */
    const indicators = Array.from(
      carousel.querySelectorAll('[data-project-indicator]'),
    ).filter((el) => el instanceof HTMLElement)
    const previous = carousel.querySelector('[data-project-previous]')
    const next = carousel.querySelector('[data-project-next]')
    /** @type {HTMLElement | null} */
    const stage = carousel.querySelector('.home-projects-stage')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const rotationDelay = 4500
    let activeIndex = 0
    let previousIndex = -1
    /** @type {number | undefined} */
    let rotationTimer
    let pointerInside = false
    /** @type {number | undefined} */
    let activePointerId
    let pointerStartX = 0
    let pointerStartY = 0
    let isDragging = false
    let suppressClick = false

    const stopRotation = () => {
      window.clearTimeout(rotationTimer)
      rotationTimer = undefined
    }

    const scheduleRotation = () => {
      stopRotation()
      if (
        reducedMotion.matches ||
        pointerInside ||
        isDragging ||
        document.hidden ||
        slides[activeIndex]?.contains(document.activeElement)
      ) {
        return
      }
      rotationTimer = window.setTimeout(() => {
        showSlide(activeIndex + 1, false, 'next')
        scheduleRotation()
      }, rotationDelay)
    }

    function showSlide(index, announce = true, explicitDirection = null) {
      const newIndex = (index + slides.length) % slides.length
      if (newIndex === activeIndex && previousIndex !== -1) return

      const direction =
        explicitDirection ||
        (newIndex > activeIndex ||
        (activeIndex === slides.length - 1 && newIndex === 0)
          ? 'next'
          : 'prev')

      const oldIndex = activeIndex
      const oldPreviewIndex = (oldIndex + 1) % slides.length
      previousIndex = oldIndex
      activeIndex = newIndex

      stage?.setAttribute('aria-live', announce ? 'polite' : 'off')

      const previewIndex = (activeIndex + 1) % slides.length

      slides.forEach((slide, slideIndex) => {
        slide.classList.remove(
          'is-active',
          'is-preview',
          'is-exiting-next',
          'is-exiting-prev',
        )

        if (slideIndex === activeIndex) {
          if (
            direction === 'prev' &&
            oldIndex !== -1 &&
            !reducedMotion.matches
          ) {
            slide.style.transition = 'none'
            slide.style.transform = 'translate3d(-102%, 0, 0) scale(0.96)'
            slide.style.opacity = '0'
            void slide.offsetHeight
            slide.style.transition = ''
            slide.style.transform = ''
            slide.style.opacity = ''
          }
          slide.setAttribute('data-state', 'active')
          slide.classList.add('is-active')
          slide.setAttribute('aria-hidden', 'false')
          slide.removeAttribute('inert')
          slide
            .querySelectorAll('a, button')
            .forEach((c) => c.removeAttribute('tabindex'))
        } else if (slideIndex === previewIndex) {
          slide.setAttribute('data-state', 'preview')
          slide.classList.add('is-preview')
          slide.setAttribute('aria-hidden', 'true')
          slide.setAttribute('inert', '')
          slide
            .querySelectorAll('a, button')
            .forEach((c) => c.setAttribute('tabindex', '-1'))
        } else if (direction === 'next' && slideIndex === oldIndex) {
          slide.setAttribute('data-state', 'exiting-next')
          slide.classList.add('is-exiting-next')
          slide.setAttribute('aria-hidden', 'true')
          slide.setAttribute('inert', '')
          slide
            .querySelectorAll('a, button')
            .forEach((c) => c.setAttribute('tabindex', '-1'))
        } else if (direction === 'prev' && slideIndex === oldPreviewIndex) {
          slide.setAttribute('data-state', 'exiting-prev')
          slide.classList.add('is-exiting-prev')
          slide.setAttribute('aria-hidden', 'true')
          slide.setAttribute('inert', '')
          slide
            .querySelectorAll('a, button')
            .forEach((c) => c.setAttribute('tabindex', '-1'))
        } else {
          slide.setAttribute('data-state', 'hidden')
          slide.setAttribute('aria-hidden', 'true')
          slide.setAttribute('inert', '')
          slide
            .querySelectorAll('a, button')
            .forEach((c) => c.setAttribute('tabindex', '-1'))
        }
      })

      indicators.forEach((indicator, indicatorIndex) => {
        const active = indicatorIndex === activeIndex
        indicator.classList.toggle('is-active', active)
        indicator.setAttribute('aria-current', String(active))
        indicator.setAttribute('aria-pressed', String(active))
        indicator.tabIndex = active ? 0 : -1
      })
    }

    // Clicking the preview card advances to it
    slides.forEach((slide) => {
      slide.addEventListener('click', (event) => {
        if (slide.classList.contains('is-preview')) {
          event.preventDefault()
          showSlide(activeIndex + 1, true, 'next')
          scheduleRotation()
        }
      })
    })

    previous?.addEventListener('click', () => {
      showSlide(activeIndex - 1, true, 'prev')
      scheduleRotation()
    })

    next?.addEventListener('click', () => {
      showSlide(activeIndex + 1, true, 'next')
      scheduleRotation()
    })

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        const dir = index >= activeIndex ? 'next' : 'prev'
        showSlide(index, true, dir)
        const activeIndicator = indicators[activeIndex]
        if (activeIndicator instanceof HTMLElement) {
          activeIndicator.focus({ preventScroll: true })
        }
        scheduleRotation()
      })
    })

    carousel.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return
      if (event.key === 'ArrowLeft') {
        event.preventDefault()
        showSlide(activeIndex - 1, true, 'prev')
        carousel.focus({ preventScroll: true })
        scheduleRotation()
      } else if (event.key === 'ArrowRight') {
        event.preventDefault()
        showSlide(activeIndex + 1, true, 'next')
        carousel.focus({ preventScroll: true })
        scheduleRotation()
      }
    })

    carousel.addEventListener('pointerenter', () => {
      pointerInside = true
      stopRotation()
    })

    carousel.addEventListener('pointerleave', () => {
      pointerInside = false
      scheduleRotation()
    })

    carousel.addEventListener('focusin', () => {
      stopRotation()
    })

    carousel.addEventListener('focusout', (event) => {
      if (
        event.relatedTarget instanceof Node &&
        carousel.contains(event.relatedTarget)
      )
        return
      scheduleRotation()
    })

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopRotation()
      else scheduleRotation()
    })

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) stopRotation()
      else scheduleRotation()
    })

    /**
     * @param {Event} event
     * @param {boolean} [cancelled]
     */
    const finishPointerGesture = (event, cancelled = false) => {
      if (
        !(event instanceof PointerEvent) ||
        event.pointerId !== activePointerId
      ) {
        return
      }

      const deltaX = event.clientX - pointerStartX
      const deltaY = event.clientY - pointerStartY
      const wasDragging = isDragging
      const completedSwipe =
        !cancelled &&
        wasDragging &&
        Math.abs(deltaX) >= 48 &&
        Math.abs(deltaX) > Math.abs(deltaY) * 1.15

      activePointerId = undefined
      isDragging = false
      carousel.classList.remove('is-dragging')
      window.removeEventListener('pointermove', movePointer, true)
      window.removeEventListener('pointerup', finishPointer, true)
      window.removeEventListener('pointercancel', cancelPointer, true)

      if (completedSwipe) {
        const restoreFocus = slides[activeIndex]?.contains(
          document.activeElement,
        )
        const dir = deltaX < 0 ? 'next' : 'prev'
        showSlide(activeIndex + (deltaX < 0 ? 1 : -1), true, dir)
        if (restoreFocus) carousel.focus({ preventScroll: true })
        suppressClick = true
        window.setTimeout(() => {
          suppressClick = false
        }, 0)
      }

      scheduleRotation()
    }

    /** @param {Event} event */
    const movePointer = (event) => {
      if (
        !(event instanceof PointerEvent) ||
        event.pointerId !== activePointerId
      ) {
        return
      }

      const deltaX = event.clientX - pointerStartX
      const deltaY = event.clientY - pointerStartY

      if (
        !isDragging &&
        Math.abs(deltaX) >= 8 &&
        Math.abs(deltaX) > Math.abs(deltaY) * 1.15
      ) {
        isDragging = true
        carousel.classList.add('is-dragging')
      }

      if (isDragging) event.preventDefault()
    }

    /** @param {Event} event */
    const finishPointer = (event) => finishPointerGesture(event)
    /** @param {Event} event */
    const cancelPointer = (event) => finishPointerGesture(event, true)

    stage?.addEventListener('pointerdown', (event) => {
      if (
        !(event instanceof PointerEvent) ||
        !event.isPrimary ||
        (event.pointerType === 'mouse' && event.button !== 0) ||
        (event.target instanceof Element && event.target.closest('button'))
      ) {
        return
      }

      activePointerId = event.pointerId
      pointerStartX = event.clientX
      pointerStartY = event.clientY
      stopRotation()
      window.addEventListener('pointermove', movePointer, {
        capture: true,
        passive: false,
      })
      window.addEventListener('pointerup', finishPointer, true)
      window.addEventListener('pointercancel', cancelPointer, true)
    })

    stage?.addEventListener('dragstart', (event) => event.preventDefault())

    carousel.addEventListener(
      'click',
      (event) => {
        if (!suppressClick) return
        event.preventDefault()
        event.stopImmediatePropagation()
        suppressClick = false
      },
      true,
    )

    scheduleRotation()
  }
</script>

<style>
  .home-projects-section {
    padding-block: clamp(2rem, 4vh, 3rem);
    background: var(--color-paper);
  }

  .home-projects-content {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .home-projects-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .home-projects-intro > div {
    max-width: 900px;
  }

  .home-projects-intro .eyebrow {
    margin-bottom: 0.75rem;
  }

  .home-projects-intro h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
  }

  .home-projects-intro .section-intro {
    max-width: 630px;
    margin: 0.9rem 0 0;
    color: var(--color-body);
    font-size: var(--type-body-size);
    line-height: var(--type-body-line-height);
  }

  .home-projects-intro > .button {
    flex: 0 0 auto;
  }

  .home-projects-carousel {
    min-width: 0;
    overflow: hidden;
    padding: clamp(0.65rem, 1vw, 0.9rem);
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: var(--radius-large);
    background:
      radial-gradient(ellipse at 8% 12%, rgb(201 84 43 / 9%), transparent 36%),
      radial-gradient(
        ellipse at 92% 88%,
        rgb(84 123 157 / 10%),
        transparent 38%
      ),
      #f2f0ec;
    box-shadow:
      0 1px 2px rgb(16 27 45 / 4%),
      0 16px 34px -22px rgb(16 27 45 / 24%),
      0 34px 70px -48px rgb(16 27 45 / 24%);
  }

  .home-projects-carousel:focus-visible {
    outline: 3px solid #e1784f;
    outline-offset: 4px;
  }

  .home-projects-carousel.is-dragging,
  .home-projects-carousel.is-dragging * {
    cursor: grabbing;
    user-select: none;
  }

  .home-projects-stage {
    --preview-peek: clamp(170px, 18vw, 225px);
    --preview-overlap: clamp(18px, 2vw, 26px);
    position: relative;
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    padding: clamp(0.45rem, 0.8vw, 0.7rem);
    border-radius: var(--radius-medium);
  }

  .home-project-slide {
    position: relative;
    display: grid;
    min-width: 0;
    grid-area: 1 / 1;
    width: calc(100% - var(--preview-peek, 190px));
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: stretch;
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    padding: clamp(0.75rem, 1.4vw, 1rem);
    border: 1.5px solid rgb(16 27 45 / 8%);
    border-right: 2.5px solid rgb(16 27 45 / 8%);
    border-radius: var(--radius-medium);
    background: var(--color-white);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform-origin: left center;
    transform: translate3d(calc(100% + 60px), 0, 0) scale(0.95);
    transition:
      transform 800ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 800ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 600ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 800ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 800ms cubic-bezier(0.22, 1, 0.36, 1),
      visibility 800ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform, opacity;
  }

  .home-project-slide.is-active {
    z-index: 3;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    border-color: rgba(232, 93, 38, 0.38);
    border-right-color: #e85d26;
    transform: translate3d(0, 0, 0) scale(1);
    box-shadow:
      0 20px 48px -12px rgba(16, 27, 45, 0.2),
      0 6px 18px -2px rgba(16, 27, 45, 0.1),
      12px 0 28px -4px rgba(232, 93, 38, 0.3),
      4px 0 12px -2px rgba(232, 93, 38, 0.34),
      0 0 0 1px rgba(232, 93, 38, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .home-project-slide.is-active .home-project-copy {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 500ms 150ms var(--ease-out);
  }

  .home-project-slide.is-preview {
    z-index: 1;
    opacity: 0.84;
    visibility: visible;
    pointer-events: auto;
    cursor: pointer;
    transform-origin: left center;
    transform: translate3d(calc(100% - var(--preview-overlap, 22px)), 0, 0)
      scale(0.975);
    box-shadow:
      0 8px 24px -8px rgba(16, 27, 45, 0.12),
      0 2px 8px -2px rgba(16, 27, 45, 0.06);
    filter: saturate(0.96);
  }

  .home-project-slide.is-preview .home-project-copy {
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }

  .home-project-slide.is-preview a {
    pointer-events: none;
  }

  .home-project-slide.is-preview:hover {
    opacity: 0.94;
    filter: saturate(1);
    box-shadow:
      0 12px 30px -8px rgba(16, 27, 45, 0.18),
      0 3px 8px -2px rgba(16, 27, 45, 0.08);
  }

  .home-project-slide.is-exiting-next {
    z-index: 2;
    opacity: 0;
    visibility: visible;
    pointer-events: none;
    transform: translate3d(-102%, 0, 0) scale(0.96);
    box-shadow: 0 4px 14px rgb(16 27 45 / 6%);
  }

  .home-project-slide.is-exiting-prev {
    z-index: 2;
    opacity: 0;
    visibility: visible;
    pointer-events: none;
    transform: translate3d(calc(100% + 60px), 0, 0) scale(0.95);
    box-shadow: 0 4px 14px rgb(16 27 45 / 6%);
  }

  .home-project-slide[data-state='hidden'] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate3d(calc(100% + 60px), 0, 0) scale(0.95);
    transition: none !important;
  }

  .home-project-slide .home-project-image {
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 280px;
    align-self: center;
    aspect-ratio: 1.72;
    padding: clamp(0.4rem, 0.8vw, 0.65rem);
    border: 1px solid rgb(16 27 45 / 10%);
    border-radius: var(--radius-medium);
    background: linear-gradient(145deg, #f5eee8 0%, #f0f3f4 100%);
    box-shadow:
      0 12px 26px -16px rgb(16 27 45 / 32%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
    transition:
      transform 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out),
      border-color 300ms ease;
  }

  .home-project-image {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    background: var(--color-peach);
  }

  .home-project-image img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-small);
    object-fit: contain;
    transition: transform 350ms var(--ease-out);
  }

  .home-project-image:hover img {
    transform: scale(1.012);
  }

  .home-project-image:hover {
    transform: translateY(-2px);
    border-color: rgb(201 84 43 / 28%);
    box-shadow:
      0 18px 32px -18px rgb(16 27 45 / 36%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
  }

  .home-project-image:focus-visible {
    outline-offset: 5px;
    border-color: var(--color-orange-dark);
  }

  .home-project-image-index {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid rgb(255 255 255 / 32%);
    background: rgb(16 27 45 / 78%);
    color: var(--color-white);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .home-project-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    padding: clamp(1.25rem, 2.2vw, 2rem) clamp(1.25rem, 2.3vw, 2rem)
      clamp(1rem, 1.5vw, 1.35rem);
    border-left: 1px solid var(--color-line);
  }

  .home-project-category {
    margin: 0;
    color: var(--color-orange-dark);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .home-project-copy h3 {
    margin: 0.6rem 0 0;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 620;
    letter-spacing: -0.045em;
    word-spacing: 0.045em;
    line-height: 1.2;
  }

  .home-project-description {
    margin: 0.7rem 0 1rem;
    color: var(--color-body);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .home-project-link {
    display: inline-flex;
