---
import { HUBSPOT_SUBMIT_URL } from '../scripts/hubspot-form.js'
import {
  DEFAULT_PHONE_COUNTRY,
  phoneCountries,
} from '../data/phone-countries.js'

const { idPrefix = 'contact' } = Astro.props
const endpoint = HUBSPOT_SUBMIT_URL
const fieldId = (suffix) => `${idPrefix}-${suffix}`
const defaultCountry =
  phoneCountries.find((c) => c.iso === DEFAULT_PHONE_COUNTRY) ??
  phoneCountries[0]
---

<form
  class="contact-form"
  data-contact-form
  data-endpoint={endpoint}
  data-hs-do-not-collect="true"
  novalidate
>
  <div class="row gx-3 gy-3 form-grid">
    <div class="form-field col-md-6">
      <label for={fieldId('name')}>
        Full name <span aria-hidden="true">*</span>
      </label>
      <input
        id={fieldId('name')}
        name="name"
        autocomplete="name"
        maxlength="80"
        required
        aria-invalid="false"
        aria-describedby={fieldId('name-error')}
      />
      <span
        class="form-field-error"
        id={fieldId('name-error')}
        data-error-for="name"
        hidden
      ></span>
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('email')}>
        Work email <span aria-hidden="true">*</span>
      </label>
      <input
        id={fieldId('email')}
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        maxlength="254"
        required
        aria-invalid="false"
        aria-describedby={fieldId('email-error')}
      />
      <span
        class="form-field-error"
        id={fieldId('email-error')}
        data-error-for="email"
        hidden
      ></span>
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('company')}>
        Company name <span class="form-optional">(optional)</span>
      </label>
      <input
        id={fieldId('company')}
        name="company"
        autocomplete="organization"
        maxlength="120"
      />
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('phone')}>
        Phone number <span class="form-optional">(optional)</span>
      </label>
      <div class="phone-input" data-phone-input>
        <input
          type="hidden"
          name="phoneCountry"
          value={defaultCountry.iso}
          data-default={defaultCountry.iso}
          data-phone-country
        />
        <button
          type="button"
          class="phone-country-button"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-controls={fieldId('phone-country-list')}
          aria-label={`Country code: ${defaultCountry.name} +${defaultCountry.dial}`}
          data-phone-country-button
        >
          <img
            class="phone-flag"
            src={defaultCountry.flag}
            alt=""
            width="22"
            height="16"
            data-phone-country-flag
          />
          <span data-phone-country-dial>+{defaultCountry.dial}</span>
          <svg
            class="phone-country-chevron"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <path d="m4 6 4 4 4-4"></path>
          </svg>
        </button>
        <input
          id={fieldId('phone')}
          name="phone"
          type="tel"
          inputmode="tel"
          autocomplete="tel-national"
          maxlength="20"
          placeholder={defaultCountry.example}
          aria-invalid="false"
          aria-describedby={fieldId('phone-error')}
        />
        <div class="phone-country-menu" data-phone-country-menu hidden>
          <input
            type="search"
            class="phone-country-search"
            placeholder="Search country or code"
            aria-label="Search country or dial code"
            aria-controls={fieldId('phone-country-list')}
            autocomplete="off"
            data-phone-country-search
          />
          <ul
            class="phone-country-list"
            id={fieldId('phone-country-list')}
            role="listbox"
            aria-label="Country"
          >
            {
              phoneCountries.map((country) => (
                <li
                  id={fieldId(`phone-country-${country.iso.toLowerCase()}`)}
                  role="option"
                  aria-selected={country.iso === defaultCountry.iso ? 'true' : 'false'}
                  data-value={country.iso}
                  data-name={country.name}
                  data-dial={country.dial}
                  data-flag={country.flag}
                  data-example={country.example}
                >
                  <img
                    class="phone-flag"
                    src={country.flag}
                    alt=""
                    width="22"
                    height="16"
                    loading="lazy"
                  />
                  <span class="phone-country-name">{country.name}</span>
                  <span class="phone-country-dial">+{country.dial}</span>
                </li>
              ))
            }
          </ul>
          <p class="phone-country-empty" data-phone-country-empty hidden>
            No country found
          </p>
        </div>
      </div>
      <span
        class="form-field-error"
        id={fieldId('phone-error')}
        data-error-for="phone"
        hidden
      ></span>
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('topic')}>
        Service <span aria-hidden="true">*</span>
      </label>
      <select
        id={fieldId('topic')}
        name="topic"
        required
        aria-invalid="false"
        aria-describedby={fieldId('topic-error')}
      >
        <option value="" selected disabled>
          Select a service
        </option>
        <option>Custom Software</option>
        <option>AI &amp; Automation</option>
        <option>Web Applications</option>
        <option>Mobile Apps</option>
        <option>Enterprise Solutions</option>
        <option>Cloud &amp; Data</option>
        <option>Other</option>
      </select>
      <span
        class="form-field-error"
        id={fieldId('topic-error')}
        data-error-for="topic"
        hidden
      ></span>
    </div>
    <div class="form-field col-md-6">
      <label for={fieldId('budget')}>
        Project budget <span class="form-optional">(optional)</span>
      </label>
      <select id={fieldId('budget')} name="budget">
        <option value="" selected>
          Select a range
        </option>
        <option>Under ₹5 lakh</option>
        <option>₹5–15 lakh</option>
        <option>₹15–50 lakh</option>
        <option>Above ₹50 lakh</option>
        <!-- Value must match the HubSpot project_budget option exactly. -->
        <option value="- Prefer to discuss">Prefer to discuss</option>
      </select>
    </div>
    <div class="form-field col-12">
      <label for={fieldId('message')}>
        Project details <span aria-hidden="true">*</span>
      </label>
      <textarea
        id={fieldId('message')}
        name="message"
        rows="4"
        maxlength="3000"
        required
        placeholder="What are you planning, and what would a useful outcome look like?"
        aria-invalid="false"
        aria-describedby={fieldId('message-error')}
      ></textarea>
      <span
        class="form-field-error"
        id={fieldId('message-error')}
        data-error-for="message"
        hidden
      ></span>
    </div>
  </div>

  <div class="contact-consent">
    <label class="contact-privacy-consent" for={fieldId('privacy')}>
      <input
        id={fieldId('privacy')}
        name="privacyConsent"
        type="checkbox"
        required
        aria-invalid="false"
        aria-describedby={fieldId('privacy-error')}
      />
      <span>
        I agree to the <a href="/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a> and understand my
        details will be used to respond to this enquiry.
      </span>
    </label>
    <span
      class="form-field-error contact-consent-error"
      id={fieldId('privacy-error')}
      data-error-for="privacyConsent"
      hidden
    ></span>
  </div>

  <!-- Spam honeypot: invisible to people, often filled by bots. -->
  <div class="contact-form-hp" aria-hidden="true">
    <label for={fieldId('website')}>Website</label>
    <input
      id={fieldId('website')}
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="form-submit-row">
    <button class="button button-primary" type="submit">
      <span
        class="form-submit-spinner"
        data-submit-spinner
        aria-hidden="true"
        hidden
      ></span>
      <span data-submit-label>Send project inquiry</span>
      <span aria-hidden="true" data-submit-arrow>↗</span>
    </button>
    <p>
      {endpoint ? (
        <>
          Fields marked <span aria-hidden="true">*</span> are required.
        </>
      ) : (
        <>
          Online sending isn’t set up yet. You can also email{' '}
          <a href="mailto:info@incaendo.com">info@incaendo.com</a>.
        </>
      )}
    </p>
  </div>
</form>

<script>
  import {
    buildHubSpotPayload,
    describeHubSpotError,
    SUBMIT_FAILED_MESSAGE,
  } from '../scripts/hubspot-form.js'
  import { showToast } from '../scripts/toast.js'

  function initializeContactForms() {
    const forms = Array.from(
      document.querySelectorAll('[data-contact-form]'),
    ).filter((f) => f instanceof HTMLFormElement)

    forms.forEach((form) => {
      if (!(form instanceof HTMLFormElement)) return
      if (form.dataset.initialized === 'true') return
      form.dataset.initialized = 'true'

      const submitLabel = form.querySelector('[data-submit-label]')
      const submitSpinner = form.querySelector('[data-submit-spinner]')
      const submitArrow = form.querySelector('[data-submit-arrow]')
      const originalButtonText = submitLabel?.textContent ?? 'Send project inquiry'

      // Submission feedback is shown as a toast (src/scripts/toast.js);
      // field validation stays inline next to each field. The submit button
      // stays locked for the toast's full lifetime as well as the request.
      const FEEDBACK_MS = 3000
      let dismissToast = () => {}
      const notifySuccess = () => {
        dismissToast()
        dismissToast = showToast({
          type: 'success',
          title: 'Inquiry sent successfully!',
          description:
            'Thank you for reaching out. Our team will get back to you soon.',
          duration: FEEDBACK_MS,
        })
      }
      const notifyError = (description = SUBMIT_FAILED_MESSAGE) => {
        dismissToast()
        dismissToast = showToast({
          type: 'error',
          title: 'Unable to send your inquiry',
          description,
          duration: FEEDBACK_MS,
        })
      }

      const setSending = (sending) => {
        if (submitLabel) {
          submitLabel.textContent = sending ? 'Sending…' : originalButtonText
        }
        if (submitSpinner instanceof HTMLElement) submitSpinner.hidden = !sending
        if (submitArrow instanceof HTMLElement) submitArrow.hidden = sending
      }

      const setFieldError = (name, message = '') => {
        const field = form.elements.namedItem(name)
        const error = form.querySelector(`[data-error-for="${name}"]`)
        if (!(field instanceof HTMLElement) || !(error instanceof HTMLElement)) return

        const hasError = Boolean(message)
        field.setAttribute('aria-invalid', String(hasError))
        error.textContent = message
        error.hidden = !hasError
      }

      // Phone numbers are checked with libphonenumber-js (Google's phone
      // number data). It is loaded only when the visitor uses the phone field
      // or submits, so it doesn't slow down every page.
      let phoneLib = null
      let phoneLibLoading = null
      const loadPhoneLib = () =>
        (phoneLibLoading ??= import('libphonenumber-js/max').then(
          (module) => (phoneLib = module),
        ))

      const NAME_PATTERN = /^\p{L}[\p{L}\p{M} .'’-]*$/u
      const EMAIL_PATTERN = /^[^\s@]+@[^\s@]+\.[^\s@.]{2,}$/
      const MESSAGE_MIN = 10

      const getControl = (name) => form.elements.namedItem(name)
      const getValue = (name) => {
        const field = getControl(name)
        return field && 'value' in field ? String(field.value).trim() : ''
      }
      const countryOptions = Array.from(
        form.querySelectorAll('[data-phone-country-menu] [role="option"]'),
      )
      const getCountry = () => {
        const iso = getValue('phoneCountry')
        const option =
          countryOptions.find((o) => o.dataset.value === iso) ??
          countryOptions[0]
        return {
          iso: option?.dataset.value ?? 'IN',
          name: option?.dataset.name ?? 'India',
          dial: option?.dataset.dial ?? '91',
          example: option?.dataset.example ?? '',
        }
      }

      // Parsed number when it is valid for the chosen country's dial code
      // (a typed "+code" or leading 0 is fine), otherwise null.
      const parsePhone = () => {
        const value = getValue('phone')
        if (!value || !phoneLib) return null
        const country = getCountry()
        const parsed = phoneLib.parsePhoneNumberFromString(value, country.iso)
        return parsed?.isValid() && parsed.countryCallingCode === country.dial
          ? parsed
          : null
      }

      const validators = {
        name: () => {
          const value = getValue('name')
          if (!value) return 'Enter your full name.'
          if (value.length < 2) return 'Name is too short.'
          if (!NAME_PATTERN.test(value))
            return 'Use letters only (spaces, . \' - are fine).'
          return ''
        },
        email: () => {
          const value = getValue('email')
          const field = getControl('email')
          if (!value) return 'Enter your work email.'
          const browserValid =
            field instanceof HTMLInputElement ? field.validity.valid : true
          return browserValid && EMAIL_PATTERN.test(value)
            ? ''
            : 'Enter a valid email address, like name@company.com.'
        },
        phone: () => {
          if (!getValue('phone') || !phoneLib) return '' // optional
          if (parsePhone()) return ''
          const country = getCountry()
          return `Enter a valid ${country.name} number (e.g. +${country.dial} ${country.example}).`
        },
        topic: () =>
          getValue('topic') ? '' : 'Choose the service you need help with.',
        message: () => {
          const value = getValue('message')
          if (!value) return 'Tell us a little about your project.'
          return value.length < MESSAGE_MIN
            ? `Please add a few more details (at least ${MESSAGE_MIN} characters).`
            : ''
        },
        privacyConsent: () => {
          const field = getControl('privacyConsent')
          return field instanceof HTMLInputElement && field.checked
            ? ''
            : 'Please confirm before continuing.'
        },
      }

      const validateField = (name) => {
        const message = validators[name]?.() ?? ''
        setFieldError(name, message)
        return message
      }

      const validate = () => {
        const errors = {}
        Object.keys(validators).forEach((name) => {
          errors[name] = validateField(name)
        })
        return errors
      }

      // Phone box: keep only characters a phone number can contain.
      const phoneField = getControl('phone')
      if (phoneField instanceof HTMLInputElement) {
        phoneField.addEventListener('input', () => {
          const cleaned = phoneField.value.replace(/[^\d\s()+-]/g, '')
          if (cleaned !== phoneField.value) phoneField.value = cleaned
        })
      }

      // Country picker: a button with the flag and dial code that opens a
      // searchable list.
      const countryInput = form.querySelector('[data-phone-country]')
      const countryButton = form.querySelector('[data-phone-country-button]')
      const countryMenu = form.querySelector('[data-phone-country-menu]')
      const countrySearch = form.querySelector('[data-phone-country-search]')
      const countryEmpty = form.querySelector('[data-phone-country-empty]')
      const countryFlag = form.querySelector('[data-phone-country-flag]')
      const countryDial = form.querySelector('[data-phone-country-dial]')
      let activeOption = null

      const setCountry = (iso) => {
        const option = countryOptions.find((o) => o.dataset.value === iso)
        if (!option || !(countryInput instanceof HTMLInputElement)) return
        countryInput.value = iso
        countryOptions.forEach((o) =>
          o.setAttribute('aria-selected', String(o === option)),
        )
        const { name, dial, flag, example } = option.dataset
        if (countryFlag instanceof HTMLImageElement && flag) countryFlag.src = flag
        if (countryDial) countryDial.textContent = `+${dial}`
        countryButton?.setAttribute('aria-label', `Country code: ${name} +${dial}`)
        if (phoneField instanceof HTMLInputElement) {
          phoneField.placeholder = example ?? ''
        }
        if (getValue('phone')) {
          loadPhoneLib().then(() => validateField('phone'))
        }
      }

      const setActive = (option) => {
        activeOption?.classList.remove('is-active')
        activeOption = option
        if (!option) {
          countrySearch?.removeAttribute('aria-activedescendant')
          return
        }
        option.classList.add('is-active')
        countrySearch?.setAttribute('aria-activedescendant', option.id)
        option.scrollIntoView({ block: 'nearest' })
      }

      const visibleOptions = () => countryOptions.filter((o) => !o.hidden)

      const filterCountries = () => {
        const query =
          countrySearch instanceof HTMLInputElement
            ? countrySearch.value.trim().toLowerCase()
            : ''
        const digits = query.replace(/\D/g, '')
        countryOptions.forEach((o) => {
          const { name = '', dial = '', value = '' } = o.dataset
          o.hidden = Boolean(
            query &&
              !name.toLowerCase().includes(query) &&
              value.toLowerCase() !== query &&
              !(digits && dial.startsWith(digits)),
          )
        })
        const shown = visibleOptions()
        if (countryEmpty instanceof HTMLElement) countryEmpty.hidden = shown.length > 0
        setActive(shown[0] ?? null)
      }

      const isMenuOpen = () =>
        countryMenu instanceof HTMLElement && !countryMenu.hidden

      const openMenu = () => {
        if (!(countryMenu instanceof HTMLElement)) return
        loadPhoneLib()
        countryMenu.hidden = false
        countryButton?.setAttribute('aria-expanded', 'true')
        if (countrySearch instanceof HTMLInputElement) countrySearch.value = ''
        filterCountries()
        setActive(
          countryOptions.find((o) => o.getAttribute('aria-selected') === 'true') ??
            null,
        )
        countryMenu.scrollIntoView({ block: 'nearest' })
        if (countrySearch instanceof HTMLElement) countrySearch.focus()
      }

      const closeMenu = (focusButton = false) => {
        if (!(countryMenu instanceof HTMLElement) || countryMenu.hidden) return
        countryMenu.hidden = true
        countryButton?.setAttribute('aria-expanded', 'false')
        setActive(null)
        if (focusButton && countryButton instanceof HTMLElement) {
          countryButton.focus()
        }
      }

      const chooseOption = (option) => {
        if (!option?.dataset.value) return
        setCountry(option.dataset.value)
        closeMenu(false)
        if (phoneField instanceof HTMLElement) phoneField.focus()
      }

      countryButton?.addEventListener('click', () => {
        if (isMenuOpen()) closeMenu(true)
        else openMenu()
      })
      countryButton?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault()
          openMenu()
        }
      })
      countrySearch?.addEventListener('input', filterCountries)
      countrySearch?.addEventListener('keydown', (event) => {
        const shown = visibleOptions()
        const index = activeOption ? shown.indexOf(activeOption) : -1
        if (event.key === 'ArrowDown') {
          event.preventDefault()
          setActive(shown[Math.min(index + 1, shown.length - 1)] ?? null)
        } else if (event.key === 'ArrowUp') {
          event.preventDefault()
          setActive(shown[Math.max(index - 1, 0)] ?? null)
        } else if (event.key === 'Enter') {
          event.preventDefault()
          if (activeOption) chooseOption(activeOption)
        } else if (event.key === 'Escape') {
          // Close only the list, not the contact popup around the form.
          event.preventDefault()
          event.stopPropagation()
          closeMenu(true)
        } else if (event.key === 'Tab') {
          closeMenu(false)
        }
      })
      countryOptions.forEach((option) => {
        option.addEventListener('click', () => chooseOption(option))
        option.addEventListener('pointermove', () => {
          if (activeOption !== option) setActive(option)
        })
      })
      document.addEventListener('pointerdown', (event) => {
        if (!isMenuOpen()) return
        const wrapper = form.querySelector('[data-phone-input]')
        if (event.target instanceof Node && wrapper?.contains(event.target)) return
        closeMenu(false)
      })

      // A reset puts the country back to the default.
      form.addEventListener('reset', () => {
        closeMenu(false)
        // A hidden input keeps its current value on reset, so the default
        // is read from data-default and applied after the reset finishes.
        const defaultIso =
          countryInput instanceof HTMLElement
            ? (countryInput.dataset.default ?? 'IN')
            : 'IN'
        setTimeout(() => setCountry(defaultIso))
      })

      if (phoneField instanceof HTMLInputElement) {
        phoneField.addEventListener('focus', () => loadPhoneLib(), { once: true })
      }

      // Check a field once the visitor leaves it, but only if they typed
      // something, so empty fields aren't flagged before submitting.
      form.addEventListener('focusout', (event) => {
        const name =
          event.target instanceof HTMLElement
            ? event.target.getAttribute('name')
            : null
        if (!name || !validators[name] || name === 'privacyConsent') return
        if (!getValue(name)) return
        if (name === 'phone') loadPhoneLib().then(() => validateField('phone'))
        else validateField(name)
      })

      form.addEventListener('input', (event) => {
        if (event.target instanceof HTMLElement) {
          const name = event.target.getAttribute('name')
          if (name && event.target.getAttribute('aria-invalid') === 'true') {
            setFieldError(name)
          }
        }
      })
      form.addEventListener('change', (event) => {
        if (event.target instanceof HTMLElement) {
          const name = event.target.getAttribute('name')
          if (name && event.target.getAttribute('aria-invalid') === 'true') {
            setFieldError(name)
          }
        }
      })

      let isSubmitting = false

      form.addEventListener('submit', async (event) => {
        event.preventDefault()
        if (isSubmitting) return
        if (getValue('phone')) {
          try {
            await loadPhoneLib()
          } catch {
            // Couldn't load the checker (offline?): send the number as typed.
          }
        }
        validate()
        const firstInvalid = form.querySelector('[aria-invalid="true"]')
        if (firstInvalid instanceof HTMLElement) {
          firstInvalid.focus()
          return
        }

        const endpoint = form.dataset.endpoint?.trim() ?? ''
        if (!endpoint) {
          notifyError(
            'Online sending isn’t set up yet. Please email info@incaendo.com.',
          )
          return
        }

        let target
        try {
          target = new URL(endpoint, window.location.href)
          if (target.protocol !== 'https:')
            throw new Error('A secure endpoint is required.')
        } catch {
          notifyError(
            'Online sending isn’t available right now. Please email info@incaendo.com.',
          )
          return
        }

        // Read values before disabling controls: disabled fields are
        // excluded from FormData.
        const formData = new FormData(form)
        const parsedPhone = parsePhone()
        if (parsedPhone) {
          formData.set('phone', parsedPhone.formatInternational())
        } else if (getValue('phone')) {
          formData.set('phone', `+${getCountry().dial} ${getValue('phone')}`)
        }
        const honeypot = formData.get('website')
        const payload = buildHubSpotPayload(formData)

        const controls = Array.from(
          form.querySelectorAll('input, select, textarea, button'),
        ).filter((c) => 'disabled' in c)
        isSubmitting = true
        let succeeded = false
        controls.forEach((control) => {
          control.disabled = true
        })
        setSending(true)
        dismissToast()
        // Lifecycle events (bubbling) let a container such as the contact
        // modal react without coupling to this component:
        //   contact-form:pending  -> request in flight
        //   contact-form:settled  -> response handled, toast shown
        //   contact-form:complete -> toast lifecycle done, button unlocked
        const emit = (name) =>
          form.dispatchEvent(
            new CustomEvent(`contact-form:${name}`, {
              bubbles: true,
              detail: { success: succeeded },
            }),
          )
        emit('pending')

        try {
          // Bot filled the hidden field: don't forward it, but don't tip it off.
          if (typeof honeypot === 'string' && honeypot.trim()) {
            form.reset()
            succeeded = true
            notifySuccess()
            return
          }

          let response
          try {
            response = await fetch(target.href, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(payload),
            })
          } catch {
            notifyError()
            return
          }

          if (!response.ok) {
            // Keep everything the visitor typed; only flag what HubSpot rejected.
            const { fieldErrors } = await describeHubSpotError(response)
            Object.entries(fieldErrors).forEach(([name, fieldMessage]) =>
              setFieldError(name, fieldMessage),
            )
            notifyError()
            return
          }

          form.reset()
          form.querySelectorAll('[aria-invalid="true"]').forEach((field) => {
            field.setAttribute('aria-invalid', 'false')
          })
          form.querySelectorAll('.form-field-error').forEach((error) => {
            if (error instanceof HTMLElement) {
              error.textContent = ''
              error.hidden = true
            }
          })
          succeeded = true
          notifySuccess()
        } catch {
          notifyError()
        } finally {
          // Every path above has shown a toast. Fields come back right away
          // (values are kept on failure); the submit button and the
          // duplicate-submit guard stay locked until the toast has run.
          const submitButton = form.querySelector('button[type="submit"]')
          controls.forEach((control) => {
            if (control !== submitButton) control.disabled = false
          })
          setSending(false)
          emit('settled')
          // If HubSpot rejected specific fields, move focus to the first one.
          const rejected = form.querySelector('[aria-invalid="true"]')
          if (rejected instanceof HTMLElement) rejected.focus()

          await new Promise((resolve) => window.setTimeout(resolve, FEEDBACK_MS))
          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false
          }
          isSubmitting = false
          emit('complete')
        }
      })
    })
  }

  initializeContactForms()
  document.addEventListener('astro:page-load', initializeContactForms)
</script>

