---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageIntro from '../components/PageIntro.astro'
import ReviewNotice from '../components/ReviewNotice.astro'
import { pages } from '../data/site-content.js'
---

<BaseLayout title={pages.privacy.title} description={pages.privacy.description}>
  <main id="main-content">
    <PageIntro
      eyebrow="Privacy"
      title="Your information deserves clarity."
      description="This page identifies the privacy information Incaendo needs to provide before the site is launched with live forms or analytics."
      index="08 / 09"
    />
    <section
      class="section privacy-section"
      aria-labelledby="privacy-status-heading"
    >
      <div class="site-container privacy-layout">
        <aside class="privacy-sidebar">
          <span class="privacy-draft-label">Review required</span>
          <p>Company-specific privacy notice is not yet available.</p>
        </aside>
        <div class="privacy-content">
          <ReviewNotice title="Do not publish as a final privacy policy">
            The responsible legal entity, privacy contact, data handling
            practices, retention periods, and applicable jurisdictions were not
            provided. Confirm these with Incaendo’s privacy or legal owner
            before launch.
          </ReviewNotice>
          <h2 id="privacy-status-heading">Information still to confirm</h2>
          <div class="privacy-topic">
            <h3>Who is responsible for this website?</h3>
            <p>
              Confirm the legal entity name, registered address, and a contact
              for privacy questions.
            </p>
          </div>
          <div class="privacy-topic">
            <h3>What information is collected?</h3>
            <p>
              Document website logs, analytics, cookies, contact form
              submissions, and any third-party services used.
            </p>
          </div>
          <div class="privacy-topic">
            <h3>How is information used and retained?</h3>
            <p>
              State the purposes, legal basis where applicable, retention
              periods, and safeguards for each data category.
            </p>
          </div>
          <div class="privacy-topic">
            <h3>Who receives or processes information?</h3>
            <p>
              Identify hosting, email, analytics, and other service providers
              and explain any international transfers.
            </p>
          </div>
          <div class="privacy-topic">
            <h3>What choices and rights do visitors have?</h3>
            <p>
              Confirm the rights and choices available to visitors in the
              jurisdictions where Incaendo operates and explain how to exercise
              them.
            </p>
          </div>
          <p class="privacy-updated">Last reviewed: not yet reviewed</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
