    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(16 27 45 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(16 27 45 / 3%) 1px, transparent 1px);
    background-size: 28px 28px;
    content: '';
    mask-image: radial-gradient(ellipse at center, black 12%, transparent 80%);
    pointer-events: none;
  }

  .delivery-visual-meta {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1.2rem;
    left: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--color-muted);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
