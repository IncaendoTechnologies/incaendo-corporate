---
const {
  eyebrow,
  title,
  titleAccent,
  description,
  headingId,
  reveal = false,
  link,
  linkLabel = 'Explore more',
  tone = 'light',
} = Astro.props
---

<div
  class:list={[`section-heading section-heading-${tone}`, reveal && 'reveal']}
  data-services-intro={reveal ? '' : undefined}
>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={headingId}>
      {title}{titleAccent && <span class="hero-title-accent">{titleAccent}</span>}
    </h2>
    {description && <p class="section-intro">{description}</p>}
  </div>
  {link && (
    <a class="text-link" href={link}>
      {linkLabel}{' '}
      <span class="link-arrow" aria-hidden="true">
        →
      </span>
    </a>
  )}
</div>
