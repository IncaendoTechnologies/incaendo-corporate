  .delivery-panel[hidden] {
    display: none !important;
  }

  .delivery-panel.is-entering {
    animation: delivery-panel-enter 360ms var(--ease-out) both;
  }

  @keyframes delivery-panel-enter {
    from {
      opacity: 0.45;
      transform: translateY(7px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .delivery-visual {
    position: relative;
    display: grid;
    min-height: 250px;
    aspect-ratio: 640 / 330;
    place-items: center;
    overflow: hidden;
    border-bottom: 1px solid rgb(16 27 45 / 8%);
    background:
      radial-gradient(
        ellipse at 50% 56%,
        rgb(84 123 157 / 12%),
        transparent 50%
      ),
      linear-gradient(135deg, #f6f4f0 0%, #f9f8f6 54%, #f3f5f6 100%);
  }

  .delivery-visual::before {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgb(16 27 45 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(16 27 45 / 3%) 1px, transparent 1px);
    background-size: 28px 28px;
    content: '';
    mask-image: radial-gradient(ellipse at center, black 12%, transparent 80%);
    pointer-events: none;
  }

  .delivery-visual-meta {
    position: absolute;
    z-index: 2;
    top: 1rem;
    right: 1.2rem;
    left: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    color: var(--color-muted);
    font-size: 0.61rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .delivery-visual-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .delivery-visual-pulse {
    width: 0.43rem;
    height: 0.43rem;
    border-radius: 50%;
    background: var(--color-orange-dark);
    box-shadow: 0 0 0 4px rgb(168 65 33 / 10%);
    animation: delivery-status-pulse 2.8s ease-in-out infinite;
  }

  .delivery-visual-count {
    color: var(--color-navy-soft);
    font-variant-numeric: tabular-nums;
  }

  @keyframes delivery-status-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 4px rgb(168 65 33 / 9%);
    }
    50% {
      box-shadow: 0 0 0 7px rgb(168 65 33 / 3%);
    }
  }

  .delivery-scene {
    position: relative;
    z-index: 1;
    display: block;
    width: min(100%, 640px);
    height: 100%;
    overflow: visible;
    padding: 2.2rem 0.55rem 0.45rem;
  }

  .delivery-route,
  .delivery-orbit-ring,
  .delivery-screen-top,
  .delivery-blueprint-line,
  .delivery-blueprint-link,
  .delivery-api-link,
  .delivery-product-top,
  .delivery-qa-progress,
  .delivery-check-mark,
  .delivery-release-line,
  .delivery-monitor-line,
  .delivery-feedback-loop,
  .delivery-feedback-arrow,
  .delivery-core-icon {
