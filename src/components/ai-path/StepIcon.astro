        />
        <line
          x1="35"
          y1="25"
          x2="35"
          y2="52"
          stroke="#ff8c70"
          stroke-width="1.2"
          stroke-linecap="round"
          opacity="0.6"
        />
      </g>
      <g class="metric-bar-item bar-4">
