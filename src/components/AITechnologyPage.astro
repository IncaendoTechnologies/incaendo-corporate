---
import AIAgentsShowcase from './AIAgentsShowcase.astro'
import AIPracticalPath from './AIPracticalPath.astro'

const capabilities = [
  {
    number: '01',
    title: 'Intelligent automation',
    description:
      'Automate repeatable, rules-based steps and use language models where work depends on interpreting text or context.',
    includes: 'Workflow orchestration · Exception routes · Human approval',
    tag: 'MOVE WORK FORWARD',
  },
  {
    number: '02',
    title: 'LLM-powered applications',
    description:
      'Design conversational and task-focused applications around a model chosen for the use case, constraints, and operating environment.',
    includes: 'Assistants · Structured outputs · Model integration',
    tag: 'MAKE SOFTWARE MORE USEFUL',
  },
  {
    number: '03',
    title: 'Knowledge retrieval & RAG',
    description:
      'Retrieve relevant material from approved information sources so answers can be grounded in business context and linked to evidence.',
    includes: 'Content preparation · Retrieval · Source references',
    tag: 'CONNECT KNOWLEDGE',
  },
  {
    number: '04',
    title: 'AI agents & tool integration',
    description:
      'Connect bounded, task-oriented AI workflows to authorized tools and APIs, with permissions and confirmation around consequential actions.',
    includes: 'Scoped tools · API actions · Approval gates',
    tag: 'ACT WITH CONTROL',
  },
  {
    number: '05',
    title: 'AI in existing systems',
    description:
      'Integrate AI into the software, data sources, and processes people already use instead of creating another disconnected destination.',
    includes: 'Business APIs · Existing products · Data flows',
    tag: 'FIT THE REAL WORK',
  },
  {
    number: '06',
    title: 'Evaluation & governance',
    description:
      'Evaluate outputs against defined criteria and design for access control, monitoring, validation, and appropriate human review.',
    includes: 'Quality checks · Access controls · Monitoring',
    tag: 'BUILD TRUST INTO DELIVERY',
  },
]

// Key figures shown around the AI circle once it is clicked. These are
// provisional: none is backed by approved material in this repository yet.
// Set `confirmed: true` on each once verified; while any is unconfirmed, the
// hero shows a short "provisional figures" note.
const heroStats = [
  { value: '100+', label: 'AI Agent Workflows', confirmed: false },
  { value: '20+', label: 'AI Live Deployments', confirmed: false },
  { value: '92%', label: 'AI Accuracy', confirmed: false },
  { value: '24/7', label: 'Workflow Availability', confirmed: false },
  { value: '5+', label: 'Business Use Cases', confirmed: false },
].map((stat, index, all) => {
  // Evenly spaced around one circle (72° apart), starting at the top.
  const angle = -Math.PI / 2 + (index * 2 * Math.PI) / all.length
  return {
    ...stat,
    cos: +Math.cos(angle).toFixed(4),
    sin: +Math.sin(angle).toFixed(4),
  }
})
const statsProvisional = heroStats.some((stat) => !stat.confirmed)
---

<div class="ai-tech-page" data-ai-technology>
  <section class="ai-tech-hero" aria-labelledby="ai-tech-title">
    <div class="site-container ai-tech-hero-grid">
      <div class="ai-tech-hero-copy">
        <p class="eyebrow">
          <span class="eyebrow-dot"></span>AI
        </p>
        <h1 id="ai-tech-title">
          Practical AI.
          <br />
          <span>Built around real business work.</span>
        </h1>
        <p class="ai-tech-lead">
          We build AI-powered applications and integrations that connect
          business data, existing systems, and everyday workflows to useful
          outcomes—with clear boundaries for quality, access, and human
          judgment.
        </p>
        <div class="ai-tech-actions">
          <a class="button button-primary" href="#ai-capabilities">
            Explore our AI capabilities <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="/contact">
            Discuss an AI project{' '}
            <span class="link-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>

      <div class="ai-particles" data-ai-particles data-state="idle">
        <div class="ai-particles-stage" data-particles-stage>
          <canvas aria-hidden="true"></canvas>
          <button
            class="ai-particles-core"
            type="button"
            aria-expanded="false"
            aria-controls="ai-particles-stats"
            aria-label="AI: show key figures"
            data-particles-core
          >
            <b aria-hidden="true">AI</b>
          </button>
          <div
            class="ai-particles-stats"
            id="ai-particles-stats"
            data-particles-stats
            inert
          >
            <ul aria-label="Key figures">
              {heroStats.map((stat, index) => (
                <li
                  class="ai-particles-stat"
                  style={`--cos: ${stat.cos}; --sin: ${stat.sin}; --order: ${index}`}
                >
                  <b>{stat.value}</b>
                  <span>{stat.label}</span>
                </li>
              ))}
            </ul>
            {statsProvisional && (
              <p class="ai-particles-provisional">
                Provisional figures, to be confirmed
              </p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="ai-capabilities section section-soft"
    id="ai-capabilities"
    aria-labelledby="ai-capabilities-title"
  >
    <div class="site-container">
      <div class="ai-section-heading ai-capabilities-heading">
        <div>
          <p class="eyebrow">CAPABILITIES</p>
          <h2 id="ai-capabilities-title">
            The right building blocks.
            <br />
            <span>Connected to your context.</span>
          </h2>
        </div>
        <p>
          From focused workflow improvements to AI-enabled products, each
          capability can be shaped around existing data, systems, and operating
          constraints.
        </p>
      </div>
      <div class="ai-capability-grid">
        {capabilities.map((item) => (
          <article class="ai-detail-card">
            <div class="ai-card-meta">
              <span>{item.number}</span>
              <span>{item.tag}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="ai-includes">
              <span>IN PRACTICE</span>
              <p>{item.includes}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <AIPracticalPath />

  <AIAgentsShowcase />
</div>

<script>
  import '../scripts/ai-particle-hero.js'
</script>

<style>
  .ai-tech-page {
    --ai-panel: #f0ede8;
    --ai-blue-wash: #e9eef2;
    overflow: clip;
    background: var(--color-paper);
  }
  .ai-tech-page section {
    position: relative;
  }
  .ai-tech-page h1,
  .ai-tech-page h2,
  .ai-tech-page h3,
  .ai-tech-page p {
    margin-top: 0;
  }
  .ai-tech-page h2 {
    margin-bottom: 1.1rem;
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    line-height: var(--type-section-line-height);
  }
  .ai-tech-page h2 span,
  .ai-tech-page h1 span {
    color: var(--color-orange-dark);
  }
  .ai-tech-hero {
    display: grid;
    align-items: center;
    padding-block: 55px clamp(1.75rem, 4vh, 3.5rem);
    background:
      radial-gradient(
        ellipse at 92% 14%,
        rgb(244 233 223 / 78%),
        transparent 34%
      ),
      linear-gradient(125deg, #fbfaf8 0%, var(--color-paper) 52%, #f0ece6 100%);
  }
  .ai-tech-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(480px, 1.1fr);
    align-items: center;
    gap: clamp(2.5rem, 5.6vw, 5.3rem);
  }
  .ai-tech-hero-copy {
    max-width: 560px;
  }
  .ai-tech-hero-copy .eyebrow {
    margin-bottom: 1.15rem;
  }
  .ai-tech-hero-copy h1 {
    max-width: 650px;
    margin-bottom: 1.15rem;
    font-size: var(--type-page-hero-size);
    font-weight: var(--type-display-weight);
    letter-spacing: var(--type-display-letter-spacing);
    line-height: var(--type-page-hero-line-height);
  }
  .ai-tech-lead {
    max-width: 550px;
    margin-bottom: 1.55rem;
    color: var(--color-body);
    font-size: var(--type-lead-size);
    line-height: var(--type-lead-line-height);
  }
  .ai-tech-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.35rem;
  }
  .ai-tech-actions .button {
    gap: 0.75rem;
  }

  /* Hero visual: a square particle field sized from its column; clicking
     the AI circle swaps the particles for five key figures */
  .ai-particles {
    position: relative;
    display: grid;
    /* Square field: capped on desktop and limited to the height the hero has
       below the header, so the whole composition fits one screen */
    width: min(
      100%,
      530px,
      max(
        400px,
        calc(
          100svh - var(--site-header-height) - 55px -
            clamp(1.75rem, 4vh, 3.5rem) - 1.5rem
        )
      )
    );
    min-width: 0;
    justify-self: center;
  }
  .ai-particles-stage {
    --orbit-r: 34.5cqmin;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    container-type: size;
  }
  /* Warm light behind the field, softening once the figures show */
  .ai-particles-stage::before {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 50%,
      rgb(244 226 210 / 85%),
      rgb(244 226 210 / 30%) 38%,
      transparent 60%
    );
    content: '';
    pointer-events: none;
    transition: opacity 900ms ease;
  }
  [data-state='open'] .ai-particles-stage::before {
    opacity: 0.6;
  }
  .ai-particles-stage canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Idle: the canvas draws the AI letters in particles, so the button is a
     transparent hit area over them. Open: the solid disc (the <b>) fades in
     at the centre of the figures and the hit area shrinks to it. */
  .ai-particles-core {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    display: grid;
    width: 62cqmin;
    aspect-ratio: 1;
    padding: 0;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transform: translate(-50%, -50%);
  }
  .ai-particles-core:focus-visible {
    outline: 3px solid var(--color-orange);
    outline-offset: 2px;
  }
  .ai-particles-core b {
    display: grid;
    width: clamp(92px, 27cqmin, 170px);
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgb(201 84 43 / 48%);
    border-radius: 50%;
    background: radial-gradient(
      circle at 34% 26%,
      #fff 0%,
      #fbf3ec 52%,
      #f3e3d6 100%
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 90%),
      0 0 0 10px rgb(255 253 250 / 62%),
      0 24px 48px -18px rgb(16 27 45 / 32%);
    font-family: var(--font-heading);
    font-size: clamp(2.6rem, 13.5cqmin, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    /* optical centring: the heading face sits slightly high */
    padding: 0.06em 0.04em 0 0;
    opacity: 0;
    transform: scale(0.92);
    transition:
      opacity 250ms ease,
      transform 300ms var(--ease-out);
  }
  [data-state='open'] .ai-particles-core {
    width: clamp(92px, 27cqmin, 170px);
  }
  [data-state='open'] .ai-particles-core b {
    opacity: 1;
    transform: none;
    transition:
      opacity 400ms ease 300ms,
      transform 500ms var(--ease-out) 300ms;
  }
  [data-state='open'] .ai-particles-core:hover b {
    transform: scale(1.03);
  }

  /* Expanded state: particles fade out fully, then the figures fade in.
     Closing reverses the order, so the two never show at the same time. */
  .ai-particles-stage canvas {
    transition: opacity 250ms ease 250ms;
  }
  [data-state='open'] .ai-particles-stage canvas {
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .ai-particles-stats {
    --orbit-r: 37cqmin;
    position: absolute;
    z-index: 2;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 250ms ease,
      visibility 0s linear 250ms;
  }
  [data-state='open'] .ai-particles-stats {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 450ms ease 420ms,
      visibility 0s linear 420ms;
  }
  /* A faint guide circle ties the five figures to the centre */
  .ai-particles-stats::before {
    position: absolute;
    top: 50%;
    left: 50%;
    width: calc(var(--orbit-r) * 2);
    aspect-ratio: 1;
    border: 1px dashed rgb(16 27 45 / 14%);
    border-radius: 50%;
    content: '';
    transform: translate(-50%, -50%);
  }
  .ai-particles-stats ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ai-particles-stat {
    position: absolute;
    top: calc(50% + var(--sin) * var(--orbit-r));
    left: calc(50% + var(--cos) * var(--orbit-r));
    display: grid;
    width: max-content;
    min-width: 30cqmin;
    justify-items: center;
    gap: 0.15rem;
    padding: 0.65rem 0.95rem 0.7rem;
    border: 1px solid rgb(16 27 45 / 8%);
    border-radius: 14px;
    background: rgb(255 253 250 / 92%);
    box-shadow: 0 12px 26px -18px rgb(16 27 45 / 45%);
    text-align: center;
    transform: translate(-50%, -50%) scale(0.94);
    transition: transform 450ms var(--ease-out);
  }
  [data-state='open'] .ai-particles-stat {
    transform: translate(-50%, -50%);
    transition: transform 650ms var(--ease-out)
      calc(420ms + var(--order) * 60ms);
  }
  .ai-particles-stat b {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 8cqmin, 2.75rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .ai-particles-stat span {
    color: var(--color-body);
    font-size: clamp(0.84rem, 2.85cqmin, 1rem);
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }
  .ai-particles .ai-particles-provisional {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    color: #756b64;
    font-size: 0.74rem;
    font-weight: 600;
  }
  .ai-particles-provisional::before {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c9a13f;
    content: '';
  }
  /* Small laptops and landscape tablets: the field fills its column, so the
     figures sit a little closer and the core is slightly smaller */
  @media (min-width: 801px) and (max-width: 1100px) {
    .ai-particles-stats {
      --orbit-r: 33cqmin;
    }
    [data-state='open'] .ai-particles-core,
    .ai-particles-core b {
      width: 25cqmin;
    }
    .ai-particles-stat {
      padding-inline: 0.75rem;
    }
  }
  /* Narrow screens: the field fills the column, so cards get a fixed,
     narrower width with wrapping labels, figures move out a little, and the
     core eases back (transform only, so nothing reflows) */
  @media (max-width: 800px) {
    .ai-particles-stats {
      --orbit-r: 36cqmin;
    }
    [data-state='open'] .ai-particles-core {
      transform: translate(-50%, -50%) scale(0.8);
    }
    .ai-particles-stat {
      width: 27cqmin;
      min-width: 0;
      padding: 0.5rem 0.35rem 0.55rem;
      border-radius: 12px;
    }
    .ai-particles-stat b {
      font-size: 7.4cqmin;
    }
    .ai-particles-stat span {
      font-size: max(0.72rem, 3.3cqmin);
      white-space: normal;
    }
  }
  /* Smallest phones: a slightly smaller core keeps clear space */
  @container (max-width: 340px) {
    [data-state='open'] .ai-particles-core,
    .ai-particles-core b {
      width: 27cqmin;
    }
    .ai-particles-core b {
      font-size: 13.5cqmin;
    }
  }

  .section {
    padding-block: clamp(4.4rem, 7.2vw, 6.8rem);
  }
  .ai-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4.8rem);
    margin-bottom: 2.5rem;
  }
  .ai-section-heading > div {
    max-width: 680px;
  }
  .ai-section-heading h2 {
    margin-bottom: 0;
  }
  .ai-section-heading h2 span {
    color: var(--color-orange-dark);
  }
  .ai-section-heading > p {
    max-width: 440px;
    margin-bottom: 0.15rem;
    color: var(--color-body);
    font-size: 0.94rem;
    line-height: 1.7;
  }
  .ai-capabilities {
    background: #f0ede8;
  }
  .ai-capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .ai-detail-card {
    display: flex;
    min-height: 250px;
    flex-direction: column;
    padding: 1.4rem 1.45rem 1.25rem;
    border: 1px solid #e1ddd6;
    border-radius: var(--radius-medium);
    background: rgb(255 255 255 / 78%);
    box-shadow: 0 8px 24px rgb(16 27 45 / 3%);
    transition:
      transform 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out),
      border-color 260ms ease;
  }
  .ai-detail-card:hover {
    transform: translateY(-4px);
    border-color: rgb(168 65 33 / 36%);
    box-shadow: 0 17px 38px rgb(16 27 45 / 9%);
  }
  .ai-card-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 1.35rem;
    color: var(--color-orange-dark);
    font-size: 0.59rem;
    font-weight: 750;
    letter-spacing: 0.11em;
  }
  .ai-card-meta span:last-child {
    color: var(--color-muted);
    font-size: 0.52rem;
    text-align: right;
  }
  .ai-detail-card h3 {
    margin-bottom: 0.65rem;
    font-size: 1.14rem;
    font-weight: 650;
    letter-spacing: -0.04em;
  }
  .ai-detail-card > p {
    margin-bottom: 1.1rem;
    color: var(--color-body);
    font-size: 0.81rem;
    line-height: 1.62;
  }
  .ai-includes {
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid #eae7e2;
  }
  .ai-includes > span {
    color: var(--color-muted);
    font-size: 0.55rem;
    font-weight: 750;
    letter-spacing: 0.11em;
  }
  .ai-includes p {
    margin: 0.22rem 0 0;
    color: var(--color-ink);
    font-size: 0.67rem;
    line-height: 1.5;
  }

  @media (max-width: 1050px) {
    .ai-tech-hero-grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(390px, 1.1fr);
      gap: 2.3rem;
    }
    .ai-tech-hero-copy h1 {
      font-size: clamp(2.55rem, 4.25vw, 3.5rem);
    }
  }
  @media (max-width: 900px) {
    .ai-tech-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .ai-tech-hero-copy {
      max-width: 700px;
    }
    .ai-particles {
      width: min(100%, 600px);
    }
  }
  @media (max-width: 800px) {
    .ai-tech-hero {
      min-height: 0;
    }
    .ai-tech-hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
    .ai-tech-hero-copy {
      max-width: 700px;
    }
    .ai-tech-hero-copy h1 {
      max-width: 700px;
      font-size: clamp(2.7rem, 7vw, 4rem);
    }
    .ai-section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 1rem;
    }
    .ai-section-heading > p {
      max-width: 650px;
      margin: 0;
    }
    .ai-capability-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .ai-tech-hero {
      padding-block: 55px 3rem;
    }
    .ai-tech-hero-grid {
      gap: 2rem;
    }
    .ai-tech-hero-copy h1 {
      font-size: clamp(2.45rem, 10vw, 3.3rem);
    }
    .ai-tech-lead {
      font-size: 0.98rem;
      line-height: 1.62;
    }
    .ai-tech-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.9rem;
    }
    .ai-tech-actions .button {
      width: 100%;
      justify-content: space-between;
    }
    .ai-tech-page h2 {
      font-size: clamp(1.9rem, 8vw, 2.45rem);
    }
    .section {
      padding-block: 3.8rem;
    }
    .ai-section-heading {
      margin-bottom: 1.7rem;
    }
    .ai-section-heading > p {
      font-size: 0.86rem;
    }
    .ai-capability-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.7rem;
    }
    .ai-detail-card {
      min-height: 0;
      padding: 1.15rem;
    }
    .ai-card-meta {
      margin-bottom: 0.9rem;
    }
    .ai-detail-card > p {
      margin-bottom: 0.8rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-detail-card,
    .ai-particles *,
    .ai-particles *::before {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
