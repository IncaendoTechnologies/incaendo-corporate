---
import {
  Users,
  HeartPulse,
  Check,
  ChevronLeft,
  ChevronRight,
  ArrowUpRight,
} from 'lucide-react'

const productCards = [
  {
    id: 'hrms',
    name: 'Incaendo HRMS',
    category: 'Human Resources Platform',
    description:
      'Manage your people, attendance, leave, payroll, and performance from one connected HR platform.',
    icon: Users,
    tone: 'orange',
    urlHost: 'hrms.incaendo.com',
    exploreHref: 'https://hrms.incaendo.com/',
    learnHref: '/products/hrm',
    exploreText: 'Explore',
    learnText: 'Learn More',
    external: true,
    highlights: [
      'Employee & attendance management',
      'Leave & payroll management',
      'Performance & appraisal',
      'Employee self-service',
    ],
    slides: [
      {
        image: '/products/hrms-workforce-directory.jpg',
        alt: 'Incaendo HRMS workforce directory showing active staff counts, department rosters, and employee records',
        caption: 'Team Roster & Staff Analytics',
      },
      {
        image: '/products/hrms-leave-management.jpg',
        alt: 'Incaendo HRMS leave management showing team leave calendar and pending approvals',
        caption: 'Leave Approvals & Team Calendar',
      },
      {
        image: '/products/hrms-employee-self-service.jpg',
        alt: 'Incaendo HRMS employee profile and personal information self-service view',
        caption: 'Employee Profile & Self-Service',
      },
      {
        image: '/products/hrms-leave-overview.png',
        alt: 'Incaendo HRMS leave balances, leave types, and transaction history overview',
        caption: 'Leave Entitlements & Balances',
      },
    ],
  },
  {
    id: 'nirvan',
    name: 'NIRVAN',
    category: 'Healthcare CRM & Hospital Management Software',
    description:
      'Simplify healthcare operations with one connected platform for clinics, hospitals, and growing healthcare networks.',
    icon: HeartPulse,
    tone: 'blue',
    urlHost: 'nirvan.incaendo.com',
    exploreHref: '/products/nirvan',
    learnHref: '/products/nirvan',
    exploreText: 'Explore',
    learnText: 'Learn More',
    external: true,
    highlights: [
      'Clinic & patient management',
      'Hospital appointments and workflows',
      'Multi-hospital management',
      'Enterprise healthcare operations',
    ],
    slides: [
      {
        image: '/products/nirvan-hospital-operations.png',
        alt: 'NIRVAN inpatient operations dashboard showing ward bed occupancy and clinician schedules',
        caption: 'Bed Occupancy & Ward Operations',
      },
      {
        image: '/products/nirvan-appointments-crm.png',
        alt: 'NIRVAN healthcare CRM showing OPD doctor schedules and telemedicine queues',
        caption: 'OPD & Telemedicine Rosters',
      },
      {
        image: '/products/nirvan-pharmacy-dispensing.png',
        alt: 'NIRVAN central pharmacy dispensing dashboard with e-prescription indents and formulary management',
        caption: 'Digital Pharmacy & E-Prescriptions',
      },
      {
        image: '/products/nirvan-diagnostics-lab.png',
        alt: 'NIRVAN diagnostic pathology and radiology center tracking sample barcodes and turnaround time',
        caption: 'Diagnostic Pathology & Imaging LIMS',
      },
    ],
  },
]
---

<section
  class="saas-section"
  id="saas-products"
  aria-labelledby="saas-products-title"
>
  <div class="site-container">
    <div class="saas-intro reveal">
      <p class="eyebrow">
        <span class="eyebrow-dot"></span>Software as a Service{' '}
        <span class="saas-eyebrow-case">(SaaS)</span>
      </p>
      <h2 id="saas-products-title">
        <span>Grow Your Business</span> with Software Built for the Way You
        Work.
      </h2>
      <p class="saas-lead">
        From managing people and operations to centralizing healthcare and business
        workflows, Incaendo's business software helps bring essential operations into
        one place. Choose the products you need, simplify everyday work, and scale as
        your business grows.
      </p>
      <div class="saas-actions">
        <a class="text-link saas-text-link" href="/contact">
          Talk to our team{' '}
          <span class="link-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
    </div>

    <!-- Two Separate Product Cards Grid -->
    <div
      class="saas-products reveal"
      id="saas-product-list"
      aria-label="SaaS products"
      data-reveal-stagger
    >
      {productCards.map((product) => {
        const Icon = product.icon
        return (
          <article class={`saas-product-card is-${product.tone}`} data-reveal-item>
            <!-- Card Header: Icon & Category Badge -->
            <div class="saas-card-top">
              <span class={`saas-icon is-${product.tone}`} aria-hidden="true">
                <Icon size={24} strokeWidth={1.8} />
              </span>
              <span class="saas-product-badge">{product.category}</span>
            </div>

            <!-- Card Heading & Description -->
            <div class="saas-card-copy">
              <h3 class="saas-product-name">{product.name}</h3>
              <p class="saas-product-desc">{product.description}</p>
            </div>

            <!-- Independent Image Carousel inside each card -->
            <div
              class="card-carousel-wrapper"
              data-card-carousel
              data-product-id={product.id}
              aria-roledescription="carousel"
              aria-label={`${product.name} Screenshots`}
            >
              <!-- Browser Mockup Chrome Bar -->
              <div class="card-browser-chrome">
                <div class="chrome-dots" aria-hidden="true">
                  <span class="chrome-dot is-red"></span>
                  <span class="chrome-dot is-yellow"></span>
                  <span class="chrome-dot is-green"></span>
                </div>
                <div class="chrome-url-bar">
                  <svg
                    class="chrome-lock-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                  <span class="chrome-url-text">{product.urlHost}</span>
                </div>
                <span class="chrome-status-tag">Live Platform</span>
              </div>

              <!-- Viewport & Slider Track -->
              <div class="card-carousel-viewport">
                <div
                  class="card-carousel-track"
                  data-carousel-track
                  style="transform: translateX(0%);"
                >
                  {product.slides.map((slide, slideIdx) => (
                    <div
                      class={`card-carousel-slide ${slideIdx === 0 ? 'is-active' : ''}`}
                      data-carousel-slide={slideIdx}
                      aria-hidden={slideIdx === 0 ? 'false' : 'true'}
                    >
                      <img
                        src={slide.image}
                        alt={slide.alt}
                        width="1024"
                        height="484"
                        loading={slideIdx === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                        class="carousel-img"
                      />
                    </div>
                  ))}
                </div>

                <!-- Floating Navigation Arrows -->
                <button
                  type="button"
                  class="carousel-nav-btn btn-prev"
                  data-carousel-prev
                  aria-label={`Previous ${product.name} image`}
                >
                  <ChevronLeft size={18} strokeWidth={2.4} aria-hidden="true" />
                </button>
                <button
                  type="button"
                  class="carousel-nav-btn btn-next"
                  data-carousel-next
                  aria-label={`Next ${product.name} image`}
                >
                  <ChevronRight size={18} strokeWidth={2.4} aria-hidden="true" />
                </button>

                <!-- Bottom Floating Overlay Bar -->
                <div class="carousel-overlay-bar">
                  <!-- Slide Caption Tag -->
                  <div
                    class="carousel-caption-pill"
                    data-carousel-caption
                  >
                    <span class="caption-text">{product.slides[0].caption}</span>
                    <ArrowUpRight size={12} strokeWidth={2.2} className="caption-arrow" aria-hidden="true" />
                  </div>

                  <!-- Pagination Dots with Active Pill -->
                  <div
                    class="carousel-dots-list"
                    role="tablist"
                    aria-label={`${product.name} slide navigation`}
                  >
                    {product.slides.map((slide, dotIdx) => (
                      <button
                        type="button"
                        class={`carousel-dot ${dotIdx === 0 ? 'is-active' : ''}`}
                        data-carousel-dot={dotIdx}
                        role="tab"
                        aria-selected={dotIdx === 0 ? 'true' : 'false'}
                        aria-label={`Go to slide ${dotIdx + 1}: ${slide.caption}`}
                      >
                        <span class="visually-hidden">Slide {dotIdx + 1}</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <!-- Key Highlights List -->
            <div class="saas-highlights">
              <span class="saas-highlights-title">Key highlights:</span>
              <ul class="saas-highlights-list">
                {product.highlights.map((highlight) => (
                  <li>
                    <span class={`saas-check is-${product.tone}`} aria-hidden="true">
                      <Check size={14} strokeWidth={2.4} />
                    </span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Card Bottom Actions -->
            <div class="saas-card-actions">
              <a
                href={product.exploreHref}
                class="button button-primary saas-btn-explore"
                target={product.external ? '_blank' : undefined}
                rel={product.external ? 'noopener noreferrer' : undefined}
                aria-label={`Explore ${product.name}`}
              >
                {product.exploreText} <span aria-hidden="true">→</span>
              </a>
              <a
                href={product.learnHref}
                class="saas-link-learn"
                target={product.external ? '_blank' : undefined}
                rel={product.external ? 'noopener noreferrer' : undefined}
                aria-label={`Learn more about ${product.name}`}
              >
                {product.learnText} <span class="link-arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        )
      })}
    </div>
  </div>
</section>

<style>
  .saas-section {
    position: relative;
    padding-block: var(--section-space-sm) var(--section-space-md);
    background: var(--color-paper);
  }
  .saas-section h2,
  .saas-section h3,
  .saas-section p {
    margin-top: 0;
  }

  /* --- Intro ------------------------------------------------------------- */

  .saas-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto clamp(2.25rem, 3.8vw, 3.25rem);
    text-align: center;
  }
  .saas-intro h2 {
    max-width: 820px;
    margin-bottom: 1rem;
    color: var(--color-ink);
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
    text-wrap: balance;
  }
  .saas-intro h2 span {
    color: var(--color-orange-dark);
  }
  .saas-eyebrow-case {
    letter-spacing: 0.06em;
    text-transform: none;
  }
  .saas-lead {
    max-width: 680px;
    margin-bottom: 1.5rem;
    color: var(--color-body);
    font-size: var(--type-intro-size);
    line-height: var(--type-intro-line-height);
    text-wrap: pretty;
  }
  .saas-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem 1.35rem;
  }
  .saas-text-link {
    color: var(--color-orange-dark);
  }
  .saas-text-link:hover {
    color: var(--color-orange);
  }

  /* --- Product cards grid (2-column spacious layout) --------------------- */

  .saas-products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 3vw, 2.75rem);
    max-width: 1260px;
    margin-inline: auto;
    padding: 0;
  }

  .saas-product-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.75rem, 2.5vw, 2.35rem) clamp(1.5rem, 2.2vw, 2.25rem);
    border: 1px solid #ebe5dc;
    border-radius: var(--radius-large, 24px);
    background: #ffffff;
    box-shadow: 0 14px 36px -22px rgba(16, 27, 45, 0.16);
    transition:
      transform var(--duration-standard) var(--ease-out),
      box-shadow var(--duration-standard) ease,
      border-color var(--duration-fast) ease;
  }

  .saas-product-card:hover {
    border-color: rgba(201, 84, 43, 0.35);
    box-shadow: 0 24px 52px -20px rgba(16, 27, 45, 0.22);
    transform: translateY(-4px);
  }

  .saas-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }

  /* Icon tiles, toned from the existing palette */
  .saas-icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border-radius: 12px;
    transition:
      background var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }
  .saas-icon.is-orange {
    background: rgb(201 84 43 / 11%);
    color: var(--color-orange-dark);
  }
  .saas-icon.is-blue {
    background: rgb(84 123 157 / 13%);
    color: #2b577e;
  }

  .saas-product-card:hover .saas-icon.is-orange {
    background: var(--color-orange);
    color: #ffffff;
  }
  .saas-product-card:hover .saas-icon.is-blue {
    background: #2b577e;
    color: #ffffff;
  }

  .saas-product-badge {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: #f7f4ef;
    border: 1px solid #ede7dd;
    color: var(--color-navy);
    font-size: var(--type-meta-size);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: none;
    line-height: 1.3;
  }

  .saas-card-copy {
    margin-bottom: 1.25rem;
  }

  .saas-product-name {
    margin: 0 0 0.5rem;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: var(--type-card-title-lg-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .saas-product-desc {
    color: var(--color-body);
    font-size: var(--type-card-text-size);
    line-height: 1.55;
    margin: 0;
  }

  /* --- Image Carousel Component Inside Card ------------------------------ */

  .card-carousel-wrapper {
    position: relative;
    border-radius: 16px;
    background: #f8f7f4;
    border: 1px solid #ebe5dc;
    box-shadow: 0 8px 24px -12px rgba(16, 27, 45, 0.12);
    overflow: hidden;
    margin-bottom: 1.5rem;
    user-select: none;
  }

  .card-browser-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 14px;
    background: #ffffff;
    border-bottom: 1px solid #eee8df;
  }

  .chrome-dots {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .chrome-dot {
    width: 8.5px;
    height: 8.5px;
    border-radius: 50%;
  }
  .chrome-dot.is-red { background: #ef4444; }
  .chrome-dot.is-yellow { background: #f59e0b; }
  .chrome-dot.is-green { background: #10b981; }

  .chrome-url-bar {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 10px;
    background: #f5f2ec;
    border-radius: 999px;
    font-size: 0.72rem;
    font-family: monospace;
    color: #556270;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chrome-lock-icon {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    color: #8c97a4;
  }

  .chrome-status-tag {
    font-size: 0.68rem;
    font-weight: 700;
    color: #2b577e;
    background: #eef5fb;
    padding: 2px 7px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .card-carousel-viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1024 / 484;
    background: #fdfdfc;
  }

  .card-carousel-track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
    will-change: transform;
  }

  .card-carousel-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Floating Navigation Arrows */
  .carousel-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(16, 27, 45, 0.12);
    box-shadow: 0 4px 14px rgba(16, 27, 45, 0.18);
    display: grid;
    place-items: center;
    color: var(--color-navy);
    cursor: pointer;
    z-index: 5;
    transition:
      background var(--duration-fast) ease,
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      transform var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .carousel-nav-btn.btn-prev {
    left: 10px;
  }

  .carousel-nav-btn.btn-next {
    right: 10px;
  }

  .carousel-nav-btn:hover {
    background: var(--color-orange);
    color: #ffffff;
    border-color: var(--color-orange);
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 18px rgba(201, 84, 43, 0.32);
  }

  .carousel-nav-btn:focus-visible {
    outline: 2px solid var(--color-orange);
    outline-offset: 2px;
  }

  /* Bottom Floating Bar inside Carousel */
  .carousel-overlay-bar {
    position: absolute;
    bottom: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    z-index: 6;
  }

  .carousel-caption-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    background: rgba(16, 27, 45, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 999px;
    color: #ffffff;
    font-size: var(--type-label-size);
    font-weight: 600;
    letter-spacing: 0.01em;
    box-shadow: 0 4px 12px rgba(16, 27, 45, 0.22);
    max-width: 65%;
    overflow: hidden;
    pointer-events: auto;
    transition: opacity 0.25s ease;
  }

  .caption-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .caption-arrow {
    color: #ff9d71;
    flex-shrink: 0;
  }

  .carousel-dots-list {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 9px;
    background: rgba(16, 27, 45, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(16, 27, 45, 0.22);
    pointer-events: auto;
  }

  .carousel-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    border: none;
    padding: 0;
    cursor: pointer;
    transition:
      width 0.3s cubic-bezier(0.25, 1, 0.5, 1),
      border-radius 0.3s ease,
      background 0.3s ease;
  }

  .carousel-dot:hover {
    background: rgba(255, 255, 255, 0.85);
  }

  .carousel-dot.is-active {
    width: 20px;
    border-radius: 999px;
    background: var(--color-orange);
  }

  .carousel-dot:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  /* --- Key Highlights ---------------------------------------------------- */

  .saas-highlights {
    margin-top: auto;
    margin-bottom: 1.5rem;
    padding-top: 1.15rem;
    border-top: 1px solid #f0eae1;
  }

  .saas-highlights-title {
    display: block;
    margin-bottom: 0.75rem;
    color: var(--color-navy);
    font-size: var(--type-label-size);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .saas-highlights-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .saas-highlights-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    color: var(--color-body);
    font-size: var(--type-card-text-size);
    line-height: 1.4;
  }

  .saas-check {
    display: grid;
    width: 18px;
    height: 18px;
    place-items: center;
    flex-shrink: 0;
    margin-top: 1px;
    border-radius: 50%;
  }

  .saas-check.is-orange {
    background: rgb(201 84 43 / 14%);
    color: var(--color-orange-dark);
  }

  .saas-check.is-blue {
    background: rgb(43 87 126 / 14%);
    color: #2b577e;
  }

  /* --- Card Actions ------------------------------------------------------ */

  .saas-card-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #f0eae1;
  }

  .saas-btn-explore {
    padding: 0.7rem 1.6rem;
    border-radius: 999px;
    text-decoration: none;
  }

  .saas-link-learn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-navy);
    font-size: var(--type-ui-size);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .saas-link-learn:hover {
    color: var(--color-orange);
  }

  .saas-link-learn .link-arrow {
    transition: transform var(--duration-fast) ease;
  }

  .saas-link-learn:hover .link-arrow {
    transform: translateX(3px);
  }

  /* --- Responsive Breakpoints -------------------------------------------- */

  @media (max-width: 1040px) {
    /* minmax(0, 1fr) lets the column shrink below its content's minimum
       width, so cards never push past narrow phone screens. */
    .saas-products {
      grid-template-columns: minmax(0, 1fr);
      max-width: 680px;
    }

    .saas-highlights-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .saas-product-card {
      padding: 1.35rem 1.15rem;
    }

    .saas-card-top {
      margin-bottom: 0.9rem;
    }

    .saas-product-badge {
      padding: 0.25rem 0.65rem;
    }

    .carousel-nav-btn {
      width: 28px;
      height: 28px;
    }

    .carousel-caption-pill {
      padding: 3px 8px;
      max-width: 62%;
    }

    .carousel-dots-list {
      padding: 4px 7px;
      gap: 4px;
    }

    .carousel-dot.is-active {
      width: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-carousel-track {
      transition: none !important;
    }
    .saas-product-card {
      transition: none !important;
    }
    .saas-product-card:hover {
      transform: none !important;
    }
  }
</style>

<script>
  function initCardCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>('[data-card-carousel]')
    if (!carousels.length) return

    carousels.forEach((carouselEl) => {
      // Prevent double init
      if (carouselEl.dataset.initialized === 'true') return
      carouselEl.dataset.initialized = 'true'

      const track = carouselEl.querySelector<HTMLElement>('[data-carousel-track]')
      const slides = Array.from(carouselEl.querySelectorAll<HTMLElement>('[data-carousel-slide]'))
      const prevBtn = carouselEl.querySelector<HTMLButtonElement>('[data-carousel-prev]')
      const nextBtn = carouselEl.querySelector<HTMLButtonElement>('[data-carousel-next]')
      const dots = Array.from(carouselEl.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'))
      const captionPill = carouselEl.querySelector<HTMLElement>('[data-carousel-caption]')
      const captionText = captionPill?.querySelector<HTMLElement>('.caption-text')

      if (!track || slides.length === 0) return

      // Use predefined captions from dots aria-label
      const dotLabels = dots.map((d) => {
        const label = d.getAttribute('aria-label') || ''
        return label.replace(/^Go to slide \d+:\s*/, '')
      })

      let currentIdx = 0
      const totalSlides = slides.length
      let autoPlayTimer: any = null
      const AUTO_PLAY_INTERVAL = 5500
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

      function updateSlide(idx: number) {
        currentIdx = (idx + totalSlides) % totalSlides
        if (track) {
          track.style.transform = `translateX(-${currentIdx * 100}%)`
        }

        // Update slides aria-hidden
        slides.forEach((s, i) => {
          const isActive = i === currentIdx
          s.classList.toggle('is-active', isActive)
          s.setAttribute('aria-hidden', isActive ? 'false' : 'true')
        })

        // Update dots
        dots.forEach((dot, i) => {
          const isActive = i === currentIdx
          dot.classList.toggle('is-active', isActive)
          dot.setAttribute('aria-selected', isActive ? 'true' : 'false')
        })

        // Update caption text
        if (captionText && dotLabels[currentIdx]) {
          captionText.textContent = dotLabels[currentIdx]
        }
      }

      function nextSlide() {
        updateSlide(currentIdx + 1)
      }

      function prevSlide() {
        updateSlide(currentIdx - 1)
      }

      // Arrow listeners
      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation()
        nextSlide()
        resetTimer()
      })

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation()
        prevSlide()
        resetTimer()
      })

      // Dot listeners
      dots.forEach((dot, dotIdx) => {
        dot.addEventListener('click', (e) => {
          e.stopPropagation()
          updateSlide(dotIdx)
          resetTimer()
        })
      })

      // Touch / Swipe support
      let touchStartX = 0
      let touchEndX = 0

      carouselEl.addEventListener('touchstart', (e: TouchEvent) => {
        if (e.changedTouches?.[0]) {
          touchStartX = e.changedTouches[0].screenX
        }
      }, { passive: true })

      carouselEl.addEventListener('touchend', (e: TouchEvent) => {
        if (e.changedTouches?.[0]) {
          touchEndX = e.changedTouches[0].screenX
          const diff = touchEndX - touchStartX
          if (Math.abs(diff) > 40) {
            if (diff < 0) {
              nextSlide()
            } else {
              prevSlide()
            }
            resetTimer()
          }
        }
      }, { passive: true })

      // Keyboard support within card
      carouselEl.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault()
          prevSlide()
          resetTimer()
        } else if (e.key === 'ArrowRight') {
          e.preventDefault()
          nextSlide()
          resetTimer()
        }
      })

      // Autoplay management
      function startTimer() {
        if (prefersReducedMotion) return
        stopTimer()
        autoPlayTimer = window.setInterval(nextSlide, AUTO_PLAY_INTERVAL)
      }

      function stopTimer() {
        if (autoPlayTimer) {
          clearInterval(autoPlayTimer)
          autoPlayTimer = null
        }
      }

      function resetTimer() {
        stopTimer()
        startTimer()
      }

      // Pause on hover or focus
      carouselEl.addEventListener('mouseenter', stopTimer)
      carouselEl.addEventListener('mouseleave', startTimer)
      carouselEl.addEventListener('focusin', stopTimer)
      carouselEl.addEventListener('focusout', startTimer)

      // Start initial autoplay
      startTimer()
    })
  }

  // Support standard navigation and Astro view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCardCarousels)
  } else {
    initCardCarousels()
  }
  document.addEventListener('astro:page-load', initCardCarousels)
</script>
