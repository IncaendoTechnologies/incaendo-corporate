  .web-dashboard-main > small {
    color: var(--color-orange-dark);
    font-size: 0.47rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .web-dashboard-main > strong {
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 650;
  }
  .web-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.35rem;
