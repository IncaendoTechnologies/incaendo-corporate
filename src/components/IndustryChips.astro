---
// Industry labels for a project, as design system category badges
// (inc-badge-brand). Labels come from the project data and are editorial
// classifications, not official industry designations.
// Props: industries (string[]), class (optional extra class for the list).
const { industries = [], class: className } = Astro.props
---

{industries.length > 0 && (
  <ul class:list={['industry-chips', className]} aria-label="Industries">
    {industries.map((industry) => (
      <li class="inc-badge inc-badge-brand">{industry}</li>
    ))}
  </ul>
)}

<style>
  .industry-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .industry-chips > li {
    white-space: nowrap;
  }
</style>
