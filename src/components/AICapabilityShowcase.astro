        <br />
        <span>Purpose makes it useful.</span>
      </h2>
      <p class="section-intro">
        The best technology starts with a clear understanding of the problem.
        Explore a practical perspective on AI, responsible implementation, and
        the questions worth asking before you begin.
      </p>
    </div>

    <div
      class="ai-capability-list reveal"
      data-reveal-stagger
      data-ai-stagger
      role="group"
      aria-label="AI implementation lifecycle stages"
    >
      {capabilities.map((capability, index) => (
        <button
          class="ai-capability"
          type="button"
          data-ai-capability={capability.id}
          data-ai-caption={capability.caption}
          aria-pressed={index === 0 ? 'true' : 'false'}
          aria-controls="ai-capability-visual"
          data-reveal-item
        >
          <span class="ai-capability-number">{capability.number}</span>
          <span class="ai-capability-copy">
            <span class="ai-capability-title">{capability.title}</span>
            <span class="ai-capability-detail">{capability.detail}</span>
          </span>
          <span class="ai-capability-indicator" aria-hidden="true">
            ↗
          </span>
        </button>
      ))}
    </div>

    <a class="text-link ai-section-link" href="/ai-technology">
