---
const stats = [
  {
    value: 100,
    label: 'Projects Delivered',
    icon: 'projects',
    tone: 'orange',
    slot: 'top-left',
  },
  {
    value: 15,
    label: 'Years of Experience',
    icon: 'years',
    tone: 'blue',
    slot: 'top-right',
  },
  {
    value: 79,
    label: 'Technology Experts',
    icon: 'experts',
    tone: 'blue',
    slot: 'bottom-left',
  },
  {
    value: 10,
    label: 'Industries Worked With',
    icon: 'industries',
    tone: 'orange',
    slot: 'bottom-right',
  },
]
---

<div class="hero-visual home-tech-visual" data-hero-stats>
  <div class="home-visual-stage">
    <div class="home-visual-scene">
      <svg
        class="home-visual-orbits"
        viewBox="0 0 600 500"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          class="home-orbit-orange"
          d="M61 253 C67 124 160 49 294 57 C433 65 535 138 535 250 C535 350 448 426 305 431 C168 436 67 359 61 253"
        />
        <path class="home-orbit-blue" d="M72 218 C80 147 133 106 207 101" />
        <path class="home-orbit-orange" d="M400 110 C492 144 525 225 499 304" />
        <path class="home-orbit-blue" d="M103 342 C146 384 198 391 248 370" />
        <g class="home-visual-dots">
          <circle cx="24" cy="205" r="1.5" />
          <circle cx="36" cy="205" r="1.5" />
          <circle cx="48" cy="205" r="1.5" />
          <circle cx="24" cy="217" r="1.5" />
          <circle cx="36" cy="217" r="1.5" />
          <circle cx="48" cy="217" r="1.5" />
          <circle cx="552" cy="360" r="1.5" />
          <circle cx="564" cy="360" r="1.5" />
          <circle cx="576" cy="360" r="1.5" />
          <circle cx="552" cy="372" r="1.5" />
          <circle cx="564" cy="372" r="1.5" />
          <circle cx="576" cy="372" r="1.5" />
        </g>
        <g class="home-visual-badge home-badge-cloud">
          <rect x="278" y="63" width="48" height="48" rx="13" />
          <path d="M291 91a6 6 0 0 1 1.2-11.9 8 8 0 0 1 15.1 2.2A5.1 5.1 0 1 1 308 91z" />
        </g>
        <g class="home-visual-badge home-badge-chart">
          <rect x="34" y="252" width="44" height="44" rx="12" />
          <path d="M46 284v-7m8 7v-15m8 15v-21m8 21v-11" />
        </g>
        <g class="home-visual-badge home-badge-code">
          <rect x="537" y="98" width="40" height="40" rx="12" />
          <path d="m551 109-6 9 6 9m7-18 6 9-6 9" />
        </g>
        <circle class="home-orbit-node is-orange" r="3">
          <animateMotion
            dur="18s"
            begin="-2s"
            repeatCount="indefinite"
            path="M61 253 C67 124 160 49 294 57 C433 65 535 138 535 250 C535 350 448 426 305 431 C168 436 67 359 61 253"
          />
        </circle>
        <circle class="home-orbit-node is-blue" r="2.6">
          <animateMotion
            dur="21s"
            begin="-5s"
            repeatCount="indefinite"
            path="M61 253 C67 124 160 49 294 57 C433 65 535 138 535 250 C535 350 448 426 305 431 C168 436 67 359 61 253"
          />
        </circle>
        <circle class="home-orbit-node is-orange" r="2.4">
          <animateMotion
            dur="16s"
            begin="-3.4s"
            repeatCount="indefinite"
            path="M103 342 C146 384 198 391 248 370"
          />
        </circle>
      </svg>

      <figure class="home-laptop">
        <div class="home-laptop-screen">
          <div class="home-dashboard" aria-hidden="true">
            <aside class="home-dashboard-sidebar">
              <span class="home-dashboard-brand">
                <i></i> INCAENDO
              </span>
              <span class="home-dashboard-nav is-current">
                <i></i> Overview
              </span>
              <span class="home-dashboard-nav">
                <i></i> Projects
              </span>
              <span class="home-dashboard-nav">
                <i></i> Services
              </span>
              <span class="home-dashboard-nav">
                <i></i> Insights
              </span>
              <span class="home-dashboard-profile">
                <i>IN</i> Workspace
              </span>
            </aside>
            <div class="home-dashboard-main">
              <div class="home-dashboard-topbar">
                <span>YOUR WORKSPACE</span>
                <span class="home-dashboard-avatar">I</span>
              </div>
              <div class="home-dashboard-heading">
                <span>Technology overview</span>
                <b>Solutions for what’s next.</b>
              </div>
              <div class="home-dashboard-services">
                <span class="home-dashboard-service">
                  <i class="service-web"></i>Web Applications
                </span>
                <span class="home-dashboard-service">
                  <i class="service-mobile"></i>Mobile Apps
                </span>
                <span class="home-dashboard-service">
                  <i class="service-ai"></i>AI Solutions
                </span>
                <span class="home-dashboard-service">
                  <i class="service-cloud"></i>Cloud Platforms
                </span>
                <span class="home-dashboard-service">
                  <i class="service-integrations"></i>Integrations
                </span>
              </div>
              <div class="home-dashboard-bottom">
                <div class="home-dashboard-chart">
                  <span>Delivery activity</span>
                  <svg viewBox="0 0 180 52" preserveAspectRatio="none">
                    <path
                      class="chart-area"
                      d="M0 43 C20 39 21 26 41 31 S65 34 82 21 108 30 126 17 151 21 180 5 V52 H0Z"
                    />
                    <path
                      class="chart-line"
                      d="M0 43 C20 39 21 26 41 31 S65 34 82 21 108 30 126 17 151 21 180 5"
                    />
                  </svg>
                  <div>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                </div>
                <div class="home-dashboard-status">
                  <span>CONNECTED SERVICES</span>
                  <b>
                    <i></i> Web applications
                  </b>
                  <b>
                    <i></i> AI solutions
                  </b>
                  <b>
                    <i></i> Cloud platforms
                  </b>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="home-laptop-base">
          <span></span>
        </div>
        <figcaption class="visually-hidden">
          Laptop dashboard illustrating Incaendo’s web, mobile, AI, cloud, and
          integration capabilities.
        </figcaption>
      </figure>

      <figure class="home-phone">
        <div class="home-phone-screen" aria-hidden="true">
          <div class="home-phone-camera"></div>
          <div class="home-phone-topbar">
            <span>9:41</span>
            <i></i>
          </div>
          <div class="home-phone-greeting">
            <span>YOUR WORKSPACE</span>
            <b>
              Built around
              <br />
              your business.
            </b>
          </div>
          <div class="home-phone-card">
            <span class="home-phone-card-icon">iN</span>
            <span>
              <b>Digital services</b>
              <small>Explore your toolkit</small>
            </span>
            <i class="phone-chevron"></i>
          </div>
          <div class="home-phone-section">
            Your solutions <span>View all</span>
          </div>
          <div class="home-phone-row">
            <i class="phone-web"></i>
            <span>Web applications</span>
            <b>›</b>
          </div>
          <div class="home-phone-row">
            <i class="phone-ai"></i>
            <span>AI solutions</span>
            <b>›</b>
          </div>
          <div class="home-phone-row">
            <i class="phone-cloud"></i>
            <span>Cloud platforms</span>
            <b>›</b>
          </div>
          <div class="home-phone-tabs">
            <i class="is-active"></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
        </div>
        <figcaption class="visually-hidden">
          Smartphone app preview showing a compact view of Incaendo services.
        </figcaption>
      </figure>
    </div>

    <ul class="home-stat-cards" aria-label="Incaendo company statistics">
      {stats.map((stat) => (
        <li
          class={
            'home-stat-card hero-callout-' + stat.tone + ' slot-' + stat.slot
          }
        >
          <span class="home-stat-icon" aria-hidden="true">
            {stat.icon === 'projects' && (
              <svg viewBox="0 0 24 24">
                <rect x="3.5" y="6.5" width="17" height="13" rx="2.5" />
                <path d="M8.5 6.5V5A1.5 1.5 0 0 1 10 3.5h4A1.5 1.5 0 0 1 15.5 5v1.5" />
                <path d="m9 13 2 2 4-4" />
              </svg>
            )}
            {stat.icon === 'years' && (
              <svg viewBox="0 0 24 24">
                <rect x="3.5" y="5" width="17" height="15" rx="2.5" />
                <path d="M3.5 9.5h17M8 3v4M16 3v4M8 14h3M8 16.5h6" />
              </svg>
            )}
            {stat.icon === 'experts' && (
              <svg viewBox="0 0 24 24">
                <circle cx="9" cy="8.5" r="3.25" />
                <path d="M3.5 19a5.5 5.5 0 0 1 11 0M15.5 5.6a3.25 3.25 0 0 1 0 5.8M17.5 14.2a5.5 5.5 0 0 1 3 4.8" />
              </svg>
            )}
            {stat.icon === 'industries' && (
              <svg viewBox="0 0 24 24">
                <path d="M3.5 20.5h17M5.5 20.5V8.5l5-3v15M10.5 20.5V10l8 3.5v7M13.5 15.5h2M13.5 18h2M7.5 11h1M7.5 14h1M7.5 17h1" />
              </svg>
            )}
          </span>
          <span class="home-stat-copy">
            <span class="home-stat-value" aria-hidden="true">
              <span class="home-stat-number">
                <span class="home-stat-number-final">{stat.value}</span>
                <span class="home-stat-number-live" data-count-to={stat.value}>
                  {stat.value}
                </span>
              </span>
              <span class="home-stat-suffix">+</span>
            </span>
            <span class="home-stat-label">
              <span class="visually-hidden">{stat.value}+ </span>
              {stat.label}
            </span>
          </span>
        </li>
      ))}
      <li class="home-stat-card home-stat-card-ai slot-bottom-center">
        <span class="home-stat-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="6.5" y="6.5" width="11" height="11" rx="2.5" />
            <path d="M9.5 3v3.5M14.5 3v3.5M9.5 17.5V21M14.5 17.5V21M3 9.5h3.5M3 14.5h3.5M17.5 9.5H21M17.5 14.5H21" />
            <path d="m12 9.4.7 1.9 1.9.7-1.9.7-.7 1.9-.7-1.9-1.9-.7 1.9-.7z" />
          </svg>
        </span>
        <span class="home-stat-copy">
          <span class="home-stat-card-title">AI Automation</span>
          <span class="home-stat-label">Integration</span>
        </span>
      </li>
    </ul>
  </div>
</div>

<script is:inline>
  ;(() => {
    const panel = document.currentScript.previousElementSibling
    if (
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    )
      return
    panel.setAttribute('data-stats-pending', '')
    setTimeout(() => {
      if (!panel.dataset.statsReady) panel.removeAttribute('data-stats-pending')
    }, 3000)
  })()
</script>

<script>
  import '../scripts/hero-stats.js'
</script>

<style>
  .home-tech-visual {
    position: relative;
    z-index: 1;
    width: 100%;
    min-width: 0;
    container-type: inline-size;
  }

  .home-visual-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 600 / 500;
    isolation: isolate;
  }

  .home-visual-stage::before {
    position: absolute;
    inset: 7% 5% 6%;
    z-index: -1;
    border-radius: 42%;
    background:
      radial-gradient(
        ellipse at 53% 45%,
        rgb(255 255 255 / 75%),
        transparent 48%
      ),
      radial-gradient(
        ellipse at 67% 50%,
        rgb(201 84 43 / 14%),
        transparent 58%
      ),
      radial-gradient(
        ellipse at 34% 57%,
        rgb(84 123 157 / 13%),
        transparent 60%
      );
    content: '';
    pointer-events: none;
  }

  .home-visual-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .home-visual-orbits {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    fill: none;
    pointer-events: none;
  }

  .home-visual-orbits path {
    stroke: var(--color-blue);
    stroke-opacity: 0.34;
    stroke-width: 1.2;
    stroke-linecap: round;
  }

  .home-visual-orbits .home-orbit-orange {
    stroke: var(--color-orange);
    stroke-opacity: 0.25;
  }

  .home-visual-orbits path:not(.home-orbit-orange) {
    stroke-opacity: 0.23;
  }

  .home-visual-dots {
    fill: var(--color-blue);
    opacity: 0.4;
  }

  .home-visual-badge > rect {
    fill: #fff;
    filter: drop-shadow(0 5px 12px rgb(16 27 45 / 10%));
  }

  .home-visual-badge > path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.5;
  }

  .home-badge-cloud > rect {
    fill: #4d91f5;
  }

  .home-badge-cloud > path {
    fill: #fff;
    stroke: none;
  }

  .home-badge-chart > rect {
    fill: var(--color-orange);
  }

  .home-badge-chart > path {
    stroke: #fff;
  }

  .home-badge-code > rect {
    fill: #4d91f5;
  }

  .home-badge-code > path {
    stroke: #fff;
  }

  .home-orbit-node {
    fill: var(--color-orange);
    filter: drop-shadow(0 0 3px rgb(201 84 43 / 38%));
    animation: home-node-pulse 3.8s ease-in-out infinite;
  }

  .home-orbit-node.is-blue {
    fill: var(--color-blue);
    filter: drop-shadow(0 0 3px rgb(84 123 157 / 35%));
  }

  .home-laptop {
    position: absolute;
    z-index: 2;
    top: 18.5%;
    left: 14%;
    width: 72%;
    margin: 0;
    filter: drop-shadow(0 20px 22px rgb(16 27 45 / 16%));
    animation:
      home-device-arrive 700ms var(--ease-out) both,
      home-laptop-float 10s ease-in-out 700ms infinite;
  }

  .home-laptop-screen {
    position: relative;
    aspect-ratio: 1.62;
    overflow: hidden;
    padding: 1.55%;
    border: 1px solid rgb(255 255 255 / 70%);
    border-radius: 13px 13px 5px 5px;
    background: linear-gradient(145deg, #34445a, #101b2d 76%);
    box-shadow:
      0 0 0 1px rgb(16 27 45 / 18%),
      inset 0 1px 0 rgb(255 255 255 / 35%),
      0 3px 8px rgb(16 27 45 / 18%);
  }

  .home-laptop-screen::after {
    position: absolute;
    z-index: 1;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      118deg,
      rgb(255 255 255 / 12%),
      transparent 18%,
      transparent 76%,
      rgb(255 255 255 / 6%)
    );
    content: '';
    pointer-events: none;
  }

  .home-dashboard {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: 19% minmax(0, 1fr);
    overflow: hidden;
    border-radius: 7px;
    background: #fbfcfd;
  }

  .home-dashboard-sidebar {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 5.5%;
    padding: 5% 4%;
    background: #f1f4f7;
    color: #647286;
    font-size: clamp(5px, 1.32cqi, 8px);
    line-height: 1;
  }

  .home-dashboard-brand {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 9%;
    color: var(--color-ink);
    font-size: 0.92em;
    font-weight: 800;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .home-dashboard-brand i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 4px 0 0 -1px var(--color-blue);
  }

  .home-dashboard-nav {
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .home-dashboard-nav > i {
    width: 5px;
    height: 5px;
    border: 1px solid #90a0b3;
    border-radius: 2px;
  }

  .home-dashboard-nav.is-current {
    color: var(--color-orange-dark);
    font-weight: 700;
  }

  .home-dashboard-nav.is-current > i {
    border-color: var(--color-orange);
    background: var(--color-orange);
  }

  .home-dashboard-profile {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-top: auto;
    padding-top: 7px;
    border-top: 1px solid var(--color-line);
    font-size: 0.88em;
    white-space: nowrap;
  }

  .home-dashboard-profile i,
  .home-dashboard-avatar {
    display: grid;
    width: 13px;
    flex: none;
    aspect-ratio: 1;
    place-items: center;
    border-radius: 50%;
    background: #e2ebf2;
    color: var(--color-blue);
    font-size: 0.75em;
    font-style: normal;
    font-weight: 800;
  }

  .home-dashboard-main {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 3.2% 3.5%;
    color: var(--color-ink);
  }

  .home-dashboard-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-muted);
    font-size: clamp(5px, 1.05cqi, 6.5px);
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .home-dashboard-avatar {
    width: 14px;
    font-size: 8px;
  }

  .home-dashboard-heading {
    display: grid;
    gap: 2px;
    margin-block: 3% 3.5%;
  }

  .home-dashboard-heading > span {
    color: var(--color-muted);
    font-size: clamp(5px, 1.16cqi, 7px);
  }

  .home-dashboard-heading > b {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(9px, 2cqi, 12px);
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .home-dashboard-services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 4px;
  }

  .home-dashboard-service {
    display: flex;
    min-width: 0;
    min-height: 22px;
    align-items: center;
    gap: 4px;
    padding: 3px 4px;
    border: 1px solid #edf0f3;
    border-radius: 5px;
    background: #fff;
    color: #405064;
    font-size: clamp(5px, 1.2cqi, 7px);
    font-weight: 600;
    line-height: 1.05;
  }

  .home-dashboard-service > i {
    width: 9px;
    height: 9px;
    flex: none;
    border-radius: 3px;
    background: #e7edf2;
  }

  .home-dashboard-service .service-web,
  .home-phone-row .phone-web {
    background: #f3dfd4;
  }
  .home-dashboard-service .service-mobile {
    background: #e1eaf2;
  }
  .home-dashboard-service .service-ai,
  .home-phone-row .phone-ai {
    background: #f3e2d9;
  }
  .home-dashboard-service .service-cloud,
  .home-phone-row .phone-cloud {
    background: #e2eaf1;
  }
  .home-dashboard-service .service-integrations {
    background: linear-gradient(135deg, #f1ddd2 50%, #e0eaf2 50%);
  }

  .home-dashboard-bottom {
    display: grid;
    min-height: 0;
    flex: 1;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 6px;
    margin-top: 6px;
  }

  .home-dashboard-chart,
  .home-dashboard-status {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
    overflow: hidden;
    padding: 5px;
    border: 1px solid #edf0f3;
    border-radius: 5px;
    background: #fff;
  }

  .home-dashboard-chart > span,
  .home-dashboard-status > span {
    color: #647286;
    font-size: clamp(5px, 1.05cqi, 6.5px);
    font-weight: 700;
  }

  .home-dashboard-chart > svg {
    width: 100%;
    flex: 1;
    min-height: 10px;
    overflow: visible;
  }
  .home-dashboard-chart .chart-area {
    fill: rgb(84 123 157 / 10%);
  }
  .home-dashboard-chart .chart-line {
    fill: none;
    stroke: var(--color-blue);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
  .home-dashboard-chart > div {
    display: flex;
    justify-content: space-between;
    height: 2px;
  }
  .home-dashboard-chart > div i {
    width: 8%;
    height: 1px;
    background: #d7dee6;
  }
  .home-dashboard-status b {
    display: flex;
    align-items: center;
    gap: 3px;
    color: #526176;
    font-size: clamp(4.5px, 0.95cqi, 6px);
    font-weight: 500;
    white-space: nowrap;
  }
  .home-dashboard-status b i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #73957d;
  }

  .home-laptop-base {
    position: relative;
    height: clamp(12px, 3.5cqi, 21px);
    margin-inline: -3.5%;
    clip-path: polygon(4% 0, 96% 0, 100% 78%, 90% 100%, 10% 100%, 0 78%);
    border-radius: 0 0 8px 8px;
    background: linear-gradient(180deg, #dce2e8, #aeb8c2 68%, #eef1f4);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 90%),
      0 3px 4px rgb(16 27 45 / 12%);
  }

  .home-laptop-base > span {
    position: absolute;
    top: 0;
    left: 42%;
    width: 16%;
    height: 42%;
    border-radius: 0 0 5px 5px;
    background: linear-gradient(180deg, #aeb8c2, #c7ced5);
  }

  .home-phone {
    position: absolute;
    z-index: 4;
    top: 31%;
    right: 3.5%;
    width: 17%;
    height: 48%;
    margin: 0;
    padding: 3px;
    border: 1px solid #536176;
    border-radius: 18px;
    background: linear-gradient(145deg, #35445a, #101b2d);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 45%),
