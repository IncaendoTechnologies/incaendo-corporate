  }

  .delivery-monitor-metric {
    fill: var(--color-blue);
    font-size: 5.5px;
    letter-spacing: 0.2px;
  }

  .delivery-feedback-caption {
    fill: #8793a0;
    font-size: 5px;
    letter-spacing: 0.35px;
  }

  @keyframes delivery-draw-line {
