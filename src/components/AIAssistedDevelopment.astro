        </div>
      </div>
    </div>

    <!-- Streamlined Action Bridge directly connecting to the 5-Step AI Workflow -->
    <div class="aidev-bridge">
      <p class="aidev-bridge-text">
        Explore how our engineers transform real business needs into reliable,
        production-ready AI outcomes.
      </p>
      <a
        class="button button-primary aidev-bridge-btn"
        href="#ai-practical-path"
      >
        <span>Explore AI-Powered Process</span>
        <svg
          class="aidev-bridge-icon"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 5v14M19 12l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  function setupAIVisualization() {
    const root = document.getElementById('ai-vis-root')
    const svg = document.getElementById('ai-vis-svg')
    const cube = document.getElementById('ai-cube-wrapper')
    const cubeRig = document.getElementById('ai-cube-3d-rig')
    if (!root || !svg || !cube) return

    const cards = [0, 1, 2, 3, 4, 5].map((i) =>
      root.querySelector(`[data-card-idx="${i}"]`),
    )
    const fibers = [0, 1, 2, 3, 4, 5].map((i) =>
      document.getElementById(`ai-fiber-${i}`),
    )
    const nodes = [0, 1, 2, 3, 4, 5].map((i) =>
      document.getElementById(`ai-node-${i}`),
    )
    const particles = [0, 1, 2, 3, 4, 5].map((i) =>
      document.getElementById(`ai-particle-${i}`),
    )

    if (
      !cards.every(Boolean) ||
      !fibers.every(Boolean) ||
      !nodes.every(Boolean) ||
      !particles.every(Boolean)
    ) {
      return
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    const updateGeometry = () => {
      if (window.innerWidth <= 900) {
        svg.style.display = 'none'
        return
      }
      svg.style.display = 'block'

      const rootRect = root.getBoundingClientRect()
      const cubeRect = cube.getBoundingClientRect()

      const cubeCenterY = cubeRect.top + cubeRect.height / 2 - rootRect.top
      const cubeLeftX = cubeRect.left + 10 - rootRect.left
      const cubeRightX = cubeRect.right - 10 - rootRect.left

      // Exact attachment coordinates on the sleek 3D AI cube
      const cubeOrigins = [
        { x: cubeLeftX + 12, y: cubeCenterY - 34 }, // 0: top-left
        { x: cubeLeftX, y: cubeCenterY }, // 1: mid-left
        { x: cubeLeftX + 12, y: cubeCenterY + 34 }, // 2: bottom-left
        { x: cubeRightX - 12, y: cubeCenterY - 34 }, // 3: top-right
        { x: cubeRightX, y: cubeCenterY }, // 4: mid-right
        { x: cubeRightX - 12, y: cubeCenterY + 34 }, // 5: bottom-right
      ]

      cards.forEach((card, i) => {
        if (!card) return
        const cardRect = card.getBoundingClientRect()
        const cardY = cardRect.top + cardRect.height / 2 - rootRect.top
        const isLeft = i < 3

        const cardX = isLeft
          ? cardRect.right - rootRect.left
          : cardRect.left - rootRect.left

        const origin = cubeOrigins[i]
        const fiber = fibers[i]
        const node = nodes[i]
        if (!fiber || !node) return

        const isMidCard = i === 1 || i === 4
        // Position circular node along the horizontal span
        // With spacious distance from AI, outer nodes are 38px from card, indented 30px
        const nodeDist = isMidCard ? 30 : 38
        const nodeX = isLeft ? cardX + nodeDist : cardX - nodeDist
        const nodeY = cardY

        node.setAttribute('transform', `translate(${nodeX}, ${nodeY})`)

        // Path originates FROM the AI cube origin and terminates at the Card edge
        // This ensures signal particles travel outward from AI into each capability
        let d = ''
        if (isMidCard) {
          // Straight horizontal path: AI Origin -> Node -> Card
          d = `M ${origin.x} ${origin.y} L ${nodeX} ${nodeY} L ${cardX} ${cardY}`
        } else {
          // Curved path: leaves AI horizontally, sweeps smoothly through Node, straight into Card
          const dx = nodeX - origin.x
          const c1x = origin.x + dx * 0.28
          const c1y = origin.y
          const c2x = origin.x + dx * 0.72
          const c2y = nodeY
          d = `M ${origin.x} ${origin.y} C ${c1x} ${c1y}, ${c2x} ${c2y}, ${nodeX} ${nodeY} L ${cardX} ${cardY}`
        }

        fiber.setAttribute('d', d)
      })
    }

    updateGeometry()

    // Interactive Hover Synchronization (Card <-> Fiber <-> Node)
    cards.forEach((card, i) => {
      if (!card) return
      const fiber = fibers[i]
      const node = nodes[i]

      card.addEventListener('pointerenter', () => {
        card.classList.add('is-hovered')
        fiber?.classList.add('is-hovered')
        node?.classList.add('is-hovered')
      })

      card.addEventListener('pointerleave', () => {
        card.classList.remove('is-hovered')
        fiber?.classList.remove('is-hovered')
        node?.classList.remove('is-hovered')
      })
    })

    // Interactive 3D Parallax Tilt Tracking on Mouse Move
    let targetTiltX = 0
    let targetTiltY = 0
    let currentTiltX = 0
    let currentTiltY = 0
    let isHoveringRoot = false

    root.addEventListener('pointerenter', () => {
      isHoveringRoot = true
    })

    root.addEventListener('pointermove', (e) => {
      if (window.innerWidth <= 900) return
      const rect = root.getBoundingClientRect()
      const centerX = rect.left + rect.width / 2
      const centerY = rect.top + rect.height / 2
      const nx = (e.clientX - centerX) / (rect.width / 2)
      const ny = (e.clientY - centerY) / (rect.height / 2)
      targetTiltX = Math.max(-1, Math.min(1, ny)) * -9
      targetTiltY = Math.max(-1, Math.min(1, nx)) * 12
    })

    root.addEventListener('pointerleave', () => {
      isHoveringRoot = false
      targetTiltX = 0
      targetTiltY = 0
    })

    // Synchronized Particle Animation Loop (Shared lock-step cycle)
    let animProgress = 0
    const CYCLE_DURATION = 3000 // ms
    let lastTime = performance.now()
    let rafId = 0
    let isVisible = true

    const animateParticles = (now = performance.now()) => {
      if (!isVisible || reducedMotion.matches || window.innerWidth <= 900) {
        rafId = 0
        return
      }

      const delta = now - lastTime
      lastTime = now

      animProgress = (animProgress + delta / CYCLE_DURATION) % 1

      let travelP = 0
      let opacity = 0

      if (animProgress < 0.78) {
        const t = animProgress / 0.78
        // Smooth acceleration out of AI, cruising along fiber, deceleration into card
        travelP = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t

        // Quick fade-in as particle launches from AI (0 to 0.12),
        // brilliant steady glow across fiber & node (0.12 to 0.86),
        // smooth fade-out as it enters the card (0.86 to 1.0)
        if (t < 0.12) {
          opacity = t / 0.12
        } else if (t > 0.86) {
          opacity = (1 - t) / 0.14
        } else {
          opacity = 1
        }
      } else {
        // Rest pause before next pulse launches from AI
        travelP = 1
        opacity = 0
      }

      fibers.forEach((fiber, i) => {
        const pGroup = particles[i]
        if (!fiber || !pGroup) return

        try {
          if (fiber instanceof SVGPathElement) {
            const totalLen = fiber.getTotalLength()
            if (totalLen > 0) {
              const pt = fiber.getPointAtLength(totalLen * travelP)
              pGroup.setAttribute('transform', `translate(${pt.x}, ${pt.y})`)
              pGroup.style.opacity = String(opacity)
            }
          }
        } catch {
          // ignore layout math transitions
        }
      })

      // Interactive 3D Parallax update on cube rig
      if (cubeRig && window.innerWidth > 900) {
        currentTiltX += (targetTiltX - currentTiltX) * 0.08
        currentTiltY += (targetTiltY - currentTiltY) * 0.08

        if (
          isHoveringRoot ||
          Math.abs(currentTiltX) > 0.05 ||
          Math.abs(currentTiltY) > 0.05
        ) {
          cubeRig.style.transform = `perspective(800px) rotateX(${currentTiltX.toFixed(2)}deg) rotateY(${currentTiltY.toFixed(2)}deg) translateZ(8px)`
        } else {
          cubeRig.style.transform = ''
        }
      }

      rafId = requestAnimationFrame(animateParticles)
    }

    const startAnimation = () => {
      if (rafId) return
      lastTime = performance.now()
      rafId = requestAnimationFrame(animateParticles)
    }

    const stopAnimation = () => {
      if (rafId) {
        cancelAnimationFrame(rafId)
        rafId = 0
      }
    }

    startAnimation()

    const observer = new IntersectionObserver(
      ([entry]) => {
        isVisible = entry.isIntersecting
        if (isVisible) {
          updateGeometry()
          startAnimation()
        } else {
          stopAnimation()
        }
      },
      { threshold: 0.15 },
    )
    observer.observe(root)

    const handleResize = () => {
      updateGeometry()
      if (isVisible && !reducedMotion.matches && window.innerWidth > 900) {
        startAnimation()
      } else {
        stopAnimation()
      }
    }

    window.addEventListener('resize', handleResize)
  }

  setupAIVisualization()
  document.addEventListener('astro:page-load', setupAIVisualization)
</script>

<style>
  .aidev {
    position: relative;
    border-top: 1px solid var(--color-line);
    background: linear-gradient(180deg, #fdfbf9 0%, #fef7f4 50%, #fdfbf9 100%);
  }

  /* ---------- Heading ---------- */
  .aidev-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(1rem, 2vw, 1.35rem);
    margin-bottom: clamp(1.75rem, 3.2vw, 2.5rem);
  }

  .aidev-title-wrap {
    text-align: center;
    width: 100%;
  }

  .aidev-heading h2 {
    margin: 0;
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
    text-wrap: balance;
  }

  .aidev-heading h2 span {
    color: var(--color-orange-dark);
  }

  .aidev-heading-break {
    display: none;
  }

  .aidev-lead-break {
    display: none;
  }

  .aidev-lead {
    margin: 0 auto;
    width: 100%;
    max-width: 58rem;
    color: var(--color-body);
    font-size: 0.94rem;
    line-height: 1.7;
    text-align: center;
    text-wrap: balance;
  }

  /* ---------- 3D AI Visualization Section (Spacious & Balanced) ---------- */
  .ai-vis-section {
    position: relative;
    width: 100%;
    max-width: 1280px;
    margin: 1.25rem auto 2.5rem;
    background: transparent;
  }

  /* SVG Connections Overlay */
  .ai-vis-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
    background: transparent;
