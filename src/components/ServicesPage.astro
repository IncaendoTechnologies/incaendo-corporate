---
import { homepageServices } from '../data/site-content.js'
import { Image } from 'astro:assets'
import servicesHeroImage from '../assets/Modern Cloud Developer Workspace.png'
import serviceAIAutomationImage from '../assets/service-ai-automation.webp'
import serviceCustomSoftwareImage from '../assets/service-custom-software-visual.webp'
import serviceWebApplicationsImage from '../assets/service-web-applications.webp'
import serviceMobileApplicationsImage from '../assets/service-mobile-applications.webp'
import serviceEnterpriseSolutionsImage from '../assets/service-enterprise-solutions.webp'
import serviceCloudDataImage from '../assets/service-cloud-data.webp'
import DeliveryProcess from './DeliveryProcess.astro'

const serviceDetails = [
  {
    id: 'ai-automation',
    number: '01',
    title: 'AI & Automation',
    eyebrow: 'INTELLIGENCE, APPLIED TO THE WORK',
    description:
      'Use AI where it can help people move work forward: interpreting documents, finding useful knowledge, preparing a response, or coordinating a repeatable workflow. We start with the task, data, and review needs before choosing an approach.',
    challenge:
      'Manual handoffs, repetitive record handling, and information spread across business tools.',
    capabilities: [
      'Workflow mapping and automation opportunities',
      'AI assistants and knowledge retrieval',
      'Document extraction with validation paths',
      'Integration with authorized tools and APIs',
    ],
    deliverables:
      'A scoped workflow, connected application or assistant, and clear review and exception paths.',
    image: serviceAIAutomationImage,
    imageAlt:
      'An AI assistant showing supplier, total and due date extracted and validated from an invoice, flagging it for manager review, above an extract, validate, review and done workflow',
    link: '/ai-technology',
    linkLabel: 'Explore AI',
  },
  {
    id: 'custom-software-development',
    number: '02',
    title: 'Custom Software Development',
    eyebrow: 'SOFTWARE THAT FITS YOUR PROCESS',
    description:
      'Build a product around the way your business needs to work when an off-the-shelf tool is not a good fit. We can shape the requirements, application architecture, interfaces, APIs, and integrations as one considered system.',
    challenge:
      'Important work depends on disconnected spreadsheets, manual processes, or tools that cannot adapt to the business.',
    capabilities: [
      'Business and workflow applications',
      'Internal tools and operational systems',
      'API design and system integrations',
      'Product engineering and iterative enhancement',
    ],
    deliverables:
      'A clear product scope, working software, integration points, and a maintainable foundation for future change.',
    image: serviceCustomSoftwareImage,
    imageAlt:
      'A code editor showing a POST /orders API route with passing tests, above a diagram connecting a customer portal, an orders API and a database',
    link: '/contact',
    linkLabel: 'Discuss custom software',
  },
  {
    id: 'web-application-development',
    number: '03',
    title: 'Web Application Development',
    eyebrow: 'CONNECTED DIGITAL EXPERIENCES',
    description:
      'Create responsive web applications that make complex tasks easier to complete. From customer and partner portals to dashboards and internal platforms, the experience, data, and system connections are planned together.',
    challenge:
      'Customers or teams need a clear digital way to access information, complete tasks, or manage an ongoing relationship.',
    capabilities: [
      'Customer, partner, and employee portals',
      'Dashboards and data-rich interfaces',
      'Responsive journeys across screen sizes',
      'Authentication, APIs, and business integrations',
    ],
    deliverables:
      'A responsive application experience with the interfaces and connections needed for its intended users.',
    image: serviceWebApplicationsImage,
    imageAlt:
      'A customer portal showing active, delivered and due figures and a list of orders with their status, beside the same orders in a phone app',
    link: '/contact',
    linkLabel: 'Discuss a web application',
  },
  {
    id: 'mobile-app-development',
    number: '04',
    title: 'Mobile App Development',
    eyebrow: 'USEFUL EXPERIENCES, WHERE WORK HAPPENS',
    description:
      'Plan and build mobile experiences around real user needs, device capabilities, and the systems behind the app. Platform choices are made in context, including whether native or cross-platform development best serves the product.',
    challenge:
      'A service or business process needs to be accessible in a focused, convenient experience on a mobile device.',
    capabilities: [
      'iOS and Android product planning',
      'Native or cross-platform implementation choices',
      'Mobile interfaces and device-aware flows',
      'Backend, API, and account integrations',
    ],
    deliverables:
      'A mobile product scope, platform-aligned experience, and connections to the services and data it depends on.',
    image: serviceMobileApplicationsImage,
    imageAlt:
      'A delivery app showing an order arriving today with options to track the driver, read messages and reorder, beside a shipped notification and an iOS and Android card',
    link: '/contact',
    linkLabel: 'Discuss a mobile app',
  },
  {
    id: 'enterprise-solutions',
    number: '05',
    title: 'Enterprise Solutions',
    eyebrow: 'CONNECT PEOPLE, PROCESS & SYSTEMS',
    description:
      'Bring business processes and software together across teams. Enterprise solutions can include operational applications, workflow digitisation, role-aware interfaces, and integrations planned around how information moves through an organisation.',
    challenge:
      'Teams rely on fragmented systems, repeated data entry, or processes that are difficult to coordinate across roles.',
    capabilities: [
      'Operational platforms and business applications',
      'Role-based workflows and interfaces',
      'Integration across existing enterprise systems',
      'Modernisation of specific processes or capabilities',
    ],
    deliverables:
      'A mapped operating workflow, connected solution scope, and a practical integration and rollout plan.',
    image: serviceEnterpriseSolutionsImage,
    imageAlt:
      'An operations dashboard with order and approval figures, a purchase order waiting at the finance approval stage, daily orders processed this week, and synced ERP, CRM and HR systems',
    link: '/contact',
    linkLabel: 'Discuss an enterprise solution',
  },
  {
    id: 'cloud-data',
    number: '06',
    title: 'Cloud & Data',
    eyebrow: 'FOUNDATIONS FOR RELIABLE DIGITAL WORK',
    description:
      'Design cloud and data capabilities around the needs of the product and the team operating it. This can include application environments, integrations, data flows, reporting foundations, and the monitoring needed to understand how a service is behaving.',
    challenge:
      'Applications and information need a dependable foundation, clearer movement between systems, or more useful reporting.',
    capabilities: [
      'Cloud architecture and deployment planning',
      'Data pipelines and system integrations',
      'Reporting and operational insight foundations',
      'Monitoring, maintainability, and cost considerations',
    ],
    deliverables:
      'An architecture and data-flow plan, deployment foundation, and operating considerations suited to the solution.',
    image: serviceCloudDataImage,
    imageAlt:
      'A cloud platform linking an orders API, a payments queue and an hourly data pipeline to an orders database, a data warehouse and a six-month revenue chart',
    link: '/contact',
    linkLabel: 'Discuss cloud & data',
  },
]

const deliverySteps = [
  {
    number: '01',
    title: 'Discover',
    description:
      'Understand objectives, users, current systems, constraints, and what a useful outcome means.',
    output: 'Shared problem definition',
  },
  {
    number: '02',
    title: 'Plan & Architect',
    description:
      'Prioritise requirements and make proportionate product, design, and technical decisions.',
    output: 'Scope and delivery plan',
  },
  {
    number: '03',
    title: 'Design & Develop',
    description:
      'Shape the experience and build in reviewable steps, keeping feedback close to the work.',
    output: 'Working product increments',
  },
  {
    number: '04',
    title: 'Integrate & Test',
    description:
      'Connect relevant systems and check behavior, usability, and quality against agreed needs.',
    output: 'Validated release candidate',
  },
  {
    number: '05',
    title: 'Deploy',
    description:
      'Prepare the release, coordinate the move into its intended environment, and support handover.',
    output: 'Production-ready release',
  },
  {
    number: '06',
    title: 'Support & Improve',
    description:
      'Use operational feedback and changing business needs to guide maintenance and next steps.',
    output: 'A considered improvement path',
  },
]
---

<div class="services-page">
  <section class="services-hero hero-system hero-system--split hero-system--feature" aria-labelledby="services-page-title">
    <div class="site-container services-hero-grid hero-system__inner">
      <div class="services-hero-copy hero-system__copy reveal">
        <h1 id="services-page-title" class="hero-system__title">
          Technology that <span class="hero-system__accent">Works around Your Business.</span>
        </h1>
        <p class="services-hero-lead hero-system__description">
          From AI and custom software to connected web, mobile, enterprise, and
          cloud solutions, we help turn business requirements into thoughtful,
          useful technology.
        </p>
        <div class="services-hero-actions hero-system__actions">
          <a class="button button-primary" href="#service-overview">
            Explore our services <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="/contact">
            Discuss your project{' '}
            <span class="link-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
        <div class="services-hero-proof">
          <span class="proof-mark" aria-hidden="true">
            ↗
          </span>
          <span>
            <strong>Support across the product lifecycle</strong>
            <small>From requirements through launch and improvement.</small>
          </span>
        </div>
      </div>

      <div class="services-hero-feature hero-system__visual reveal">
        <div class="services-hero-visual">
          <Image
            src={servicesHeroImage}
            alt="A developer workspace with a code editor, a cloud architecture diagram, and a business dashboard on a laptop"
            width={1200}
            sizes="(max-width: 900px) 92vw, 52vw"
            loading="eager"
            class="services-hero-image hero-system__image"
          />
        </div>
        <nav class="services-hero-areas" aria-label="Service areas">
          <span class="hero-system__support-label">Six service areas</span>
          <ol>
            {serviceDetails.map((service) => (
              <li>
                <a href={`#${service.id}`}>
                  <span aria-hidden="true">{service.number}</span>
                  {service.title}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  </section>

  <section
    class="services-overview section"
    id="service-overview"
    aria-labelledby="service-overview-title"
  >
    <div class="site-container">
      <header class="services-section-heading reveal">
        <p class="eyebrow">A connected set of capabilities</p>
        <h2 id="service-overview-title">
          Start with the Challenge. <span>Choose the Right Capability.</span>
        </h2>
        <p>
          Explore the service areas and the problems each one can help address.
          The right scope depends on your users, systems, and goals.
        </p>
      </header>

      <div class="services-overview-grid reveal" data-reveal-stagger>
        {homepageServices.map((service) => {
          const Icon = service.icon
          return (
            <a
              class="service-overview-card"
              href={`#${service.id}`}
              data-reveal-item
            >
              <span class="overview-card-top">
                <span>{service.number} / 06</span>
                <span class="overview-card-icon" aria-hidden="true">
                  <Icon size={21} strokeWidth={1.7} />
                </span>
              </span>
              <span class="overview-card-title">{service.title}</span>
              <span class="overview-card-copy">{service.description}</span>
              <span class="overview-card-link">
                View service <b aria-hidden="true">↘</b>
              </span>
            </a>
          )
        })}
      </div>
    </div>
  </section>

  <section
    class="service-details section"
    aria-labelledby="service-details-title"
  >
    <div class="site-container">
      <header class="services-section-heading services-detail-heading reveal">
        <p class="eyebrow">What the work can include</p>
        <h2 id="service-details-title">
          Useful Technology, <span>Made Specific to the Work.</span>
        </h2>
        <p>
          Each engagement is shaped to its context. These are practical starting
          points for a conversation about your requirements.
        </p>
      </header>

      <div class="service-detail-list">
        {serviceDetails.map((service, index) => (
          <article
            class:list={[
              'service-detail reveal',
              index % 2 === 1 && 'service-detail-reverse',
            ]}
            data-reveal-stagger
            id={service.id}
            aria-labelledby={`${service.id}-title`}
          >
            <div class="service-detail-copy" data-reveal-item>
              <p class="service-detail-kicker">
                <span>{service.number}</span>
                {service.eyebrow}
              </p>
              <h3 id={`${service.id}-title`}>{service.title}</h3>
              <p class="service-detail-description">{service.description}</p>
              <div class="service-detail-challenge">
                <span>BUSINESS CHALLENGE</span>
                <p>{service.challenge}</p>
              </div>
              <div class="service-detail-scope">
                <h4>How We Can Help</h4>
                <ul>
                  {service.capabilities.map((capability) => (
                    <li>{capability}</li>
                  ))}
                </ul>
              </div>
              <div class="service-detail-deliverable">
                <span>Potential outcome</span>
                <p>{service.deliverables}</p>
              </div>
              <a class="text-link service-detail-link" href={service.link}>
                {service.linkLabel}{' '}
                <span class="link-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>

            <div class="service-detail-visual" data-reveal-item>
              <Image
                src={service.image}
                alt={service.imageAlt}
                width={1200}
                sizes="(max-width: 700px) 92vw, (max-width: 1000px) 44vw, 50vw"
                loading="lazy"
                class="service-detail-image"
              />
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class="services-experience section"
    aria-labelledby="services-experience-title"
  >
    <div class="site-container experience-panel">
      <div class="experience-number reveal">
        <span>15</span>
        <small>
          YEARS OF INDUSTRY
          <br />
          EXPERIENCE
        </small>
        <i aria-hidden="true"></i>
      </div>
      <div class="experience-message reveal">
        <p class="eyebrow eyebrow-light">Business context meets engineering</p>
        <h2 id="services-experience-title">
          Good Technology Starts with <span>Understanding the Work.</span>
        </h2>
        <p>
          We bring business requirements, user needs, and existing systems into
          the conversation before settling on a technical direction. That
          context helps shape software around the problem it needs to solve.
        </p>
        <a class="text-link text-link-light" href="/projects">
          How we share project work{' '}
          <span class="link-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
      <div class="experience-principles reveal">
        <div>
          <span>01</span>
          <b>Context before code</b>
          <small>Understand the people, process, and constraints.</small>
        </div>
        <div>
          <span>02</span>
          <b>Connect what exists</b>
          <small>Consider current systems as part of the solution.</small>
        </div>
        <div>
          <span>03</span>
          <b>Leave room to improve</b>
          <small>Plan for operation, feedback, and change.</small>
        </div>
      </div>
    </div>
  </section>

  <DeliveryProcess />

  <section
    class="delivery-section section section-soft"
    id="how-we-work"
    aria-labelledby="delivery-heading"
  >
    <div class="site-container">
      <header class="services-section-heading reveal">
        <p class="eyebrow">How we work</p>
        <h2 id="delivery-heading">
          A Clear Route from <span>Requirement to Release.</span>
        </h2>
        <p>
          Planning, engineering, review, and communication stay connected
          throughout the work—not just at handover.
        </p>
      </header>
      <div class="delivery-steps reveal" data-reveal-stagger>
        {deliverySteps.map((step) => (
          <article class="delivery-step" data-reveal-item>
            <div class="delivery-step-top">
              <span>{step.number}</span>
              <i aria-hidden="true"></i>
            </div>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
            <small>
              <b>FOCUS</b>
              {step.output}
            </small>
          </article>
        ))}
      </div>
    </div>
  </section>
</div>

<style>
  .services-page {
    overflow: clip;
    background: var(--color-paper);
  }
  .services-page section {
    position: relative;
  }
  .services-page h1,
  .services-page h2,
  .services-page h3,
  .services-page h4,
  .services-page p {
    margin-top: 0;
  }
  .services-page h1 span,
  .services-page h2 span:not(.proof-mark),
  .services-page h3 span {
    color: var(--color-orange-dark);
  }
  .services-hero {
    background:
      radial-gradient(
        ellipse at 92% 12%,
        rgb(244 233 223 / 74%),
        transparent 34%
      ),
      linear-gradient(125deg, #fbfaf8 0%, var(--color-paper) 53%, #f0ece6 100%);
  }
  .services-hero-actions .button {
    gap: 0.75rem;
  }
  .services-hero-proof {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .proof-mark {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid #dfc2ad;
    border-radius: 50%;
    color: var(--color-orange-dark);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
  }
  .services-hero-proof > span:last-child {
    display: grid;
    gap: 0.12rem;
  }
  .services-hero-proof strong {
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 650;
  }
  .services-hero-proof small {
    color: var(--color-muted);
    font-size: 0.7rem;
  }

  /* Hero visual wrapper: the framed image plus a service-areas card that
     overlaps its lower-left corner (outside the image's clipped frame). */
  .services-hero-feature {
    position: relative;
  }
  .services-hero-areas {
    position: absolute;
    z-index: 2;
    bottom: -1.75rem;
    left: -1.75rem;
    display: grid;
    gap: 0.7rem;
    width: min(17.5rem, 58%);
    padding: 1rem 1.15rem 1.05rem;
    border: 1px solid rgb(16 27 45 / 7%);
    border-radius: 18px;
    background: rgb(255 255 255 / 93%);
    box-shadow:
      0 1px 0 #fff inset,
      0 22px 44px -24px rgb(16 27 45 / 40%),
      0 2px 6px -3px rgb(16 27 45 / 10%);
    backdrop-filter: blur(6px);
  }
  .services-hero-areas .hero-system__support-label {
    margin-bottom: 0;
    color: var(--color-orange-dark);
  }
  .services-hero-areas ol {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .services-hero-areas a {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: baseline;
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
    line-height: 1.3;
    transition: color var(--duration-fast) ease;
  }
  .services-hero-areas a span {
    color: var(--color-muted);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .services-hero-areas a:hover {
    color: var(--color-orange-dark);
  }
  /* Stacked layouts: the card sits below the image at full width, with
     the areas in two columns while there is room */
  @media (max-width: 900px) {
    .services-hero-areas {
      position: static;
      width: auto;
      margin-top: 0.85rem;
    }
    .services-hero-areas ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1rem;
    }
  }
  @media (max-width: 480px) {
    .services-hero-areas ol {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .services-hero-visual {
    position: relative;
    display: flex;
    min-height: 410px;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 1.27;
    align-items: stretch;
    border-radius: var(--radius-large);
    background: var(--color-paper);
    box-shadow:
      0 26px 65px rgb(16 27 45 / 18%),
      0 3px 12px rgb(16 27 45 / 8%);
    color: var(--color-navy);
    isolation: isolate;
  }
  .services-hero-image {
    position: absolute;
    z-index: -2;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }
  .services-overview {
    padding-block: clamp(4.5rem, 7vw, 6.5rem);
  }
  .services-section-heading {
    max-width: 800px;
    margin: 0 auto clamp(2.2rem, 4vw, 3rem);
    text-align: center;
  }
  .services-section-heading .eyebrow {
    margin-bottom: 0.7rem;
  }
  .services-section-heading h2 {
    margin-bottom: 0.9rem;
    color: var(--color-navy);
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
  }
  .services-section-heading h2 span {
    color: var(--color-orange-dark);
  }
  .services-section-heading > p:last-child {
    max-width: 690px;
    margin: 0 auto;
    color: var(--color-body);
    font-size: var(--type-body-size);
    line-height: var(--type-body-line-height);
  }
  .services-overview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .service-overview-card {
    --card-lift: 0px;
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 232px;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.35rem 1.4rem 1.2rem;
    overflow: hidden;
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: var(--radius-medium);
    background: linear-gradient(145deg, #fff, #fbf9f6);
    box-shadow: 0 12px 34px rgb(16 27 45 / 5%);
    color: var(--color-ink);
    transform: translateY(var(--card-lift));
    transition:
      transform 260ms var(--ease-out),
      border-color 260ms var(--ease-out),
      box-shadow 260ms var(--ease-out),
      background 260ms var(--ease-out);
  }
  .service-overview-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(
      90deg,
      var(--color-orange),
      #e09a63,
      transparent
    );
    content: '';
    opacity: 0.55;
    transition: opacity 260ms var(--ease-out);
  }
  .service-overview-card:hover,
  .service-overview-card:focus-visible {
    --card-lift: -5px;
    border-color: rgb(168 65 33 / 35%);
    background: #fff;
    box-shadow:
      0 20px 38px rgb(16 27 45 / 12%),
      0 5px 16px rgb(168 65 33 / 6%);
    color: var(--color-ink);
  }
  .service-overview-card:hover::before,
  .service-overview-card:focus-visible::before {
    opacity: 1;
  }
  .overview-card-top {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }
  .overview-card-top > span:first-child {
    color: var(--color-muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.11em;
  }
  .overview-card-icon {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgb(168 65 33 / 15%);
    border-radius: 14px;
    background: #f4e9df;
    color: var(--color-orange-dark);
    transition:
      transform 260ms var(--ease-out),
      background 260ms var(--ease-out);
  }
  .service-overview-card:hover .overview-card-icon,
  .service-overview-card:focus-visible .overview-card-icon {
    transform: translateY(-2px) scale(1.04);
    background: #fff2e9;
  }
  .overview-card-title {
    margin-bottom: 0.45rem;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: var(--type-card-heading-size);
    font-weight: 650;
    letter-spacing: -0.035em;
    word-spacing: 0.035em;
    line-height: 1.25;
  }
  .overview-card-copy {
    margin-bottom: 1rem;
    color: var(--color-body);
    font-size: 0.8rem;
    line-height: 1.55;
