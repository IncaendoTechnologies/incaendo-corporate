---
const {
  ariaLabel = 'Pages',
  dataPagination = 'data-pagination',
  dataPrev = 'data-page-prev',
  dataNext = 'data-page-next',
  dataNumbers = 'data-page-numbers',
  class: className,
} = Astro.props

const paginationAttr = { [dataPagination]: '' }
const prevAttr = { [dataPrev]: '' }
const nextAttr = { [dataNext]: '' }
const numbersAttr = { [dataNumbers]: '' }
---

<nav
  class:list={['ui-pagination', className]}
  {...paginationAttr}
  aria-label={ariaLabel}
  hidden
>
  <button
    type="button"
    class="pagination-arrow"
    {...prevAttr}
    aria-label="Previous page"
  >
    <span aria-hidden="true">←</span> Previous
  </button>
  <div class="pagination-numbers" {...numbersAttr}></div>
  <button
    type="button"
    class="pagination-arrow"
    {...nextAttr}
    aria-label="Next page"
  >
    Next <span aria-hidden="true">→</span>
  </button>
</nav>

<style>
  .ui-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    margin-top: clamp(2rem, 4vw, 3.25rem);
  }

  .pagination-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 42px;
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-navy);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.2;
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease,
      opacity 180ms ease;
  }

  .pagination-arrow:hover:not(:disabled) {
    border-color: #ead1c4;
    color: var(--color-orange-dark);
    transform: translateY(-1px);
  }

  .pagination-arrow:disabled {
    cursor: not-allowed;
    opacity: 0.4;
    transform: none;
  }

  .pagination-numbers {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Page-number buttons are created dynamically via document.createElement,
     so :global() is required for these rules to apply to them. */
  .pagination-numbers :global(button),
  .pagination-numbers :global(.pagination-number),
  .pagination-numbers :global(.insights-pagination-number) {
    display: inline-flex;
    min-width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    padding-inline: 0.4rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: var(--color-paper);
    color: var(--color-navy);
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1;
    transition:
      color 180ms ease,
      background 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .pagination-numbers :global(button:hover:not(.is-active)),
  .pagination-numbers :global(.pagination-number:hover:not(.is-active)),
  .pagination-numbers
    :global(.insights-pagination-number:hover:not(.is-active)) {
    border-color: #ead1c4;
    color: var(--color-orange-dark);
    transform: translateY(-1px);
  }

  .pagination-numbers :global(button.is-active),
  .pagination-numbers :global(.pagination-number.is-active),
  .pagination-numbers :global(.insights-pagination-number.is-active) {
    border-color: var(--color-orange-dark);
    background: var(--color-orange-dark);
    color: var(--color-white);
  }

  @media (max-width: 600px) {
    .ui-pagination {
      gap: 0.5rem 0.6rem;
    }

    .pagination-arrow {
      min-height: 38px;
      padding: 0.5rem 0.8rem;
      font-size: 0.72rem;
    }

    .pagination-numbers :global(button),
    .pagination-numbers :global(.pagination-number),
    .pagination-numbers :global(.insights-pagination-number) {
      min-width: 38px;
      height: 38px;
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pagination-arrow,
    .pagination-numbers :global(button),
    .pagination-numbers :global(.pagination-number),
    .pagination-numbers :global(.insights-pagination-number) {
      transition: none;
      animation: none;
    }
  }
</style>
