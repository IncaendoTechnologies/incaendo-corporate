---
const capabilities = [
  {
    number: '01',
    title: 'Intelligent automation',
    description:
      'Automate repeatable, rules-based steps and use language models where work depends on interpreting text or context.',
    includes: 'Workflow orchestration · Exception routes · Human approval',
    tag: 'MOVE WORK FORWARD',
  },
  {
    number: '02',
    title: 'LLM-powered applications',
    description:
      'Design conversational and task-focused applications around a model chosen for the use case, constraints, and operating environment.',
    includes: 'Assistants · Structured outputs · Model integration',
    tag: 'MAKE SOFTWARE MORE USEFUL',
  },
  {
    number: '03',
    title: 'Knowledge retrieval & RAG',
    description:
      'Retrieve relevant material from approved information sources so answers can be grounded in business context and linked to evidence.',
    includes: 'Content preparation · Retrieval · Source references',
    tag: 'CONNECT KNOWLEDGE',
  },
  {
    number: '04',
    title: 'AI agents & tool integration',
    description:
      'Connect bounded, task-oriented AI workflows to authorized tools and APIs, with permissions and confirmation around consequential actions.',
    includes: 'Scoped tools · API actions · Approval gates',
    tag: 'ACT WITH CONTROL',
  },
  {
    number: '05',
    title: 'AI in existing systems',
    description:
      'Integrate AI into the software, data sources, and processes people already use instead of creating another disconnected destination.',
    includes: 'Business APIs · Existing products · Data flows',
    tag: 'FIT THE REAL WORK',
  },
  {
    number: '06',
    title: 'Evaluation & governance',
    description:
      'Evaluate outputs against defined criteria and design for access control, monitoring, validation, and appropriate human review.',
    includes: 'Quality checks · Access controls · Monitoring',
    tag: 'BUILD TRUST INTO DELIVERY',
  },
]

const applications = [
  {
    code: 'OPS / 01',
    title: 'Operations & workflow management',
    scenario:
      'Triage incoming requests, prepare case summaries, and route work to the appropriate queue.',
    value: 'A more consistent handoff, with exceptions kept in view.',
  },
  {
    code: 'SERVICE / 02',
    title: 'Customer support',
    scenario:
      'Help service teams find approved answers, summarize a conversation, or prepare a response for an agent.',
    value:
      'Faster access to context while a person remains accountable for the reply.',
  },
  {
    code: 'KNOWLEDGE / 03',
    title: 'Enterprise knowledge',
    scenario:
      'Search across permitted policies, manuals, and internal guidance with answers grounded in retrieved sources.',
    value:
      'Less time locating material and a clearer path back to the evidence.',
  },
  {
    code: 'RECORDS / 04',
    title: 'Document processing',
    scenario:
      'Extract fields from business records, compare them with expected formats, and send uncertain results for review.',
    value: 'Reduce repetitive entry and make discrepancies easier to spot.',
  },
  {
    code: 'INSIGHT / 05',
    title: 'Reporting & business intelligence',
    scenario:
      'Let teams ask scoped questions of prepared business information and receive a summary for further analysis.',
    value:
      'Turn a large body of information into a useful starting point, not an unchecked decision.',
  },
  {
    code: 'PRODUCT / 06',
    title: 'Employee-facing products',
    scenario:
      'Bring guided assistance into internal applications where employees already complete their work.',
    value:
      'Make relevant context and next steps available inside the existing workflow.',
  },
]

const realities = [
  {
    title: 'Data privacy & permissions',
    copy: 'Decide which sources can be used, who can retrieve them, and what information must stay out of a prompt or response.',
  },
  {
    title: 'Fit with current systems',
    copy: 'Map APIs, data ownership, identity, and operational boundaries before choosing how the AI capability connects.',
  },
  {
    title: 'Validation & human oversight',
    copy: 'Set review points for uncertain outputs and require confirmation before consequential actions are taken.',
  },
  {
    title: 'Evaluation & monitoring',
    copy: 'Test representative cases, track output quality, and review behavior as information and workflows change.',
  },
  {
    title: 'Maintainability & operating cost',
    copy: 'Account for model usage, retrieval, infrastructure, support, and the effort required to keep the system current.',
  },
  {
    title: 'The right model and retrieval',
    copy: 'Choose model, context, and retrieval patterns to match the task instead of assuming a single approach fits every problem.',
  },
]

const stages = [
  {
    id: 'sources',
    number: '01',
    title: 'Business data & approved sources',
    short: 'Start with permitted information',
    description:
      'Identify the systems and materials that are appropriate for the task. Define ownership, access boundaries, freshness, and the information that must remain excluded.',
    activities: [
      'Map systems and data owners',
      'Confirm permissions and source quality',
    ],
    output: 'A scoped, governed set of inputs.',
  },
  {
    id: 'context',
    number: '02',
    title: 'Context retrieval & preparation',
    short: 'Find the relevant context',
    description:
      'Prepare information for retrieval and assemble only the context needed for the request. Preserve source references and respect the user’s access to each item.',
    activities: [
      'Prepare and index relevant content',
      'Retrieve, rank, and cite source material',
    ],
    output: 'Relevant context with traceable sources.',
  },
  {
    id: 'reasoning',
    number: '03',
    title: 'AI reasoning & task execution',
    short: 'Apply a bounded AI task',
    description:
      'Give the selected model a clear task, suitable context, and limited tools. Keep the workflow focused on the intended outcome and return a structured result where useful.',
    activities: [
      'Set task instructions and output format',
      'Call only authorized tools when needed',
    ],
    output: 'A candidate answer, summary, or action.',
  },
  {
    id: 'validation',
    number: '04',
    title: 'Validation, permissions & quality',
    short: 'Check before it is used',
    description:
      'Check the response against rules, source evidence, permissions, and quality criteria. Route uncertainty or sensitive decisions to a person rather than silently proceeding.',
    activities: [
      'Validate output and access rules',
      'Escalate exceptions for human review',
    ],
    output: 'A checked result or a clear review request.',
  },
  {
    id: 'workflow',
    number: '05',
    title: 'Useful output in the workflow',
    short: 'Return value to the work',
    description:
      'Deliver the result where it can be reviewed and acted on, such as an existing application, case queue, or reporting workflow. Capture feedback to guide improvement.',
    activities: [
      'Integrate with the relevant business process',
      'Monitor outcomes and improve the experience',
    ],
    output: 'A practical next step in a familiar system.',
  },
]
---

<div class="ai-tech-page" data-ai-technology>
  <section class="ai-tech-hero" aria-labelledby="ai-tech-title">
    <div class="site-container ai-tech-hero-grid">
      <div class="ai-tech-hero-copy">
        <p class="eyebrow">
          <span class="eyebrow-dot"></span>AI
        </p>
        <h1 id="ai-tech-title">
          Practical AI.
          <br />
          <span>Built around real business work.</span>
        </h1>
        <p class="ai-tech-lead">
          We build AI-powered applications and integrations that connect
          business data, existing systems, and everyday workflows to useful
          outcomes—with clear boundaries for quality, access, and human
          judgment.
        </p>
        <div class="ai-tech-actions">
          <a class="button button-primary" href="#ai-capabilities">
            Explore our AI capabilities <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="/contact">
            Discuss an AI project <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="ai-hero-note">
          <span class="ai-hero-note-mark" aria-hidden="true">
            15
          </span>
          <span>
            <strong>Years of industry experience</strong>
            <small>Engineering perspective applied to new technology.</small>
          </span>
        </div>
      </div>

      <div
        class="ai-architecture"
        aria-label="AI system flow from approved business data through retrieval, model reasoning, validation, and an existing workflow"
      >
        <div class="architecture-topline">
          <span>APPLIED AI / SYSTEM VIEW</span>
          <span class="architecture-status">
            <i></i>Designed around the task
          </span>
        </div>
        <div class="architecture-canvas">
          <div class="architecture-rail" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="architecture-node source-node">
            <span class="architecture-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M5 4.75h9l5 5v9.5H5zM14 5v5h5M8 14h8M8 17h6" />
              </svg>
            </span>
            <span>
              <small>INPUT LAYER</small>
              <strong>Approved sources</strong>
              <em>Documents · systems · records</em>
            </span>
            <b>01</b>
          </div>
          <div class="architecture-node retrieval-node">
            <span class="architecture-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <circle cx="10.8" cy="10.8" r="6.3" />
                <path d="m15.5 15.5 4.2 4.2M8.3 10.8h5M10.8 8.3v5" />
              </svg>
            </span>
            <span>
              <small>CONTEXT LAYER</small>
              <strong>Retrieve &amp; prepare</strong>
              <em>Relevant context with sources</em>
            </span>
            <b>02</b>
          </div>
          <div class="architecture-core">
            <div class="core-orbit core-orbit-one"></div>
            <div class="core-orbit core-orbit-two"></div>
            <div class="core-center">
              <span>AI</span>
              <small>REASON</small>
            </div>
            <span class="core-particle core-particle-one"></span>
            <span class="core-particle core-particle-two"></span>
          </div>
          <div class="architecture-node validation-node">
            <span class="architecture-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="m12 3.5 7 2.8v5.1c0 4.5-3 7.5-7 9.1-4-1.6-7-4.6-7-9.1V6.3zM8.5 11.8l2.3 2.3 4.8-5" />
              </svg>
            </span>
            <span>
              <small>CONTROL LAYER</small>
              <strong>Validate &amp; review</strong>
              <em>Permissions · quality · people</em>
            </span>
            <b>04</b>
          </div>
          <div class="architecture-node output-node">
            <span class="architecture-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M4 6.5h16v12H4zM8 10h8M8 14h4M16.5 3.5v6M13.5 6.5h6" />
              </svg>
            </span>
            <span>
              <small>WORKFLOW LAYER</small>
              <strong>Useful next step</strong>
              <em>Existing product or process</em>
            </span>
            <b>05</b>
          </div>
          <svg
            class="architecture-flow"
            viewBox="0 0 600 400"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path d="M55 62C148 62 205 126 258 180M545 62C452 62 395 126 342 180M55 338C148 338 205 274 258 220M545 338C452 338 395 274 342 220" />
            <path
              class="architecture-flow-pulse"
              d="M55 62C148 62 205 126 258 180M545 62C452 62 395 126 342 180M55 338C148 338 205 274 258 220M545 338C452 338 395 274 342 220"
            />
          </svg>
        </div>
        <div class="architecture-foot">
          <span>
            <i class="legend-dot legend-blue"></i>Business context
          </span>
          <span>
            <i class="legend-dot legend-orange"></i>Controlled action
          </span>
          <span>Human review where it matters</span>
        </div>
      </div>
    </div>
  </section>

  <section
    class="ai-capabilities section section-soft"
    id="ai-capabilities"
    aria-labelledby="ai-capabilities-title"
  >
    <div class="site-container">
      <div class="ai-section-heading ai-capabilities-heading">
        <div>
          <p class="eyebrow">CAPABILITIES</p>
          <h2 id="ai-capabilities-title">
            The right building blocks.
            <br />
            <span>Connected to your context.</span>
          </h2>
        </div>
        <p>
          From focused workflow improvements to AI-enabled products, each
          capability can be shaped around existing data, systems, and operating
          constraints.
        </p>
      </div>
      <div class="ai-capability-grid">
        {capabilities.map((item) => (
          <article class="ai-detail-card">
            <div class="ai-card-meta">
              <span>{item.number}</span>
              <span>{item.tag}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="ai-includes">
              <span>IN PRACTICE</span>
              <p>{item.includes}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section
    class="ai-workflow section"
    id="ai-workflow"
    aria-labelledby="ai-workflow-title"
    data-ai-workflow
  >
    <div class="site-container">
      <div class="ai-section-heading ai-workflow-heading">
        <div>
          <p class="eyebrow">HOW AN AI SOLUTION WORKS</p>
          <h2 id="ai-workflow-title">
            A clear path from information
            <br />
            to <span>useful action.</span>
          </h2>
        </div>
        <p>
          Reliable AI is a system, not a prompt. Explore the stages that connect
          relevant information to an output people can understand and use.
        </p>
      </div>
      <div class="workflow-layout">
        <div class="workflow-selector">
          <p class="workflow-selector-label">
            SELECT A STAGE <span data-stage-count>01 / 05</span>
          </p>
          <div
            class="workflow-tabs"
            role="tablist"
            aria-label="AI solution workflow stages"
          >
            {stages.map((stage, index) => (
              <button
                class="workflow-tab"
                type="button"
                role="tab"
                id={`workflow-tab-${stage.id}`}
                aria-controls={`workflow-panel-${stage.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                tabindex={index === 0 ? '0' : '-1'}
                data-workflow-tab={stage.id}
              >
                <span class="workflow-tab-number">{stage.number}</span>
                <span class="workflow-tab-copy">
                  <strong>{stage.short}</strong>
                  <small>{stage.title}</small>
                </span>
                <span class="workflow-tab-arrow" aria-hidden="true">
                  ↗
                </span>
              </button>
            ))}
          </div>
          <div class="collaboration-note">
            <span aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M7 10.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM17 10.5a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM3.5 19v-1.2A4.3 4.3 0 0 1 7.8 13.5h1.4M20.5 19v-1.2a4.3 4.3 0 0 0-4.3-4.3h-1.4M9 19v-1.4a4.5 4.5 0 0 1 9 0V19z" />
              </svg>
            </span>
            <div>
              <strong>Continuous collaboration</strong>
              <p>
                Feedback, communication, and quality checks throughout the
                journey.
              </p>
            </div>
          </div>
        </div>

        <div class="workflow-experience">
          <div class="workflow-visual-shell">
            <div class="workflow-visual-heading">
              <span>AI SOLUTION / PROCESS MAP</span>
              <span class="workflow-live">
                <i></i>CONTROLLED FLOW
              </span>
            </div>
            <div
              class="workflow-scenes"
              aria-label="Visual representation of selected AI workflow stage"
            >
              <div
                class="workflow-scene is-active"
                data-workflow-scene="sources"
                aria-hidden="false"
              >
                <div class="scene-source-stack">
                  <div class="source-file">
                    <i>DOC</i>
                    <span>
                      <b>Operating guide</b>
                      <small>Approved document</small>
                    </span>
                    <em>✓</em>
                  </div>
                  <div class="source-file">
                    <i>CRM</i>
                    <span>
                      <b>Customer record</b>
                      <small>Permission checked</small>
                    </span>
                    <em>✓</em>
                  </div>
                  <div class="source-file">
                    <i>API</i>
                    <span>
                      <b>Business system</b>
                      <small>Read-only access</small>
                    </span>
                    <em>✓</em>
                  </div>
                </div>
                <div class="scene-connector">
                  <span></span>
                  <i></i>
                  <span></span>
                </div>
                <div class="source-boundary">
                  <small>ALLOWED CONTEXT</small>
                  <strong>3 sources in scope</strong>
                  <div class="boundary-meter">
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                    <i></i>
                  </div>
                  <em>Access policy applied</em>
                </div>
                <span class="scene-corner-label">SOURCES / SCOPE / ACCESS</span>
              </div>
              <div
                class="workflow-scene"
                data-workflow-scene="context"
                aria-hidden="true"
                hidden
              >
                <div class="retrieval-query">
                  <small>USER QUESTION</small>
                  <p>“What is the current approval process?”</p>
                  <span>Search permitted knowledge ↗</span>
                </div>
                <div class="retrieval-results">
                  <div class="retrieval-result result-selected">
                    <span>01</span>
                    <div>
                      <b>Operations handbook</b>
                      <small>Section 4.2 · approval steps</small>
                      <i>
                        <em></em>
                      </i>
                    </div>
                    <strong>0.94</strong>
                  </div>
                  <div class="retrieval-result">
                    <span>02</span>
                    <div>
                      <b>Service policy</b>
                      <small>Updated 12 Feb · review path</small>
                      <i>
                        <em></em>
                      </i>
                    </div>
                    <strong>0.81</strong>
                  </div>
                  <div class="retrieval-result">
                    <span>03</span>
                    <div>
                      <b>Team guide</b>
                      <small>Roles and responsibilities</small>
                      <i>
                        <em></em>
                      </i>
                    </div>
                    <strong>0.72</strong>
                  </div>
                </div>
                <span class="scene-corner-label">
                  RETRIEVAL / RANKING / CITATIONS
                </span>
              </div>
              <div
                class="workflow-scene"
                data-workflow-scene="reasoning"
                aria-hidden="true"
                hidden
              >
                <div class="reasoning-context">
                  <small>CONTEXT WINDOW</small>
                  <span>3 cited passages</span>
                  <span>Task: summarize process</span>
                  <span>Tools: none required</span>
                </div>
                <div class="reasoning-core">
                  <div class="reasoning-core-orbit"></div>
                  <div class="reasoning-core-center">
                    <b>AI</b>
                    <small>REASON</small>
                  </div>
                  <div class="reasoning-token token-a"></div>
                  <div class="reasoning-token token-b"></div>
                </div>
                <div class="reasoning-output">
                  <small>STRUCTURED RESULT</small>
                  <b>Approval steps</b>
                  <i></i>
                  <i></i>
                  <i></i>
                  <span>Sources attached</span>
                </div>
                <span class="scene-corner-label">
                  TASK / CONTEXT / BOUNDED TOOLS
                </span>
              </div>
              <div
                class="workflow-scene"
                data-workflow-scene="validation"
                aria-hidden="true"
                hidden
              >
                <div class="validation-list">
                  <div>
                    <span>01</span>
                    <b>Source references included</b>
                    <i>PASS</i>
                  </div>
                  <div>
                    <span>02</span>
                    <b>Response matches format</b>
                    <i>PASS</i>
                  </div>
                  <div>
                    <span>03</span>
                    <b>Access policy respected</b>
                    <i>PASS</i>
                  </div>
                  <div class="validation-review">
                    <span>04</span>
                    <b>Human review required</b>
                    <i>REVIEW</i>
                  </div>
                </div>
                <div class="validation-side">
                  <div class="validation-seal">
                    <span>✓</span>
                  </div>
                  <small>QUALITY GATE</small>
                  <strong>Ready for review</strong>
                  <p>Checked against task rules and source context.</p>
                </div>
                <span class="scene-corner-label">
                  CHECK / ESCALATE / APPROVE
                </span>
              </div>
              <div
                class="workflow-scene"
                data-workflow-scene="workflow"
                aria-hidden="true"
                hidden
              >
                <div class="workflow-ticket">
                  <div class="ticket-bar">
                    <span>CASE / 2841</span>
                    <span class="ticket-state">PREPARED</span>
                  </div>
                  <h4>Approval request summary</h4>
                  <p>
                    Context and source links are ready for an operations
                    reviewer.
                  </p>
                  <div class="ticket-source">
                    <span>3</span> Verified knowledge references
                  </div>
                  <div class="ticket-actions">
                    <span>Return to case queue</span>
                    <b>Review next step&nbsp; ↗</b>
                  </div>
                </div>
                <div class="workflow-destination">
                  <div class="destination-icon">↗</div>
                  <small>EXISTING WORKFLOW</small>
                  <strong>Case management</strong>
                  <span>Human action remains in control</span>
                </div>
                <span class="scene-corner-label">
                  INTEGRATE / DELIVER / LEARN
                </span>
              </div>
            </div>
          </div>
          <div class="workflow-details" aria-live="polite" aria-atomic="true">
            {stages.map((stage, index) => (
              <article
                class="workflow-panel"
                id={`workflow-panel-${stage.id}`}
                role="tabpanel"
                aria-labelledby={`workflow-tab-${stage.id}`}
                tabindex="0"
                data-workflow-panel={stage.id}
                hidden={index !== 0}
              >
                <div class="workflow-panel-title">
                  <span>STAGE {stage.number}</span>
                  <h3>{stage.title}</h3>
                </div>
                <p class="workflow-description">{stage.description}</p>
                <div class="workflow-detail-grid">
                  <div>
                    <small>WHAT HAPPENS</small>
                    <ul>
                      {stage.activities.map((activity) => (
                        <li>{activity}</li>
                      ))}
                    </ul>
                  </div>
                  <div class="workflow-output">
                    <small>OUTPUT</small>
                    <p>{stage.output}</p>
                  </div>
                </div>
              </article>
            ))}
            <div class="workflow-progress">
              <span>PROCESS VIEW</span>
              <div class="workflow-progress-track" aria-hidden="true">
                <i data-workflow-progress></i>
              </div>
              <span data-stage-footer>01 / 05</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="ai-applications section section-soft"
    aria-labelledby="ai-applications-title"
  >
    <div class="site-container">
      <div class="ai-section-heading ai-applications-heading">
        <div>
          <p class="eyebrow">BUSINESS APPLICATIONS</p>
          <h2 id="ai-applications-title">
            Useful patterns across
            <br />
            <span>the work of a business.</span>
          </h2>
        </div>
        <p>
          These are practical scenarios to explore—not claims about a specific
          deployment. The fit depends on the process, information, and controls
          involved.
        </p>
      </div>
      <div class="application-grid">
        {applications.map((item, index) => (
          <article class="application-item">
            <div class="application-topline">
              <span>{item.code}</span>
              <span class="application-index">0{index + 1}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.scenario}</p>
            <div class="application-value">
              <span>WHY IT CAN HELP</span>
              <p>{item.value}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="ai-enterprise section" aria-labelledby="ai-enterprise-title">
    <div class="site-container enterprise-layout">
      <div class="enterprise-intro">
        <p class="eyebrow">BUILT FOR ENTERPRISE REALITIES</p>
        <h2 id="ai-enterprise-title">
          Good AI is shaped by its <span>boundaries.</span>
        </h2>
        <p>
          Real environments bring existing data, access rules, service
          expectations, and operating costs. Those realities should influence
          the design from the start.
        </p>
        <a class="text-link" href="#ai-workflow">
          See the workflow <span aria-hidden="true">↗</span>
