  .delivery-staging-card {
    fill: rgb(255 255 255 / 96%);
    stroke: rgb(84 123 157 / 32%);
    stroke-width: 1;
    filter: drop-shadow(0 5px 9px rgb(16 27 45 / 7%));
  }

  .delivery-staging-status {
