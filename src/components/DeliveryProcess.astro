    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .delivery-core-halo,
  .delivery-production-halo {
    fill: rgb(84 123 157 / 6%);
    stroke: rgb(84 123 157 / 16%);
    stroke-width: 1;
  }

  .delivery-core-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: delivery-core-pulse 4.8s ease-in-out infinite;
  }

  @keyframes delivery-core-pulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  .delivery-core-ring,
  .delivery-production-ring {
    fill: rgb(255 255 255 / 75%);
    stroke: rgb(84 123 157 / 28%);
    stroke-width: 1.5;
  }

  .delivery-core-dot {
    fill: var(--color-navy);
    stroke: rgb(168 65 33 / 60%);
    stroke-width: 2;
  }

  .delivery-core-icon {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .delivery-core-label,
  .delivery-check-label {
    fill: var(--color-navy-soft);
    font-family: var(--font-body);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .delivery-particle {
    fill: var(--color-orange-dark);
    filter: drop-shadow(0 0 4px rgb(168 65 33 / 35%));
    animation: delivery-particle-pulse 3.1s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .delivery-particle-two {
    fill: var(--color-blue);
    animation-delay: 1.2s;
  }

  @keyframes delivery-particle-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.78);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  .delivery-float {
    transform-box: fill-box;
    transform-origin: center;
    animation: delivery-float 5s ease-in-out infinite;
  }

  .delivery-float-two {
    animation-delay: -1.6s;
  }

  .delivery-float-three {
    animation-delay: -2.8s;
  }

  .delivery-float-four {
    animation-delay: -0.9s;
  }

  @keyframes delivery-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .delivery-screen-top {
    stroke: rgb(16 27 45 / 10%);
  }

  .delivery-wire-block {
    fill: rgb(84 123 157 / 12%);
    stroke: rgb(84 123 157 / 18%);
  }

  .delivery-wire-accent {
    fill: rgb(168 65 33 / 78%);
  }

  .delivery-blueprint-panel {
