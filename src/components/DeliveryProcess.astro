    width: 1.05rem;
    height: 1.05rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .delivery-collaboration > span:nth-child(2) {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
  }

  .delivery-collaboration strong {
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .delivery-collaboration > span:nth-child(2) > span {
    color: var(--color-body);
    font-size: 0.7rem;
    line-height: 1.4;
