---
import BaseLayout from '../layouts/BaseLayout.astro'
import { faqs, pages } from '../data/site-content.js'
---

<BaseLayout title={pages.faq.title} description={pages.faq.description}>
  <main id="main-content" class="faq-page">
    <section
      class="faq-hero hero-system hero-system--text"
      aria-labelledby="faq-hero-heading"
    >
      <div class="site-container faq-hero-inner hero-system__inner reveal">
        <div class="hero-system__copy">
          <p class="eyebrow hero-system__eyebrow">FAQ</p>
          <h1 id="faq-hero-heading" class="faq-hero-title hero-system__title">
            Frequently asked questions.
          </h1>
          <p class="faq-hero-lead hero-system__description">
            Find clear, direct answers about Incaendo’s services, technologies,
            custom application development, and ongoing support.
          </p>
        </div>
      </div>
    </section>

    <section class="faq-content-section" aria-labelledby="faq-section-heading">
      <div class="site-container faq-layout">
        <div class="faq-header-block reveal">
          <span class="faq-label">FAQ</span>
          <h2 id="faq-section-heading" class="faq-section-title">
            Common questions about how we work
          </h2>
          <p class="faq-section-desc">
            Everything you need to know about our capabilities, platforms,
            design process, security practices, and post-launch maintenance.
          </p>
          <div class="faq-sidebar-card">
            <h3>Have a Specific Project Requirement?</h3>
            <p>
              Our engineering team is ready to consult on architecture,
              technology choices, and project feasibility.
            </p>
            <a class="button button-primary" href="/contact">
              Talk to our team <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <div class="faq-accordion-wrap">
          <div class="faq-list reveal" data-reveal-stagger>
            {faqs.map((faq, index) => (
              <details class="faq-item" open={index === 0}>
                <summary>
                  <span class="faq-question-text">{faq.question}</span>
                  <span class="faq-mark" aria-hidden="true" />
                </summary>
                <div class="faq-answer">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .faq-page {
    background-color: var(--color-paper);
    min-height: 100vh;
  }

  /* Design system Hero: canvas ground, left-aligned copy. */
  .faq-hero {
  }

  .faq-content-section {
    padding-block: clamp(4rem, 7vw, 6.5rem);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 992px) {
    .faq-layout {
      grid-template-columns: 360px 1fr;
      gap: 4rem;
      align-items: start;
    }

    .faq-header-block {
      position: sticky;
      top: calc(var(--site-header-height) + 2rem);
    }
  }

  .faq-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-orange-text);
    margin-bottom: 0.75rem;
  }

  .faq-section-title {
    font-family: var(--font-heading);
    font-size: var(--type-section-size);
    font-weight: var(--type-section-weight);
    line-height: 1.2;
    letter-spacing: -0.01em;
    word-spacing: normal;
    color: var(--color-ink);
    margin-bottom: 1rem;
  }

  .faq-section-desc {
    font-size: var(--type-intro-size);
    line-height: 1.65;
    color: var(--color-body);
    margin-bottom: 2rem;
  }

  .faq-sidebar-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-medium);
    padding: 1.75rem;
    box-shadow: 0 4px 20px rgba(15, 33, 54, 0.04);
  }

  .faq-sidebar-card h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .faq-sidebar-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-muted);
    margin-bottom: 1.25rem;
  }

  .faq-accordion-wrap {
    background: var(--color-white);
    border: 0;
    border-radius: var(--radius-large);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    box-shadow: var(--shadow-1);
  }

  .faq-accordion-wrap .faq-list {
    border-top: none;
  }

  .faq-accordion-wrap .faq-item {
    border-bottom: 1px solid var(--color-line);
    padding-block: 0.4rem;
  }

  .faq-accordion-wrap .faq-item:last-child {
    border-bottom: none;
  }

  .faq-accordion-wrap .faq-item summary {
    font-size: 1.05rem;
    padding-block: 0.8rem;
  }

  .faq-question-text {
    padding-right: 1rem;
    line-height: 1.45;
  }
</style>
