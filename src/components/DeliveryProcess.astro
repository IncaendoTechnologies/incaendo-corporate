<style>
  .delivery-process {
    --stage-gap: clamp(0.85rem, 1.5vw, 1.25rem);
    position: relative;
    padding-block: clamp(4rem, 6.5vw, 6rem);
    background:
      radial-gradient(
        ellipse at 6% 10%,
        rgb(201 84 43 / 6%),
        transparent 28rem
      ),
      radial-gradient(
        ellipse at 96% 90%,
        rgb(84 123 157 / 7%),
        transparent 30rem
      ),
      var(--color-paper);
  }

  /* Holds shared gradients/filters; display:none would break them */
  .dp-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .delivery-intro {
    max-width: 780px;
    margin: 0 auto clamp(2rem, 3.5vw, 2.75rem);
    text-align: center;
  }
  .delivery-intro .eyebrow {
    margin-bottom: 0.8rem;
  }
  .delivery-intro h2 {
    margin: 0 0 0.8rem;
    color: var(--color-ink);
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
  }
  .delivery-intro h2 span {
    color: var(--color-orange-dark);
  }
  .delivery-intro-copy {
    margin: 0 auto;
    color: var(--color-body);
    font-size: var(--type-body-size);
    line-height: var(--type-body-line-height);
  }

  /* Five stage cards */
  .delivery-stages {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--stage-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .delivery-stage {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: 0.45rem 0.45rem 1.25rem;
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: 20px;
    background: linear-gradient(165deg, #fff 0%, #fffdfa 100%);
    box-shadow:
      0 18px 40px -32px rgb(16 27 45 / 38%),
      0 2px 6px rgb(16 27 45 / 3%);
    transition:
      transform var(--duration-standard) var(--ease-out),
      border-color var(--duration-standard) ease,
      box-shadow var(--duration-standard) ease;
  }

  /* Illustration frame; the chevron between cards hangs off its right edge */
  .delivery-stage-art {
    position: relative;
  }
  .delivery-stage-canvas {
    aspect-ratio: 220 / 140;
    overflow: hidden;
    border-radius: 14px;
    background:
      radial-gradient(ellipse at 30% 20%, rgb(201 84 43 / 7%), transparent 60%),
      radial-gradient(
        ellipse at 80% 90%,
        rgb(84 123 157 / 9%),
        transparent 60%
      ),
      #faf7f2;
    transition: background-color var(--duration-standard) ease;
  }
  .delivery-stage-canvas svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .delivery-stage:not(:last-child) .delivery-stage-art::after {
    position: absolute;
    z-index: 2;
    top: 50%;
    right: calc(-0.45rem - 1px - var(--stage-gap) / 2);
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
    border: 1px solid rgb(201 84 43 / 22%);
    border-radius: 50%;
    background: var(--color-paper);
    color: var(--color-orange-dark);
    content: '›';
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1;
    transform: translate(50%, -50%);
  }

  .delivery-stage-head {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1.25rem 0.6rem 0.45rem;
  }
  .delivery-stage-number {
    flex: none;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    background: #f8eee8;
    color: var(--color-orange-dark);
    font-size: 0.7rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    transition:
      background-color var(--duration-standard) ease,
      color var(--duration-standard) ease;
  }
  .delivery-stage h3 {
    margin: 0;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    word-spacing: 0.03em;
    line-height: 1.25;
  }
  .delivery-stage p {
    margin: 0 0.6rem;
    color: var(--color-body);
    font-size: 0.87rem;
    line-height: 1.55;
  }

  @media (hover: hover) {
    .delivery-stage:hover {
      transform: translateY(-4px);
      border-color: rgb(201 84 43 / 26%);
      box-shadow:
        0 24px 44px -28px rgb(168 65 33 / 40%),
        0 0 0 4px rgb(201 84 43 / 5%);
    }
    .delivery-stage:hover .delivery-stage-canvas {
      background-color: #fdf4ee;
    }
    .delivery-stage:hover .delivery-stage-number {
      background: var(--color-orange-dark);
      color: #fff;
    }
    .delivery-stage:hover .dp-focal {
      filter: drop-shadow(0 0 6px rgb(201 84 43 / 45%));
    }
  }

  /* Illustration palette (shared by all five) */
  .dp-card {
    stroke: rgb(16 27 45 / 10%);
    stroke-width: 1;
  }
  .dp-tile {
    fill: #f8f5f0;
    stroke: rgb(16 27 45 / 8%);
    stroke-width: 1;
  }
  .dp-rule {
    stroke: rgb(16 27 45 / 12%);
    stroke-width: 1.2;
  }
  .dp-grid {
    stroke: rgb(16 27 45 / 7%);
    stroke-dasharray: 2 4;
