  }

  .delivery-product-panel {
    fill: #fff;
    stroke: rgb(84 123 157 / 35%);
  }

  .delivery-product-top {
    stroke: rgb(16 27 45 / 10%);
  }

  .delivery-product-module {
    fill: rgb(84 123 157 / 13%);
