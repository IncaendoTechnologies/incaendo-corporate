---
import { Image } from 'astro:assets'
import { projects, projectCategories } from '../data/projects.js'
import FilterBar from './FilterBar.astro'
import IndustryChips from './IndustryChips.astro'
import Pagination from './Pagination.astro'

const tomo = projects.find((project) => project.name === 'Tomo')
const dominos = projects.find((project) => project.name === "Domino's")
const zeeMedia = projects.find((project) => project.name === 'Zee Media')

const filterItems = projectCategories.map((category, index) => ({
  label: category,
  value: index === 0 ? 'all' : category,
}))
---

<section class="projects-hero" aria-labelledby="projects-page-heading">
  <div class="site-container projects-hero-layout">
    <div class="projects-hero-copy">
      <p class="eyebrow">
        <span class="eyebrow-dot"></span> Selected work
      </p>
      <h1 id="projects-page-heading">
        A portfolio of <span>digital work</span>, shaped around what matters.
      </h1>
      <p class="projects-hero-description">
        Explore products, platforms, and digital experiences from across
        Incaendo’s project portfolio. Each reflects a different audience,
        challenge, and role for technology.
      </p>
      <div class="projects-hero-actions">
        <a class="button button-primary" href="/contact">
          Discuss your project <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="#project-portfolio">
          Explore the portfolio{' '}
          <span class="link-arrow link-arrow-down" aria-hidden="true">
            ↓
          </span>
        </a>
      </div>
      <div class="projects-hero-meta" aria-label="Portfolio coverage">
        <span>Mobile products</span>
        <span>Web platforms</span>
        <span>Connected services</span>
      </div>
    </div>

    <div class="projects-hero-visual" aria-hidden="true">
      <div class="hero-visual-halo" aria-hidden="true"></div>
      <figure class="hero-screen hero-screen-main">
        <Image
          src={dominos.image}
          alt=""
          width={640}
          sizes="(max-width: 900px) 80vw, 40vw"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>
          {dominos.name}
          <span>Commerce</span>
        </figcaption>
      </figure>
      <figure class="hero-screen hero-screen-left">
        <Image
          src={tomo.image}
          alt=""
          width={360}
          sizes="(max-width: 700px) 36vw, 18vw"
          loading="eager"
        />
        <figcaption>{tomo.name}</figcaption>
      </figure>
      <figure class="hero-screen hero-screen-right">
        <Image
          src={zeeMedia.image}
          alt=""
          width={380}
          sizes="(max-width: 700px) 38vw, 19vw"
          loading="eager"
        />
        <figcaption>{zeeMedia.name}</figcaption>
      </figure>
      <span class="hero-visual-index" aria-hidden="true">
        INCAENDO / PROJECTS
      </span>
    </div>
  </div>
</section>

<section
  class="portfolio-section section"
  id="project-portfolio"
  aria-labelledby="portfolio-heading"
>
  <div class="site-container">
    <div class="portfolio-intro">
      <div>
        <p class="eyebrow">Project portfolio</p>
        <h2 id="portfolio-heading">
          Different challenges. <span>Thoughtful digital work.</span>
        </h2>
      </div>
      <p>
        Browse a selection across digital products, media, commerce, financial
        services, operations, and learning. Each project shows its documented
        overview and scope, without claims beyond the source material.
      </p>
    </div>

    <FilterBar
      items={filterItems}
      ariaLabel="Filter projects by category"
      dataToolbar="data-project-toolbar"
      dataFilter="data-project-filter"
      chipClass="project-filter"
    />

    <div class="project-list reveal" data-reveal-stagger>
      {projects.map((project, index) => (
        <article
          class="project-row"
          aria-labelledby={`project-${index + 1}-heading`}
          data-portfolio-card
          data-category={project.category}
          data-reveal-item
        >
          <figure class="project-row-media">
            <Image
              src={project.image}
              alt={project.alt}
              width={980}
              sizes="(max-width: 760px) 92vw, (max-width: 1100px) 44vw, 540px"
              quality={90}
              loading={index < 3 ? 'eager' : 'lazy'}
            />
          </figure>
          <div class="project-row-copy">
            <h3 id={`project-${index + 1}-heading`}>{project.name}</h3>
            <IndustryChips
              industries={project.industries}
              class="project-row-chips"
            />
            <p class="project-row-overview">{project.description}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="portfolio-empty" data-project-empty hidden>
      No projects in this category yet. Choose another area to explore.
    </p>
    <Pagination
      ariaLabel="Project pages"
      dataPagination="data-project-pagination"
      dataPrev="data-page-prev"
      dataNext="data-page-next"
      dataNumbers="data-page-numbers"
    />
  </div>
</section>

<script>
  const PAGE_SIZE = 10
  const portfolio = document.querySelector('.portfolio-section')

  if (portfolio instanceof HTMLElement) {
    const filters = portfolio.querySelectorAll('[data-project-filter]')
    const cards = Array.from(
      portfolio.querySelectorAll('[data-portfolio-card]'),
    )
    const emptyState = portfolio.querySelector('[data-project-empty]')
    const pagination = portfolio.querySelector('[data-project-pagination]')
    const pageNumbers = portfolio.querySelector('[data-page-numbers]')
    const prevButton = portfolio.querySelector('[data-page-prev]')
    const nextButton = portfolio.querySelector('[data-page-next]')
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches

    let activeCategory = 'all'
    let currentPage = 1

    const render = (scrollToGrid = false) => {
      const matches = cards.filter(
        (card) =>
          activeCategory === 'all' ||
          card.getAttribute('data-category') === activeCategory,
      )
      const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE))
      currentPage = Math.min(Math.max(currentPage, 1), totalPages)
      const start = (currentPage - 1) * PAGE_SIZE
      const end = start + PAGE_SIZE

      cards.forEach((card) => {
        const matchIndex = matches.indexOf(card)
        card.hidden =
          matchIndex === -1 || matchIndex < start || matchIndex >= end
      })

      if (emptyState) emptyState.hidden = matches.length !== 0

      if (pagination instanceof HTMLElement) {
        pagination.hidden = matches.length === 0 || totalPages <= 1
      }

      if (prevButton instanceof HTMLButtonElement) {
        prevButton.disabled = currentPage === 1
      }
      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = currentPage === totalPages
      }

      if (pageNumbers) {
        pageNumbers.innerHTML = ''
        for (let page = 1; page <= totalPages; page += 1) {
          const button = document.createElement('button')
          button.type = 'button'
          button.className = 'pagination-number'
          button.textContent = String(page)
          button.setAttribute('aria-label', `Go to page ${page}`)
          if (page === currentPage) {
            button.classList.add('is-active')
            button.setAttribute('aria-current', 'page')
          }
          button.addEventListener('click', () => {
            if (page === currentPage) return
            currentPage = page
            render(true)
          })
          pageNumbers.appendChild(button)
        }
      }

      if (scrollToGrid) {
        const grid = portfolio.querySelector('.project-list')
        grid?.scrollIntoView({
          behavior: reducedMotion ? 'auto' : 'smooth',
          block: 'start',
        })
      }
    }

    filters.forEach((filter) => {
      filter.addEventListener('click', () => {
        const category = filter.getAttribute('data-project-filter')

        filters.forEach((button) => {
          const isActive = button === filter
          button.classList.toggle('is-active', isActive)
          button.setAttribute('aria-pressed', String(isActive))
        })

        activeCategory = category ?? 'all'
        currentPage = 1
        render()
      })
    })

    prevButton?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage -= 1
        render(true)
      }
    })

    nextButton?.addEventListener('click', () => {
      currentPage += 1
      render(true)
    })

    // The site-wide scroll-reveal (src/scripts/motion.js) fires once for
    // this whole grid via IntersectionObserver and animates every
    // [data-reveal-item] it finds at that moment. If cards beyond page 1
    // are already hidden when that fires, GSAP sets their pre-animation
    // (invisible) state and never revisits them, so they'd stay invisible
    // forever even after a later page change unhides them. Waiting two
    // animation frames lets that one-time reveal run first.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        render()
      })
    })
  }
</script>

<style>
  .projects-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.7rem, 6vw, 5.5rem) clamp(4.25rem, 7vw, 6.25rem);
    background:
      radial-gradient(
        ellipse at 78% 46%,
        rgb(244 233 223 / 76%),
        transparent 34%
      ),
      #f1efeb;
  }

  .projects-hero::before,
  .projects-hero::after {
    position: absolute;
    z-index: 0;
    width: min(47vw, 620px);
    aspect-ratio: 1;
    border: 1px solid rgb(201 84 43 / 8%);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .projects-hero::before {
    top: -65%;
    right: -9%;
    box-shadow: 0 0 0 40px rgb(201 84 43 / 2%);
  }

  .projects-hero::after {
    right: 17%;
    bottom: -84%;
    width: min(33vw, 430px);
    border-color: rgb(84 123 157 / 8%);
  }

  .projects-hero-layout {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 510px;
    grid-template-columns: minmax(0, 0.93fr) minmax(0, 1.07fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .projects-hero-copy {
    max-width: 620px;
  }

  .projects-hero-copy .eyebrow {
    margin-bottom: 1.2rem;
  }

  .projects-hero h1 {
    max-width: 650px;
    margin-bottom: 1.35rem;
    color: var(--color-navy);
    font-size: var(--type-page-hero-size);
    font-weight: var(--type-display-weight);
    letter-spacing: var(--type-display-letter-spacing);
    word-spacing: var(--type-display-word-spacing);
    line-height: var(--type-page-hero-line-height);
  }

  .projects-hero h1 span,
  .portfolio-intro h2 span {
    color: var(--color-orange-dark);
  }

  .projects-hero-description {
    max-width: 570px;
    margin-bottom: 1.7rem;
    color: #5c6878;
    font-size: var(--type-body-size);
    line-height: var(--type-body-line-height);
  }

  .projects-hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.2rem 1.7rem;
  }

  .projects-hero-actions .text-link {
    font-size: 0.81rem;
    font-weight: 650;
  }

  .projects-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.15rem;
    margin-top: 2.4rem;
    color: #667283;
    font-size: 0.69rem;
    font-weight: 600;
  }

  .projects-hero-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .projects-hero-meta span::before {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-orange);
    content: '';
  }

  .projects-hero-visual {
    position: relative;
    min-width: 0;
    min-height: 490px;
    isolation: isolate;
  }

  .hero-visual-halo {
    position: absolute;
    top: 16%;
    left: 16%;
    width: 72%;
    aspect-ratio: 1;
    border: 1px solid rgb(84 123 157 / 19%);
    border-radius: 50%;
    box-shadow:
      0 0 0 28px rgb(84 123 157 / 3%),
      0 0 0 68px rgb(201 84 43 / 3%);
  }

  .hero-screen {
    position: absolute;
    z-index: 1;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgb(255 255 255 / 85%);
    border-radius: 14px;
    background: var(--color-white);
    box-shadow: 0 24px 70px rgb(16 27 45 / 17%);
    transform: translateZ(0);
  }

  .hero-screen img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-screen-main {
    top: 12%;
    right: 1%;
    width: 77%;
    height: 69%;
    transform: rotate(2deg);
  }

  .hero-screen-left {
    z-index: 2;
    bottom: 4%;
    left: 1%;
    width: 41%;
    height: 43%;
    transform: rotate(-5deg);
  }

  .hero-screen-right {
    z-index: 3;
    right: 0;
    bottom: 2%;
    width: 42%;
    height: 37%;
    transform: rotate(5deg);
  }

  .hero-screen figcaption {
    position: absolute;
    right: 0.55rem;
    bottom: 0.55rem;
    left: 0.55rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgb(255 255 255 / 80%);
    border-radius: 6px;
    background: rgb(255 255 255 / 92%);
    color: var(--color-navy);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.25;
    backdrop-filter: blur(10px);
  }

  .hero-screen figcaption span {
    color: var(--color-muted);
    font-size: 0.58rem;
    font-weight: 600;
  }

  .hero-visual-index {
    position: absolute;
    right: 0.2rem;
    bottom: 0;
    color: #8e9298;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.17em;
  }

  .portfolio-section {
    padding-block: 70px;
    background:
      radial-gradient(ellipse at 10% 4%, rgb(84 123 157 / 7%), transparent 30%),
      linear-gradient(180deg, #fbfaf8 0%, #f7f5f1 100%);
  }

  .portfolio-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(260px, 0.7fr);
    align-items: end;
    gap: 3rem;
    margin-bottom: 2.8rem;
  }

  .portfolio-intro .eyebrow {
    margin-bottom: 0.8rem;
  }

  .portfolio-intro h2 {
    max-width: 740px;
    margin: 0;
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
  }

  .portfolio-intro > p {
    max-width: 465px;
    margin: 0 0 0.25rem;
    color: #657182;
    font-size: 0.88rem;
    line-height: 1.7;
  }

  /* Project showcase: image-led cards raised from the page background */
  .project-list {
    display: grid;
    gap: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  .project-row {
    display: grid;
    grid-template-columns: minmax(0, 44fr) minmax(0, 56fr);
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding: clamp(1.25rem, 2.6vw, 2rem);
    border: 1px solid rgb(16 27 45 / 8%);
    border-radius: var(--radius-large);
    background: linear-gradient(135deg, #fff 0%, #fbf9f6 100%);
    box-shadow:
      0 1px 2px rgb(16 27 45 / 4%),
      0 16px 36px -18px rgb(16 27 45 / 14%);
  }

  .project-row[hidden] {
    display: none;
  }

  /* All project screenshots share a 1.72:1 ratio, so the frame matches it
     and images show in full without letterboxing or cropping */
  .project-row-media {
    position: relative;
    overflow: hidden;
    margin: 0;
    aspect-ratio: 1.72;
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: var(--radius-medium);
    background: var(--color-paper);
    box-shadow: 0 10px 24px -16px rgb(16 27 45 / 30%);
    transition:
      transform 420ms var(--ease-out),
      box-shadow 420ms var(--ease-out),
      border-color 420ms var(--ease-out);
  }

  .project-row-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out);
  }

  .project-row:hover .project-row-media {
    border-color: rgb(201 84 43 / 26%);
    box-shadow: 0 16px 32px -18px rgb(16 27 45 / 34%);
    transform: translateY(-3px);
  }

  .project-row:hover .project-row-media img {
    transform: scale(1.03);
  }

  .project-row-copy {
    min-width: 0;
  }

  .project-row h3 {
    margin: 0 0 0.8rem;
    color: var(--color-navy);
    font-size: clamp(1.8rem, 2.7vw, 2.55rem);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: 1.12;
  }

  .project-row :global(.project-row-chips) {
    margin-bottom: 0.9rem;
  }

  .project-row-overview {
    max-width: 620px;
    margin: 0;
    color: var(--color-body);
    font-size: 0.94rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .projects-hero-copy {
      animation: projects-rise-in 650ms var(--ease-out) both;
    }

    .projects-hero-visual {
      animation: projects-rise-in 800ms 100ms var(--ease-out) both;
    }

    @keyframes projects-rise-in {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 1050px) {
    .projects-hero-layout {
      min-height: 455px;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 2rem;
    }

    .projects-hero h1 {
      font-size: clamp(2.65rem, 5vw, 3.6rem);
    }

    .projects-hero-visual {
      min-height: 420px;
    }

    .project-row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 760px) {
    .projects-hero {
      padding-block: 3.5rem 4rem;
    }

    .projects-hero-layout {
      min-height: 0;
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }

    .projects-hero-copy {
      max-width: 680px;
    }

    .projects-hero h1 {
      max-width: 640px;
      font-size: clamp(2.6rem, 8vw, 3.7rem);
    }

    .projects-hero-meta {
      margin-top: 1.5rem;
    }

    .projects-hero-visual {
      width: 100%;
      max-width: 590px;
      min-height: clamp(320px, 69vw, 420px);
      margin-inline: auto;
    }

    .hero-screen-main {
      top: 9%;
      right: 3%;
      width: 76%;
      height: 70%;
    }

    .hero-screen-left {
      bottom: 4%;
      left: 1%;
      width: 40%;
      height: 41%;
    }

    .hero-screen-right {
      right: 1%;
      bottom: 2%;
      width: 40%;
      height: 36%;
    }

    .portfolio-intro {
      grid-template-columns: 1fr;
      gap: 1rem;
      margin-bottom: 2rem;
    }

    .portfolio-toolbar {
      align-items: flex-start;
      flex-direction: column;
    }

    .project-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.25rem;
    }
  }

  @media (max-width: 560px) {
    .projects-hero h1 {
      font-size: clamp(2.45rem, 10vw, 3.15rem);
    }

    .projects-hero-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.95rem;
    }

    .projects-hero-visual {
      min-height: 310px;
    }

    .hero-screen {
      border-radius: 9px;
    }

    .hero-screen figcaption {
      right: 0.35rem;
      bottom: 0.35rem;
      left: 0.35rem;
      padding: 0.4rem 0.5rem;
      font-size: 0.58rem;
    }

    .hero-screen figcaption span {
      display: none;
    }

    .project-row-media {
      border-radius: var(--radius-medium);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-row-media,
    .project-row-media img {
      transition: none;
      animation: none;
    }

    .project-row:hover .project-row-media,
    .project-row:hover .project-row-media img {
      transform: none;
    }
  }
</style>
