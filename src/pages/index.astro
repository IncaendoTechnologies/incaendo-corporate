    <section class="reachout-section" aria-labelledby="reachout-heading">
      <div class="site-container reachout-inner reveal">
        <div>
          <p class="eyebrow">A good place to start</p>
          <h2 id="reachout-heading">
            Tell Us What You’re
            <br />
            Working Toward.
          </h2>
        </div>
        <div class="reachout-action">
          <p>Share the challenge. We’ll help shape the next conversation.</p>
          <a
            class="button button-primary"
            href="/contact#project-inquiry"
            data-open-contact-modal
          >
            Discuss your project <span aria-hidden="true">↗</span>
          </a>
          <span class="small-note">
            Contact details and message delivery are being configured.
          </span>
        </div>
      </div>
    </section>

    <section class="section section-faq" aria-labelledby="faq-heading">
      <div class="site-container faq-layout">
        <div class="reveal">
          <p class="eyebrow">A few useful answers</p>
          <h2 id="faq-heading">
            Frequently
            <br />
            Asked Questions.
          </h2>
          <a class="text-link" href="/contact">
            Have another question?{' '}
            <span class="link-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
        <FAQList />
      </div>
    </section>
  </main>
</BaseLayout>
