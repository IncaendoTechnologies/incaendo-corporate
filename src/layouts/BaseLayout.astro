---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import ContactModal from '../components/ContactModal.astro'
import HubSpotTracking from '../components/HubSpotTracking.astro'
import SEO from '../components/SEO.astro'
import EntranceMotionBoot from '../components/EntranceMotionBoot.astro'
import introLogo from '../assets/Modern Blue and Orange iN Logo.png'

const {
  title = 'Incaendo | Software Development & Technology',
  description = 'Incaendo is a software development and technology company with 15 years of industry experience.',
  // canonicalPath, noindex, openGraphType, image, imageAlt, pageType,
  // breadcrumbs, article and schema pass through to the SEO component.
  ...seo
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f7f4" />
    <EntranceMotionBoot />
    <script is:inline>
      try {
        const introSeen = sessionStorage.getItem('incaendo-brand-intro-seen')
        const reducedMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches
        if (!introSeen && !reducedMotion) {
          sessionStorage.setItem('incaendo-brand-intro-seen', 'true')
          document.documentElement.dataset.brandIntro = 'playing'
        }
      } catch {
        // If storage or scripting is unavailable, keep the site unobstructed.
      }
    </script>
    <SEO title={title} description={description} {...seo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <HubSpotTracking />
  </head>
  <body>
    <div class="site-intro" data-site-intro aria-hidden="true" inert>
      <div class="site-intro-content">
        <div class="site-intro-visual">
          <span
            class="site-intro-particle is-orange"
            style="--x: -132px; --y: -58px; --delay: 690ms"
          ></span>
          <span
            class="site-intro-particle is-blue"
            style="--x: 130px; --y: -72px; --delay: 760ms"
          ></span>
          <span
            class="site-intro-particle is-orange"
            style="--x: -154px; --y: 16px; --delay: 820ms"
          ></span>
          <span
            class="site-intro-particle is-blue"
            style="--x: 151px; --y: 20px; --delay: 880ms"
          ></span>
          <span
            class="site-intro-particle is-blue"
            style="--x: -112px; --y: 78px; --delay: 740ms"
          ></span>
          <span
            class="site-intro-particle is-orange"
            style="--x: 115px; --y: 82px; --delay: 800ms"
          ></span>
          <img
            class="site-intro-logo"
            src={introLogo.src}
            width={introLogo.width}
            height={introLogo.height}
            alt=""
            decoding="async"
          />
        </div>
        <p class="site-intro-tagline">
          <span aria-hidden="true"></span>Ideas into digital solutions.
        </p>
      </div>
    </div>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <ContactModal />
    <script>
      import '../scripts/motion.js'
      import '../scripts/ai-showcase.js'
      import '../scripts/site-intro.js'
    </script>
  </body>
</html>
