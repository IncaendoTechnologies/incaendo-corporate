          <p class="eyebrow">Built on relationships</p>
          <h2 id="clients-heading">Good Work Begins with Trust.</h2>
        </div>
        <div class="client-proof-card">
          <span class="client-card-mark" aria-hidden="true">
            +
          </span>
          <div>
            <strong>Client names and logo assets</strong>
            <p>
              Awaiting verified company information and permission to publish.
            </p>
          </div>
          <a href="/contact" aria-label="Discuss Incaendo's client work">
            ↗
          </a>
        </div>
      </div>
    </section> -->

