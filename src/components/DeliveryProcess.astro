  .delivery-orbit-ring {
    stroke: rgb(84 123 157 / 13%);
    stroke-dasharray: 2 8;
    stroke-width: 1;
    transform-origin: center;
    animation: delivery-orbit 45s linear infinite;
  }

  @keyframes delivery-orbit {
