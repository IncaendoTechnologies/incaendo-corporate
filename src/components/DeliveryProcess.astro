  .delivery-visual-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .delivery-visual-pulse {
    width: 0.43rem;
    height: 0.43rem;
    border-radius: 50%;
    background: var(--color-orange-dark);
    box-shadow: 0 0 0 4px rgb(168 65 33 / 10%);
    animation: delivery-status-pulse 2.8s ease-in-out infinite;
  }

  .delivery-visual-count {
    color: var(--color-navy-soft);
    font-variant-numeric: tabular-nums;
  }

  @keyframes delivery-status-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 4px rgb(168 65 33 / 9%);
    }
    50% {
      box-shadow: 0 0 0 7px rgb(168 65 33 / 3%);
    }
  }

  .delivery-scene {
    position: relative;
    z-index: 1;
    display: block;
    width: min(100%, 640px);
    height: 100%;
    overflow: visible;
    padding: 2.2rem 0.55rem 0.45rem;
  }

  .delivery-route,
  .delivery-orbit-ring,
  .delivery-screen-top,
  .delivery-blueprint-line,
  .delivery-blueprint-link,
  .delivery-api-link,
  .delivery-product-top,
  .delivery-qa-progress,
  .delivery-check-mark,
  .delivery-release-line,
  .delivery-monitor-line,
  .delivery-feedback-loop,
  .delivery-feedback-arrow,
  .delivery-core-icon {
    vector-effect: non-scaling-stroke;
  }

  .delivery-route {
    stroke: rgb(84 123 157 / 38%);
    stroke-width: 1.5;
  }

  .delivery-route-soft {
    stroke: rgb(84 123 157 / 17%);
    stroke-width: 1;
  }

  .delivery-route-dash {
    stroke-dasharray: 5 8;
    animation: delivery-route-flow 14s linear infinite;
  }

  @keyframes delivery-route-flow {
    to {
      stroke-dashoffset: -104;
    }
  }

  .delivery-orbit-ring {
    stroke: rgb(84 123 157 / 13%);
    stroke-dasharray: 2 8;
    stroke-width: 1;
    transform-origin: center;
    animation: delivery-orbit 45s linear infinite;
  }

  @keyframes delivery-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  .delivery-node-card,
  .delivery-screen,
  .delivery-blueprint-panel,
  .delivery-code-panel,
  .delivery-api-card,
  .delivery-product-panel,
  .delivery-qa-panel,
  .delivery-release-card,
  .delivery-monitor-card,
  .delivery-feedback-card {
    fill: rgb(255 255 255 / 90%);
    stroke: rgb(16 27 45 / 10%);
    stroke-width: 1;
  }

  .delivery-node-card,
  .delivery-screen,
  .delivery-code-panel,
  .delivery-api-card,
  .delivery-release-card,
  .delivery-monitor-card,
  .delivery-feedback-card {
    filter: drop-shadow(0 5px 9px rgb(16 27 45 / 6%));
  }

  .delivery-node-line,
  .delivery-blueprint-line,
  .delivery-release-line {
    stroke: rgb(84 123 157 / 33%);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .delivery-node-dot,
  .delivery-screen-dot,
  .delivery-window-dot {
    fill: var(--color-blue);
  }

  .delivery-dot-blue {
    fill: var(--color-blue);
  }

  .delivery-dot-orange,
  .delivery-window-dot-orange {
    fill: var(--color-orange-dark);
  }

  .delivery-svg-label {
    fill: #8793a0;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .delivery-core-halo,
  .delivery-production-halo {
    fill: rgb(84 123 157 / 6%);
    stroke: rgb(84 123 157 / 16%);
    stroke-width: 1;
  }

  .delivery-core-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: delivery-core-pulse 4.8s ease-in-out infinite;
  }

  @keyframes delivery-core-pulse {
    0%,
    100% {
      opacity: 0.65;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  .delivery-core-ring,
  .delivery-production-ring {
    fill: rgb(255 255 255 / 75%);
    stroke: rgb(84 123 157 / 28%);
    stroke-width: 1.5;
  }

  .delivery-core-dot {
    fill: var(--color-navy);
    stroke: rgb(168 65 33 / 60%);
    stroke-width: 2;
  }

  .delivery-core-icon {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .delivery-core-label,
  .delivery-check-label {
    fill: var(--color-navy-soft);
    font-family: var(--font-body);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .delivery-particle {
    fill: var(--color-orange-dark);
    filter: drop-shadow(0 0 4px rgb(168 65 33 / 35%));
    animation: delivery-particle-pulse 3.1s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .delivery-particle-two {
    fill: var(--color-blue);
    animation-delay: 1.2s;
  }

  @keyframes delivery-particle-pulse {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(0.78);
    }
    50% {
      opacity: 1;
      transform: scale(1.2);
    }
  }

  .delivery-float {
    transform-box: fill-box;
    transform-origin: center;
    animation: delivery-float 5s ease-in-out infinite;
  }

  .delivery-float-two {
    animation-delay: -1.6s;
  }

  .delivery-float-three {
    animation-delay: -2.8s;
  }

  .delivery-float-four {
    animation-delay: -0.9s;
  }

  @keyframes delivery-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .delivery-screen-top {
    stroke: rgb(16 27 45 / 10%);
  }

  .delivery-wire-block {
    fill: rgb(84 123 157 / 12%);
    stroke: rgb(84 123 157 / 18%);
  }

  .delivery-wire-accent {
    fill: rgb(168 65 33 / 78%);
  }

  .delivery-blueprint-panel {
    fill: rgb(246 248 249 / 95%);
    stroke: rgb(84 123 157 / 24%);
  }

  .delivery-blueprint-line {
    stroke: rgb(84 123 157 / 30%);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .delivery-blueprint-node {
    fill: #fff;
    stroke: var(--color-blue);
    stroke-width: 2;
  }

  .delivery-blueprint-node-accent {
    fill: var(--color-orange-dark);
    stroke: #fff;
  }

  .delivery-blueprint-link {
    stroke: rgb(84 123 157 / 45%);
    stroke-width: 2;
  }

  .delivery-blueprint-component {
    fill: var(--color-navy-soft);
    font-family: var(--font-body);
    font-size: 6px;
    font-weight: 700;
    letter-spacing: 0.35px;
  }

  .delivery-code-line {
    fill: none;
    stroke: var(--color-orange-dark);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .delivery-api-node {
    fill: #fff;
    stroke: var(--color-blue);
    stroke-width: 2;
  }

  .delivery-api-link {
    stroke: rgb(84 123 157 / 45%);
    stroke-dasharray: 4 5;
    stroke-width: 1.5;
    animation: delivery-route-flow 12s linear infinite;
  }

  .delivery-product-panel {
    fill: #fff;
    stroke: rgb(84 123 157 / 35%);
  }

  .delivery-product-top {
    stroke: rgb(16 27 45 / 10%);
  }

  .delivery-product-module {
    fill: rgb(84 123 157 / 13%);
    stroke: rgb(84 123 157 / 25%);
  }

  .delivery-product-module-accent {
    fill: rgb(168 65 33 / 14%);
    stroke: rgb(168 65 33 / 38%);
  }

  .delivery-qa-panel {
    fill: rgb(255 255 255 / 91%);
    stroke: rgb(16 27 45 / 11%);
    filter: drop-shadow(0 12px 20px rgb(16 27 45 / 6%));
  }

  .delivery-qa-progress {
    stroke: rgb(84 123 157 / 28%);
    stroke-linecap: round;
    stroke-width: 3;
  }

  .delivery-check-halo {
    fill: rgb(84 123 157 / 8%);
    animation: delivery-check-halo 3.4s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .delivery-check-two .delivery-check-halo {
    animation-delay: 0.7s;
  }

  .delivery-check-three .delivery-check-halo {
    animation-delay: 1.4s;
  }

  .delivery-check-four .delivery-check-halo {
    animation-delay: 2.1s;
  }

  @keyframes delivery-check-halo {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.92);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  .delivery-check-ring {
    fill: #fff;
    stroke: var(--color-blue);
    stroke-width: 1.5;
  }

  .delivery-check-ring-accent {
    stroke: var(--color-orange-dark);
  }

  .delivery-check-mark {
    fill: none;
    stroke: var(--color-blue);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .delivery-check-three .delivery-check-mark {
    stroke: var(--color-orange-dark);
  }

  .delivery-check-label {
    font-size: 8.5px;
  }

  .delivery-check-warning {
    fill: var(--color-orange-dark);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
  }

  .delivery-result-chip {
    fill: rgb(84 123 157 / 9%);
    stroke: rgb(84 123 157 / 24%);
  }

  .delivery-result-dot {
    fill: var(--color-orange-dark);
  }

  .delivery-result-label {
    fill: var(--color-navy-soft);
    font-family: var(--font-body);
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.8px;
  }

  .delivery-production-node {
    fill: var(--color-navy);
    stroke: rgb(84 123 157 / 55%);
    stroke-width: 1;
  }

  .delivery-production-node-two {
    fill: #1b2a40;
  }

  .delivery-production-status {
    fill: #72bd91;
    filter: drop-shadow(0 0 4px rgb(114 189 145 / 60%));
  }

  .delivery-monitor-grid {
    stroke: rgb(84 123 157 / 22%);
    stroke-dasharray: 2 4;
  }

  .delivery-monitor-line {
    fill: none;
    stroke: var(--color-orange-dark);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    stroke-dasharray: 180;
    animation: delivery-draw-line 4.8s ease-in-out infinite alternate;
  }

  .delivery-staging-card {
    fill: rgb(255 255 255 / 96%);
    stroke: rgb(84 123 157 / 32%);
    stroke-width: 1;
    filter: drop-shadow(0 5px 9px rgb(16 27 45 / 7%));
  }

  .delivery-staging-status {
    fill: var(--color-blue);
    filter: drop-shadow(0 0 3px rgb(84 123 157 / 45%));
  }

  .delivery-staging-label,
  .delivery-monitor-metric,
  .delivery-feedback-caption {
    fill: var(--color-navy-soft);
    font-family: var(--font-body);
    font-size: 7px;
    font-weight: 700;
    letter-spacing: 0.45px;
  }

  .delivery-staging-line {
    stroke: rgb(84 123 157 / 38%);
    stroke-linecap: round;
    stroke-width: 2;
  }

  .delivery-monitor-metric {
    fill: var(--color-blue);
    font-size: 5.5px;
    letter-spacing: 0.2px;
  }

  .delivery-feedback-caption {
    fill: #8793a0;
    font-size: 5px;
    letter-spacing: 0.35px;
  }

  @keyframes delivery-draw-line {
    from {
      stroke-dashoffset: 180;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .delivery-feedback-loop,
  .delivery-feedback-arrow {
    fill: none;
    stroke: var(--color-blue);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .delivery-feedback-arrow {
    stroke: var(--color-orange-dark);
    stroke-width: 1.6;
  }

  .delivery-panel-content {
    padding: clamp(1.35rem, 2.6vw, 2rem) clamp(1.25rem, 3.2vw, 2.5rem) 1.5rem;
  }

  .delivery-panel-heading {
    max-width: 710px;
  }

  .delivery-stage-label {
    display: inline-block;
    margin-bottom: 0.55rem;
    color: var(--color-orange-dark);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .delivery-panel-heading h3 {
    margin-bottom: 0.55rem;
    color: var(--color-navy);
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    font-weight: var(--type-heading-weight);
    letter-spacing: -0.05em;
    line-height: 1.16;
  }

  .delivery-panel-heading p {
    max-width: 670px;
    margin-bottom: 1.4rem;
    color: var(--color-body);
    font-size: 0.91rem;
    line-height: 1.65;
  }

  .delivery-detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: 1.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--delivery-line);
  }

  .delivery-detail-grid h4 {
    margin-bottom: 0.7rem;
    color: var(--color-navy-soft);
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .delivery-detail-grid ul {
    display: grid;
    gap: 0.52rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .delivery-detail-grid li {
    position: relative;
    padding-left: 1rem;
    color: var(--color-body);
    font-size: 0.77rem;
    line-height: 1.45;
  }

  .delivery-detail-grid li::before {
    position: absolute;
    top: 0.48em;
    left: 0;
    width: 0.38rem;
    height: 0.38rem;
    border: 1px solid rgb(84 123 157 / 60%);
    border-radius: 50%;
    background: rgb(84 123 157 / 12%);
    content: '';
  }

  .delivery-deliverables li::before {
    border-color: rgb(168 65 33 / 65%);
    background: rgb(168 65 33 / 12%);
  }

  .delivery-controls {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(100px, 1fr) minmax(130px, 1.3fr) minmax(
        100px,
        1fr
      );
    align-items: center;
    gap: 1rem;
    padding: 0.2rem 0 0.1rem;
  }

  .delivery-control-button {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgb(16 27 45 / 11%);
    border-radius: 10px;
    background: #fff;
    color: var(--color-navy);
    cursor: pointer;
    font-size: 0.74rem;
    font-weight: 650;
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms var(--ease-out),
      background-color 220ms var(--ease-out),
      color 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out);
  }

  .delivery-control-button:not(:disabled):hover {
    transform: translateY(-2px);
    border-color: rgb(168 65 33 / 40%);
    box-shadow: 0 7px 17px rgb(16 27 45 / 8%);
    color: var(--color-orange-dark);
  }

  .delivery-control-button:focus-visible {
    outline: 3px solid #e1784f;
    outline-offset: 3px;
  }

  .delivery-control-button:disabled {
    background: #f7f6f3;
    color: #a2a8ad;
    cursor: not-allowed;
    opacity: 0.75;
  }

  .delivery-control-next {
    border-color: var(--color-navy);
    background: var(--color-navy);
    color: #fff;
  }

  .delivery-control-next:not(:disabled):hover {
    border-color: var(--color-orange-dark);
    background: var(--color-orange-dark);
    color: #fff;
  }

  .delivery-progress-wrap {
    min-width: 0;
  }

  .delivery-progress-copy {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.45rem;
    color: var(--color-muted);
    font-size: 0.59rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .delivery-progress-copy span:first-child {
    color: var(--color-navy-soft);
    font-variant-numeric: tabular-nums;
  }

  .delivery-progress-track {
    height: 4px;
    overflow: hidden;
    border-radius: 99px;
    background: rgb(84 123 157 / 14%);
  }

  .delivery-progress-track > span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(
      90deg,
      var(--color-blue),
      var(--color-orange-dark)
    );
    transform: scaleX(0.2);
    transform-origin: left center;
    transition: transform 400ms var(--ease-out);
  }

  .delivery-collaboration {
    display: flex;
    grid-column: 2;
    align-items: center;
    gap: 0.85rem;
    margin-top: -0.15rem;
    padding: 0.72rem 0.9rem;
    border: 1px solid rgb(84 123 157 / 15%);
    border-radius: 14px;
    background: rgb(255 255 255 / 55%);
  }

  .delivery-collaboration-icon {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(84 123 157 / 18%);
    border-radius: 50%;
    background: rgb(84 123 157 / 8%);
    color: var(--color-blue);
  }

  .delivery-collaboration-icon svg {
    width: 1.05rem;
    height: 1.05rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .delivery-collaboration > span:nth-child(2) {
    display: grid;
    min-width: 0;
    gap: 0.1rem;
  }

  .delivery-collaboration strong {
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .delivery-collaboration > span:nth-child(2) > span {
    color: var(--color-body);
    font-size: 0.7rem;
    line-height: 1.4;
  }

  .delivery-collaboration-rule {
    width: 1px;
    height: 1.75rem;
    flex: 0 0 auto;
    margin-left: auto;
    background: var(--delivery-line);
  }

  .delivery-collaboration-note {
    flex: 0 0 auto;
    color: var(--color-muted);
    font-size: 0.62rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  /* Delivery stage diagrams */
  .dp-card,
  .dp-architecture,
  .dp-qa-dashboard,
  .dp-score-panel,
  .dp-monitor-panel,
  .dp-production-card {
    fill: var(--color-navy-soft);
    stroke: rgb(84 123 157 / 42%);
    stroke-width: 1;
    filter: drop-shadow(0 7px 12px rgb(0 0 0 / 18%));
  }

  .dp-card {
    fill: var(--color-navy-soft);
    stroke: rgb(84 123 157 / 42%);
  }

  .dp-card,
  .dp-layer,
  .dp-score-panel,
  .dp-production-card {
    transition:
      stroke 180ms var(--ease-out),
      filter 180ms var(--ease-out);
  }

  .dp-card:hover,
  .dp-layer:hover,
  .dp-score-panel:hover,
  .dp-production-card:hover {
    stroke: var(--color-orange);
    filter: drop-shadow(0 0 7px rgb(201 84 43 / 24%));
  }

  .dp-link,
  .dp-link-soft,
  .dp-arch-spine,
  .dp-mini-link,
  .dp-deploy-link,
  .dp-deploy-feedback {
    fill: none;
    stroke: var(--color-blue);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .dp-link {
    stroke-width: 1.7;
  }

  .dp-link-soft {
    stroke: rgb(84 123 157 / 27%);
    stroke-dasharray: 4 8;
    stroke-width: 3.5;
  }

  .dp-flow,
  .dp-pipeline-flow,
  .dp-deploy-flow {
    fill: var(--color-blue);
    filter: drop-shadow(0 0 4px rgb(84 123 157 / 55%));
    transform-box: fill-box;
    transform-origin: center;
  }

  .dp-flow-b,
  .dp-flow-d,
  .dp-flow-f {
    fill: var(--color-orange-dark);
  }

  .dp-flow-c,
  .dp-flow-d {
    animation-name: dp-flow-reverse;
  }

  .dp-card-status,
  .dp-card-status-accent,
  .dp-signal-dot {
    fill: var(--color-blue);
    filter: drop-shadow(0 0 3px rgb(84 123 157 / 42%));
  }

  .dp-card-status-accent,
  .dp-signal-dot-accent {
    fill: var(--color-orange-dark);
  }

  .dp-heading,
  .dp-layer-title {
    fill: #fff;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 750;
    letter-spacing: 0.65px;
  }

  .dp-layer-title {
    font-size: 8px;
  }

  .dp-copy,
  .dp-layer-copy {
    fill: rgb(211 223 237 / 75%);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 550;
    letter-spacing: 0.15px;
  }

  .dp-layer-copy {
    font-size: 7px;
    letter-spacing: 0;
  }

