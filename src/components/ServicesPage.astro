  .service-detail:nth-child(even) {
    border-color: rgb(84 123 157 / 14%);
    background: linear-gradient(135deg, #f4f7f9 0%, #fff 100%);
  }
  .service-detail:hover {
    border-color: rgb(201 84 43 / 28%);
    box-shadow: 0 18px 40px rgb(16 27 45 / 8%);
  }
  .service-detail-reverse .service-detail-copy {
    order: 2;
  }
  .service-detail-reverse .service-detail-visual {
    order: 1;
  }
  .service-detail-copy {
    min-width: 0;
  }
  .service-detail-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.9rem;
    color: var(--color-orange-dark);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }
  .service-detail-kicker span {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid #e3c6b3;
    border-radius: 50%;
    font-size: 0.65rem;
    letter-spacing: 0;
  }
  .service-detail-copy h3 {
    margin-bottom: 0.8rem;
    color: var(--color-navy);
    font-size: clamp(1.8rem, 2.7vw, 2.55rem);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: 1.12;
  }
  .service-detail-description {
    margin-bottom: 1.1rem;
    color: var(--color-body);
    font-size: 0.94rem;
    line-height: 1.7;
  }
  .service-detail-challenge {
    padding: 0.85rem 1rem;
    border-left: 2px solid var(--color-orange);
    background: #f3eee8;
  }
  .service-detail-challenge > span,
  .service-detail-deliverable > span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--color-orange-dark);
    font-size: 0.59rem;
    font-weight: 700;
    letter-spacing: 0.11em;
  }
  .service-detail-challenge p {
    margin-bottom: 0;
    color: var(--color-ink);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .service-detail-scope {
    margin-top: 1rem;
  }
  .service-detail-scope h4 {
    margin-bottom: 0.55rem;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    word-spacing: 0.02em;
  }
  .service-detail-scope ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .service-detail-scope li {
    position: relative;
    padding-left: 0.9rem;
    color: var(--color-body);
    font-size: 0.75rem;
    line-height: 1.48;
  }
  .service-detail-scope li::before {
    position: absolute;
    top: 0.48em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-orange);
    content: '';
  }
  .service-detail-deliverable {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.35rem 0.7rem;
    margin-top: 1rem;
  }
  .service-detail-deliverable > span {
    margin: 0;
    white-space: nowrap;
  }
  .service-detail-deliverable p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.7rem;
    line-height: 1.45;
  }
  .service-detail-link {
    margin-top: 1rem;
    color: var(--color-orange-dark);
    font-size: 0.78rem;
  }
  .service-detail-visual {
    position: relative;
    min-width: 0;
    min-height: 370px;
    overflow: hidden;
    border: 1px solid rgb(16 27 45 / 10%);
    border-radius: var(--radius-large);
    background: #e9eef2;
    box-shadow: 0 18px 48px rgb(16 27 45 / 8%);
    transition:
      transform 360ms var(--ease-out),
      box-shadow 360ms var(--ease-out),
      border-color 260ms var(--ease-out);
  }
  .service-detail-image {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 700ms var(--ease-out);
  }
  .service-detail:hover .service-detail-visual {
    transform: translateY(-3px);
    border-color: rgb(201 84 43 / 32%);
    box-shadow: 0 22px 52px rgb(16 27 45 / 13%);
  }
  .service-detail:hover .service-detail-image {
    transform: scale(1.045);
  }
  /* Gentler zoom keeps the monitor clear of the container edges. */
  .service-detail#web-application-development:hover .service-detail-image {
    transform: scale(1.02);
  }
  .detail-visual-head,
  .detail-visual-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.65rem;
  }
  .detail-visual-head {
    position: relative;
    z-index: 1;
    padding: 0.7rem 0.8rem;
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: 999px;
    background: rgb(255 255 255 / 82%);
    box-shadow: 0 8px 24px rgb(16 27 45 / 8%);
    backdrop-filter: blur(12px);
    color: var(--color-muted);
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .detail-visual-state {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-body);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0;
  }
  .detail-visual-state i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 0 4px rgb(201 84 43 / 10%);
  }
  .detail-visual-foot {
    position: relative;
    z-index: 1;
    padding-top: 0.65rem;
    border-top: 1px solid rgb(16 27 45 / 9%);
    color: var(--color-muted);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-shadow: 0 1px 8px rgb(255 255 255 / 80%);
  }
  .automation-flow {
    position: relative;
    display: grid;
    width: min(100%, 440px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
    align-self: center;
    padding: 1.1rem 0;
  }
  .automation-node {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: 84px;
    align-content: center;
    gap: 0.32rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgb(16 27 45 / 10%);
    border-radius: 10px;
    background: rgb(255 255 255 / 90%);
    box-shadow: 0 10px 25px rgb(16 27 45 / 6%);
  }
  .automation-node span {
    color: var(--color-muted);
    font-size: 0.53rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }
  .automation-node b {
    color: var(--color-navy);
    font-size: 0.85rem;
    font-weight: 650;
  }
  .automation-node-accent {
    border-color: rgb(168 65 33 / 24%);
    background: #fff8f3;
  }
  .automation-node-review {
    border-color: rgb(84 123 157 / 23%);
    background: #f7fafc;
  }
  .automation-path {
    position: absolute;
    z-index: 0;
    top: 50%;
    right: 15%;
    left: 15%;
    height: 1px;
    background: linear-gradient(90deg, #9bb4c7, var(--color-orange), #9bb4c7);
    transform: rotate(26deg);
  }
  .automation-path i {
    position: absolute;
    top: -2px;
    left: 25%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 10px rgb(201 84 43 / 48%);
    animation: service-packet 3.8s ease-in-out infinite;
  }
  .automation-path i:nth-child(2) {
    left: 68%;
    animation-delay: -1.8s;
  }
  .automation-path i:nth-child(3) {
    left: 47%;
    background: var(--color-blue);
    animation-delay: -2.8s;
  }
  .automation-caption {
    grid-column: 1 / -1;
    justify-self: center;
    color: var(--color-muted);
    font-size: 0.63rem;
    letter-spacing: 0.02em;
    text-align: center;
  }
  .software-board {
    position: relative;
    display: grid;
    width: min(100%, 450px);
    min-height: 250px;
    grid-template-columns: 36px minmax(0, 1fr);
    align-self: center;
    padding: 1.1rem 1rem 2.2rem;
    border: 1px solid #d9dfe4;
    border-radius: 13px;
    background: #fff;
    box-shadow: 0 18px 35px rgb(16 27 45 / 9%);
