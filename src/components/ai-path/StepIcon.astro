---
/**
 * Animated icon for one step of the AI practical-path roadmap
 * (AIPracticalPath.astro). The SVG and its animations live here so the
 * section component stays readable.
 *
 * name: 'understand' | 'prepare' | 'design' | 'connect' | 'improve'
 */
const { name } = Astro.props
---

{name === 'understand' && (
  <svg
    viewBox="0 0 68 68"
    fill="none"
    class="ai-step-svg svg-target"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <radialGradient id="target-ambient-glow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ea580c" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#ea580c" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="target-red-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ff5722" />
        <stop offset="100%" stop-color="#dc2626" />
      </linearGradient>
      <linearGradient
        id="target-center-grad"
        x1="0%"
        y1="0%"
        x2="100%"
        y2="100%"
      >
        <stop offset="0%" stop-color="#ff3d00" />
        <stop offset="100%" stop-color="#991b1b" />
      </linearGradient>
      <linearGradient id="arrow-shaft-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#f8fafc" />
        <stop offset="100%" stop-color="#cbd5e1" />
      </linearGradient>
      <filter
        id="target-3d-shadow"
        x="-20%"
        y="-20%"
        width="140%"
        height="140%"
      >
        <feDropShadow
          dx="0"
          dy="4"
          stdDeviation="4"
          flood-color="#ea580c"
          flood-opacity="0.36"
        />
      </filter>
    </defs>
    {/* Pulsing Ambient Aura */}
    <circle
      cx="32"
      cy="34"
      r="28"
      fill="url(#target-ambient-glow)"
      class="target-ambient-aura"
    />
    {/* Concentric Radar / Sonar Rings expanding from Bullseye */}
    <circle
      cx="32"
      cy="34"
      r="8"
      stroke="#ff5722"
      stroke-width="1.6"
      fill="none"
      class="target-sonar-ring sonar-1"
    />
    <circle
      cx="32"
      cy="34"
      r="8"
      stroke="#ea580c"
      stroke-width="1.6"
      fill="none"
      class="target-sonar-ring sonar-2"
    />
    <g filter="url(#target-3d-shadow)">
      <circle
        cx="32"
        cy="34"
        r="23"
        fill="#ffffff"
        stroke="#f1ede6"
        stroke-width="1.5"
      />
      <circle
        cx="32"
        cy="34"
        r="18.5"
        fill="url(#target-red-grad)"
        class="target-pulse-ring"
      />
      <circle cx="32" cy="34" r="12" fill="#ffffff" />
      <circle
        cx="32"
        cy="34"
        r="6.8"
        fill="url(#target-center-grad)"
        class="target-bullseye-dot"
      />
      <path
        d="M 28 31 A 5 5 0 0 1 35 31"
        stroke="#ffffff"
        stroke-width="1.2"
        stroke-linecap="round"
        opacity="0.6"
        fill="none"
      />
    </g>
    {/* Animated Target Arrow with Dynamic Strike & Vibration */}
    <g class="target-arrow-rig">
      <line
        x1="32"
        y1="34"
        x2="54"
        y2="12"
        stroke="url(#arrow-shaft-grad)"
        stroke-width="3"
        stroke-linecap="round"
      />
      <circle cx="32" cy="34" r="1.8" fill="#7f1d1d" class="arrow-tip-glow" />
      <path d="M 45 15 L 53 13 L 51 21 Z" fill="#ff4d26" />
      <path d="M 50 10 L 58 8 L 56 16 Z" fill="#dc2626" />
      <line
        x1="49"
        y1="17"
        x2="55"
        y2="11"
        stroke="#ffffff"
        stroke-width="1.2"
        stroke-linecap="round"
        opacity="0.7"
      />
    </g>
    <g class="sparkle-ray" style="transform-origin: 56px 10px;">
      <line
        x1="56"
        y1="6"
        x2="60"
        y2="3"
        stroke="#ea580c"
        stroke-width="2"
        stroke-linecap="round"
      />
      <line
        x1="62"
        y1="10"
        x2="66"
        y2="12"
        stroke="#ea580c"
        stroke-width="2"
        stroke-linecap="round"
      />
      <line
        x1="52"
        y1="3"
        x2="50"
        y2="0"
        stroke="#ea580c"
        stroke-width="1.6"
        stroke-linecap="round"
      />
    </g>
  </svg>
)}

{name === 'prepare' && (
  <svg
    viewBox="0 0 68 68"
    fill="none"
    class="ai-step-svg svg-data"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="doc-bg-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#ffffff" />
        <stop offset="100%" stop-color="#f0f9ff" />
      </linearGradient>
      <linearGradient id="mag-rim-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ff5722" />
        <stop offset="100%" stop-color="#c2410c" />
      </linearGradient>
      <radialGradient id="mag-lens-flare" cx="35%" cy="35%" r="65%">
        <stop offset="0%" stop-color="#ffffff" stop-opacity="0.8" />
        <stop offset="50%" stop-color="#38bdf8" stop-opacity="0.25" />
        <stop offset="100%" stop-color="#0284c7" stop-opacity="0.05" />
      </radialGradient>
      <filter id="doc-3d-shadow" x="-15%" y="-15%" width="130%" height="130%">
        <feDropShadow
          dx="0"
          dy="3"
          stdDeviation="3"
          flood-color="#0284c7"
          flood-opacity="0.18"
        />
      </filter>
      <filter id="mag-3d-shadow" x="-25%" y="-25%" width="150%" height="150%">
        <feDropShadow
          dx="1"
          dy="4"
          stdDeviation="4"
          flood-color="#ea580c"
          flood-opacity="0.38"
        />
      </filter>
    </defs>
    {/* Document Base with Live Glowing Data Lines and Rising Bars */}
    <g filter="url(#doc-3d-shadow)">
      <rect
        x="14"
        y="10"
        width="30"
        height="42"
        rx="4"
        fill="url(#doc-bg-grad)"
        stroke="#38bdf8"
        stroke-width="1.8"
      />
      <path d="M 36 10 L 44 18 L 36 18 Z" fill="#bae6fd" />
      <path
        d="M 36 10 L 36 18 L 44 18"
        stroke="#38bdf8"
        stroke-width="1.6"
        fill="none"
        stroke-linejoin="round"
      />
      <line
        x1="20"
        y1="20"
        x2="31"
        y2="20"
        stroke="#0284c7"
        stroke-width="2.4"
        stroke-linecap="round"
        class="doc-line doc-line-1"
      />
      <line
        x1="20"
        y1="26"
        x2="38"
        y2="26"
        stroke="#0284c7"
        stroke-width="2.4"
        stroke-linecap="round"
        class="doc-line doc-line-2"
      />
      <line
        x1="20"
        y1="32"
        x2="33"
        y2="32"
        stroke="#0284c7"
        stroke-width="2.4"
        stroke-linecap="round"
        class="doc-line doc-line-3"
      />
      {/* Live Data Stream Bars on Document */}
      <rect
        x="20"
        y="40"
        width="3.2"
        height="6"
        rx="1"
        fill="#0284c7"
        class="doc-bar doc-bar-1"
      />
      <rect
        x="25"
        y="37"
        width="3.2"
        height="9"
        rx="1"
        fill="#0284c7"
        class="doc-bar doc-bar-2"
      />
      <rect
        x="30"
        y="34"
        width="3.2"
        height="12"
        rx="1"
        fill="#38bdf8"
        class="doc-bar doc-bar-3"
      />
    </g>
    {/* Active Scanning Magnifier with Smooth Orbit/Sweep Motion */}
    <g class="magnifier-active-scanner" filter="url(#mag-3d-shadow)">
      <circle
        cx="41"
        cy="27"
        r="11"
        fill="url(#mag-lens-flare)"
        class="mag-glass-glow"
      />
      <circle
        cx="41"
        cy="27"
        r="11"
        stroke="url(#mag-rim-grad)"
        stroke-width="3"
      />
      <path
        d="M 35 22 A 7.5 7.5 0 0 1 45 22"
        stroke="#ffffff"
        stroke-width="1.8"
        stroke-linecap="round"
        fill="none"
      />
      <line
        x1="49"
        y1="35"
        x2="58"
        y2="44"
        stroke="url(#mag-rim-grad)"
        stroke-width="4.5"
        stroke-linecap="round"
      />
      <line
        x1="50"
        y1="36"
        x2="57"
        y2="43"
        stroke="#ffd0b5"
        stroke-width="1.4"
        stroke-linecap="round"
      />
      {/* Laser Scan Crosshair / Reticle Pulse */}
      <circle
        cx="41"
        cy="27"
        r="3"
        fill="#ea580c"
        opacity="0.65"
        class="mag-reticle-dot"
      />
    </g>
    <g class="sparkle-ray" style="transform-origin: 55px 10px;">
      <line
        x1="55"
        y1="6"
        x2="59"
        y2="3"
        stroke="#ea580c"
        stroke-width="2"
        stroke-linecap="round"
      />
      <line
        x1="61"
        y1="10"
        x2="65"
        y2="12"
        stroke="#ea580c"
        stroke-width="2"
        stroke-linecap="round"
      />
    </g>
  </svg>
)}

{name === 'design' && (
  <svg
    viewBox="0 0 68 68"
    fill="none"
    class="ai-step-svg svg-chip"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="chip-grad-body" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ff5722" />
        <stop offset="50%" stop-color="#ea1d24" />
        <stop offset="100%" stop-color="#b91c1c" />
      </linearGradient>
      <linearGradient id="pin-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fb923c" />
        <stop offset="100%" stop-color="#ea580c" />
      </linearGradient>
      <radialGradient id="chip-aura-pulse" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ea580c" stop-opacity="0.45" />
        <stop offset="100%" stop-color="#ea580c" stop-opacity="0" />
      </radialGradient>
      <filter
        id="chip-ambient-glow"
        x="-30%"
        y="-30%"
        width="160%"
        height="160%"
      >
        <feDropShadow
          dx="0"
          dy="5"
          stdDeviation="5.5"
          flood-color="#ea580c"
          flood-opacity="0.5"
        />
      </filter>
    </defs>
    {/* Energy Aura behind Chip */}
    <circle
      cx="33"
      cy="33"
      r="26"
      fill="url(#chip-aura-pulse)"
      class="chip-energy-aura"
    />
    {/* Electronic Circuit Pins with Active Energy Pulse */}
    <g class="chip-pins-layer">
      <rect
        x="25"
        y="8"
        width="4"
        height="10"
        rx="1.5"
        fill="url(#pin-grad)"
        class="chip-pin pin-v1"
      />
      <rect
        x="37"
        y="8"
        width="4"
        height="10"
        rx="1.5"
        fill="url(#pin-grad)"
        class="chip-pin pin-v2"
      />
      <rect
        x="25"
        y="48"
        width="4"
        height="10"
        rx="1.5"
        fill="url(#pin-grad)"
        class="chip-pin pin-v3"
      />
      <rect
        x="37"
        y="48"
        width="4"
        height="10"
        rx="1.5"
        fill="url(#pin-grad)"
        class="chip-pin pin-v4"
      />
      <rect
        x="8"
        y="25"
        width="10"
        height="4"
        rx="1.5"
        fill="url(#pin-grad)"
        class="chip-pin pin-h1"
      />
      <rect
        x="8"
        y="37"
        width="10"
        height="4"
        rx="1.5"
        fill="url(#pin-grad)"
        class="chip-pin pin-h2"
      />
      <rect
        x="48"
        y="25"
        width="10"
        height="4"
        rx="1.5"
        fill="url(#pin-grad)"
        class="chip-pin pin-h3"
      />
      <rect
        x="48"
        y="37"
        width="10"
        height="4"
        rx="1.5"
        fill="url(#pin-grad)"
        class="chip-pin pin-h4"
      />
      {/* Streaming electric signal packets */}
      <circle
        cx="27"
        cy="11"
        r="1.5"
        fill="#ffffff"
        class="signal-dot dot-t1"
      />
      <circle
        cx="39"
        cy="11"
        r="1.5"
        fill="#ffffff"
        class="signal-dot dot-t2"
      />
      <circle
        cx="11"
        cy="27"
        r="1.5"
        fill="#ffffff"
        class="signal-dot dot-l1"
      />
      <circle
        cx="11"
        cy="39"
        r="1.5"
        fill="#ffffff"
        class="signal-dot dot-l2"
      />
      <circle
        cx="55"
        cy="27"
        r="1.5"
        fill="#ffffff"
        class="signal-dot dot-r1"
      />
      <circle
        cx="55"
        cy="39"
        r="1.5"
        fill="#ffffff"
        class="signal-dot dot-r2"
      />
      <circle
        cx="27"
        cy="55"
        r="1.5"
        fill="#ffffff"
        class="signal-dot dot-b1"
      />
      <circle
        cx="39"
        cy="55"
        r="1.5"
        fill="#ffffff"
        class="signal-dot dot-b2"
      />
    </g>
    {/* AI Processor Core with Dynamic Respiration & Bezel */}
    <g class="chip-core-glow" filter="url(#chip-ambient-glow)">
      <rect
        x="16"
        y="16"
        width="34"
        height="34"
        rx="8"
        fill="url(#chip-grad-body)"
        class="chip-body-rect"
      />
      <rect
        x="18.5"
        y="18.5"
        width="29"
        height="29"
        rx="6"
        stroke="rgba(255, 255, 255, 0.55)"
        stroke-width="1.4"
        fill="none"
        class="chip-inner-bezel"
      />
      {/* AI Text with Glowing Neural Pulse */}
      <text
        x="33"
        y="39"
        font-family="system-ui, -apple-system, sans-serif"
        font-weight="800"
        font-size="16"
        fill="#ffffff"
        text-anchor="middle"
        letter-spacing="0.04em"
        class="chip-ai-label"
      >
        AI
      </text>
    </g>
    <g class="sparkle-ray" style="transform-origin: 55px 11px;">
      <line
        x1="54"
        y1="7"
        x2="58"
        y2="4"
        stroke="#ea580c"
        stroke-width="2"
        stroke-linecap="round"
      />
      <line
        x1="60"
        y1="11"
        x2="64"
        y2="13"
        stroke="#ea580c"
        stroke-width="2"
        stroke-linecap="round"
      />
    </g>
  </svg>
)}

{name === 'connect' && (
  <svg
    viewBox="0 0 68 68"
    fill="none"
    class="ai-step-svg svg-stack"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="layer-top-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#bae6fd" />
        <stop offset="100%" stop-color="#38bdf8" />
      </linearGradient>
      <linearGradient id="layer-mid-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#60a5fa" />
        <stop offset="100%" stop-color="#2563eb" />
      </linearGradient>
      <linearGradient id="layer-bot-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#3b82f6" />
        <stop offset="100%" stop-color="#1d4ed8" />
      </linearGradient>
      <linearGradient id="gear-3d-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ff5722" />
        <stop offset="100%" stop-color="#dc2626" />
      </linearGradient>
      <filter id="stack-3d-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow
          dx="0"
          dy="4"
          stdDeviation="4"
          flood-color="#0284c7"
          flood-opacity="0.28"
        />
      </filter>
      <filter id="gear-3d-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow
          dx="1"
          dy="3"
          stdDeviation="3.5"
          flood-color="#ea580c"
          flood-opacity="0.38"
        />
      </filter>
    </defs>

    {/* Red-Orange Gear spinning smoothly around true center (48, 24) */}
    <g class="workflow-gear" filter="url(#gear-3d-shadow)">
      <circle cx="48" cy="24" r="11" fill="url(#gear-3d-grad)" />
      <rect
        x="45.5"
        y="10"
        width="5"
        height="28"
        rx="1.5"
        fill="url(#gear-3d-grad)"
      />
      <rect
        x="34"
        y="21.5"
        width="28"
        height="5"
        rx="1.5"
        fill="url(#gear-3d-grad)"
      />
      <rect
        x="37.5"
        y="13.5"
        width="21"
        height="21"
        rx="1.5"
        fill="url(#gear-3d-grad)"
        transform="rotate(45 48 24)"
      />
      <circle cx="48" cy="24" r="8.5" fill="#f97316" />
      <circle cx="48" cy="24" r="4" fill="#ffffff" />
    </g>

    {/* 3D Stacked Isometric Diamond Layers with Accordion Float Motion */}
    <g class="stack-layers-group" filter="url(#stack-3d-shadow)">
      {/* Bottom Layer */}
      <g class="stack-layer layer-bottom">
        <path
          d="M 9 40 L 25 48 L 41 40 L 41 44 L 25 52 L 9 44 Z"
          fill="#1e40af"
        />
        <path
          d="M 25 34 L 41 42 L 25 50 L 9 42 Z"
          fill="url(#layer-bot-grad)"
        />
      </g>

      {/* Middle Layer */}
      <g class="stack-layer layer-middle">
        <path
          d="M 9 30 L 25 38 L 41 30 L 41 34 L 25 42 L 9 34 Z"
          fill="#1d4ed8"
        />
        <path
          d="M 25 24 L 41 32 L 25 40 L 9 32 Z"
          fill="url(#layer-mid-grad)"
        />
      </g>

      {/* Top Layer */}
      <g class="stack-layer layer-top">
        <path
          d="M 9 20 L 25 28 L 41 20 L 41 24 L 25 32 L 9 24 Z"
          fill="#0284c7"
        />
        <path
          d="M 25 14 L 41 22 L 25 30 L 9 22 Z"
          fill="url(#layer-top-grad)"
        />
        <path
          d="M 12 22 L 25 28.5 L 38 22"
          stroke="#ffffff"
          stroke-width="1.2"
          stroke-linecap="round"
          opacity="0.6"
          fill="none"
        />
      </g>
    </g>

    {/* Action rays / energy sparkles at top right */}
    <g class="sparkle-ray" style="transform-origin: 59px 9px;">
      <line
        x1="58"
        y1="6"
        x2="62"
        y2="3"
        stroke="#ea580c"
        stroke-width="2"
        stroke-linecap="round"
      />
      <line
        x1="64"
        y1="10"
        x2="68"
        y2="12"
        stroke="#ea580c"
        stroke-width="2"
        stroke-linecap="round"
      />
    </g>
  </svg>
)}

{name === 'improve' && (
  <svg
    viewBox="0 0 68 68"
    fill="none"
    class="ai-step-svg svg-bars"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="bar-3d-grad" x1="0%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#ff6b4a" />
        <stop offset="100%" stop-color="#d9381e" />
      </linearGradient>
      <linearGradient id="arrow-sweep-grad" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#f97316" />
        <stop offset="100%" stop-color="#dc2626" />
      </linearGradient>
      <radialGradient id="beacon-glow-grad" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ff5722" stop-opacity="0.75" />
        <stop offset="100%" stop-color="#ff5722" stop-opacity="0" />
      </radialGradient>
      <filter id="bars-3d-shadow" x="-20%" y="-20%" width="140%" height="140%">
        <feDropShadow
          dx="0"
