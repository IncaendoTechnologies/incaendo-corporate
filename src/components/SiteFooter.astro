---
import { navigation } from '../data/site-content.js'
import logo from '../assets/incaendo-logo.png'
---

<footer class="site-footer">
  <div class="site-container footer-main">
    <div class="footer-brand">
      <a class="site-logo site-logo-footer" href="/" aria-label="Incaendo home">
        <img
          src={logo.src}
          width={logo.width}
          height={logo.height}
          alt="Incaendo Technologies"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>Software development and technology, shaped around what matters.</p>
    </div>
    <div class="footer-links-group">
      <span class="footer-label">Explore</span>
      <ul class="footer-links">
        {navigation.slice(1).map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="footer-links-group">
      <span class="footer-label">Company</span>
      <ul class="footer-links">
        <li>
          <a href="/careers">Careers</a>
        </li>
        <li>
          <a href="/contact">Contact</a>
        </li>
        <li>
          <a href="/privacy">Privacy</a>
        </li>
      </ul>
    </div>
    <div class="footer-cta-block reveal">
      <div class="footer-contact-preview">
        <h2>Have a project in mind?</h2>
        <p class="footer-preview-copy">
          Let’s turn your ideas into meaningful digital solutions. Tell us what
          you’re looking to build, and let’s explore how we can make it happen.
        </p>
        <a class="footer-preview-link" href="/contact#project-inquiry">
          Discuss Your Project <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </div>
  <div class="site-container footer-bottom">
    <span>© {new Date().getFullYear()} Incaendo</span>
    <span>15 years of industry experience</span>
  </div>
</footer>
