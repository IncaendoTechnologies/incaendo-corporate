---
/*
 * Site footer: the design system `SiteFooter` (inc-footer), markup and copy
 * as in the design system. The .inc-shell wrapper lets its container
 * queries switch to four columns from 1024px. Styles come from
 * src/styles/incaendo/components.css.
 */
import { Image } from 'astro:assets'
import logoReversed from '../assets/incaendo-logo-reversed.png'
import { homepageServices } from '../data/site-content.js'

const currentYear = new Date().getFullYear()

const companyLinks = [
  { href: '/ai-technology', label: 'AI' },
  { href: '/projects', label: 'Projects' },
  { href: '/teams', label: 'Teams' },
  { href: '/insights', label: 'Insights' },
  { href: '/careers', label: 'Careers' },
  // Goes to the Contact page; the popup is for in-page calls to action.
  { href: '/contact', label: 'Contact', contactPage: true },
]

const mapUrl =
  'https://www.google.com/maps/dir/?api=1&destination=TigerCubs%2C%20B-9%2C%20B%20Block%2C%20Sector%202%2C%20Noida%2C%20UP%20201301'
---

<div class="inc-shell">
  <footer class="inc-footer">
    <div class="site-container">
      <div class="inc-footer-grid">
        <div class="inc-footer-brand">
          <a href="/" aria-label="Incaendo home">
            <Image
              src={logoReversed}
              width={348}
              alt="Incaendo Technologies"
              loading="lazy"
            />
          </a>
          <p>
            Web platforms, mobile apps, AI agents and cloud infrastructure for
            startups, SMEs and enterprises, since 2012.
          </p>
        </div>

        <nav aria-label="Services">
          <p class="inc-footer-heading">Services</p>
          <ul>
            {homepageServices.map((service) => (
              <li>
                <a class="inc-footer-link" href={service.href}>
                  {service.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <nav aria-label="Company">
          <p class="inc-footer-heading">Company</p>
          <ul>
            {companyLinks.map((link) => (
              <li>
                <a
                  class="inc-footer-link"
                  href={link.href}
                  data-contact-page-link={link.contactPage ? '' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="inc-footer-contact">
          <p class="inc-footer-heading">Get in touch</p>
          <address>
            Incaendo Technologies Private Limited
            <br />
            <a
              class="inc-footer-link"
              href={mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="First Floor, B-9, B Block, Sector 2, Noida, UP 201301, India (opens Google Maps in a new tab)"
            >
              First Floor, B-9, B Block, Sector 2<br />
              Noida, UP – 201301, India
            </a>
          </address>
          <p class="footer-email">
            <a class="inc-footer-link" href="mailto:info@incaendo.com">
              info@incaendo.com
            </a>
          </p>
          <div class="inc-footer-social">
            <a
              href="https://www.linkedin.com/company/incaendo-technologies-pvt-ltd-/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Incaendo on LinkedIn"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
            </a>
            <a
              href="https://www.instagram.com/incaendo_technologies/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Incaendo on Instagram"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
            </a>
            <a
              href="https://www.facebook.com/Incaendo/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Incaendo on Facebook"
            >
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <div class="inc-footer-legal">
        <span>© {currentYear} Incaendo Technologies Private Limited</span>
        <span>
          <a href="/privacy-policy" target="_blank" rel="noopener noreferrer">
            Privacy policy
          </a>{' '}
          ·
          <a
            href="/terms-and-conditions"
            target="_blank"
            rel="noopener noreferrer"
          >
            Terms
          </a>{' '}
          ·
          <a href="/faq" target="_blank" rel="noopener noreferrer">
            FAQ
          </a>
        </span>
      </div>
    </div>
  </footer>
</div>

<style>
  /* Matches the design system preview: the email sits 12px below the
     address. */
  .footer-email {
    margin: var(--space-3) 0 0;
  }
</style>
