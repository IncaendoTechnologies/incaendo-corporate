  .dp-card:hover,
  .dp-layer:hover,
  .dp-score-panel:hover,
  .dp-production-card:hover,
  .dp-product-card:hover {
    stroke: rgb(201 84 43 / 55%);
    filter: drop-shadow(0 6px 14px rgb(201 84 43 / 12%));
  }

  .dp-link,
  .dp-link-soft,
  .dp-mini-link,
  .dp-deploy-link,
  .dp-deploy-feedback {
    fill: none;
    stroke: rgb(16 27 45 / 26%);
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .dp-link {
    stroke-width: 1.5;
  }

  .dp-link-soft {
    stroke: rgb(84 123 157 / 24%);
    stroke-dasharray: 4 8;
    stroke-width: 3.5;
  }

