---
import AIAgentsShowcase from './AIAgentsShowcase.astro'
import AIPracticalPath from './AIPracticalPath.astro'
import AIBusinessApplications from './AIBusinessApplications.astro'
import AIAssistedDevelopment from './AIAssistedDevelopment.astro'

const capabilities = [
  {
    number: '01',
    title: 'Intelligent Automation',
    description:
      'Automate repeatable, rules-based steps and use language models where work depends on interpreting text or context.',
    includes: 'Workflow orchestration · Exception routes · Human approval',
    tag: 'MOVE WORK FORWARD',
  },
  {
    number: '02',
    title: 'LLM-Powered Applications',
    description:
      'Design conversational and task-focused applications around a model chosen for the use case, constraints, and operating environment.',
    includes: 'Assistants · Structured outputs · Model integration',
    tag: 'MAKE SOFTWARE MORE USEFUL',
  },
  {
    number: '03',
    title: 'Knowledge Retrieval & RAG',
    description:
      'Retrieve relevant material from approved information sources so answers can be grounded in business context and linked to evidence.',
    includes: 'Content preparation · Retrieval · Source references',
    tag: 'CONNECT KNOWLEDGE',
  },
  {
    number: '04',
    title: 'AI Agents & Tool Integration',
    description:
      'Connect bounded, task-oriented AI workflows to authorized tools and APIs, with permissions and confirmation around consequential actions.',
    includes: 'Scoped tools · API actions · Approval gates',
    tag: 'ACT WITH CONTROL',
  },
  {
    number: '05',
    title: 'AI in Existing Systems',
    description:
      'Integrate AI into the software, data sources, and processes people already use instead of creating another disconnected destination.',
    includes: 'Business APIs · Existing products · Data flows',
    tag: 'FIT THE REAL WORK',
  },
  {
    number: '06',
    title: 'Evaluation & Governance',
    description:
      'Evaluate outputs against defined criteria and design for access control, monitoring, validation, and appropriate human review.',
    includes: 'Quality checks · Access controls · Monitoring',
    tag: 'BUILD TRUST INTO DELIVERY',
  },
]

// Key figures shown around the AI letters by default. These are
// provisional: none is backed by approved material in this repository yet.
// Set `confirmed: true` on each once verified; while any is unconfirmed, the
// hero shows a short "provisional figures" note.
//
// Each card is hand-placed (centre, percent of the stage) in the space
// around the open-view particle sphere, as a pentagon that keeps every card
// clear of the "AI" letters. wx/wy place it on the desktop stage (1.1:1);
// x/y on the square (stacked tablet) and 4:5 (small fields) stages.
const heroStats = [
  {
    value: '100+',
    label: 'AI Agent Workflows',
    icon: 'workflow',
    accent: 'orange',
    x: 50,
    y: 7.5,
    wx: 50,
    wy: 7.5,
    confirmed: false,
  },
  {
    value: '5+',
    label: 'Business Use Cases',
    icon: 'grid',
    accent: 'blue',
    x: 19,
    y: 25,
    wx: 18.5,
    wy: 25,
    confirmed: false,
  },
  {
    value: '20+',
    label: 'AI Live Deployments',
    icon: 'cloud',
    accent: 'blue',
    x: 81,
    y: 25,
    wx: 81.5,
    wy: 25,
    confirmed: false,
  },
  {
    value: '24/7',
    label: 'Workflow Availability',
    icon: 'clock',
    accent: 'orange',
    x: 24,
    y: 76.5,
    wx: 25,
    wy: 77,
    confirmed: false,
  },
  {
    value: '92%',
    label: 'AI Accuracy',
    icon: 'shield',
    accent: 'green',
    x: 76,
    y: 78,
    wx: 75,
    wy: 78.5,
    confirmed: false,
  },
]
const statsProvisional = heroStats.some((stat) => !stat.confirmed)

// Each card enters along the same line it sits on relative to the sphere's
// centre, so it settles in from its own side (top drops down, left slides
// in from the left, and so on) instead of every card rising from below.
const ENTRANCE_PX = 16
const entranceOffset = (stat) => {
  const dx = stat.x - 50
  const dy = stat.y - 50
  const length = Math.hypot(dx, dy) || 1
  return {
    x: (dx / length) * ENTRANCE_PX,
    y: (dy / length) * ENTRANCE_PX,
  }
}

// Line icons on a 24px grid, drawn with the card's accent colour.
/** @type {Record<string, string>} */
const statIcons = {
  workflow:
    '<circle cx="12" cy="5" r="2.4"/><circle cx="5.5" cy="18.5" r="2.4"/><circle cx="18.5" cy="18.5" r="2.4"/><path d="M12 7.4v4.1M5.5 16.1v-2.1a2.5 2.5 0 0 1 2.5-2.5h8a2.5 2.5 0 0 1 2.5 2.5v2.1"/>',
  grid: '<rect x="4" y="4" width="6.5" height="6.5" rx="1.8"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="1.8"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="1.8"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="1.8"/>',
  cloud:
    '<path d="M7.2 18.5h10.3a4 4 0 0 0 .5-7.97A6 6 0 0 0 6.6 9.6 4.5 4.5 0 0 0 7.2 18.5Z"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.2V12l3.2 2.2"/>',
  shield:
    '<path d="M12 3.5 5 6.2v5.3c0 4.3 2.9 7.6 7 9 4.1-1.4 7-4.7 7-9V6.2Z"/><path d="m8.8 12.1 2.2 2.2 4.3-4.4"/>',
}
---

<div class="ai-tech-page" data-ai-technology>
  <section
    class="ai-tech-hero hero-system hero-system--split hero-system--feature"
    aria-labelledby="ai-tech-title"
  >
    <div class="site-container ai-tech-hero-grid hero-system__inner">
      <div class="ai-tech-hero-copy hero-system__copy">
        <h1 id="ai-tech-title" class="hero-system__title">
          AI Moves <span class="hero-system__accent">Your Business</span>{' '}
          Forward.
          <br />
          Designed around the{' '}
          <span class="hero-system__accent">Way You Work</span>.
        </h1>
        <p class="ai-tech-lead hero-system__description">
          We build AI-powered applications and integrations that connect
          business data, existing systems, and everyday workflows to useful
          outcomes—with clear boundaries for quality, access, and human
          judgment.
        </p>
        <div class="ai-tech-actions hero-system__actions">
          <a class="button button-primary" href="#ai-capabilities">
            Explore our AI capabilities <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="/contact">
            Discuss an AI project{' '}
            <span class="link-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
      </div>

      <div
        class="ai-particles hero-system__visual"
        data-ai-particles
        data-state="idle"
      >
        <div class="ai-particles-stage" data-particles-stage>
          <canvas aria-hidden="true"></canvas>
          <div class="ai-particles-core" aria-hidden="true" data-particles-core>
            <b aria-hidden="true">AI</b>
          </div>
          <div class="ai-particles-stats" data-particles-stats>
            <ul aria-label="Key figures">
              {heroStats.map((stat, index) => {
                const entrance = entranceOffset(stat)
                return (
                  <li
                    class={`ai-particles-stat is-${stat.accent}`}
                    style={`--x: ${stat.x}%; --y: ${stat.y}%; --wx: ${stat.wx}%; --wy: ${stat.wy}%; --order: ${index}; --ex: ${entrance.x.toFixed(1)}px; --ey: ${entrance.y.toFixed(1)}px`}
                  >
                    <div class="ai-particles-stat-card">
                      <svg
                        class="ai-particles-stat-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                        set:html={statIcons[stat.icon]}
                      />
                      <div>
                        <b>{stat.value}</b>
                        <span>{stat.label}</span>
                      </div>
                    </div>
                  </li>
                )
              })}
            </ul>
            {statsProvisional && (
              <p class="ai-particles-provisional">
                Provisional figures, to be confirmed
              </p>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <AIAssistedDevelopment />

  <AIBusinessApplications />

  <AIPracticalPath />

  <AIAgentsShowcase />

  <section
    class="ai-capabilities section section-soft"
    id="ai-capabilities"
    aria-labelledby="ai-capabilities-title"
  >
    <div class="site-container">
      <div class="ai-section-heading ai-capabilities-heading">
        <div>
          <h2 id="ai-capabilities-title">
            The Right Building Blocks.
            <br />
            <span>Connected to Your Context.</span>
          </h2>
        </div>
        <p>
          From focused workflow improvements to AI-enabled products, each
          capability can be shaped around existing data, systems, and operating
          constraints.
        </p>
      </div>
      <div class="ai-capability-grid">
        {capabilities.map((item) => (
          <article class="ai-detail-card" data-service-tilt>
            <div class="ai-card-meta">
              <span>{item.number}</span>
              <span>{item.tag}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="ai-includes">
              <span>IN PRACTICE</span>
              <p>{item.includes}</p>
            </div>
          </article>
        ))}
      </div>
      <a class="button button-primary ai-capabilities-cta" href="/projects">
        <span>Where Ideas Become Impact</span>
        <span class="link-arrow" aria-hidden="true">
          →
        </span>
      </a>
    </div>
  </section>
</div>

<script>
  import '../scripts/service-card-tilt.js'
  import '../scripts/ai-particle-hero.js'
</script>

<style>
  .ai-tech-page {
    --ai-panel: #f0ede8;
    --ai-blue-wash: #e9eef2;
    overflow: clip;
    background: var(--color-paper);
  }
  .ai-tech-page section {
    position: relative;
  }
  .ai-tech-page h1,
  .ai-tech-page h2,
  .ai-tech-page h3,
  .ai-tech-page p {
    margin-top: 0;
  }
  .ai-tech-page h2 {
    margin-bottom: 1.1rem;
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
  }
  .ai-tech-page h2 span,
  .ai-tech-page h1 span {
    color: var(--color-orange-dark);
  }
  /* Plain warm off-white ground behind the particle field. On desktop the
     field takes an even wider feature column than the other pages. */
  .ai-tech-hero {
    --hero-feature-columns: minmax(0, 0.84fr) minmax(0, 1.16fr);
    background: linear-gradient(
      125deg,
      #fbfaf8 0%,
      var(--color-paper) 52%,
      #f0ece6 100%
    );
  }
  .ai-tech-actions .button {
    gap: 0.75rem;
  }

  /* Hero visual: a particle field filling the shared hero visual frame
     (column width x --hero-visual-ratio, the approved Services image size).
     It loads straight into its open view: the cloud gathers into a sphere
     around the AI letters with the five key figures shown alongside it. The
     sphere and letters size from the frame's shorter side. */
  .ai-particles {
    position: relative;
    display: grid;
    min-width: 0;
  }
  .ai-particles-stage {
    position: relative;
    width: 100%;
    aspect-ratio: var(--hero-visual-ratio);
    container-type: size;
  }
  .ai-particles-stage canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The canvas draws the AI letters in both states, so the button is always a
     transparent hit area over them; it narrows as the letters settle smaller
     in the open view. The <b> only supplies the font the letters are
     sampled from. */
  .ai-particles-core {
    position: absolute;
    z-index: 3;
    top: 50%;
    left: 50%;
    width: 62cqmin;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    transform: translate(-50%, -50%);
    transition:
      width 600ms var(--ease-out),
      aspect-ratio 600ms var(--ease-out),
      border-radius 600ms var(--ease-out);
  }
  [data-state='open'] .ai-particles-core {
    width: 39cqmin;
    aspect-ratio: 6 / 5;
    border-radius: 22%;
  }
  .ai-particles-core b {
    font-family: var(--font-heading);
    font-weight: 800;
    opacity: 0;
  }

  /* The cards fade in on load as the cloud gathers into its sphere. The
     layer sits above the core but lets clicks through, so only the cards
     themselves take the pointer. */
  .ai-particles-stats {
    position: absolute;
    z-index: 4;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 250ms ease,
      visibility 0s linear 250ms;
  }
  [data-state='open'] .ai-particles-stats {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 400ms ease 380ms,
      visibility 0s linear 380ms;
  }

  /* Cards: each holds its spot (the <li>) and floats gently inside it; the
     float only runs while the view is open, so closing never jumps. */
  .ai-particles-stats ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ai-particles-stat {
    position: absolute;
    top: var(--wy);
    left: var(--wx);
    opacity: 0;
    transform: translate(calc(-50% + var(--ex)), calc(-50% + var(--ey)))
      scale(0.94);
    transition:
      opacity 220ms ease,
      transform 400ms var(--ease-out);
  }
  [data-state='open'] .ai-particles-stat {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
    transition:
      opacity 500ms ease calc(480ms + var(--order) * 90ms),
      transform 700ms var(--ease-out) calc(480ms + var(--order) * 90ms);
  }
  .ai-particles-stat.is-orange {
    --accent: var(--color-orange);
  }
  .ai-particles-stat.is-blue {
    --accent: var(--color-blue);
  }
  .ai-particles-stat.is-green {
    --accent: var(--color-green);
  }
  .ai-particles-stat-card {
    display: flex;
    align-items: center;
    gap: clamp(0.65rem, 1.6cqmin, 0.85rem);
    padding: clamp(0.55rem, 1.35cqmin, 0.75rem) clamp(0.95rem, 2.2cqmin, 1.2rem)
      clamp(0.55rem, 1.35cqmin, 0.75rem) clamp(0.55rem, 1.35cqmin, 0.75rem);
    border: 1px solid rgb(16 27 45 / 7%);
    border-radius: 18px;
    background: rgb(255 255 255 / 90%);
    box-shadow:
      0 1px 0 #fff inset,
      0 18px 38px -22px rgb(16 27 45 / 36%),
      0 2px 6px -3px rgb(16 27 45 / 10%);
    white-space: nowrap;
    animation: ai-card-float 6.4s ease-in-out infinite alternate paused;
    animation-delay: calc(var(--order) * -1.45s);
    backdrop-filter: blur(6px);
    transition:
      transform 300ms var(--ease-out),
      box-shadow 300ms ease,
      border-color 300ms ease;
  }
  [data-state='open'] .ai-particles-stat-card {
    animation-play-state: running;
  }
  .ai-particles-stat-card:hover {
    border-color: color-mix(in srgb, var(--accent) 32%, transparent);
    box-shadow:
      0 1px 0 #fff inset,
      0 24px 44px -22px rgb(16 27 45 / 42%),
      0 10px 26px -16px color-mix(in srgb, var(--accent) 60%, transparent);
    transform: translateY(-4px) scale(1.035);
  }
  .ai-particles-stat-icon {
    flex: none;
    box-sizing: border-box;
    width: clamp(2.4rem, 7cqmin, 2.85rem);
    height: clamp(2.4rem, 7cqmin, 2.85rem);
    padding: clamp(0.55rem, 1.6cqmin, 0.65rem);
    border-radius: 13px;
    background: color-mix(in srgb, var(--accent) 11%, #fff);
    fill: none;
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    transition:
      background 300ms ease,
      box-shadow 300ms ease;
  }
  .ai-particles-stat-card:hover .ai-particles-stat-icon {
    background: color-mix(in srgb, var(--accent) 18%, #fff);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 9%, transparent);
  }
  .ai-particles-stat-card div {
    display: grid;
    gap: 0.15rem;
  }
  .ai-particles-stat b {
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 4.3cqmin, 1.75rem);
    font-weight: 750;
    letter-spacing: -0.035em;
    word-spacing: 0.035em;
    line-height: 1.05;
  }
  .ai-particles-stat span {
    color: var(--color-body);
    font-size: clamp(0.72rem, 2.1cqmin, 0.875rem);
    font-weight: 550;
    line-height: 1.3;
  }
  .ai-particles .ai-particles-provisional {
    position: absolute;
    right: 0;
    bottom: 0.25rem;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 0;
    color: #756b64;
    font-size: 0.74rem;
    font-weight: 600;
  }
  .ai-particles-provisional::before {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #c9a13f;
    content: '';
  }
  /* Off-screen or in a background tab: hold every CSS animation */
  [data-paused] .ai-particles-stage * {
    animation-play-state: paused !important;
  }
  @keyframes ai-card-float {
    from {
      translate: -1px -3px;
    }
    to {
      translate: 1.5px 4px;
    }
  }
  /* Small fields: tighter cards whose labels may wrap onto two lines */
  @container (max-width: 470px) {
    .ai-particles-stat-card {
      gap: 0.45rem;
      padding: 0.45rem 0.6rem 0.45rem 0.45rem;
      border-radius: 12px;
      white-space: normal;
    }
    .ai-particles-stat-card div {
      max-width: 19cqmin;
    }
    .ai-particles-stat-icon {
      width: 2rem;
      height: 2rem;
      padding: 0.42rem;
      border-radius: 9px;
    }
    .ai-particles-stat b {
      font-size: clamp(1rem, 5.2cqmin, 1.3rem);
    }
    .ai-particles-stat span {
      font-size: 0.72rem;
      line-height: 1.2;
    }
  }
  /* Desktop: the field is the page's centrepiece. hero-system--feature
     gives it the wider column (0.84 : 1.16) and up to 46rem; here it gets a
     taller 1.1:1 stage (--hero-feature-columns above widens the column to
     0.84 : 1.16). The sphere and letters size
     from the stage height (about 658px at 1440, was 517px), and the cards
     scale to ~1.15x their previous desktop size. The copy keeps its
     typography but is pinned near the top of the row (1.5rem below the
     hero padding) rather than centred, so the taller visual does not push
     it down: it sits 20-30px higher than the centred position it had. */
  @media (min-width: 1101px) {
    .ai-tech-hero-copy {
      align-self: start;
      margin-top: 1.5rem;
    }
    .ai-particles-stage {
      aspect-ratio: 1.1;
    }
    .ai-particles-stat-card {
      gap: clamp(0.65rem, 1.82cqmin, 0.9rem);
      padding: clamp(0.55rem, 1.53cqmin, 0.75rem)
        clamp(0.95rem, 2.67cqmin, 1.3rem) clamp(0.55rem, 1.53cqmin, 0.75rem)
        clamp(0.55rem, 1.53cqmin, 0.75rem);
      border-radius: 20px;
    }
    .ai-particles-stat-icon {
      width: clamp(2.4rem, 6.7cqmin, 3rem);
      height: clamp(2.4rem, 6.7cqmin, 3rem);
      padding: clamp(0.55rem, 1.53cqmin, 0.72rem);
      border-radius: 15px;
    }
    .ai-particles-stat b {
      font-size: clamp(1.2rem, 3.9cqmin, 1.8rem);
    }
    .ai-particles-stat span {
      font-size: clamp(0.72rem, 2.02cqmin, 0.92rem);
    }
  }
  /* Below desktop the wide frame is too shallow for the cards: stacked
     tablets use a square stage, and compact fields (two-column tablet/small
     laptop, and phones) a 4:5 stage that gives the cards vertical room
     around the letters. Both use the x/y card positions. */
  @media (max-width: 1100px) {
    .ai-particles-stage {
      aspect-ratio: 1;
    }
    .ai-particles-stat {
      top: var(--y);
      left: var(--x);
    }
  }
  @media (min-width: 901px) and (max-width: 1100px), (max-width: 600px) {
    .ai-particles-stage {
      aspect-ratio: 4 / 5;
    }
  }
  @media (max-width: 800px) {
    .ai-particles .ai-particles-provisional {
      bottom: -1.4rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-particles-stat-card {
      animation: none;
    }
    .ai-particles-stat-card:hover {
      transform: none;
    }
  }

  .section {
    padding-block: clamp(4.4rem, 7.2vw, 6.8rem);
  }
  .ai-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4.8rem);
    margin-bottom: 2.5rem;
  }
  .ai-section-heading > div {
    max-width: 680px;
  }
  .ai-section-heading h2 {
    margin-bottom: 0;
  }
  .ai-section-heading h2 span {
    color: var(--color-orange-dark);
  }
  .ai-section-heading > p {
    max-width: 440px;
    margin-bottom: 0.15rem;
    color: var(--color-body);
    font-size: 0.94rem;
    line-height: 1.7;
  }
  .ai-capabilities {
    background: #f0ede8;
  }
  .ai-capability-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .ai-capabilities-cta {
    display: flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    margin: 2.1rem auto 0;
    gap: 0.7rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .ai-capabilities-cta:focus-visible {
    border-radius: var(--radius-small);
    outline: 2px solid var(--color-orange-dark);
    outline-offset: 4px;
  }
  .ai-detail-card {
    --service-card-lift: 0px;
    position: relative;
    display: flex;
    min-height: 250px;
    flex-direction: column;
    padding: 1.4rem 1.45rem 1.25rem;
    overflow: hidden;
    border: 1px solid #e1ddd6;
    border-radius: var(--radius-medium);
    background: rgb(255 255 255 / 78%);
    box-shadow: 0 8px 24px rgb(16 27 45 / 3%);
    transition:
      transform 280ms var(--ease-out),
      border-color 280ms var(--ease-out),
