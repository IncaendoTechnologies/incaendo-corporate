---
import { Image } from 'astro:assets'
import InsightArtwork from './InsightArtwork.astro'
import InsightCard from './InsightCard.astro'
import { articles } from '../data/articles.js'

const { article } = Astro.props
const slugify = (value) =>
  value
    .toLocaleLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')
const relatedArticles = articles
  .filter(
    (item) => item.slug !== article.slug && item.category === article.category,
  )
  .concat(
    articles.filter(
      (item) =>
        item.slug !== article.slug && item.category !== article.category,
    ),
  )
  .slice(0, 3)
---

<div class="insight-article-page">
  <header class="article-intro hero-system hero-system--article">
    <div class="site-container article-intro-inner hero-system__inner">
      <nav class="article-breadcrumbs" aria-label="Breadcrumb">
        <a href="/insights/">Insights</a>
        <span aria-hidden="true">/</span>
        <span>{article.category}</span>
      </nav>
      <h1 class="hero-system__title">{article.title}</h1>
      <p class="article-deck hero-system__description">{article.excerpt}</p>
      <div class="article-meta" aria-label="Article details">
        {article.author ? (
          <>
            <span>By {article.author}</span>
            <span>{article.dateFormatted || article.publishedDate}</span>
            <span>{article.readMinutes} min read</span>
          </>
        ) : (
          <>
            <span>Sample editorial draft</span>
            <span>Date to be confirmed</span>
            <span>Estimated {article.readMinutes} min read</span>
          </>
        )}
      </div>
    </div>
  </header>

  <main class="article-main">
    <div class="site-container">
      <figure class="article-cover reveal">
        {article.image ? (
          <Image
            src={article.image.src}
            alt={article.image.alt}
            widths={[720, 1080, 1600, 2160]}
            sizes="(max-width: 1160px) 100vw, 1080px"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <InsightArtwork
            variant={article.variant}
            title={`Illustration for ${article.title}`}
            prefix={article.slug}
          />
        )}
      </figure>
      {!article.author && !article.isPublishedBlog && !article.isCaseStudy && (
        <p class="article-draft-warning">
          Sample editorial content for page development. Replace with approved
          Incaendo material before publication; no publication date or author
          has been assigned.
        </p>
      )}

      <div class="article-reading-layout">
        <aside class="article-toc" aria-labelledby="article-toc-heading">
          <p class="eyebrow" id="article-toc-heading">
            In this article
          </p>
          <ol>
            {article.sections.map((section) => (
              <li>
                <a href={`#${slugify(section.heading)}`}>{section.heading}</a>
              </li>
            ))}
          </ol>
          <a class="article-back-link" href="/insights/">
            <span class="link-arrow link-arrow-back" aria-hidden="true">
              ←
            </span>
            All insights
          </a>
        </aside>

        <article class="article-body">
          {article.sections.map((section) => (
            <section
              id={slugify(section.heading)}
              aria-labelledby={`${slugify(section.heading)}-heading`}
            >
              <h2 id={`${slugify(section.heading)}-heading`}>
                {section.heading}
              </h2>
              {section.paragraphs?.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {section.list && (
                <ul>
                  {section.list.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {section.image && (
                <figure class="article-inline-image">
                  <Image
                    src={section.image.src}
                    alt={section.image.alt ?? ''}
                    widths={[600, 900, 1200]}
                    sizes="(max-width: 800px) 100vw, 700px"
                    loading="lazy"
                    decoding="async"
                  />
                  {section.image.caption && (
                    <figcaption>{section.image.caption}</figcaption>
                  )}
                </figure>
              )}
              {section.table && (
                <div class="article-table-wrap">
                  <table class="article-table">
                    {section.table.headers && (
                      <thead>
                        <tr>
                          {section.table.headers.map((h) => (
                            <th scope="col">{h}</th>
                          ))}
                        </tr>
                      </thead>
                    )}
                    <tbody>
                      {section.table.rows.map((row) => (
                        <tr>
                          {row.map((cell) => (
                            <td>{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
              {section.subsections?.map((sub) => (
                <div class="article-subsection">
                  {sub.heading && <h3>{sub.heading}</h3>}
                  {sub.paragraphs?.map((p) => (
                    <p>{p}</p>
                  ))}
                  {sub.list && (
                    <ul>
                      {sub.list.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  )}
                  {sub.image && (
                    <figure class="article-inline-image">
                      <Image
                        src={sub.image.src}
                        alt={sub.image.alt ?? ''}
                        widths={[600, 900, 1200]}
                        sizes="(max-width: 800px) 100vw, 700px"
                        loading="lazy"
                        decoding="async"
                      />
                      {sub.image.caption && (
                        <figcaption>{sub.image.caption}</figcaption>
                      )}
                    </figure>
                  )}
                  {sub.table && (
                    <div class="article-table-wrap">
                      <table class="article-table">
                        {sub.table.headers && (
                          <thead>
                            <tr>
                              {sub.table.headers.map((h) => (
                                <th scope="col">{h}</th>
                              ))}
                            </tr>
                          </thead>
                        )}
                        <tbody>
                          {sub.table.rows.map((row) => (
                            <tr>
                              {row.map((cell) => (
                                <td>{cell}</td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                  {sub.afterParagraphs?.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              ))}
              {section.afterParagraphs?.map((p) => (
                <p>{p}</p>
              ))}
              {section.code && <pre><code>{section.code}</code></pre>}
            </section>
          ))}
          {!article.author &&
            !article.isPublishedBlog &&
            !article.isCaseStudy && (
              <p class="article-endnote">
                This article is a sample editorial draft. Technical examples are
                illustrative and should be reviewed before publication.
              </p>
            )}
        </article>
      </div>
    </div>
  </main>

  <section
    class="article-related section"
    aria-labelledby="related-insights-heading"
  >
    <div class="site-container">
      <div class="article-related-heading">
        <div>
          <p class="eyebrow">Keep exploring</p>
          <h2 id="related-insights-heading">More Ideas to Consider.</h2>
        </div>
        <a class="article-back-link" href="/insights/">
          Browse all insights{' '}
          <span class="link-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </div>
      <div class="article-related-grid">
        {relatedArticles.map((relatedArticle) => (
          <InsightCard article={relatedArticle} variant="related" />
        ))}
      </div>
    </div>
  </section>

  <section class="article-closing" aria-labelledby="article-closing-heading">
    <div class="site-container article-closing-inner">
      <div>
        <p class="eyebrow eyebrow-light">Put an idea into context</p>
        <h2 id="article-closing-heading">
          Have a Challenge You’re Working Through?
        </h2>
      </div>
      <a class="button button-light" href="/contact">
        Talk with Incaendo <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</div>

<style>
  .article-intro {
    background: var(--surface-subtle);
  }

  .article-intro-inner {
    max-width: 920px;
  }

  .article-breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1rem;
    color: #828b97;
    font-size: 0.69rem;
  }

  .article-breadcrumbs a {
    color: var(--color-orange-dark);
    font-weight: 650;
  }

  .article-intro h1 {
    max-width: 880px;
    margin: 0 0 1.15rem;
    font-family: var(--font-heading);
    font-size: var(--type-hero-h1-size);
    font-weight: var(--type-hero-h1-weight);
    letter-spacing: var(--type-hero-h1-letter-spacing);
    word-spacing: var(--type-hero-h1-word-spacing);
    line-height: var(--type-hero-h1-line-height);
  }

  .article-deck {
    max-width: 760px;
    margin: 0;
    font-family: var(--font-body);
    color: var(--color-body);
    font-size: var(--type-hero-desc-size);
    font-weight: var(--type-hero-desc-weight);
    line-height: var(--type-hero-desc-line-height);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    margin-top: 1.35rem;
    color: #7e8895;
    font-size: 0.67rem;
  }

  .article-main {
    padding-block: 2.8rem 5rem;
    background: #fbfaf8;
  }

  .article-cover {
    max-width: 1080px;
    margin: 0 auto 0.75rem;
    overflow: hidden;
    border: 1px solid #e7e4de;
    border-radius: var(--radius-large);
    box-shadow: 0 20px 55px rgb(16 27 45 / 8%);
  }

  .article-cover :global(.insight-art),
  .article-cover > :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 18 / 9;
    object-fit: cover;
  }

  .article-draft-warning {
    max-width: 1080px;
    margin: 0 auto 3.7rem;
    color: #89919c;
    font-size: 0.66rem;
    line-height: 1.5;
  }

  .article-reading-layout {
    display: grid;
    max-width: 1080px;
    grid-template-columns: minmax(190px, 0.36fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 6rem);
    margin-inline: auto;
  }

  .article-toc {
    position: sticky;
    top: calc(var(--site-header-height) + 2rem);
    align-self: start;
  }

  .article-toc .eyebrow {
    margin-bottom: 0.8rem;
    font-size: var(--type-eyebrow-size);
  }

  .article-toc ol {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0 0 1.2rem;
    border-bottom: 1px solid var(--color-line);
    list-style: none;
  }

  .article-toc a {
    color: #657183;
    font-size: 0.72rem;
    line-height: 1.5;
    transition: color 180ms ease;
  }

  .article-toc a:hover {
    color: var(--color-orange-dark);
  }

  .article-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 1rem;
    color: var(--color-orange-dark);
    font-size: 0.72rem;
    font-weight: 650;
  }

  .article-body {
    max-width: 700px;
  }

  .article-body section + section {
    margin-top: 3rem;
  }

  .article-body h2 {
    margin: 0 0 0.85rem;
    font-size: var(--type-compact-heading-size);
    font-weight: 620;
    letter-spacing: -0.05em;
    word-spacing: 0.05em;
    line-height: 1.2;
  }

  .article-body h3 {
    margin: 1.8rem 0 0.6rem;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .article-inline-image {
    margin: 1.75rem 0 2rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-medium);
    background: #fff;
    box-shadow: 0 10px 30px rgb(16 27 45 / 5%);
  }

  .article-inline-image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .article-inline-image figcaption {
    padding: 0.65rem 1rem;
    border-top: 1px solid var(--color-line);
    background: #faf8f5;
    color: #6a7686;
    font-size: 0.75rem;
    text-align: center;
    font-style: italic;
  }

  .article-table-wrap {
    overflow-x: auto;
    margin: 1.75rem 0 2rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-medium);
    background: #fff;
    box-shadow: 0 6px 20px rgb(16 27 45 / 4%);
  }

  .article-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }

  .article-table th,
  .article-table td {
    padding: 0.85rem 1.15rem;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
  }

  .article-table thead th {
    background: #f7f5f1;
    color: var(--color-ink);
    font-weight: 650;
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .article-table tbody tr:last-child td {
    border-bottom: none;
  }

  .article-table tbody tr:hover {
    background: #faf8f5;
  }

  .article-subsection {
    margin-top: 1.5rem;
  }

  .article-body p,
  .article-body li {
    color: #465466;
    font-size: 0.94rem;
    line-height: 1.82;
  }

  .article-body p {
    margin-bottom: 1rem;
  }

  .article-body ul {
    display: grid;
    gap: 0.45rem;
    margin: 0 0 1.25rem;
    padding-left: 1.2rem;
  }

  .article-body li::marker {
    color: var(--color-orange-dark);
  }

  .article-body pre {
    overflow-x: auto;
    margin: 1.25rem 0 0;
    padding: 1.15rem 1.3rem;
    border: 1px solid rgb(255 255 255 / 10%);
    border-radius: var(--radius-medium);
    background: #17283d;
    color: #f1d0bf;
    font-size: 0.8rem;
    line-height: 1.7;
  }

  .article-endnote {
    margin-top: 2.8rem !important;
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--color-orange-dark);
    background: #f2efeb;
    color: #778292 !important;
    font-size: 0.72rem !important;
  }

  .article-related {
    background: var(--surface-subtle);
  }

  .article-related-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .article-related-heading h2 {
    margin: 0;
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
  }

  .article-related-heading .eyebrow {
    margin-bottom: 0.65rem;
  }

  .article-related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: 1rem;
  }

  .article-closing {
    padding-block: 3rem;
    background: var(--color-navy);
  }

  .article-closing-inner {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .article-closing h2 {
    margin: 0;
    color: white;
    font-size: var(--type-compact-heading-size);
    font-weight: 600;
  }

  .article-closing .eyebrow {
    margin-bottom: 0.6rem;
  }

  @media (max-width: 850px) {
    .article-reading-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
    .article-toc {
      position: static;
    }
    .article-toc ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .article-related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .article-intro {
      padding-block: var(--hero-space-top) 2rem;
    }
    .article-breadcrumbs {
      margin-bottom: 1.25rem;
    }
    .article-intro h1 {
      font-size: clamp(2.15rem, 8.5vw, 2.75rem);
    }
    .article-cover {
      border-radius: var(--radius-medium);
    }
    .article-cover :global(.insight-art),
    .article-cover > :global(img) {
      aspect-ratio: 16 / 10;
    }
    .article-draft-warning {
      margin-bottom: 2.4rem;
    }
    .article-toc ol,
    .article-related-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .article-reading-layout {
      gap: 1.5rem;
    }
    .article-body p,
    .article-body li {
      font-size: 0.88rem;
    }
    .article-related-heading,
    .article-closing-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
