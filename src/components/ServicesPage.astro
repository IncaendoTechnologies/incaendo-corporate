    margin-left: 0.6rem;
    color: #8793a0;
    font-size: 0.52rem;
    font-style: normal;
  }
  .web-dashboard {
    display: grid;
    min-height: 205px;
    grid-template-columns: 42px minmax(0, 1fr);
  }
