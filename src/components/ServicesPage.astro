    color: var(--color-muted);
    font-size: 0.48rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }
  .software-module b {
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 650;
