---
import BaseLayout from '../layouts/BaseLayout.astro'
import { pages } from '../data/site-content.js'
import LegalHero from '../components/LegalHero.astro'
import {
  Database,
  LockKeyhole,
  ShieldCheck,
  SlidersHorizontal,
  UserCheck,
} from 'lucide-react'
---

<BaseLayout title={pages.privacy.title} description={pages.privacy.description}>
  <main id="main-content" class="legal-page">
    <!-- =========================
         HERO
    ========================= -->
    <LegalHero
      headingId="privacy-hero-heading"
      titleLead="Privacy &"
      titleAccent="Data Protection."
      description="We believe your information should be handled responsibly. Learn how Incaendo collects, uses and protects information when you use our website and services."
      points={['Clear Information', 'Responsible Data Use', 'Secure Practices']}
      tags={['Privacy', 'Data Protection', 'Security', 'Transparency', 'Responsible Data Use']}
      doc={{
        icon: ShieldCheck,
        label: 'Incaendo Policy',
        title: 'Privacy Policy',
        summary: 'How your information is collected, used and protected.',
        sections: 16,
        updated: 'Updated September 2026',
        highlights: [
          'What we collect and why',
          'Cookies, analytics and sharing',
          'Your privacy choices',
        ],
        statusIcon: UserCheck,
        status: 'We do not sell or rent your personal information',
      }}
      cards={[
        {
          icon: Database,
          title: 'Data Collection',
          text: 'Details you share with us, plus basic technical data from visits.',
        },
        {
          icon: SlidersHorizontal,
          title: 'Data Usage',
          text: 'Used to respond, deliver services and improve our website.',
        },
        {
          icon: LockKeyhole,
          title: 'Data Protection',
          text: 'Reasonable safeguards against unauthorised access or misuse.',
        },
      ]}
    />

    <!-- =========================
         POLICY CONTENT
    ========================= -->
    <section
      class="legal-content-section"
      aria-labelledby="policy-main-heading"
    >
      <div class="site-container legal-document-container">
        <div class="legal-document-card">
          <!-- INTRO -->
          <div class="legal-intro">
            <span class="company-subheading">
              Incaendo Technologies Pvt. Ltd.
            </span>
            <h2 id="policy-main-heading">Privacy Policy</h2>
            <p class="updated-date">
              <strong>Last Updated: September 2026</strong>
            </p>

            <p>
              At Incaendo Technologies Pvt. Ltd., we respect your privacy and
              are committed to protecting the information you share with us.
              This Privacy Policy explains what information we may collect, how
              we use it, how we protect it, and what choices you have when you
              visit our website, contact us, or use our services.
            </p>

            <p>
              By using the Incaendo website or submitting your information
              through our website, you agree to the practices described in this
              Privacy Policy.
            </p>
          </div>

          <!-- 01 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">01</span>
              About Incaendo
            </h2>
            <p>
              Incaendo Technologies Pvt. Ltd. provides technology and digital
              solutions to businesses. Our services may include:
            </p>
            <ul>
              <li>Software Development</li>
              <li>Web Development</li>
              <li>Mobile App Development</li>
              <li>AI & Automation</li>
              <li>CRM Solutions</li>
              <li>LMS Solutions</li>
              <li>Cloud & Data Solutions</li>
              <li>Technology Consulting and related services</li>
            </ul>
            <p>
              This Privacy Policy applies to information collected through our
              website, contact forms, enquiry forms, communication with our
              team, and other interactions with Incaendo.
            </p>
          </div>

          <!-- 02 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">02</span>
              Information We Collect
            </h2>
            <p>
              Depending on how you interact with us, we may collect information
              that you provide directly to us as well as certain technical
              information collected when you use our website.
            </p>
            <p>
              <strong>Information You Provide</strong>
            </p>
            <p>
              When you contact us, request a consultation, submit an enquiry, or
              discuss a project, you may provide:
            </p>
            <ul>
              <li>Name</li>
              <li>Company name</li>
              <li>Email address</li>
              <li>Phone number</li>
              <li>Job title or role</li>
              <li>Business requirements</li>
              <li>Project details</li>
              <li>Budget or timeline information</li>
              <li>Any other information you voluntarily provide</li>
            </ul>
            <p>
              Please do not submit confidential passwords, payment credentials,
              or sensitive personal information through general website forms
              unless specifically requested through an appropriate secure
              process.
            </p>
            <p>
              <strong>Automatically Collected Information</strong>
            </p>
            <p>
              When you visit our website, certain technical information may be
              collected automatically, such as:
            </p>
            <ul>
              <li>IP address</li>
              <li>Browser type</li>
              <li>Device type</li>
              <li>Operating system</li>
              <li>Pages visited</li>
              <li>Approximate location derived from technical information</li>
              <li>Date and time of website visits</li>
              <li>Referring website or source</li>
              <li>Website usage and interaction information</li>
            </ul>
          </div>

          <!-- 03 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">03</span>
              How We Use Your Information
            </h2>
            <p>
              We may use the information we collect for legitimate business and
              operational purposes, including:
            </p>
            <ul>
              <li>Responding to your enquiries</li>
              <li>Contacting you regarding your project or requirements</li>
              <li>Understanding your business needs</li>
              <li>Providing quotations, consultations, or proposals</li>
              <li>Delivering and managing our services</li>
              <li>Communicating about ongoing projects</li>
              <li>Improving our website and services</li>
              <li>Understanding website traffic and user behaviour</li>
              <li>Maintaining website security</li>
              <li>Preventing misuse, fraud, or unauthorized activity</li>
              <li>Meeting applicable legal and regulatory requirements</li>
            </ul>
            <div class="legal-highlight">
              We aim to use personal information only for appropriate and
              relevant business purposes and to collect information that is
              reasonably necessary for those purposes.
            </div>
          </div>

          <!-- 04 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">04</span>
              Project & Business Information
            </h2>
            <p>
              If you contact Incaendo regarding software development, website
              development, mobile applications, AI & automation, CRM, LMS, or
              other technology services, you may share information about your
              business or project.
            </p>
            <p>
              We treat such information as confidential and use it primarily for
              understanding your requirements, preparing proposals, providing
              services, and communicating with you.
            </p>
            <p>
              We do not intentionally use your confidential project information
              for unrelated purposes.
            </p>
          </div>

          <!-- 05 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">05</span>
              Cookies & Similar Technologies
            </h2>
            <p>
              Our website may use cookies and similar technologies to improve
              your browsing experience and understand how the website is being
              used.
            </p>
            <p>Cookies may help us:</p>
            <ul>
              <li>Remember certain preferences</li>
              <li>Understand website traffic</li>
              <li>Measure website performance</li>
              <li>Improve website functionality</li>
              <li>Understand how visitors interact with our content</li>
              <li>
                Support analytics and marketing activities where applicable
              </li>
            </ul>
            <p>
              You can manage or disable cookies through your browser settings.
              Disabling certain cookies may affect some website functionality.
            </p>
          </div>

          <!-- 06 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">06</span>
              Analytics & Website Services
            </h2>
            <p>
              We may use third-party analytics or website technologies to
              understand website performance and visitor behaviour.
            </p>
            <p>
              These services may collect information such as browser details,
              device information, pages visited, traffic sources, and
              interactions with our website.
            </p>
            <p>
              The information collected through these tools may be used for
              analytics, performance improvement, security, and marketing
              measurement.
            </p>
            <p>
              Third-party services may process information according to their
              own privacy policies and terms.
            </p>
          </div>

          <!-- 07 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">07</span>
              How We Share Information
            </h2>
            <p>
              We do <strong>not sell or rent your personal information</strong>
              to third parties.
            </p>
            <p>
              We may share information with trusted third parties where
              reasonably necessary to operate our business or provide services,
              including:
            </p>
            <ul>
              <li>Website hosting and infrastructure providers</li>
              <li>Analytics providers</li>
              <li>CRM and communication platforms</li>
              <li>Email and messaging service providers</li>
              <li>Technology and software service providers</li>
              <li>Professional advisors where necessary</li>
              <li>
                Government authorities or law-enforcement agencies when legally
                required
              </li>
            </ul>
            <p>
              Where third parties process information on our behalf, we expect
              them to handle that information appropriately and only for the
              relevant purpose.
            </p>
          </div>

          <!-- 08 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">08</span>
              Business Partners & Service Providers
            </h2>
            <p>
              For certain projects, Incaendo may work with technology providers,
              contractors, consultants, integration partners, or other service
              providers.
            </p>
            <p>
              Where information needs to be shared with such parties, we aim to
              limit the information shared to what is reasonably required for
              the relevant business or project purpose.
            </p>
          </div>

          <!-- 09 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">09</span>
              Data Security
            </h2>
            <p>
              We take reasonable technical and organizational measures to
              protect the information we hold against:
            </p>
            <ul>
              <li>Unauthorized access</li>
              <li>Unauthorized disclosure</li>
              <li>Loss or misuse</li>
              <li>Alteration</li>
              <li>Destruction</li>
            </ul>
            <p>
              However, no website, online communication, or electronic storage
              system can be guaranteed to be completely secure.
            </p>
            <p>
              While we take reasonable steps to protect information, we cannot
              guarantee absolute security of information transmitted through the
              internet.
            </p>
          </div>

          <!-- 10 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">10</span>
              How Long We Keep Information
            </h2>
            <p>
              We retain personal information only for as long as reasonably
              necessary for the purpose for which it was collected, including:
            </p>
            <ul>
              <li>Responding to enquiries</li>
              <li>Managing business relationships</li>
              <li>Providing services</li>
              <li>Maintaining business records</li>
              <li>Resolving disputes</li>
              <li>
                Meeting contractual, legal, accounting, or regulatory
                requirements
              </li>
            </ul>
            <p>
              When information is no longer reasonably required, we may delete,
              anonymize, or securely dispose of it, subject to applicable legal
              requirements.
            </p>
          </div>

          <!-- 11 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">11</span>
              Your Privacy Choices
            </h2>
            <p>
              Depending on applicable law, you may have rights regarding your
              personal information, including the ability to:
            </p>
            <ul>
              <li>Ask what personal information we hold about you</li>
              <li>Request correction of inaccurate information</li>
              <li>Request deletion of information where applicable</li>
              <li>Withdraw consent where processing is based on consent</li>
              <li>Ask questions about how your information is being used</li>
              <li>Request that certain communications stop</li>
            </ul>
            <p>
              Some requests may be subject to legal, contractual, or other
              legitimate business requirements.
            </p>
          </div>

          <!-- 12 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">12</span>
              Marketing Communications
            </h2>
            <p>
              If you provide your contact information to us, we may contact you
              regarding your enquiry, project, services, or other relevant
              business matters.
            </p>
            <p>
              Where applicable, we may also send promotional or marketing
              communications.
            </p>
            <p>
              You may request to stop receiving marketing communications at any
              time by contacting us or using the unsubscribe option provided in
              the communication.
            </p>
            <p>
              You may still receive important service-related or transactional
              communications when necessary.
            </p>
          </div>

          <!-- 13 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">13</span>
              Third-Party Websites
            </h2>
            <p>
              Our website may contain links to third-party websites, platforms,
              or services.
            </p>
            <p>
              These websites operate independently from Incaendo and may have
              their own privacy policies and terms.
            </p>
            <p>
              We are not responsible for the privacy practices, content,
              security, or policies of third-party websites.
            </p>
            <p>
              We recommend reviewing the privacy policy of any external website
              before providing personal information.
            </p>
          </div>

          <!-- 14 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">14</span>
              Children's Privacy
            </h2>
            <p>
              Our services are intended primarily for businesses and
              professional users. Our website is not specifically directed
              toward children.
            </p>
            <p>
              We do not knowingly collect personal information from children
              through our website. If you believe that a child has provided
              personal information to us, please contact us so that we can
              review the matter and take appropriate action.
            </p>
          </div>

          <!-- 15 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">15</span>
              Changes to This Privacy Policy
            </h2>
            <p>
              We may update this Privacy Policy from time to time to reflect
              changes in our services, business practices, technology, or
              applicable legal requirements.
            </p>
            <p>
              When we make changes, we will update the
              <strong>Last Updated</strong> date shown at the beginning of this
              policy.
            </p>
            <p>
              We encourage visitors to review this page periodically to stay
              informed about how we handle information.
            </p>
          </div>

          <!-- 16 -->
          <div class="legal-section">
            <h2>
              <span class="section-number">16</span>
              Contact Us
            </h2>
            <p>
              If you have questions about this Privacy Policy, want to make a
              privacy-related request, or need clarification regarding how we
              handle your information, you can contact us.
            </p>
          </div>

          <!-- CONTACT CARD -->
          <div class="legal-contact-card">
            <span class="contact-badge">Privacy & Support</span>
            <h2>Have a Question about Your Privacy?</h2>
            <p>
              Our team is available to help you understand how your information
              is handled and to respond to privacy-related requests.
            </p>

            <div class="contact-grid">
              <div class="contact-grid-item">
                <strong>Email:</strong>
                <a href="mailto:info@incaendo.com">info@incaendo.com</a>
              </div>
              <div class="contact-grid-item">
                <strong>Company:</strong>
                <span>Incaendo Technologies Pvt. Ltd.</span>
              </div>
              <div class="contact-grid-item">
                <strong>Address:</strong>
                <span>
                  First Floor, B-9, B Block, Sector 2, Noida, Uttar Pradesh –
                  201301
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .legal-page {
    background-color: var(--color-paper);
    min-height: 100vh;
  }

  /* =========================
     CONTENT
  ========================= */
  .legal-content-section {
    padding-block: clamp(3.5rem, 6vw, 6rem);
  }

  .legal-document-container {
    max-width: 900px;
    margin-inline: auto;
  }

  .legal-document-card {
    background: var(--color-white);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-large);
    padding: clamp(2rem, 5vw, 4rem);
    box-shadow: 0 10px 40px rgba(16, 27, 45, 0.04);
  }

  .legal-intro {
    padding-bottom: 2.5rem;
    border-bottom: 2px solid var(--color-paper);
    margin-bottom: 2.5rem;
  }

  .company-subheading {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-orange);
    margin-bottom: 0.5rem;
  }

  .legal-intro h2 {
    font-family: var(--font-heading);
    font-size: var(--type-section-size);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.03em;
    word-spacing: 0.03em;
    color: var(--color-ink);
    margin-bottom: 0.5rem;
  }

  .updated-date {
    font-size: 0.95rem;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  .legal-intro p,
  .legal-section p {
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--color-body);
    margin-bottom: 1rem;
  }

  .legal-intro p:last-child {
    margin-bottom: 0;
  }

  .legal-section {
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-line);
    margin-bottom: 2.5rem;
  }

  .legal-section h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 700;
    color: var(--color-ink);
    letter-spacing: -0.02em;
    word-spacing: 0.02em;
    margin-bottom: 1.25rem;
  }

  .section-number {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-orange);
    background: rgba(201, 84, 43, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .legal-section ul {
    margin: 1rem 0 1.25rem 1.25rem;
    padding: 0;
  }

  .legal-section li {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-body);
    margin-bottom: 0.45rem;
  }

  .legal-highlight {
    background: #fbf7f3;
    border-left: 3px solid var(--color-orange);
    padding: 1rem 1.25rem;
    border-radius: 0 8px 8px 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-navy);
    margin-top: 1.25rem;
  }

  /* =========================
     CONTACT CARD
  ========================= */
  .legal-contact-card {
    background: linear-gradient(135deg, #07111e 0%, #101b2d 60%, #17263c 100%);
    border-radius: var(--radius-medium);
    padding: clamp(2rem, 4vw, 3rem);
    color: var(--color-white);
    margin-top: 3rem;
  }

  .contact-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8ed0ff;
    margin-bottom: 0.6rem;
  }

  .legal-contact-card h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-white);
    margin-bottom: 0.75rem;
  }

  .legal-contact-card p {
    font-size: 0.98rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: 1.75rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
  }

  @media (min-width: 640px) {
    .contact-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    }
  }

  .contact-grid-item {
    font-size: 0.92rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
  }

  .contact-grid-item strong {
    display: block;
    color: #ffffff;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }

  .contact-grid-item a {
    color: #8ed0ff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact-grid-item a:hover {
    color: var(--color-white);
  }
</style>
