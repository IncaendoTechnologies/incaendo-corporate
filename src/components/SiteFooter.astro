---
import reversedLogo from '../assets/incaendo-logo-reversed.png'

const currentYear = new Date().getFullYear()
---

<footer class="inc-footer">
  <div class="inc-footer-inner">
    <div class="inc-footer-grid">
      <!-- Brand -->
      <div class="inc-footer-brand">
        <a href="/" aria-label="Incaendo Technologies, home" class="inc-footer-brand-link">
          <img
            src={reversedLogo.src}
            width={reversedLogo.width}
            height={reversedLogo.height}
            alt="Incaendo Technologies"
            loading="lazy"
            decoding="async"
            class="inc-footer-logo"
          />
        </a>
        <p>
          Web platforms, mobile apps, AI agents and cloud infrastructure for startups, SMEs and enterprises, since 2012.
        </p>
      </div>

      <!-- Services nav -->
      <nav aria-label="Services">
        <span class="inc-footer-heading">Services</span>
        <ul>
          <li><a class="inc-footer-link" href="/ai-technology">AI and automation</a></li>
          <li><a class="inc-footer-link" href="/services#software-development">Custom software</a></li>
          <li><a class="inc-footer-link" href="/services#web-applications">Web applications</a></li>
          <li><a class="inc-footer-link" href="/services#mobile-applications">Mobile apps</a></li>
          <li><a class="inc-footer-link" href="/services#enterprise-solutions">Enterprise solutions</a></li>
        </ul>
      </nav>

      <!-- Company nav -->
      <nav aria-label="Company">
        <span class="inc-footer-heading">Company</span>
        <ul>
          <li><a class="inc-footer-link" href="/projects">Projects</a></li>
          <li><a class="inc-footer-link" href="/teams">Teams</a></li>
          <li><a class="inc-footer-link" href="/insights">Insights</a></li>
          <li><a class="inc-footer-link" href="/careers">Careers</a></li>
          <li><a class="inc-footer-link" href="/contact" data-contact-page-link>Contact</a></li>
        </ul>
      </nav>

      <!-- Contact -->
      <div class="inc-footer-contact">
        <span class="inc-footer-heading">Get in touch</span>
        <address>
          Incaendo Technologies Private Limited<br />
          First Floor, B-9, B Block, Sector 2<br />
          Noida, UP – 201301, India
        </address>
        <a class="inc-footer-link" href="mailto:info@incaendo.com">info@incaendo.com</a>
        <div class="inc-footer-social">
          <a href="https://www.linkedin.com/company/incaendo-technologies-pvt-ltd-/" target="_blank" rel="noopener noreferrer" aria-label="Incaendo on LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </a>
          <a href="https://www.instagram.com/incaendo_technologies/" target="_blank" rel="noopener noreferrer" aria-label="Incaendo on Instagram">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          <a href="https://www.facebook.com/Incaendo/" target="_blank" rel="noopener noreferrer" aria-label="Incaendo on Facebook">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Legal line -->
    <div class="inc-footer-legal">
      <span>&copy; {currentYear} Incaendo Technologies Private Limited</span>
      <span>
        <a href="/privacy-policy">Privacy policy</a>
        <span aria-hidden="true"> · </span>
        <a href="/terms-and-conditions">Terms and conditions</a>
      </span>
    </div>
  </div>
</footer>

<style>
  .inc-footer {
    background: var(--navy, #0f2136);
    color: var(--on-navy, #ffffff);
    padding: var(--space-8, 64px) 0 var(--space-5, 24px);
    font-size: 14px;
    line-height: 20px;
  }

  .inc-footer-inner {
    width: 100%;
    max-width: var(--container-content, 1200px);
    margin: 0 auto;
    padding: 0 var(--gutter-mobile, 16px);
    box-sizing: border-box;
  }

  @media (min-width: 768px) {
    .inc-footer-inner {
      padding: 0 var(--space-5, 24px);
    }
  }

  .inc-footer-grid {
    display: grid;
    gap: var(--space-6, 32px) var(--space-5, 24px);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 1024px) {
    .inc-footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: var(--space-7, 48px);
    }

    .inc-footer-brand,
    .inc-footer-contact {
      grid-column: auto;
    }
  }

  .inc-footer-brand,
  .inc-footer-contact {
    grid-column: 1 / -1;
  }

  @media (min-width: 1024px) {
    .inc-footer-brand,
    .inc-footer-contact {
      grid-column: auto;
    }
  }

  .inc-footer-brand-link {
    display: inline-block;
    margin-bottom: var(--space-4, 16px);
  }

  .inc-footer-logo {
    display: block;
    height: 44px;
    width: auto;
  }

  .inc-footer-brand p {
    margin: 0 0 var(--space-3, 12px);
    opacity: 0.85;
    max-width: 320px;
    line-height: 1.55;
  }

  .inc-footer-heading {
    display: block;
    font-family: var(--font-display, 'Plus Jakarta Sans', Arial, sans-serif);
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-navy, #ffffff);
    opacity: 0.7;
    margin: 0 0 var(--space-3, 12px);
  }

  .inc-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .inc-footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: var(--on-navy, #ffffff);
    text-decoration: none;
    transition: opacity var(--motion-fast, 150ms) ease;
  }

  .inc-footer-link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (pointer: coarse) {
    .inc-footer-link {
      min-height: var(--tap-min, 44px);
    }
  }

  .inc-footer-contact address {
    font-style: normal;
    opacity: 0.85;
    line-height: 1.55;
    margin-bottom: var(--space-3, 12px);
  }

  .inc-footer-contact .inc-footer-link {
    margin-bottom: var(--space-3, 12px);
  }

  .inc-footer-social {
    display: flex;
    gap: var(--space-2, 8px);
    margin-top: var(--space-3, 12px);
  }

  .inc-footer-social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min, 44px);
    height: var(--tap-min, 44px);
    border-radius: 50%;
    color: var(--on-navy, #ffffff);
    border: 1px solid rgba(255, 255, 255, 0.2);
    transition:
      background-color var(--motion-fast, 150ms) ease,
      border-color var(--motion-fast, 150ms) ease;
  }

  .inc-footer-social a:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .inc-footer-social a:focus-visible {
    outline: 2px solid var(--focus, #145aa8);
    outline-offset: 2px;
  }

  .inc-footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3, 12px) var(--space-5, 24px);
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    margin-top: var(--space-7, 48px);
    padding-top: var(--space-5, 24px);
    font-size: 12px;
    line-height: 16px;
    opacity: 0.8;
  }

  .inc-footer-legal a {
    color: var(--on-navy, #ffffff);
    text-decoration: none;
  }

  .inc-footer-legal a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (pointer: coarse) {
    .inc-footer-legal a {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap-min, 44px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inc-footer-link,
    .inc-footer-social a {
      transition: none;
    }
  }
</style>
