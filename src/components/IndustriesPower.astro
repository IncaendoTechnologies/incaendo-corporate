---
// Each industry's glow tints the light flash behind its icon on hover.
const industries = [
  {
    name: 'Retail & E-commerce',
    description: 'Digital commerce platforms and customer experiences.',
    icon: 'retail',
    glow: '242 182 50',
  },
  {
    name: 'Healthcare',
    description: 'Connected care solutions and secure systems.',
    icon: 'healthcare',
    glow: '30 200 200',
  },
  {
    name: 'FinTech',
    description: 'Reliable financial platforms and payment solutions.',
    icon: 'fintech',
    glow: '242 182 50',
  },
  {
    name: 'Education',
    description: 'Learning platforms and student management systems.',
    icon: 'education',
    glow: '22 169 196',
  },
  {
    name: 'Food & Hospitality',
    description: 'Booking, ordering and customer experience solutions.',
    icon: 'hospitality',
    glow: '84 123 157',
  },
  {
    name: 'Media & Entertainment',
    description: 'Content platforms and audience engagement.',
    icon: 'media',
    glow: '201 84 43',
  },
  {
    name: 'Logistics & Transport',
    description: 'Operational visibility and process optimization.',
    icon: 'logistics',
    glow: '20 163 168',
  },
  {
    name: 'Startups & Enterprises',
    description: 'Scalable products and enterprise modernisation.',
    icon: 'enterprise',
    glow: '108 191 74',
  },
]

// A non-breaking hyphen keeps "E-commerce" together when the label wraps.
const displayName = (name) => name.replace('-', '‑')
---

<section
  class="industries-section"
  id="industries"
  aria-labelledby="industries-heading"
>
  <div class="site-container industries-content">
    <header class="industries-intro reveal">
      <p class="eyebrow">Industries we power</p>
      <h2 id="industries-heading">
        Different industries. <span>One technology partner.</span>
      </h2>
      <p>
        We turn complex industry challenges into connected, scalable digital
        experiences.
      </p>
    </header>

    <ul class="industry-row reveal" data-reveal-stagger>
      {industries.map((industry) => (
        <li
          class:list={['industry-item', `industry-${industry.icon}`]}
          style={`--industry-glow: ${industry.glow}`}
          data-reveal-item
        >
          <span class="industry-icon" aria-hidden="true">
            <svg viewBox="0 0 72 72" fill="none" focusable="false">
              {industry.icon === 'retail' && (
                <>
                  <rect
                    x="20"
                    y="5"
                    width="32"
                    height="62"
                    rx="6"
                    fill="#101b2d"
                  />
                  <rect
                    x="23"
                    y="12"
                    width="26"
                    height="45"
                    rx="2"
                    fill="#eef4fa"
                  />
                  <rect
                    x="31"
                    y="7.6"
                    width="10"
                    height="1.8"
                    rx="0.9"
                    fill="#5b6b80"
                  />
                  <circle cx="36" cy="62" r="2" fill="#5b6b80" />
                  <rect
                    x="27"
                    y="20"
                    width="18"
                    height="18"
                    rx="3"
                    fill="#f2b632"
                  />
                  <path
                    d="M30 25h2.2l2 7.4h7.4l1.6-5.2H33"
                    stroke="#101b2d"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <circle cx="35" cy="35" r="1.2" fill="#101b2d" />
                  <circle cx="41" cy="35" r="1.2" fill="#101b2d" />
                  <rect
                    x="27"
                    y="43"
                    width="18"
                    height="2.4"
                    rx="1.2"
                    fill="#c9d8e6"
                  />
                  <rect
                    x="27"
                    y="48.5"
                    width="11"
                    height="2.4"
                    rx="1.2"
                    fill="#c9d8e6"
                  />
                  <circle
                    class="retail-badge"
                    cx="50"
                    cy="9"
                    r="5"
                    fill="#c9542b"
                    stroke="#fff"
                    stroke-width="2"
                  />
                </>
              )}
              {industry.icon === 'healthcare' && (
                <>
                  <defs>
                    <linearGradient id="ind-heart" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#22cbc4" />
                      <stop offset="0.5" stop-color="#14b0c8" />
                      <stop offset="1" stop-color="#2f6fd6" />
                    </linearGradient>
                  </defs>
                  <path
                    d="M36 63C20 51 6 41 6 24.5 6 14.5 13.8 7 23 7c5.8 0 10 3 13 8 3-5 7.2-8 13-8 9.2 0 17 7.5 17 17.5C66 41 52 51 36 63Z"
                    fill="url(#ind-heart)"
                  />
                  <path
                    d="M15 15.5c2.2-2.6 5.4-3.8 8.6-3.4"
                    stroke="#fff"
                    stroke-width="3"
                    stroke-linecap="round"
                    opacity="0.45"
                  />
                  <path
                    class="heart-pulse"
                    d="M9 34h13l4.5-8 6 17 5.5-22 5 13h20"
                    pathLength="100"
                    stroke="#fff"
                    stroke-width="3.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </>
              )}
              {industry.icon === 'fintech' && (
                <>
                  <circle cx="36" cy="36" r="32" fill="#f2b632" />
                  <rect
                    x="22"
                    y="13"
                    width="25"
                    height="42"
                    rx="4.5"
                    fill="#101b2d"
                  />
                  <rect
                    x="25"
                    y="18"
                    width="19"
                    height="30"
                    rx="1.5"
                    fill="#e8f6f7"
                  />
                  <circle cx="34.5" cy="51.5" r="1.4" fill="#5b6b80" />
                  <path
                    d="M34.5 22.5 42 25.3v5.5c0 4.8-3.1 8.3-7.5 10-4.4-1.7-7.5-5.2-7.5-10v-5.5Z"
                    fill="#14a3a8"
                  />
                  <path
                    class="fintech-check"
                    d="m31 31.6 2.6 2.6 4.6-4.9"
                    pathLength="1"
                    stroke="#fff"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                  <g class="fintech-coin">
                    <circle
                      cx="48"
                      cy="46"
                      r="9.5"
                      fill="#c9542b"
                      stroke="#fff"
                      stroke-width="2.5"
                    />
                    <path
                      d="M50.6 43.2c-.6-.8-1.6-1.2-2.7-1.2-1.5 0-2.5.8-2.5 1.9 0 2.7 5.4 1.4 5.4 4.2 0 1.1-1.1 1.9-2.6 1.9-1.2 0-2.2-.4-2.8-1.2M48 40.4v1.6m0 8v1.6"
                      stroke="#fff"
                      stroke-width="1.6"
                      stroke-linecap="round"
                    />
                  </g>
                </>
              )}
              {industry.icon === 'education' && (
                <>
                  <circle cx="36" cy="36" r="32" fill="#16a9c4" />
                  <path
                    d="m24 50-4 11m28-11 4 11"
                    stroke="#0b6e84"
                    stroke-width="2.6"
                    stroke-linecap="round"
                  />
                  <rect
                    x="13"
                    y="21"
                    width="46"
                    height="29"
                    rx="2.5"
                    fill="#f2b632"
                  />
                  <rect
                    x="16"
                    y="24"
                    width="40"
                    height="23"
                    rx="1"
                    fill="#173a46"
                  />
                  <path
                    class="edu-chalk"
                    d="M20 30c1.6-2 3.2 2 4.8 0s3.2 2 4.8 0M20 35.5h11M36 29l3.4 3.4m0-3.4L36 32.4M43 30.7h7M20 41h17M41 38.5h9m-9 3h6"
                    pathLength="1"
                    stroke="#fff"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <rect
                    x="20"
                    y="48"
                    width="32"
                    height="3"
                    rx="1.5"
                    fill="#e09b16"
                  />
                  <path d="M40 18.5v4c3.4 2.2 9.6 2.2 13 0v-4" fill="#101b2d" />
                  <path d="m46.5 11 11 4.5-11 4.5-11-4.5Z" fill="#101b2d" />
                  <path
                    d="M57.5 15.5v7"
                    stroke="#c9542b"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                  <circle cx="57.5" cy="23.6" r="1.6" fill="#c9542b" />
                </>
              )}
              {industry.icon === 'hospitality' && (
                <>
                  <defs>
                    <linearGradient id="ind-cloche" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#f4f7fb" />
                      <stop offset="1" stop-color="#b9c9d9" />
                    </linearGradient>
                  </defs>
                  <g class="food-lid">
                    <path
                      d="M13 43a23 23 0 0 1 46 0Z"
                      fill="url(#ind-cloche)"
                      stroke="#547b9d"
                      stroke-width="1.8"
                      stroke-linejoin="round"
                    />
                    <path
                      d="M21 37.5a16 16 0 0 1 8.4-11.3"
                      stroke="#fff"
                      stroke-width="2.6"
                      stroke-linecap="round"
                    />
                    <rect x="34.5" y="17" width="3" height="4" fill="#547b9d" />
                    <circle cx="36" cy="16" r="3.2" fill="#547b9d" />
                  </g>
                  <rect
                    x="9"
                    y="43"
                    width="54"
                    height="4.5"
                    rx="2.25"
                    fill="#547b9d"
                  />
                  <path
                    d="M20 50h20.5a3.2 3.2 0 0 1 0 6.4h-9l-4.6 4.4H20Z"
                    fill="#f4a98d"
                  />
                  <rect
                    x="11"
                    y="48.5"
                    width="9"
                    height="13.5"
                    rx="2"
                    fill="#14a3a8"
                  />
                  <circle
                    class="food-glint"
                    cx="52"
                    cy="25"
                    r="2.2"
                    fill="#f2b632"
                  />
                </>
              )}
              {industry.icon === 'media' && (
                <>
                  <defs>
                    <linearGradient id="ind-screen" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#ee7347" />
                      <stop offset="1" stop-color="#c9542b" />
                    </linearGradient>
                    <clipPath id="ind-screen-clip">
                      <rect x="11" y="15" width="50" height="34" rx="2" />
                    </clipPath>
                  </defs>
                  <rect x="31" y="54" width="10" height="6" fill="#101b2d" />
                  <path
                    d="M24 61h24"
                    stroke="#101b2d"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                  <rect
                    x="6"
                    y="10"
                    width="60"
                    height="45"
                    rx="5"
                    fill="#101b2d"
                  />
                  <rect
                    x="11"
                    y="15"
                    width="50"
                    height="34"
                    rx="2"
                    fill="url(#ind-screen)"
                  />
                  <g clip-path="url(#ind-screen-clip)">
                    <path
                      class="media-sheen"
                      d="M2 15h9L2 49h-9Z"
                      fill="#fff"
                      opacity="0.35"
                    />
                  </g>
                  <path
                    class="media-play"
                    d="M31 24.5 44.5 32 31 39.5Z"
                    fill="#fff"
                  />
                  <circle cx="61.5" cy="52" r="1.3" fill="#3fd0c9" />
                </>
              )}
              {industry.icon === 'logistics' && (
                <>
                  <path
                    class="truck-lines"
                    d="M3 28h10M1 36h12M5 44h8"
                    stroke="#14a3a8"
                    stroke-width="3"
                    stroke-linecap="round"
                  />
                  <g class="truck-body">
                    <rect
                      x="16"
                      y="20"
                      width="32"
                      height="26"
                      rx="2.5"
                      fill="#f2b632"
                      stroke="#101b2d"
                      stroke-width="2.4"
                    />
                    <rect x="28.5" y="20" width="7" height="9" fill="#c9542b" />
                    <path
                      d="M48 29h9.5l7 8.5V46H48Z"
                      fill="#fff"
                      stroke="#101b2d"
                      stroke-width="2.4"
                      stroke-linejoin="round"
                    />
                    <path d="M51.5 32.5h4.8l4.2 5h-9Z" fill="#8fc9e8" />
                    <path
                      d="M14 46h52"
                      stroke="#101b2d"
                      stroke-width="2.4"
                      stroke-linecap="round"
                    />
                    <circle cx="26" cy="49" r="5.2" fill="#101b2d" />
                    <circle cx="26" cy="49" r="2" fill="#fff" />
                    <circle cx="55" cy="49" r="5.2" fill="#101b2d" />
                    <circle cx="55" cy="49" r="2" fill="#fff" />
                  </g>
                </>
              )}
              {industry.icon === 'enterprise' && (
                <>
                  <defs>
                    <linearGradient id="ind-power" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" stop-color="#a6d63c" />
                      <stop offset="1" stop-color="#3fae78" />
                    </linearGradient>
                  </defs>
                  <circle cx="36" cy="36" r="32" fill="url(#ind-power)" />
                  <g class="enterprise-orbit">
                    <circle
                      cx="36"
                      cy="36"
                      r="25"
                      stroke="#fff"
                      stroke-width="1.4"
                      opacity="0.4"
                    />
                    <circle cx="36" cy="11" r="2.6" fill="#fff" />
                    <circle cx="57.6" cy="48.5" r="2.6" fill="#fff" />
                    <circle cx="14.4" cy="48.5" r="2.6" fill="#f2b632" />
                  </g>
                  <path
                    d="M27 26.5a14 14 0 1 0 18 0"
                    stroke="#fff"
                    stroke-width="4.6"
                    stroke-linecap="round"
                  />
                  <path
                    d="M36 20v15"
                    stroke="#fff"
                    stroke-width="4.6"
                    stroke-linecap="round"
                  />
                </>
              )}
            </svg>
          </span>
          <h3 class="industry-name">{displayName(industry.name)}</h3>
          <p class="visually-hidden">{industry.description}</p>
        </li>
      ))}
    </ul>

    <p class="industries-cta">
      <a class="text-link" href="/projects">
        Explore Our Work{' '}
        <span class="link-arrow" aria-hidden="true">
          →
        </span>
      </a>
    </p>
  </div>
</section>

<style>
  .industries-section {
    padding-block: clamp(4.5rem, 7.5vw, 7rem);
    background: linear-gradient(180deg, #faf8f5 0%, var(--color-paper) 100%);
  }

  .industries-intro {
    max-width: 850px;
    margin: 0 auto clamp(2.75rem, 4.6vw, 4rem);
    text-align: center;
  }

  .industries-intro .eyebrow {
    margin-bottom: 0.8rem;
  }

  .industries-intro h2 {
    margin-bottom: 0.9rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
  }

  .industries-intro h2 span {
    color: var(--color-orange-dark);
  }

  .industries-intro > p:last-child {
    max-width: 650px;
    margin: 0 auto;
    color: var(--color-body);
    font-size: var(--type-body-size);
    line-height: var(--type-body-line-height);
  }

  .industry-row {
    --icon-size: 68px;
    --label-color: #1f6e98;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: 2.5rem clamp(0.75rem, 1.6vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .industries-cta {
    margin: clamp(2rem, 3.5vw, 2.75rem) 0 0;
    text-align: center;
  }

  .industry-item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 1.35rem;
    text-align: center;
  }

  .industry-icon {
    position: relative;
    display: grid;
    width: var(--icon-size);
    height: var(--icon-size);
    place-items: center;
    isolation: isolate;
    transition:
      transform 300ms var(--ease-out),
      filter 300ms var(--ease-out);
  }

  /* Soft glow that stays while hovered, plus a one-off ring of light. */
  .industry-icon::before,
  .industry-icon::after {
    position: absolute;
    z-index: -1;
    inset: -14px;
    border-radius: 50%;
    content: '';
    opacity: 0;
    pointer-events: none;
  }

  .industry-icon::before {
    background: radial-gradient(
      circle,
      rgb(var(--industry-glow) / 32%) 0%,
      rgb(var(--industry-glow) / 0%) 68%
    );
    transition: opacity 300ms var(--ease-out);
  }

  .industry-icon::after {
    border: 2px solid rgb(var(--industry-glow) / 55%);
  }

  .industry-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .industry-name {
    position: relative;
    max-width: 11ch;
    margin: 0;
    color: var(--label-color);
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.15vw, 1.12rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    word-spacing: 0.015em;
    line-height: 1.4;
    overflow-wrap: normal;
    text-wrap: balance;
    transition: color 250ms var(--ease-out);
    hyphens: none;
  }

  /* Accent rule under the label; absolutely placed so hover never shifts layout. */
  .industry-name::after {
    position: absolute;
    bottom: -0.55rem;
    left: 50%;
    width: 1.75rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-orange);
    content: '';
    transform: translateX(-50%) scaleX(0);
    transition: transform 300ms var(--ease-out);
  }

  /* Icon details that move on hover; transform-box keeps origins local. */
  .retail-badge,
  .media-play,
  .enterprise-orbit,
  .fintech-coin {
    transform-box: fill-box;
    transform-origin: center;
  }

  .heart-pulse {
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
  }

  .fintech-check,
  .edu-chalk {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .food-lid,
  .truck-body,
  .truck-lines,
  .food-glint {
    transition:
      transform 320ms var(--ease-out),
      opacity 320ms var(--ease-out);
  }

  .food-glint {
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .industry-item:hover .industry-icon {
      filter: drop-shadow(0 8px 14px rgb(var(--industry-glow) / 30%));
      transform: translateY(-3px) scale(1.08);
    }

    .industry-item:hover .industry-icon::before {
      opacity: 1;
    }

    .industry-item:hover .industry-icon::after {
      animation: industry-flash 700ms var(--ease-out);
    }

    .industry-item:hover .industry-name {
      color: var(--color-navy);
    }

    .industry-item:hover .industry-name::after {
      transform: translateX(-50%) scaleX(1);
    }

    .industry-item:hover .retail-badge {
      animation: industry-pop 600ms var(--ease-out) 2;
    }

    .industry-item:hover .heart-pulse {
      animation: industry-draw-pulse 900ms ease-in-out;
    }

    .industry-item:hover .fintech-check,
    .industry-item:hover .edu-chalk {
      animation: industry-draw 650ms var(--ease-out);
    }

    .industry-item:hover .fintech-coin {
      animation: industry-pop 500ms var(--ease-out);
    }

    .industry-item:hover .food-lid {
      transform: translateY(-4px);
    }

    .industry-item:hover .food-glint {
      opacity: 1;
    }

    .industry-item:hover .media-sheen {
      animation: industry-sweep 750ms ease-in-out;
    }

    .industry-item:hover .media-play {
      animation: industry-pop 500ms var(--ease-out);
    }

    .industry-item:hover .truck-body {
      transform: translateX(3px);
    }

    .industry-item:hover .truck-lines {
      animation: industry-speed 600ms ease-in-out 2;
    }

    .industry-item:hover .enterprise-orbit {
      animation: industry-orbit 900ms var(--ease-out);
    }
  }

  @keyframes industry-flash {
    0% {
      opacity: 0.9;
      transform: scale(0.7);
    }

    100% {
      opacity: 0;
      transform: scale(1.25);
    }
  }

  @keyframes industry-pop {
    50% {
      transform: scale(1.22);
    }
  }

  @keyframes industry-draw-pulse {
    0% {
      stroke-dashoffset: 100;
    }

    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes industry-draw {
    0% {
      stroke-dashoffset: 1;
    }

    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes industry-sweep {
    0% {
      transform: translateX(0);
    }

    100% {
      transform: translateX(72px);
    }
  }

  @keyframes industry-speed {
    50% {
      opacity: 0.45;
      transform: translateX(-4px);
    }
  }

  @keyframes industry-orbit {
    100% {
      transform: rotate(120deg);
    }
  }

  /* Tablet: two balanced rows of four. */
  @media (max-width: 1099px) {
    .industry-row {
      --icon-size: 62px;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem 1.5rem;
    }
  }

  /* Phone: two columns, icons kept prominent. */
  @media (max-width: 600px) {
    .industries-section {
      padding-block: 4rem;
    }

    .industries-intro {
      margin-bottom: 2.5rem;
    }

    .industry-row {
      --icon-size: 56px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1rem;
    }

    .industry-item {
      gap: 1rem;
    }

    .industry-name {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .industry-icon,
    .industry-icon::before,
    .industry-name,
    .industry-name::after,
    .food-lid,
    .truck-body,
    .truck-lines,
    .food-glint {
      transition: none;
    }

    .industry-item:hover .industry-icon {
      transform: none;
    }

    .industry-item:hover .industry-icon::after,
    .industry-item:hover .industry-icon * {
      animation: none;
    }

    .industry-item:hover .food-lid,
    .industry-item:hover .truck-body {
      transform: none;
    }
  }
</style>
