---
// NASA/Goddard Space Flight Center Scientific Visualization Studio, Blue Marble.
import { getImage } from 'astro:assets'
import earthTextureSource from '../assets/earth-blue-marble.png'

const earthTexture = await getImage({
  src: earthTextureSource,
  width: 1024,
  format: 'webp',
  quality: 84,
})

const industries = [
  {
    name: 'Retail & E-commerce',
    description: 'Digital commerce platforms and customer experiences.',
    icon: 'retail',
    tone: 'blue',
    position: 'industry-retail',
  },
  {
    name: 'Healthcare',
    description: 'Connected care solutions and secure systems.',
    icon: 'healthcare',
    tone: 'orange',
    position: 'industry-healthcare',
  },
  {
    name: 'FinTech',
    description: 'Reliable financial platforms and payment solutions.',
    icon: 'fintech',
    tone: 'orange',
    position: 'industry-fintech',
  },
  {
    name: 'Education',
    description: 'Learning platforms and student management systems.',
    icon: 'education',
    tone: 'blue',
    position: 'industry-education',
  },
  {
    name: 'Food & Hospitality',
    description: 'Booking, ordering and customer experience solutions.',
    icon: 'hospitality',
    tone: 'blue',
    position: 'industry-hospitality',
  },
  {
    name: 'Media & Entertainment',
    description: 'Content platforms and audience engagement.',
    icon: 'media',
    tone: 'orange',
    position: 'industry-media',
  },
  {
    name: 'Logistics & Transport',
    description: 'Operational visibility and process optimization.',
    icon: 'logistics',
    tone: 'orange',
    position: 'industry-logistics',
  },
  {
    name: 'Startups & Enterprises',
    description: 'Scalable products and enterprise modernisation.',
    icon: 'enterprise',
    tone: 'blue',
    position: 'industry-enterprise',
  },
]
---

<section
  class="industries-section"
  id="industries"
  aria-labelledby="industries-heading"
>
  <div class="site-container industries-content">
    <header class="industries-intro reveal">
      <p class="eyebrow">Industries we power</p>
      <h2 id="industries-heading">
        Different industries. <span>One technology partner.</span>
      </h2>
      <p>
        We turn complex industry challenges into connected, scalable digital
        experiences.
      </p>
    </header>

    <div class="industry-stage reveal" data-reveal-stagger>
      <div class="industry-globe">
        <span class="industry-orbit industry-orbit-one" aria-hidden="true"></span>
        <span class="industry-orbit industry-orbit-two" aria-hidden="true"></span>
        <span class="industry-orbit industry-orbit-three" aria-hidden="true"></span>
        <span class="industry-particle industry-particle-one" aria-hidden="true"></span>
        <span class="industry-particle industry-particle-two" aria-hidden="true"></span>
        <span class="industry-particle industry-particle-three" aria-hidden="true"></span>
        <span class="industry-particle industry-particle-four" aria-hidden="true"></span>
        <div
          class="industry-earth"
          data-earth-globe
          role="img"
          aria-label="Rotating, satellite-textured Earth with cloud detail and blue atmospheric lighting"
        >
          <img class="industry-earth-fallback" src={earthTexture.src} alt="" />
          <canvas class="industry-earth-canvas" aria-hidden="true"></canvas>
        </div>
      </div>

      {
        industries.map((industry) => (
          <article
            class:list={[
              'industry-card',
              industry.position,
              `industry-card-${industry.tone}`,
            ]}
            data-reveal-item
            tabindex="0"
          >
            <span class="industry-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" focusable="false">
                {industry.icon === 'retail' && (
                  <>
                    <path d="M4 9h16l-1.2 11H5.2L4 9Z" />
                    <path d="m7 9 1-5h8l1 5M9 13v3m6-3v3" />
                  </>
                )}
                {industry.icon === 'healthcare' && (
                  <>
                    <path d="M12 21s-7-4.4-7-10a4 4 0 0 1 7-2.7A4 4 0 0 1 19 11c0 5.6-7 10-7 10Z" />
                    <path d="M12 10v6m-3-3h6" />
                  </>
                )}
                {industry.icon === 'fintech' && (
                  <>
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="M3 10h18m-13 5h3m4 0h2" />
                  </>
                )}
                {industry.icon === 'education' && (
                  <>
                    <path d="m3 8 9-5 9 5-9 5-9-5Z" />
                    <path d="M6 10v5c3.8 3.2 8.2 3.2 12 0v-5m3-2v6" />
                  </>
                )}
                {industry.icon === 'hospitality' && (
                  <>
                    <path d="M4 13h16l-1.5 6h-13L4 13Z" />
                    <path d="M6 11a6 6 0 0 1 12 0M8 4l-1-2m9 2 1-2M12 2v2" />
                  </>
                )}
                {industry.icon === 'media' && (
                  <>
                    <rect x="3" y="4" width="18" height="16" rx="3" />
                    <path d="m10 8 6 4-6 4V8Z" />
                  </>
                )}
                {industry.icon === 'logistics' && (
                  <>
                    <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z" />
                    <circle cx="7" cy="18" r="2" />
                    <circle cx="18" cy="18" r="2" />
                  </>
                )}
                {industry.icon === 'enterprise' && (
                  <>
                    <rect x="4" y="3" width="16" height="18" rx="2" />
                    <path d="M8 7h2m4 0h2M8 11h2m4 0h2M8 15h2m4 0h2m-5 6v-3h2v3" />
                  </>
                )}
              </svg>
            </span>
            <span class="industry-card-copy">
              <strong>{industry.name}</strong>
              <span>{industry.description}</span>
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const earthVertexShader = `
    attribute vec3 aPosition;
    attribute vec2 aUv;
    uniform float uAngle;
    uniform float uAspect;
    varying vec2 vUv;
    varying vec3 vNormal;
    varying vec3 vCloudPosition;

    void main() {
      float c = cos(uAngle);
      float s = sin(uAngle);
      vec3 p = vec3(c * aPosition.x + s * aPosition.z, aPosition.y, -s * aPosition.x + c * aPosition.z);
      vUv = aUv;
      vNormal = p;
      vCloudPosition = p;

      float cameraDistance = 3.2;
      float nearPlane = 0.1;
      float farPlane = 10.0;
      float z = p.z - cameraDistance;
      float zClip = ((farPlane + nearPlane) / (nearPlane - farPlane)) * z + ((2.0 * farPlane * nearPlane) / (nearPlane - farPlane));
      gl_Position = vec4(p.x * 2.75 / uAspect, p.y * 2.75, zClip, -z);
    }
  `

  const earthFragmentShader = `
    precision mediump float;
    uniform sampler2D uEarth;
    uniform vec3 uLightDirection;
    varying vec2 vUv;
    varying vec3 vNormal;
    varying vec3 vCloudPosition;

    float hash(vec3 p) {
      p = fract(p * 0.3183099 + vec3(0.1, 0.2, 0.3));
      p *= 17.0;
      return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
    }

    float noise(vec3 p) {
      vec3 i = floor(p);
      vec3 f = fract(p);
      f = f * f * (3.0 - 2.0 * f);
      return mix(
        mix(mix(hash(i), hash(i + vec3(1.0, 0.0, 0.0)), f.x), mix(hash(i + vec3(0.0, 1.0, 0.0)), hash(i + vec3(1.0, 1.0, 0.0)), f.x), f.y),
        mix(mix(hash(i + vec3(0.0, 0.0, 1.0)), hash(i + vec3(1.0, 0.0, 1.0)), f.x), mix(hash(i + vec3(0.0, 1.0, 1.0)), hash(i + vec3(1.0, 1.0, 1.0)), f.x), f.y),
        f.z
      );
    }

    float cloudNoise(vec3 p) {
      return noise(p * 3.0) * 0.58 + noise(p * 6.0) * 0.28 + noise(p * 12.0) * 0.14;
    }

    void main() {
      vec3 normal = normalize(vNormal);
      vec3 colorMap = texture2D(uEarth, vUv).rgb;
      float diffuse = max(dot(normal, normalize(uLightDirection)), 0.0);
      float ocean = smoothstep(0.035, 0.22, colorMap.b - max(colorMap.r, colorMap.g) * 0.65);
      vec3 viewDirection = vec3(0.0, 0.0, 1.0);
      vec3 reflectedLight = reflect(-normalize(uLightDirection), normal);
      float specular = pow(max(dot(reflectedLight, viewDirection), 0.0), 38.0) * ocean * 0.22;

      float clouds = smoothstep(0.51, 0.67, cloudNoise(vCloudPosition * 1.7 + vec3(2.0, 0.4, 1.2)));
      float cloudDetail = smoothstep(0.54, 0.72, cloudNoise(vCloudPosition * 2.8 + vec3(0.7, 1.6, 2.3)));
      float cloudCover = max(clouds * 0.74, cloudDetail * 0.34);

      vec3 surface = colorMap * (0.3 + diffuse * 0.88);
      surface += vec3(0.45, 0.64, 0.86) * specular;
      surface = mix(surface, vec3(0.77, 0.88, 0.98), cloudCover * (0.34 + diffuse * 0.42));

      float fresnel = pow(1.0 - max(dot(normal, viewDirection), 0.0), 2.7);
      vec3 atmosphere = vec3(0.12, 0.48, 0.88) * fresnel * 0.66;
      gl_FragColor = vec4(surface + atmosphere, 1.0);
    }
  `

  function compileShader(gl, type, source) {
    const shader = gl.createShader(type)
    if (!shader) throw new Error('Unable to create Earth shader')
    gl.shaderSource(shader, source)
    gl.compileShader(shader)
    if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
      const error = gl.getShaderInfoLog(shader)
      gl.deleteShader(shader)
      throw new Error(error || 'Unable to compile Earth shader')
    }
    return shader
  }

  function createSphereMesh(latitudeBands = 48, longitudeBands = 96) {
    const positions = []
    const uvs = []
    const indices = []

    for (let latitude = 0; latitude <= latitudeBands; latitude += 1) {
      const v = latitude / latitudeBands
      const phi = v * Math.PI
      const ringRadius = Math.sin(phi)
      const y = Math.cos(phi)

      for (let longitude = 0; longitude <= longitudeBands; longitude += 1) {
        const u = longitude / longitudeBands
        const theta = u * Math.PI * 2
        positions.push(ringRadius * Math.cos(theta), y, ringRadius * Math.sin(theta))
        uvs.push(u, v)
      }
    }

    for (let latitude = 0; latitude < latitudeBands; latitude += 1) {
      for (let longitude = 0; longitude < longitudeBands; longitude += 1) {
        const first = latitude * (longitudeBands + 1) + longitude
        const next = first + longitudeBands + 1
        indices.push(first, next, first + 1, next, next + 1, first + 1)
      }
    }

    return {
      positions: new Float32Array(positions),
      uvs: new Float32Array(uvs),
      indices: new Uint16Array(indices),
    }
  }

  function setupEarthGlobes() {
    document.querySelectorAll('[data-earth-globe]').forEach((globe) => {
      if (globe.dataset.webglInitialized === 'true') return
      globe.dataset.webglInitialized = 'true'

      const canvas = globe.querySelector('.industry-earth-canvas')
      const textureImage = globe.querySelector('.industry-earth-fallback')
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
      const gl = canvas?.getContext('webgl', {
        alpha: true,
        antialias: true,
        powerPreference: 'low-power',
      })

      if (!gl || !textureImage) return

      let animationFrame = 0
      let isVisible = false
      let rotation = 0
      let lastTime = 0
      let disposed = false
      let program
      let texture
      let resizeObserver
      let intersectionObserver

      try {
        const vertexShader = compileShader(gl, gl.VERTEX_SHADER, earthVertexShader)
        const fragmentShader = compileShader(gl, gl.FRAGMENT_SHADER, earthFragmentShader)
        program = gl.createProgram()
        if (!program) throw new Error('Unable to create Earth program')
        gl.attachShader(program, vertexShader)
        gl.attachShader(program, fragmentShader)
        gl.linkProgram(program)
        gl.deleteShader(vertexShader)
        gl.deleteShader(fragmentShader)

        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          throw new Error(gl.getProgramInfoLog(program) || 'Unable to link Earth program')
        }

        const mesh = createSphereMesh()
        const positionBuffer = gl.createBuffer()
        const uvBuffer = gl.createBuffer()
        const indexBuffer = gl.createBuffer()
        texture = gl.createTexture()
        if (!positionBuffer || !uvBuffer || !indexBuffer || !texture) {
          throw new Error('Unable to create Earth buffers')
        }

        gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer)
        gl.bufferData(gl.ARRAY_BUFFER, mesh.positions, gl.STATIC_DRAW)
        gl.bindBuffer(gl.ARRAY_BUFFER, uvBuffer)
        gl.bufferData(gl.ARRAY_BUFFER, mesh.uvs, gl.STATIC_DRAW)
        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer)
        gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, mesh.indices, gl.STATIC_DRAW)

        const positionLocation = gl.getAttribLocation(program, 'aPosition')
        const uvLocation = gl.getAttribLocation(program, 'aUv')
        const angleLocation = gl.getUniformLocation(program, 'uAngle')
        const aspectLocation = gl.getUniformLocation(program, 'uAspect')
        const earthLocation = gl.getUniformLocation(program, 'uEarth')
        const lightLocation = gl.getUniformLocation(program, 'uLightDirection')

        gl.useProgram(program)
        gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer)
        gl.enableVertexAttribArray(positionLocation)
        gl.vertexAttribPointer(positionLocation, 3, gl.FLOAT, false, 0, 0)
        gl.bindBuffer(gl.ARRAY_BUFFER, uvBuffer)
        gl.enableVertexAttribArray(uvLocation)
        gl.vertexAttribPointer(uvLocation, 2, gl.FLOAT, false, 0, 0)
        gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, indexBuffer)
        gl.uniform3f(lightLocation, -0.48, 0.35, 0.82)
        gl.uniform1i(earthLocation, 0)
        gl.enable(gl.DEPTH_TEST)
        gl.depthFunc(gl.LEQUAL)
        gl.clearColor(0, 0, 0, 0)

        textureImage.addEventListener('load', uploadTexture, { once: true })
        textureImage.addEventListener('error', showFallback, { once: true })

        function uploadTexture() {
          if (disposed || !textureImage.naturalWidth) return showFallback()
          gl.bindTexture(gl.TEXTURE_2D, texture)
          gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, textureImage)
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.REPEAT)
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR)
          gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR)
          gl.generateMipmap(gl.TEXTURE_2D)
          gl.activeTexture(gl.TEXTURE0)
          resizeCanvas()
          globe.classList.add('is-webgl-ready')
          draw(lastTime)
          if (!reducedMotion.matches && isVisible) {
            animationFrame = requestAnimationFrame(animate)
          }
        }

        function resizeCanvas() {
          if (!canvas) return
          const rect = canvas.getBoundingClientRect()
          if (!rect.width || !rect.height) return
          const pixelRatio = Math.min(window.devicePixelRatio || 1, 1.5)
          const width = Math.max(1, Math.round(rect.width * pixelRatio))
          const height = Math.max(1, Math.round(rect.height * pixelRatio))
          if (canvas.width === width && canvas.height === height) return
          canvas.width = width
          canvas.height = height
          gl.viewport(0, 0, width, height)
          if (textureImage.complete && textureImage.naturalWidth) draw(lastTime)
        }

        function draw(time) {
          if (disposed || !textureImage.naturalWidth) return
          gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT)
          gl.useProgram(program)
          gl.uniform1f(angleLocation, rotation)
          gl.uniform1f(aspectLocation, canvas.width / Math.max(canvas.height, 1))
          gl.activeTexture(gl.TEXTURE0)
          gl.bindTexture(gl.TEXTURE_2D, texture)
          gl.drawElements(gl.TRIANGLES, mesh.indices.length, gl.UNSIGNED_SHORT, 0)
          lastTime = time
        }

        function animate(time) {
          if (disposed || !isVisible || reducedMotion.matches) return
          const elapsed = lastTime ? Math.min((time - lastTime) / 1000, 0.1) : 0
          rotation += elapsed * 0.045
          draw(time)
          animationFrame = requestAnimationFrame(animate)
        }

        function showFallback() {
          globe.classList.remove('is-webgl-ready')
        }

        function handleContextLoss(event) {
          event.preventDefault()
          cancelAnimationFrame(animationFrame)
          showFallback()
        }

        function updateMotionPreference() {
          cancelAnimationFrame(animationFrame)
          if (reducedMotion.matches) {
            draw(lastTime)
          } else if (isVisible && textureImage.complete && textureImage.naturalWidth) {
            animationFrame = requestAnimationFrame(animate)
          }
        }

        resizeObserver = new ResizeObserver(resizeCanvas)
        resizeObserver.observe(globe)
        canvas.addEventListener('webglcontextlost', handleContextLoss, {
          once: true,
        })
        intersectionObserver = new IntersectionObserver(([entry]) => {
          isVisible = entry.isIntersecting
          cancelAnimationFrame(animationFrame)
          if (isVisible && textureImage.complete && textureImage.naturalWidth && !reducedMotion.matches) {
            animationFrame = requestAnimationFrame(animate)
          }
        })
        intersectionObserver.observe(globe)
        reducedMotion.addEventListener('change', updateMotionPreference)

        if (textureImage.complete && textureImage.naturalWidth) uploadTexture()

        globe._cleanupEarth = () => {
          disposed = true
          cancelAnimationFrame(animationFrame)
          resizeObserver?.disconnect()
          intersectionObserver?.disconnect()
          reducedMotion.removeEventListener('change', updateMotionPreference)
          canvas.removeEventListener('webglcontextlost', handleContextLoss)
          gl.deleteTexture(texture)
          gl.deleteProgram(program)
          gl.getExtension('WEBGL_lose_context')?.loseContext()
          globe.classList.remove('is-webgl-ready')
          delete globe.dataset.webglInitialized
          delete globe._cleanupEarth
        }
      } catch {
        globe.classList.remove('is-webgl-ready')
        gl.getExtension('WEBGL_lose_context')?.loseContext()
      }
    })
  }

  function cleanupEarthGlobes() {
    document.querySelectorAll('[data-earth-globe]').forEach((globe) => {
      globe._cleanupEarth?.()
    })
  }

  setupEarthGlobes()
  document.addEventListener('astro:page-load', setupEarthGlobes)
  document.addEventListener('astro:before-swap', cleanupEarthGlobes)
</script>

<style>
  .industries-section {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 7.5vw, 7rem);
    background:
      radial-gradient(ellipse at 50% 47%, rgb(244 233 223 / 63%), transparent 43%),
      linear-gradient(180deg, #faf8f5 0%, var(--color-paper) 100%);
    isolation: isolate;
  }

  .industries-section::before,
  .industries-section::after {
    position: absolute;
    z-index: -1;
    width: min(78vw, 980px);
    aspect-ratio: 1;
    border: 1px solid rgb(168 65 33 / 6%);
    border-radius: 50%;
    content: '';
    pointer-events: none;
  }

  .industries-section::before {
    top: 16%;
    left: -39%;
  }

  .industries-section::after {
    right: -42%;
    bottom: -55%;
    width: min(95vw, 1180px);
    border-color: rgb(84 123 157 / 7%);
  }

  .industries-content {
    position: relative;
    z-index: 1;
  }

  .industries-intro {
    max-width: 850px;
    margin: 0 auto clamp(2.75rem, 5vw, 4.5rem);
    text-align: center;
  }

  .industries-intro .eyebrow {
    margin-bottom: 0.8rem;
  }

  .industries-intro h2 {
    margin-bottom: 0.9rem;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    line-height: var(--type-section-line-height);
  }

  .industries-intro h2 span {
    color: var(--color-orange-dark);
  }

  .industries-intro > p:last-child {
    max-width: 650px;
    margin: 0 auto;
    color: var(--color-body);
    font-size: var(--type-body-size);
    line-height: var(--type-body-line-height);
  }

  .industry-stage {
    display: grid;
    min-height: 650px;
    grid-template-columns: minmax(0, 1fr) minmax(380px, 1.55fr) minmax(0, 1fr);
    grid-template-rows: repeat(4, minmax(128px, 1fr));
    align-items: center;
    gap: 0.85rem clamp(1rem, 2vw, 1.7rem);
  }

  .industry-globe {
    position: relative;
    display: grid;
    width: min(100%, 490px);
    aspect-ratio: 1;
    grid-area: 1 / 2 / 5 / 3;
    justify-self: center;
    place-items: center;
  }

  .industry-earth {
    position: relative;
    z-index: 1;
    display: block;
    width: 80%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1px solid rgb(208 239 255 / 38%);
    border-radius: 50%;
    background: #071b37;
    filter: drop-shadow(0 28px 30px rgb(16 27 45 / 18%));
    box-shadow: inset 0 0 20px 2px rgb(101 190 238 / 23%);
  }

  .industry-earth::after {
    position: absolute;
    z-index: 2;
    inset: 0;
    border-radius: inherit;
    background:
      radial-gradient(circle at 34% 24%, transparent 34%, rgb(8 22 45 / 12%) 65%, rgb(4 17 37 / 53%) 100%),
      linear-gradient(108deg, rgb(222 246 255 / 14%), transparent 34% 75%, rgb(5 17 36 / 20%));
    box-shadow: inset 0 0 0 1px rgb(200 235 255 / 35%), inset -13px -8px 22px rgb(2 16 36 / 25%);
    content: '';
    pointer-events: none;
  }

  .industry-earth-fallback,
  .industry-earth-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .industry-earth-fallback {
    left: 50%;
    width: 200%;
    max-width: none;
    object-fit: fill;
    transform: translateX(-50%);
    transition: opacity 500ms var(--ease-out);
  }

  .industry-earth-canvas {
    z-index: 1;
    opacity: 0;
    transition: opacity 500ms var(--ease-out);
  }

  .industry-earth.is-webgl-ready .industry-earth-fallback {
    opacity: 0;
  }

  .industry-earth.is-webgl-ready .industry-earth-canvas {
    opacity: 1;
  }

  .industry-orbit {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 50%;
    width: 126%;
    height: 38%;
    border: 1px solid rgb(84 123 157 / 30%);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-28deg);
    animation: industry-orbit-one-drift 32s ease-in-out infinite alternate;
  }

  .industry-orbit-two {
    width: 120%;
    height: 57%;
    border-color: rgb(168 65 33 / 20%);
    transform: translate(-50%, -50%) rotate(52deg);
    animation-name: industry-orbit-two-drift;
    animation-duration: 38s;
  }

  .industry-orbit-three {
    width: 110%;
    height: 76%;
    border-color: rgb(84 123 157 / 15%);
    transform: translate(-50%, -50%) rotate(-66deg);
    animation-name: industry-orbit-three-drift;
    animation-duration: 44s;
  }

  .industry-particle {
    position: absolute;
    z-index: 2;
    top: 0;
    left: 0;
    width: 7px;
    height: 7px;
    border: 1px solid rgb(255 255 255 / 85%);
    border-radius: 50%;
    background: var(--color-orange);
    box-shadow: 0 0 14px rgb(201 84 43 / 50%);
    offset-path: ellipse(61% 19% at 50% 50%);
    animation: industry-orbit-travel 28s linear infinite;
  }

  .industry-particle-two {
    width: 6px;
