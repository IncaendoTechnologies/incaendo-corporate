---
import InsightCard from './InsightCard.astro'
import InsightsHeroLatest from './InsightsHeroLatest.astro'
import FilterBar from './FilterBar.astro'
import Pagination from './Pagination.astro'
import {
  articles,
  featuredArticles,
  heroArticle,
  insightCategories,
} from '../data/articles.js'

const categoryKey = (category) =>
  category
    .toLocaleLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '')

const filterItems = [
  { label: 'All', value: 'all' },
  ...insightCategories.map((category) => ({
    label: category,
    value: categoryKey(category),
  })),
]
---

<div class="insights-page">
  <section class="insights-hero hero-system hero-system--split hero-system--feature" aria-labelledby="insights-page-heading">
    <div class="site-container insights-hero-inner hero-system__inner">
      <div class="insights-hero-copy hero-system__copy reveal" data-reveal-stagger>
        <h1 id="insights-page-heading" class="hero-system__title" data-reveal-item>
          Better Technology Starts with <span>Better Questions.</span>
        </h1>
        <p class="insights-hero-description hero-system__description" data-reveal-item>
          Practical perspectives on AI, software engineering and digital
          products—made to help teams understand the choices behind useful,
          maintainable technology.
        </p>
        <div class="insights-hero-actions hero-system__actions" data-reveal-item>
          <a class="button button-primary" href="#article-archive">
            Explore insights <span aria-hidden="true">↘</span>
          </a>
          <a class="text-link" href="/contact">
            Discuss a challenge{' '}
            <span class="link-arrow" aria-hidden="true">
              →
            </span>
          </a>
        </div>
        <nav class="insights-hero-topics hero-system__support" aria-label="Browse insights by topic" data-reveal-item>
          <span class="hero-system__support-label">Explore by topic</span>
          <ul>
            {insightCategories.map((category) => (
              <li>
                <a href="#article-archive" data-insights-topic={categoryKey(category)}>
                  {category}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <p class="insights-hero-footnote" data-reveal-item>
          Field notes on building and operating digital systems.
        </p>
      </div>
      <InsightsHeroLatest />
    </div>
  </section>

  <section
    class="insights-featured-section section"
    aria-labelledby="featured-insights-heading"
    data-insight-featured-section
  >
    <div class="site-container">
      <header class="insights-section-heading reveal">
        <div>
          <p class="eyebrow">Featured insights</p>
          <h2 id="featured-insights-heading">
            Ideas to Take <span>Further.</span>
          </h2>
        </div>
        <p>
          Selected sample topics spanning practical AI, product architecture and
          the engineering decisions in between.
        </p>
      </header>
      <div class="insights-featured-grid reveal" data-reveal-stagger>
        {[heroArticle, ...featuredArticles].map((article, index) => (
          <InsightCard
            article={article}
            variant={index === 0 ? 'lead' : 'featured'}
          />
        ))}
      </div>
    </div>
  </section>

  <section
    class="insights-archive-section section"
    id="article-archive"
    aria-labelledby="latest-insights-heading"
  >
    <div class="site-container">
      <header class="insights-section-heading insights-archive-heading reveal">
        <div>
          <p class="eyebrow">The article archive</p>
          <h2 id="latest-insights-heading">
            Browse the <span>Latest Thinking.</span>
          </h2>
        </div>
      </header>

      <FilterBar
        items={filterItems}
        ariaLabel="Filter articles by category"
        dataToolbar="data-insights-toolbar"
        dataFilter="data-insights-filter"
        dataReset="data-insights-reset"
        chipClass="insights-filter"
        resetClass="insights-reset"
        showReset={true}
      />

      <div class="insights-latest-layout">
        <div
          class="insights-latest-grid reveal"
          data-reveal-stagger
          data-insights-latest
        >
          {articles.map((article) => (
            <InsightCard article={article} variant="standard" />
          ))}
        </div>
        <p class="insights-empty-state" data-insights-empty hidden>
          No sample articles match that filter. Clear the filters or try another
          topic.
        </p>
        <Pagination
          ariaLabel="Article pages"
          dataPagination="data-insights-pagination"
          dataPrev="data-insights-page-prev"
          dataNext="data-insights-page-next"
          dataNumbers="data-insights-page-numbers"
        />
      </div>
    </div>
  </section>
</div>

<script>
  const PAGE_SIZE = 6

  const setupInsights = () => {
    const page = document.querySelector('.insights-page')
    if (!(page instanceof HTMLElement) || page.dataset.insightsReady === 'true') return
    page.dataset.insightsReady = 'true'

    const reset = page.querySelector('[data-insights-reset]')
    const filters = Array.from(page.querySelectorAll('[data-insights-filter]')).filter(
      (el) => el instanceof HTMLElement,
    )
    const empty = page.querySelector('[data-insights-empty]')
    const archive = page.querySelector('[data-insights-latest]')
    const archiveCards = archive
      ? Array.from(archive.querySelectorAll('[data-insight-card]')).filter(
          (el) => el instanceof HTMLElement,
        )
      : []
    const featureSection = page.querySelector('[data-insight-featured-section]')
    const featureCards = featureSection
      ? Array.from(featureSection.querySelectorAll('[data-insight-card]')).filter(
          (el) => el instanceof HTMLElement,
        )
      : []
    const pagination = page.querySelector('[data-insights-pagination]')
    const pageNumbers = page.querySelector('[data-insights-page-numbers]')
    const prevButton = page.querySelector('[data-insights-page-prev]')
    const nextButton = page.querySelector('[data-insights-page-next]')
    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)',
    ).matches

    let activeCategory = 'all'
    let currentPage = 1

    const update = (scrollToGrid = false) => {
      // Featured highlights: plain category filter, same as before pagination.
      featureCards.forEach((card) => {
        if (card instanceof HTMLElement) {
          card.hidden = !(
            activeCategory === 'all' ||
            card.dataset.insightCategory === activeCategory
          )
        }
      })
      if (featureSection instanceof HTMLElement) {
        featureSection.hidden = !featureCards.some(
          (card) => card instanceof HTMLElement && !card.hidden,
        )
      }

      // Archive: category filter, then slice to the current page.
      const matches = archiveCards.filter(
        (card) =>
          card instanceof HTMLElement &&
          (activeCategory === 'all' ||
            card.dataset.insightCategory === activeCategory),
      )
      const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE))
      currentPage = Math.min(Math.max(currentPage, 1), totalPages)
      const start = (currentPage - 1) * PAGE_SIZE
      const end = start + PAGE_SIZE

      archiveCards.forEach((card) => {
        if (card instanceof HTMLElement) {
          const matchIndex = matches.indexOf(card)
          card.hidden =
            matchIndex === -1 || matchIndex < start || matchIndex >= end
        }
      })

      if (archive instanceof HTMLElement) archive.hidden = matches.length === 0
      if (empty instanceof HTMLElement) empty.hidden = matches.length !== 0
      if (reset instanceof HTMLButtonElement) reset.disabled = activeCategory === 'all'

      if (pagination instanceof HTMLElement) {
        pagination.hidden = matches.length === 0 || totalPages <= 1
      }
      if (prevButton instanceof HTMLButtonElement) {
        prevButton.disabled = currentPage === 1
      }
      if (nextButton instanceof HTMLButtonElement) {
        nextButton.disabled = currentPage === totalPages
      }

      if (pageNumbers instanceof HTMLElement) {
        pageNumbers.innerHTML = ''
        for (let pageNum = 1; pageNum <= totalPages; pageNum += 1) {
          const button = document.createElement('button')
          button.type = 'button'
          button.className = 'insights-pagination-number'
          button.textContent = String(pageNum)
          button.setAttribute('aria-label', `Go to page ${pageNum}`)
          if (pageNum === currentPage) {
            button.classList.add('is-active')
            button.setAttribute('aria-current', 'page')
          }
          button.addEventListener('click', () => {
            if (pageNum === currentPage) return
            currentPage = pageNum
            update(true)
          })
          pageNumbers.appendChild(button)
        }
      }

      if (scrollToGrid && archive instanceof HTMLElement) {
        archive.scrollIntoView({
          behavior: reducedMotion ? 'auto' : 'smooth',
          block: 'start',
        })
      }
    }

    filters.forEach((filter) => {
      if (filter instanceof HTMLElement) {
        filter.addEventListener('keydown', (event) => {
          if (event instanceof KeyboardEvent) {
            if (event.key !== 'Enter' && event.key !== ' ') return
            event.preventDefault()
            filter.click()
          }
        })
        filter.addEventListener('click', () => {
          activeCategory = filter.dataset.insightsFilter || 'all'
          filters.forEach((button) => {
            if (button instanceof HTMLElement) {
              const selected = button === filter
              button.classList.toggle('is-active', selected)
              button.setAttribute('aria-pressed', String(selected))
            }
          })
          currentPage = 1
          update()
        })
      }
    })
    // Hero topic links apply the matching archive filter; the link's own
    // #article-archive href then scrolls to the filtered results.
    page.querySelectorAll('[data-insights-topic]').forEach((link) => {
      if (!(link instanceof HTMLElement)) return
      link.addEventListener('click', () => {
        const match = filters.find(
          (button) => button.dataset.insightsFilter === link.dataset.insightsTopic,
        )
        if (match instanceof HTMLElement) match.click()
      })
    })
    if (reset instanceof HTMLButtonElement) {
      reset.addEventListener('click', () => {
        activeCategory = 'all'
        filters.forEach((button) => {
          if (button instanceof HTMLElement) {
            const selected = button.dataset.insightsFilter === 'all'
            button.classList.toggle('is-active', selected)
            button.setAttribute('aria-pressed', String(selected))
            if (selected) button.focus()
          }
        })
        currentPage = 1
        update()
      })
    }
    prevButton?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage -= 1
        update(true)
      }
    })
    nextButton?.addEventListener('click', () => {
      currentPage += 1
      update(true)
    })

    // The site-wide scroll-reveal (src/scripts/motion.js) fires once for
    // this grid via IntersectionObserver and animates every
    // [data-reveal-item] it finds at that moment. If cards beyond page 1
    // are already hidden when that fires, GSAP sets their pre-animation
    // (invisible) state and never revisits them, so they'd stay invisible
    // forever even after a later page change unhides them. Waiting two
    // animation frames lets that one-time reveal run first.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        update()
      })
    })
  }

  setupInsights()
  document.addEventListener('astro:page-load', setupInsights)
</script>

<style>
  .insights-hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse at 91% 11%,
        rgb(244 233 223 / 76%),
        transparent 34%
      ),
      linear-gradient(125deg, #fbfaf8 0%, var(--color-paper) 53%, #f0ece6 100%);
  }

  .insights-hero-inner {
    position: relative;
    z-index: 1;
  }

  .insights-hero h1 span,
  .insights-section-heading h2 span {
    color: var(--color-orange-dark);
  }

  /* Topic shortcuts under the hero actions (apply the archive filter) */
  .insights-hero-topics ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .insights-hero-topics a {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid rgb(16 27 45 / 11%);
    border-radius: 999px;
    background: rgb(255 255 255 / 70%);
    color: var(--color-ink);
    font-size: 0.8rem;
    font-weight: 550;
    transition:
      border-color var(--duration-fast) ease,
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }

  .insights-hero-topics a:hover {
    border-color: rgb(168 65 33 / 36%);
    background: #fff;
    color: var(--color-orange-dark);
  }

  .insights-hero-footnote {
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.68rem;
  }

  .insights-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .insights-section-heading > div {
    max-width: 670px;
  }

  .insights-section-heading h2 {
    margin: 0;
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
  }

  .insights-section-heading > p {
    max-width: 400px;
    margin: 0 0 0.15rem;
    color: var(--color-body);
    font-size: 0.88rem;
    line-height: 1.7;
  }

  .insights-featured-section {
    background:
      radial-gradient(ellipse at 8% 2%, rgb(84 123 157 / 6%), transparent 28%),
      linear-gradient(180deg, #fbfaf8 0%, #f8f7f4 100%);
  }

  .insights-featured-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: 1rem;
  }

  .insights-archive-section {
    background:
      radial-gradient(
        ellipse at 2% 1%,
        rgb(244 233 223 / 42%),
        transparent 30%
      ),
      var(--surface-subtle);
  }

  .insights-latest-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .insights-latest-grid > :global(.insight-card) {
    flex: 0 1 calc((100% - 2rem) / 3);
    min-width: 0;
  }

  .insights-latest-grid[hidden],
  .insights-featured-section[hidden],
  .insights-featured-section [hidden],
  .insights-empty-state[hidden] {
    display: none !important;
  }

  .insights-empty-state {
    margin: 0;
    padding: 1.5rem;
    border: 1px dashed #d4d0ca;
    border-radius: var(--radius-medium);
    color: var(--text-intro);
    font-size: 0.82rem;
    text-align: center;
  }

  @media (max-width: 1050px) {
    .insights-latest-grid > :global(.insight-card) {
      flex-basis: calc((100% - 1rem) / 2);
    }
  }

  @media (max-width: 800px) {
    .insights-section-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }
    .insights-section-heading > p {
      max-width: 600px;
    }
  }

  @media (max-width: 600px) {
    .insights-featured-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .insights-latest-grid > :global(.insight-card) {
      flex-basis: 100%;
    }
  }
</style>
