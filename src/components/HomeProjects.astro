---
import { Image } from 'astro:assets'
import { projects } from '../data/projects.js'

const featuredNames = [
  'Tomo',
  "Domino's",
  'Good Morning Italia',
  'Credit Convey',
  'Spritz',
  'Fliplearn',
]
const featuredProjects = featuredNames
  .map((name) => projects.find((project) => project.name === name))
  .filter(Boolean)

const projectHref = (project) =>
  `/projects/#project-${projects.indexOf(project) + 1}-heading`
---

<section class="home-projects-section" aria-labelledby="home-projects-heading">
  <div class="site-container home-projects-content">
    <div class="home-projects-intro reveal">
      <div>
        <p class="eyebrow">Selected projects</p>
        <h2 id="home-projects-heading">
          Different challenges.{' '}
          <span class="hero-title-accent">Thoughtful digital work.</span>
        </h2>
        <p class="section-intro">
          Explore products and platforms across commerce, mobile experiences,
          and publishing—each shaped around a different audience and business
          context.
        </p>
      </div>
      <a class="button button-primary" href="/projects/">
        Explore all projects <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div
      class="home-projects-carousel reveal"
      data-project-carousel
      role="region"
      aria-roledescription="carousel"
      aria-label="Selected projects"
      tabindex="0"
    >
      <div class="home-projects-stage" aria-live="off" aria-atomic="false">
        {featuredProjects.map((project, index) => (
          <article
            class:list={['home-project-slide', index === 0 && 'is-active']}
            data-project-slide
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${featuredProjects.length}: ${project.name}`}
            aria-hidden={index === 0 ? undefined : 'true'}
            inert={index !== 0}
          >
            <a
              class="home-project-image"
              href={projectHref(project)}
              aria-label={`Explore ${project.name} project overview`}
              tabindex={index === 0 ? undefined : '-1'}
            >
              <Image
                src={project.image}
                alt={project.alt}
                width={1100}
                sizes="(max-width: 760px) 92vw, (max-width: 1100px) 48vw, 560px"
                loading={index === 0 ? 'eager' : 'lazy'}
              />
              <span class="home-project-image-index" aria-hidden="true">
                {String(index + 1).padStart(2, '0')} /{' '}
                {String(featuredProjects.length).padStart(2, '0')}
              </span>
            </a>
            <div class="home-project-copy">
              <p class="home-project-category">{project.category}</p>
              <h3>{project.name}</h3>
              <p class="home-project-description">{project.overview}</p>
              <a class="home-project-link" href={projectHref(project)}>
                View project overview{' '}
                <span class="link-arrow" aria-hidden="true">
                  →
                </span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="home-projects-controls">
        <div
          class="home-projects-pagination"
          role="group"
          aria-label="Choose a project slide"
        >
          {featuredProjects.map((project, index) => (
            <button
              class:list={[
                'home-project-indicator',
                index === 0 && 'is-active',
              ]}
              type="button"
              data-project-indicator
              aria-label={`Show project ${index + 1} of ${featuredProjects.length}: ${project.name}`}
              aria-current={index === 0 ? 'true' : undefined}
              aria-pressed={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? '0' : '-1'}
            >
              <span aria-hidden="true"></span>
            </button>
          ))}
        </div>
        <div class="home-projects-arrows">
          <button
            class="home-project-arrow"
            type="button"
            data-project-previous
            aria-label="Show previous project"
          >
            <span aria-hidden="true">←</span>
          </button>
          <button
            class="home-project-arrow"
            type="button"
            data-project-next
            aria-label="Show next project"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector('[data-project-carousel]')

  if (carousel instanceof HTMLElement) {
    const slides = [...carousel.querySelectorAll('[data-project-slide]')]
    const indicators = [
      ...carousel.querySelectorAll('[data-project-indicator]'),
    ]
    const previous = carousel.querySelector('[data-project-previous]')
    const next = carousel.querySelector('[data-project-next]')
    const stage = carousel.querySelector('.home-projects-stage')
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const rotationDelay = 3000
    let activeIndex = 0
    let rotationTimer
    let pointerInside = false
    let activePointerId
    let pointerStartX = 0
    let pointerStartY = 0
    let isDragging = false
    let suppressClick = false

    const stopRotation = () => {
      window.clearTimeout(rotationTimer)
      rotationTimer = undefined
    }

    const scheduleRotation = () => {
      stopRotation()
      if (
        reducedMotion.matches ||
        pointerInside ||
        isDragging ||
        slides[activeIndex]?.contains(document.activeElement)
      ) {
        return
      }
      rotationTimer = window.setTimeout(() => {
        showSlide(activeIndex + 1, false)
        scheduleRotation()
      }, rotationDelay)
    }

    function showSlide(index, announce = true) {
      activeIndex = (index + slides.length) % slides.length
      stage?.setAttribute('aria-live', announce ? 'polite' : 'off')

      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === activeIndex
        slide.classList.toggle('is-active', active)
        slide.setAttribute('aria-hidden', String(!active))
        slide.toggleAttribute('inert', !active)
        slide.querySelectorAll('a, button').forEach((control) => {
          if (active) control.removeAttribute('tabindex')
          else control.setAttribute('tabindex', '-1')
        })
      })

      indicators.forEach((indicator, indicatorIndex) => {
        const active = indicatorIndex === activeIndex
        indicator.classList.toggle('is-active', active)
        indicator.setAttribute('aria-current', String(active))
        indicator.setAttribute('aria-pressed', String(active))
        indicator.tabIndex = active ? 0 : -1
      })
    }

    previous?.addEventListener('click', () => {
      showSlide(activeIndex - 1)
      scheduleRotation()
    })

    next?.addEventListener('click', () => {
      showSlide(activeIndex + 1)
      scheduleRotation()
    })

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        showSlide(index)
        indicators[activeIndex]?.focus({ preventScroll: true })
        scheduleRotation()
      })
    })

    carousel.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return
      if (event.key === 'ArrowLeft') {
        event.preventDefault()
        showSlide(activeIndex - 1)
        carousel.focus({ preventScroll: true })
        scheduleRotation()
      } else if (event.key === 'ArrowRight') {
        event.preventDefault()
        showSlide(activeIndex + 1)
        carousel.focus({ preventScroll: true })
        scheduleRotation()
      }
    })

    carousel.addEventListener('pointerenter', () => {
      pointerInside = true
      stopRotation()
    })

    carousel.addEventListener('pointerleave', () => {
      pointerInside = false
      scheduleRotation()
    })

    carousel.addEventListener('focusin', () => {
      stopRotation()
    })

    carousel.addEventListener('focusout', (event) => {
      if (
        event.relatedTarget instanceof Node &&
        carousel.contains(event.relatedTarget)
      )
        return
      scheduleRotation()
    })

    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) stopRotation()
      else scheduleRotation()
    })

    const finishPointerGesture = (event, cancelled = false) => {
      if (event.pointerId !== activePointerId) return

      const deltaX = event.clientX - pointerStartX
      const deltaY = event.clientY - pointerStartY
      const wasDragging = isDragging
      const completedSwipe =
        !cancelled &&
        wasDragging &&
        Math.abs(deltaX) >= 48 &&
        Math.abs(deltaX) > Math.abs(deltaY) * 1.15

      activePointerId = undefined
      isDragging = false
      carousel.classList.remove('is-dragging')
      window.removeEventListener('pointermove', movePointer, true)
      window.removeEventListener('pointerup', finishPointer, true)
      window.removeEventListener('pointercancel', cancelPointer, true)

      if (completedSwipe) {
        const restoreFocus = slides[activeIndex].contains(
          document.activeElement,
        )
        showSlide(activeIndex + (deltaX < 0 ? 1 : -1))
        if (restoreFocus) carousel.focus({ preventScroll: true })
        suppressClick = true
        window.setTimeout(() => {
          suppressClick = false
        }, 0)
      }

      scheduleRotation()
    }

    const movePointer = (event) => {
      if (event.pointerId !== activePointerId) return

      const deltaX = event.clientX - pointerStartX
      const deltaY = event.clientY - pointerStartY

      if (
        !isDragging &&
        Math.abs(deltaX) >= 8 &&
        Math.abs(deltaX) > Math.abs(deltaY) * 1.15
      ) {
        isDragging = true
        carousel.classList.add('is-dragging')
      }

      if (isDragging) event.preventDefault()
    }

    const finishPointer = (event) => finishPointerGesture(event)
    const cancelPointer = (event) => finishPointerGesture(event, true)

    stage?.addEventListener('pointerdown', (event) => {
      if (
        !event.isPrimary ||
        (event.pointerType === 'mouse' && event.button !== 0) ||
        (event.target instanceof Element && event.target.closest('button'))
      ) {
        return
      }

      activePointerId = event.pointerId
      pointerStartX = event.clientX
      pointerStartY = event.clientY
      stopRotation()
      window.addEventListener('pointermove', movePointer, {
        capture: true,
        passive: false,
      })
      window.addEventListener('pointerup', finishPointer, true)
      window.addEventListener('pointercancel', cancelPointer, true)
    })

    stage?.addEventListener('dragstart', (event) => event.preventDefault())

    carousel.addEventListener(
      'click',
      (event) => {
        if (!suppressClick) return
        event.preventDefault()
        event.stopImmediatePropagation()
        suppressClick = false
      },
      true,
    )

    scheduleRotation()
  }
</script>

<style>
  .home-projects-section {
    padding-block: clamp(2rem, 4vh, 3rem);
    background: var(--color-paper);
  }

  .home-projects-content {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .home-projects-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
  }

  .home-projects-intro > div {
    max-width: 900px;
  }

  .home-projects-intro .eyebrow {
    margin-bottom: 0.75rem;
  }

  .home-projects-intro h2 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    line-height: var(--type-section-line-height);
  }

  .home-projects-intro .section-intro {
    max-width: 630px;
    margin: 0.9rem 0 0;
    color: var(--color-body);
    font-size: var(--type-body-size);
    line-height: var(--type-body-line-height);
  }

  .home-projects-intro > .button {
    flex: 0 0 auto;
  }

  .home-projects-carousel {
    min-width: 0;
    overflow: hidden;
    padding: clamp(0.65rem, 1vw, 0.9rem);
    border: 1px solid rgb(16 27 45 / 9%);
    border-radius: var(--radius-large);
    background:
      radial-gradient(ellipse at 8% 12%, rgb(201 84 43 / 9%), transparent 36%),
      radial-gradient(
        ellipse at 92% 88%,
        rgb(84 123 157 / 10%),
        transparent 38%
      ),
      #f2f0ec;
    box-shadow:
      0 1px 2px rgb(16 27 45 / 4%),
      0 16px 34px -22px rgb(16 27 45 / 24%),
      0 34px 70px -48px rgb(16 27 45 / 24%);
  }

  .home-projects-carousel:focus-visible {
    outline: 3px solid #e1784f;
    outline-offset: 4px;
  }

  .home-projects-carousel.is-dragging,
  .home-projects-carousel.is-dragging * {
    cursor: grabbing;
    user-select: none;
  }

  .home-projects-stage {
    display: grid;
    min-width: 0;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    cursor: grab;
    touch-action: pan-y;
    border: 1px solid rgb(16 27 45 / 8%);
    border-radius: var(--radius-medium);
    background: var(--color-white);
    box-shadow:
      0 5px 16px rgb(16 27 45 / 5%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
  }

  .home-project-slide {
    display: grid;
    min-width: 0;
    grid-area: 1 / 1;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: stretch;
    gap: clamp(1.5rem, 4vw, 4rem);
    padding: clamp(0.75rem, 1.4vw, 1rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      opacity 350ms var(--ease-out),
      visibility 350ms var(--ease-out),
      transform 350ms var(--ease-out);
    transform: translateX(12px);
  }

  .home-project-slide.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(0);
  }

  .home-project-slide .home-project-image {
    width: 100%;
    max-width: 100%;
    height: auto;
    min-height: 280px;
    align-self: center;
    aspect-ratio: 1.72;
    padding: clamp(0.4rem, 0.8vw, 0.65rem);
    border: 1px solid rgb(16 27 45 / 10%);
    border-radius: var(--radius-medium);
    background: linear-gradient(145deg, #f5eee8 0%, #f0f3f4 100%);
    box-shadow:
      0 12px 26px -16px rgb(16 27 45 / 32%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
    transition:
      transform 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out),
      border-color 300ms ease;
  }

  .home-project-image {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    background: var(--color-peach);
  }

  .home-project-image img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-small);
    object-fit: contain;
    transition: transform 350ms var(--ease-out);
  }

  .home-project-image:hover img {
    transform: scale(1.012);
  }

  .home-project-image:hover {
    transform: translateY(-2px);
    border-color: rgb(201 84 43 / 28%);
    box-shadow:
      0 18px 32px -18px rgb(16 27 45 / 36%),
      inset 0 1px 0 rgb(255 255 255 / 90%);
  }

  .home-project-image:focus-visible {
    outline-offset: 5px;
    border-color: var(--color-orange-dark);
  }

  .home-project-image-index {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    padding: 0.4rem 0.55rem;
    border: 1px solid rgb(255 255 255 / 32%);
    background: rgb(16 27 45 / 78%);
    color: var(--color-white);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .home-project-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 1.5vw, 1.35rem) clamp(1.25rem, 2.3vw, 2rem);
    border-left: 1px solid var(--color-line);
  }

  .home-project-category {
    margin: 0;
    color: var(--color-orange-dark);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .home-project-copy h3 {
    margin: 0.6rem 0 0;
    color: var(--color-navy);
    font-family: var(--font-heading);
    font-size: clamp(1.3rem, 2vw, 1.8rem);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }

  .home-project-description {
    margin: 0.7rem 0 1rem;
    color: var(--color-body);
    font-size: 0.84rem;
    line-height: 1.65;
  }

  .home-project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    color: var(--color-ink);
    font-size: 0.76rem;
    font-weight: 650;
  }

  .home-project-link span {
    color: var(--color-orange-dark);
  }

  .home-projects-stage {
    display: grid;
    min-height: 0;
  }

  .home-projects-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.8rem clamp(0.75rem, 2vw, 1.5rem) 0.35rem;
    border-top: 1px solid var(--color-line);
  }

  .home-projects-pagination,
  .home-projects-arrows {
    display: flex;
    align-items: center;
  }

  .home-projects-pagination {
    gap: 0.45rem;
  }

  .home-project-indicator {
    display: grid;
    width: 26px;
    height: 26px;
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    place-items: center;
  }

  .home-project-indicator span {
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: #b6bdc5;
    transition:
      width 220ms var(--ease-out),
      background-color 220ms ease;
  }

  .home-project-indicator.is-active span {
    width: 24px;
    background: var(--color-orange-dark);
  }

  .home-projects-arrows {
    gap: 0.55rem;
  }

  .home-project-arrow {
    display: grid;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-navy);
    cursor: pointer;
    font-size: 1.05rem;
    transition:
      color var(--duration-fast) ease,
      border-color var(--duration-fast) ease,
      background var(--duration-fast) ease,
      transform var(--duration-fast) ease;
    place-items: center;
  }

  .home-project-arrow:hover {
    transform: translateY(-2px);
    border-color: var(--color-orange-dark);
    background: #f8eee8;
    color: var(--color-orange-dark);
  }

  @media (max-width: 900px) {
    .home-projects-intro {
      align-items: flex-start;
      flex-direction: column;
      gap: 1.25rem;
    }

    .home-project-slide {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: 1.5rem;
    }

    .home-project-slide .home-project-image {
      min-height: 0;
    }
  }

  @media (max-width: 600px) {
    .home-projects-section {
      padding-block: 3.5rem;
    }

    .home-project-slide {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.15rem;
      padding: 0.6rem;
    }

    .home-project-slide .home-project-image {
      min-height: 0;
      aspect-ratio: 1.72;
    }

    .home-projects-carousel {
      padding: 0.4rem;
      border-radius: var(--radius-medium);
    }

    .home-project-copy {
      padding: 0.5rem 0.6rem 0.75rem;
      border-top: 1px solid var(--color-line);
      border-left: 0;
    }

    .home-project-description {
      margin-top: 0.55rem;
      font-size: 0.82rem;
    }

    .home-projects-controls {
      padding-inline: 0.6rem;
    }

    .home-project-arrow {
      width: 38px;
      height: 38px;
    }

    .home-projects-pagination {
      gap: 0.15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-project-slide,
    .home-project-image img,
    .home-project-image,
    .home-project-indicator span,
    .home-project-arrow {
      transition: none;
    }

    .home-project-slide {
      transform: none;
    }
  }
</style>
