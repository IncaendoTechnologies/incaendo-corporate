---
const stages = [
  {
    number: '01',
    title: 'Discover',
    description:
      'Understand the business challenge, users, goals, and constraints.',
    art: 'discover',
  },
  {
    number: '02',
    title: 'Define & Design',
    description:
      'Turn requirements into a clear solution plan and user experience.',
    art: 'design',
  },
  {
    number: '03',
    title: 'Build & Integrate',
    description:
      'Develop the solution and connect it with the necessary systems and workflows.',
    art: 'build',
  },
  {
    number: '04',
    title: 'Validate & Refine',
    description:
      'Test quality, address issues, and refine the solution before release.',
    art: 'validate',
  },
  {
    number: '05',
    title: 'Launch & Evolve',
    description:
      'Deploy the solution, monitor outcomes, and identify opportunities for improvement.',
    art: 'launch',
  },
]
