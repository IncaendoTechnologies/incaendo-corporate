---
import '../styles/global.css'
import ContactModal from '../components/ContactModal.astro'
import heroVisual from '../assets/hero-orbit.png'

const {
  title = 'NIRVAN | Healthcare CRM & Hospital Management Platform',
  description = 'Simplify healthcare operations with one connected platform for clinics, hospitals, and growing healthcare networks.',
  openGraphType = 'website',
} = Astro.props

const siteUrl = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '')
const canonicalUrl = siteUrl
  ? new URL(Astro.url.pathname, siteUrl).href
  : undefined
const socialImage = siteUrl ? new URL(heroVisual.src, siteUrl).href : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f4" />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={openGraphType} />
    <meta property="og:site_name" content="NIRVAN by Incaendo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="standalone-product-body">
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <slot />
    <ContactModal />
    <script>
      import '../scripts/motion.js'
    </script>
  </body>
</html>

<style is:global>
  body.standalone-product-body {
    background-color: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-body);
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
</style>
