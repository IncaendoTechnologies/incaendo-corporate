    height: 57%;
  }
  .web-chart > div span:nth-child(3n) {
    height: 78%;
    background: rgb(201 84 43 / 32%);
  }
  .web-chart svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .web-chart svg path {
    fill: none;
    stroke: #a84121;
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
  }
