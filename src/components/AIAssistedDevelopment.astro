          />
          <circle class="ai-particle-ring" r="4.2" fill="#e04c24" />
          <circle class="ai-particle-core" r="2.2" fill="#ffffff" />
        </g>
        <g id="ai-particle-3" class="ai-particle">
          <circle
            class="ai-particle-halo"
            r="8"
            fill="rgba(224, 76, 36, 0.35)"
            filter="url(#ai-particle-glow)"
          />
          <circle class="ai-particle-ring" r="4.2" fill="#e04c24" />
          <circle class="ai-particle-core" r="2.2" fill="#ffffff" />
        </g>
        <g id="ai-particle-4" class="ai-particle">
          <circle
            class="ai-particle-halo"
            r="8"
            fill="rgba(224, 76, 36, 0.35)"
            filter="url(#ai-particle-glow)"
          />
          <circle class="ai-particle-ring" r="4.2" fill="#e04c24" />
          <circle class="ai-particle-core" r="2.2" fill="#ffffff" />
        </g>
        <g id="ai-particle-5" class="ai-particle">
          <circle
            class="ai-particle-halo"
            r="8"
            fill="rgba(224, 76, 36, 0.35)"
            filter="url(#ai-particle-glow)"
          />
          <circle class="ai-particle-ring" r="4.2" fill="#e04c24" />
          <circle class="ai-particle-core" r="2.2" fill="#ffffff" />
        </g>
      </svg>

      <!-- Exact 3-Column Balanced Grid -->
      <div class="ai-vis-grid">
        <!-- Left Column (3 cards, middle indented inward) -->
        <div class="ai-cards-col is-left">
          {capabilitiesLeft.map((cap) => {
            const Icon = cap.icon
            const isIndented = cap.idx === 1
            return (
              <div
                class:list={[
                  'ai-node-card',
                  'is-left',
                  isIndented && 'is-indented',
                ]}
                data-card-idx={cap.idx}
              >
                <div class="ai-card-shimmer" aria-hidden="true" />
                <div class="ai-node-icon" aria-hidden="true">
                  <Icon size={24} strokeWidth={2.2} />
                </div>
                <div class="ai-node-divider" aria-hidden="true" />
                <div class="ai-node-info">
                  <h3 class="ai-node-title">{cap.title}</h3>
                  <p class="ai-node-desc">{cap.desc}</p>
                </div>
              </div>
            )
          })}
        </div>

        <!-- Center Column: Animated 3D AI Core with Multi-Axis Movement & Depth Visuals -->
        <div class="ai-center-stage" id="ai-center-stage">
          <div class="ai-cube-wrapper" id="ai-cube-wrapper">
            <!-- Pulsing Ambient Energy Aura -->
            <div class="ai-cube-ambient-glow" aria-hidden="true" />
            <!-- Delicate Orbiting Energy Ring -->
            <div class="ai-cube-energy-ring" aria-hidden="true" />
            <!-- 3D Floating & Mouse-Interactive Cube Rig -->
            <div class="ai-cube-3d-rig" id="ai-cube-3d-rig">
              <img
                class="ai-cube-img"
                id="ai-cube-img"
                src="/assets/exact-3d-ai-cube.png"
                alt="Incaendo 3D AI Core"
                width="235"
                height="260"
                loading="lazy"
                decoding="async"
              />
            </div>
            <!-- Soft Realistic 3D Floor Shadow -->
            <div class="ai-cube-floor-shadow" aria-hidden="true" />
          </div>
        </div>

        <!-- Right Column (3 cards, middle indented inward) -->
        <div class="ai-cards-col is-right">
          {capabilitiesRight.map((cap) => {
            const Icon = cap.icon
            const isIndented = cap.idx === 4
            return (
              <div
                class:list={[
                  'ai-node-card',
                  'is-right',
                  isIndented && 'is-indented',
                ]}
