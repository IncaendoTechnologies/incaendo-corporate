---
const stats = [
  {
    value: 100,
    label: 'Projects Delivered',
    icon: 'projects',
    tone: 'orange',
    slot: 'top-left',
    cardDelay: '350ms',
    floatDelay: '0s',
  },
  {
    value: 15,
    label: 'Years of Experience',
    icon: 'years',
    tone: 'blue',
    slot: 'top-right',
    cardDelay: '480ms',
    floatDelay: '-1.8s',
  },
  {
    value: 79,
    label: 'Technology Experts',
    icon: 'experts',
    tone: 'blue',
    slot: 'bottom-left',
    cardDelay: '610ms',
    floatDelay: '-3.2s',
  },
  {
    value: 10,
    label: 'Industries Worked With',
    icon: 'industries',
    tone: 'orange',
    slot: 'bottom-right',
    cardDelay: '870ms',
    floatDelay: '-4.6s',
  },
]
---

<div class="hero-visual home-tech-visual" data-hero-stats>
  <div class="home-visual-stage">
    <div class="home-visual-scene">
      <!-- Ambient Orbit Effect -->
      <svg
        class="home-visual-orbits"
        viewBox="0 0 640 500"
        preserveAspectRatio="xMidYMid meet"
        aria-hidden="true"
      >
        <defs>
          <filter id="node-glow" x="-50%" y="-50%" width="200%" height="200%">
            <feGaussianBlur
              in="SourceGraphic"
              stdDeviation="2.5"
              result="blur"
            />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <!-- Elegant primary orbital ring -->
        <path
          class="home-orbit-main"
          d="M 50,250 C 50,115 170,55 330,55 C 490,55 590,115 590,250 C 590,385 490,445 330,445 C 170,445 50,385 50,250 Z"
        />

        <!-- Secondary subtle arc -->
        <path
          class="home-orbit-secondary"
          d="M 110,115 C 210,75 420,75 530,125"
        />

        <!-- Subtle fixed orbit dots -->
        <circle cx="210" cy="74" r="2.5" class="home-orbit-dot" />
        <circle cx="470" cy="85" r="2.5" class="home-orbit-dot" />
        <circle cx="582" cy="190" r="2.5" class="home-orbit-dot" />
        <circle cx="68" cy="310" r="2.5" class="home-orbit-dot" />
        <circle cx="485" cy="420" r="2.5" class="home-orbit-dot" />

        <!-- Traveling glowing orbit nodes -->
        <circle
          class="home-orbit-node is-orange"
          r="3.5"
          filter="url(#node-glow)"
        >
          <animateMotion
            dur="22s"
            repeatCount="indefinite"
            path="M 50,250 C 50,115 170,55 330,55 C 490,55 590,115 590,250 C 590,385 490,445 330,445 C 170,445 50,385 50,250 Z"
          />
        </circle>
        <circle
          class="home-orbit-node is-orange node-secondary"
          r="2.5"
          filter="url(#node-glow)"
        >
          <animateMotion
            dur="22s"
            begin="-11s"
            repeatCount="indefinite"
            path="M 50,250 C 50,115 170,55 330,55 C 490,55 590,115 590,250 C 590,385 490,445 330,445 C 170,445 50,385 50,250 Z"
          />
        </circle>
      </svg>

      <!-- Laptop Mockup -->
      <figure class="home-laptop">
        <div class="home-laptop-screen">
          <div class="home-laptop-camera"></div>
          <div class="home-dashboard" aria-hidden="true">
            <!-- Sidebar -->
            <aside class="home-dashboard-sidebar">
              <span class="home-dashboard-brand">
                <span class="brand-mark">
                  <svg viewBox="0 0 16 16" fill="currentColor">
                    <circle cx="5" cy="5" r="3" fill="#ff5722" />
                    <circle cx="11" cy="5" r="3" fill="#3b82f6" />
                    <rect
                      x="3"
                      y="9"
                      width="10"
                      height="4"
                      rx="2"
                      fill="#1e293b"
                    />
                  </svg>
                </span>
                <b>INCAENDO</b>
              </span>
              <span class="home-dashboard-nav is-current">
                <svg
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                >
                  <rect x="2" y="2" width="4.5" height="4.5" rx="1" />
                  <rect x="7.5" y="2" width="4.5" height="4.5" rx="1" />
                  <rect x="2" y="7.5" width="4.5" height="4.5" rx="1" />
                  <rect x="7.5" y="7.5" width="4.5" height="4.5" rx="1" />
                </svg>
                Overview
              </span>
              <span class="home-dashboard-nav">
                <svg
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                >
                  <path d="M2.5 3.5h9v7h-9z" />
                  <path d="M5 3.5v-1h4v1" />
                </svg>
                Projects
              </span>
              <span class="home-dashboard-nav">
                <svg
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                >
                  <circle cx="7" cy="7" r="4.5" />
                  <path d="M7 4.5v5M4.5 7h5" />
                </svg>
                Services
              </span>
              <span class="home-dashboard-nav">
                <svg
                  viewBox="0 0 14 14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                >
                  <path d="M2.5 11.5l3-3.5 2.5 2 3.5-5" />
                </svg>
                Insights
              </span>
            </aside>

            <!-- Main Content -->
            <div class="home-dashboard-main">
              <div class="home-dashboard-topbar">
                <span>YOUR WORKSPACE</span>
                <span class="home-dashboard-info" title="Workspace Info">
                  ⓘ
                </span>
              </div>
              <div class="home-dashboard-heading">
                <span class="dashboard-kicker">Technology overview</span>
                <h3 class="dashboard-title">Solutions for what’s next.</h3>
              </div>

              <!-- 5 Services in 2 Columns -->
              <div class="home-dashboard-services">
                <div class="home-dashboard-service">
                  <span class="service-icon-box tone-orange">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <rect x="2.5" y="2.5" width="11" height="11" rx="2.5" />
                      <line x1="2.5" y1="6.5" x2="13.5" y2="6.5" />
                    </svg>
                  </span>
                  <span>Web Applications</span>
                </div>
                <div class="home-dashboard-service">
                  <span class="service-icon-box tone-blue">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <rect x="4" y="2" width="8" height="12" rx="2" />
                      <circle cx="8" cy="11.5" r="0.75" fill="currentColor" />
                    </svg>
                  </span>
                  <span>Mobile Apps</span>
                </div>
                <div class="home-dashboard-service">
                  <span class="service-icon-box tone-orange">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <rect x="4.5" y="4.5" width="7" height="7" rx="1.5" />
                      <path d="M6 2v2.5M10 2v2.5M6 11.5V14M10 11.5V14M2 6h2.5M2 10h2.5M11.5 6H14M11.5 10H14" />
                    </svg>
                  </span>
                  <span>AI Solutions</span>
                </div>
                <div class="home-dashboard-service">
                  <span class="service-icon-box tone-blue">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <path d="M4 11.5a3 3 0 0 1-.2-5.99A4 4 0 0 1 11.5 5.5a3 3 0 0 1 1 5.8 2 2 0 0 1-1.5.2H4Z" />
                    </svg>
                  </span>
                  <span>Cloud Platforms</span>
                </div>
                <div class="home-dashboard-service service-span-two">
                  <span class="service-icon-box tone-orange">
                    <svg
                      viewBox="0 0 16 16"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    >
                      <circle cx="4.5" cy="8" r="2.5" />
                      <circle cx="11.5" cy="8" r="2.5" />
                      <path d="M7 8h2" />
                    </svg>
                  </span>
                  <span>Integrations</span>
                </div>
              </div>

              <!-- Bottom Panels: Chart + Connected Services -->
              <div class="home-dashboard-bottom">
                <div class="home-dashboard-chart">
                  <span>Delivery activity</span>
                  <svg viewBox="0 0 180 50" preserveAspectRatio="none">
                    <defs>
                      <linearGradient
                        id="chart-wave-grad"
                        x1="0"
                        y1="0"
                        x2="0"
                        y2="1"
                      >
                        <stop
                          offset="0%"
                          stop-color="#3b82f6"
                          stop-opacity="0.28"
                        />
                        <stop
                          offset="100%"
                          stop-color="#3b82f6"
                          stop-opacity="0.02"
                        />
                      </linearGradient>
                    </defs>
                    <path
                      class="chart-area"
                      fill="url(#chart-wave-grad)"
                      d="M0 36 C25 34 35 22 55 26 S80 33 100 17 S135 25 155 11 S170 13 180 5 V50 H0 Z"
                    />
                    <path
                      class="chart-line"
                      d="M0 36 C25 34 35 22 55 26 S80 33 100 17 S135 25 155 11 S170 13 180 5"
                    />
                  </svg>
                </div>
                <div class="home-dashboard-status">
                  <span>CONNECTED SERVICES</span>
                  <b>
                    <i class="status-indicator"></i> Web applications
                  </b>
                  <b>
                    <i class="status-indicator"></i> AI solutions
                  </b>
                  <b>
                    <i class="status-indicator"></i> Cloud platforms
                  </b>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="home-laptop-base">
          <span class="laptop-notch"></span>
        </div>
        <figcaption class="visually-hidden">
          Laptop dashboard illustrating Incaendo’s web, mobile, AI, cloud, and
          integration capabilities.
        </figcaption>
      </figure>

      <!-- Smartphone Mockup -->
      <figure class="home-phone">
        <div class="home-phone-screen" aria-hidden="true">
          <div class="home-phone-notch"></div>
          <div class="home-phone-topbar">
            <span>9:41</span>
            <span class="phone-signals">
              <svg
                viewBox="0 0 18 10"
                width="16"
                height="8"
                fill="currentColor"
              >
                <rect x="0" y="5" width="2.5" height="5" rx="0.5" />
                <rect x="3.5" y="3" width="2.5" height="7" rx="0.5" />
                <rect x="7" y="1" width="2.5" height="9" rx="0.5" />
                <rect
                  x="11"
                  y="2"
                  width="6"
                  height="7"
                  rx="1.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1"
                />
                <rect x="12" y="3.5" width="4" height="4" rx="0.5" />
              </svg>
            </span>
          </div>
          <div class="home-phone-greeting">
            <span class="phone-kicker">YOUR WORKSPACE</span>
            <h4 class="phone-headline">
              Build around
              <br />
              your business.
            </h4>
          </div>
          <div class="home-phone-card">
            <span class="home-phone-card-icon">iN</span>
            <div class="phone-card-copy">
              <b>Digital services.</b>
              <small>Explore your options</small>
            </div>
          </div>
          <div class="home-phone-section">
            <span>Your solutions</span>
            <span class="phone-view-all">View all</span>
          </div>
          <div class="home-phone-list">
            <div class="home-phone-row">
              <span class="phone-dot tone-orange"></span>
              <span>Web applications</span>
              <b>›</b>
            </div>
            <div class="home-phone-row">
              <span class="phone-dot tone-blue"></span>
              <span>AI solutions</span>
              <b>›</b>
            </div>
            <div class="home-phone-row">
              <span class="phone-dot tone-orange"></span>
              <span>Cloud platforms</span>
              <b>›</b>
            </div>
          </div>
          <div class="home-phone-tabs">
            <span class="tab-indicator is-active"></span>
            <span class="tab-indicator"></span>
            <span class="tab-indicator"></span>
            <span class="tab-indicator"></span>
          </div>
        </div>
        <figcaption class="visually-hidden">
          Smartphone app preview showing a compact view of Incaendo services.
        </figcaption>
      </figure>
    </div>

    <!-- 5 Floating Metric Cards -->
    <ul class="home-stat-cards" aria-label="Incaendo company statistics">
      {stats.map((stat) => (
        <li
          class={
            'home-stat-card hero-callout-' + stat.tone + ' slot-' + stat.slot
          }
          style={`--card-delay: ${stat.cardDelay}; --float-delay: ${stat.floatDelay};`}
        >
          <span class="home-stat-icon" aria-hidden="true">
            {stat.icon === 'projects' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m12 2 9 4.9-9 4.9-9-4.9L12 2z" />
                <path d="m3 11.8 9 4.9 9-4.9" />
                <path d="m3 16.7 9 4.9 9-4.9" />
              </svg>
            )}
            {stat.icon === 'years' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="4" width="18" height="18" rx="3" />
                <line x1="16" y1="2" x2="16" y2="6" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="3" y1="10" x2="21" y2="10" />
                <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01" />
              </svg>
            )}
            {stat.icon === 'experts' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            )}
            {stat.icon === 'industries' && (
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="7" width="8" height="14" rx="1.5" />
                <path d="M11 3h7a2 2 0 0 1 2 2v16h-9" />
                <path d="M6 10h2M6 14h2M6 18h2M15 7h1M15 11h1M15 15h1" />
              </svg>
            )}
          </span>
          <span class="home-stat-copy">
            <span class="home-stat-value" aria-hidden="true">
              <span class="home-stat-number">
                <span class="home-stat-number-final">{stat.value}</span>
                <span class="home-stat-number-live" data-count-to={stat.value}>
                  {stat.value}
                </span>
              </span>
              <span class="home-stat-suffix">+</span>
            </span>
            <span class="home-stat-label">
              <span class="visually-hidden">{stat.value}+ </span>
              {stat.label}
            </span>
          </span>
        </li>
      ))}

      <!-- 5th Card: AI Automation Integration -->
      <li
        class="home-stat-card home-stat-card-ai slot-bottom-center"
        style="--card-delay: 740ms; --float-delay: -5.4s;"
      >
        <span class="home-stat-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1Z" />
          </svg>
        </span>
        <span class="home-stat-copy">
          <span class="home-stat-card-title">AI Automation</span>
          <span class="home-stat-label">Integration</span>
        </span>
      </li>
    </ul>
  </div>
</div>

<script is:inline>
  ;(() => {
    const panel = document.currentScript.previousElementSibling
    if (
      matchMedia('(prefers-reduced-motion: reduce)').matches ||
      !('IntersectionObserver' in window)
    )
      return
    panel.setAttribute('data-stats-pending', '')
    setTimeout(() => {
      if (!panel.dataset.statsReady) panel.removeAttribute('data-stats-pending')
    }, 3000)
  })()
</script>

<script>
  import '../scripts/hero-stats.js'
</script>

<style>
  .home-tech-visual {
    position: relative;
    z-index: 1;
    width: 100%;
    min-width: 0;
    container-type: inline-size;
  }

  .home-visual-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 620 / 480;
    isolation: isolate;
  }

  /* Soft warm ambient lighting behind devices matching reference */
  .home-visual-stage::before {
    position: absolute;
    inset: 4% 3% 6%;
    z-index: -1;
    border-radius: 46%;
    background:
      radial-gradient(
        circle at 74% 36%,
        rgb(248 221 209 / 36%),
        transparent 48%
      ),
      radial-gradient(
        circle at 32% 64%,
        rgb(225 237 249 / 24%),
        transparent 52%
      ),
      radial-gradient(
        circle at 50% 50%,
        rgb(255 255 255 / 85%),
        transparent 60%
      );
    content: '';
    pointer-events: none;
    filter: blur(24px);
  }

  .home-visual-scene {
    position: absolute;
    inset: 0;
    overflow: visible;
  }

  /* Orbit Rings and Glowing Nodes */
  .home-visual-orbits {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    pointer-events: none;
  }

  .home-orbit-main {
    stroke: rgb(201 84 43 / 26%);
    stroke-width: 1.25;
    stroke-linecap: round;
  }

  .home-orbit-secondary {
    stroke: rgb(84 123 157 / 20%);
    stroke-width: 1;
    stroke-dasharray: 4 6;
  }

  .home-orbit-dot {
    fill: rgb(201 84 43 / 38%);
  }

  .home-orbit-node {
    fill: #ff7a3d;
    filter: drop-shadow(0 0 4px rgb(201 84 43 / 60%));
    animation: home-node-pulse 3.8s ease-in-out infinite;
  }

  .home-orbit-node.node-secondary {
    fill: #ff9d66;
    opacity: 0.85;
  }

  /* Laptop Styling */
  .home-laptop {
    position: absolute;
    z-index: 2;
    top: 17%;
    left: 12%;
    width: 71%;
    margin: 0;
    filter: drop-shadow(0 24px 34px rgb(16 27 45 / 13%));
    animation:
      home-device-arrive 760ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both,
      home-laptop-float 10s ease-in-out 960ms infinite;
  }

  .home-laptop-screen {
    position: relative;
    aspect-ratio: 1.62;
    overflow: hidden;
    padding: 1.6%;
    border: 1px solid rgb(255 255 255 / 75%);
    border-radius: 12px 12px 4px 4px;
    background: linear-gradient(145deg, #303e52, #0f1826 78%);
    box-shadow:
      0 0 0 1px rgb(16 27 45 / 18%),
      inset 0 1px 0 rgb(255 255 255 / 40%),
      0 4px 10px rgb(16 27 45 / 16%);
  }

  .home-laptop-camera {
    position: absolute;
    top: 4px;
    left: 50%;
    z-index: 3;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #182230;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 15%);
    transform: translateX(-50%);
  }

  .home-dashboard {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: 20% minmax(0, 1fr);
    overflow: hidden;
    border-radius: 6px;
    background: #ffffff;
  }

  /* Dashboard Sidebar */
  .home-dashboard-sidebar {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 6%;
    padding: 6% 5%;
    border-right: 1px solid #f0f3f6;
    background: #f8fafc;
    color: #64748b;
    font-size: clamp(5px, 1.25cqi, 7.5px);
    line-height: 1;
  }

  .home-dashboard-brand {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 10%;
    color: var(--color-navy);
    font-size: 0.95em;
    font-weight: 800;
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .brand-mark {
    width: 9px;
    height: 9px;
    flex: none;
  }

  .brand-mark svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .home-dashboard-nav {
    display: flex;
    align-items: center;
    gap: 4.5px;
    padding: 3px 4px;
    border-radius: 4px;
    font-weight: 600;
    white-space: nowrap;
  }

  .home-dashboard-nav svg {
    width: 7.5px;
    height: 7.5px;
    flex: none;
  }

  .home-dashboard-nav.is-current {
    background: var(--color-orange);
    color: #ffffff;
    font-weight: 700;
    box-shadow: 0 2px 6px rgb(201 84 43 / 28%);
  }

  .home-dashboard-nav.is-current svg {
    stroke: #ffffff;
