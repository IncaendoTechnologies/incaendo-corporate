---
import ArchitectureDiagram from './ai-path/ArchitectureDiagram.astro'
import StepIcon from './ai-path/StepIcon.astro'

const workflowSteps = [
  {
    id: 'understand',
    number: '01',
    title: 'Understand the business',
    detail: 'Start with the challenge and the outcome that matters.',
  },
  {
    id: 'prepare',
    number: '02',
    title: 'Prepare the inputs',
    detail: 'Bring relevant information together and check its quality.',
  },
  {
    id: 'design',
    number: '03',
    title: 'Design the AI solution',
    detail: 'Choose an agent, model, or automation approach for the need.',
  },
  {
    id: 'connect',
    number: '04',
    title: 'Connect the workflow',
    detail: 'Fit the solution into the tools and decisions people already use.',
  },
  {
    id: 'improve',
    number: '05',
    title: 'Measure and improve',
    detail: 'Review quality and outcomes, then decide what to refine.',
  },
]
---

<section
  class="ai-path"
  aria-labelledby="ai-practical-path-title"
  data-ai-experience
>
  <div class="ai-workflow ai-reveal" id="ai-practical-path">
    <div class="site-container">
      <div class="ai-workflow-heading ai-workflow-heading-centered">
        <div class="ai-workflow-title-wrap">
          <p class="eyebrow">5-STEP IMPLEMENTATION ROADMAP</p>
          <h2 id="ai-practical-path-title">
            From Strategic Business Needs{' '}
            <br class="ai-workflow-heading-break" />
            to Measurable{' '}
            <span>
              <span class="ai-nowrap">AI-Powered</span> Outcomes.
            </span>
          </h2>
        </div>
      </div>

      <!-- Five Connected Animated SVG Cards -->
      <div
        class="ai-practical-overview"
        aria-label="Five practical steps from need to outcome"
      >
        <!-- Interactive hint for client engagement -->
        <div class="ai-cards-hint-wrap" aria-hidden="true">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 15l6 6m-6-6v4.5m0-4.5h4.5M3 12a9 9 0 1 1 18 0 9 9 0 0 1-18 0z"></path>
          </svg>
          <span>Click any step to inspect its live architecture below</span>
        </div>

        <div class="ai-overview-row">
          <!-- Card 1: Understand the Need -->
          <article
            class="ai-overview-card is-active"
            style="--card-i: 0;"
            data-target-step="understand"
            tabindex="0"
            role="button"
            aria-label="Step 01: Understand the Need"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="understand" />
            </div>
            <h3 class="ai-overview-card-title">Understand the Need</h3>
          </article>

          <!-- Connector 1 -->
          <div class="ai-overview-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-node">
              <span class="ai-bridge-dot"></span>
            </span>
          </div>

          <!-- Card 2: Gather the Right Information -->
          <article
            class="ai-overview-card"
            style="--card-i: 1;"
            data-target-step="prepare"
            tabindex="0"
            role="button"
            aria-label="Step 02: Gather the Right Information"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="prepare" />
            </div>
            <h3 class="ai-overview-card-title">Gather the Right Information</h3>
          </article>

          <!-- Connector 2 -->
          <div class="ai-overview-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-node">
              <span class="ai-bridge-dot"></span>
            </span>
          </div>

          <!-- Card 3: Choose the Right AI Solution -->
          <article
            class="ai-overview-card"
            style="--card-i: 2;"
            data-target-step="design"
            tabindex="0"
            role="button"
            aria-label="Step 03: Choose the Right AI Solution"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="design" />
            </div>
            <h3 class="ai-overview-card-title">Choose the Right AI Solution</h3>
          </article>

          <!-- Connector 3 -->
          <div class="ai-overview-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-node">
              <span class="ai-bridge-dot"></span>
            </span>
          </div>

          <!-- Card 4: Connect Your Workflow -->
          <article
            class="ai-overview-card"
            style="--card-i: 3;"
            data-target-step="connect"
            tabindex="0"
            role="button"
            aria-label="Step 04: Connect Your Workflow"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="connect" />
            </div>
            <h3 class="ai-overview-card-title">Connect Your Workflow</h3>
          </article>

          <!-- Connector 4 -->
          <div class="ai-overview-bridge" aria-hidden="true">
            <span class="ai-bridge-line"></span>
            <span class="ai-bridge-node">
              <span class="ai-bridge-dot"></span>
            </span>
          </div>

          <!-- Card 5: Improve with Results -->
          <article
            class="ai-overview-card"
            style="--card-i: 4;"
            data-target-step="improve"
            tabindex="0"
            role="button"
            aria-label="Step 05: Improve with Results"
          >
            <div class="ai-overview-icon-wrap" aria-hidden="true">
              <StepIcon name="improve" />
            </div>
            <h3 class="ai-overview-card-title">Improve with Results</h3>
          </article>
        </div>
      </div>

      <div class="ai-workflow-layout" data-active-step="understand">
        <!-- Visually hidden radio inputs to preserve state management across steps -->
        <div class="ai-workflow-hidden-inputs" aria-hidden="true">
          {workflowSteps.map((step, index) => (
            <input
              id={`workflow-${step.id}`}
              type="radio"
              name="ai-workflow-step"
              value={step.id}
              checked={index === 0}
              tabindex="-1"
            />
          ))}
        </div>

        <div class="ai-workflow-demo" data-workflow-demo>
          <div class="ai-demo-topline">
            <span class="ai-demo-label">
              <i aria-hidden="true"></i> ILLUSTRATIVE ARCHITECTURE
            </span>
            <span class="ai-demo-nav">
              <button
                type="button"
                class="ai-demo-arrow"
                aria-label="Previous step"
                data-step-prev
              >
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="M10 3 5 8l5 5"></path>
                </svg>
              </button>
              <span class="ai-demo-count" aria-live="polite" data-step-count>
                01 <b>/</b> 05
              </span>
              <button
                type="button"
                class="ai-demo-arrow"
                aria-label="Next step"
                data-step-next
              >
                <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                  <path d="m6 3 5 5-5 5"></path>
                </svg>
              </button>
            </span>
          </div>
          <div class="ai-demo-progress" aria-hidden="true">
            <span data-step-progress></span>
          </div>
          <p class="ai-demo-swipe-hint" aria-hidden="true">
            <span>←</span> Swipe or drag to change step <span>→</span>
          </p>

          <div class="ai-state-stage" aria-live="polite" aria-atomic="true">
            <article
              class="ai-state-card is-active"
              data-flow-state="understand"
            >
              <header class="ai-state-head">
                <span class="ai-state-kicker">
                  01 · UNDERSTAND THE BUSINESS
                </span>
                <h4>Interpret the Request, then Define What Success Means.</h4>
                <p>
                  LLM-based analysis connects business requests with goals,
                  context, and constraints, helping teams identify the right
                  solution and focus on meaningful outcomes.
                </p>
              </header>
              <ArchitectureDiagram name="understand" />
            </article>

            <article class="ai-state-card" data-flow-state="prepare">
              <header class="ai-state-head">
                <span class="ai-state-kicker">02 · PREPARE THE INPUTS</span>
                <h4>
                  Turn Raw Business Information into Searchable Knowledge.
                </h4>
                <p>
                  Data processing and retrieval organize relevant business
                  information, helping AI deliver more useful responses and
                  reducing time spent searching across scattered sources.
                </p>
              </header>
              <ArchitectureDiagram name="prepare" />
            </article>

            <article class="ai-state-card" data-flow-state="design">
              <header class="ai-state-head">
                <span class="ai-state-kicker">03 · DESIGN THE AI SOLUTION</span>
                <h4>Retrieve the Right Context, Generate, then Check It.</h4>
                <p>
                  LLMs and RAG can deliver more relevant, context-aware
                  responses, helping businesses improve customer decisions and
                  uncover opportunities for sales growth.
                </p>
              </header>
              <ArchitectureDiagram name="design" />
            </article>

            <article class="ai-state-card" data-flow-state="connect">
              <header class="ai-state-head">
                <span class="ai-state-kicker">04 · CONNECT THE WORKFLOW</span>
                <h4>Plug AI into the Systems Your Team Already Uses.</h4>
                <p>
                  APIs and AI agents automate connected workflows, helping teams
                  reduce repetitive effort, manage operating costs, and use
                  resources more efficiently.
                </p>
              </header>
              <ArchitectureDiagram name="connect" />
            </article>

            <article class="ai-state-card" data-flow-state="improve">
              <header class="ai-state-head">
                <span class="ai-state-kicker">05 · MEASURE &amp; IMPROVE</span>
                <h4>Check Quality, Watch the Signals, and Keep Refining.</h4>
                <p>
                  Monitoring business outcomes helps identify efficiency gains,
                  cost-saving opportunities, and ways to improve profitability
                  and sustainable revenue growth.
                </p>
              </header>
              <ArchitectureDiagram name="improve" />
            </article>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/ai-practical-path.js'
</script>

<style>
  .ai-path {
    /* One rhythm for the section edges and the gaps between its blocks */
    --ai-space: clamp(4.5rem, 7vw, 6.5rem);
    padding-block: var(--ai-space);
    border-block: 1px solid var(--color-line);
    background:
      radial-gradient(
        ellipse at 93% 12%,
        rgb(225 237 249 / 35%),
        transparent 27rem
      ),
      var(--color-paper);
  }

  /* Workflow */
  .ai-workflow {
    scroll-margin-top: 2rem;
  }
  .ai-workflow-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    width: 100%;
    margin: 0 0 clamp(1.35rem, 2.2vw, 1.85rem);
  }
  .ai-workflow-title-wrap {
    text-align: left;
    width: 100%;
  }
  .ai-workflow-heading .eyebrow {
    margin-bottom: 0.45rem;
    color: var(--color-orange-dark);
    font-size: var(--type-eyebrow-size);
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .ai-workflow-heading h2 {
    margin: 0;
    font-size: var(--type-section-size);
    font-weight: var(--type-heading-weight);
    letter-spacing: var(--type-section-letter-spacing);
    word-spacing: var(--type-section-word-spacing);
    line-height: var(--type-section-line-height);
    color: var(--color-navy);
    text-wrap: balance;
  }
  .ai-workflow-heading h2 span {
    color: var(--color-orange-dark);
  }
  .ai-nowrap {
    white-space: nowrap;
  }
  .ai-workflow-heading-break {
    display: none;
  }
  .desktop-only {
    display: block;
  }
  @media (max-width: 640px) {
    .desktop-only {
      display: none;
    }
  }
  @media (min-width: 680px) {
    .ai-workflow-heading-break {
      display: inline;
    }
  }
  @media (min-width: 1101px) {
    .ai-workflow-heading h2 {
      white-space: nowrap;
    }
  }

  /* Five Connected Animated SVG Cards (Row) */
  .ai-practical-overview {
    position: relative;
    margin-bottom: clamp(1.5rem, 2.8vw, 2.5rem);
    width: 100%;
  }

  /* Interactive hint above cards */
  .ai-cards-hint-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: -0.5rem auto 1.6rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .ai-cards-hint-wrap svg {
    color: var(--color-orange-dark);
  }

  .ai-overview-row {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    position: relative;
  }

  .ai-overview-card {
    flex: 1 1 0;
    min-width: 0;
    max-width: 215px;
    background: #ffffff;
    border: 1.5px solid rgba(226, 232, 240, 0.95);
    border-radius: 18px;
    padding: 1.35rem 1rem 1.45rem;
    min-height: 162px;
    box-shadow:
      0 10px 25px -5px rgba(15, 23, 42, 0.05),
      0 4px 10px -2px rgba(15, 23, 42, 0.02);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    position: relative;
    cursor: pointer;
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.25s ease;
    animation: overviewCardIn 0.55s var(--ease-out) both;
    animation-delay: calc(var(--card-i, 0) * 80ms + 100ms);
  }

  .ai-overview-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 20%;
    right: 20%;
    height: 3px;
    background: #ea580c;
    border-radius: 0 0 3px 3px;
    opacity: 0;
    transform: scaleX(0.4);
    transition: all 0.25s ease;
  }

  @keyframes overviewCardIn {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-overview-card:hover,
  .ai-overview-card:focus-visible {
    transform: translateY(-4px);
    border-color: rgba(234, 88, 12, 0.45);
    box-shadow:
      0 14px 28px -6px rgba(234, 88, 12, 0.14),
      0 4px 10px rgba(15, 23, 42, 0.04);
    outline: none;
  }

  .ai-overview-card:hover .ai-overview-card-title {
    color: var(--color-orange-dark);
  }

  .ai-overview-card.is-active {
    border-color: #ea580c;
    background: linear-gradient(180deg, #ffffff 0%, #fff9f6 100%);
    transform: translateY(-4px);
    box-shadow:
      0 16px 36px -6px rgba(234, 88, 12, 0.22),
      0 0 0 1px rgba(234, 88, 12, 0.18);
  }

  .ai-overview-card.is-active::before {
    opacity: 1;
    transform: scaleX(1);
  }

  .ai-overview-card.is-active .ai-overview-card-title {
    color: var(--color-orange-dark);
  }

  .ai-overview-icon-wrap {
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.85rem;
    position: relative;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-overview-card:hover .ai-overview-icon-wrap {
    transform: scale(1.1);
  }

  .ai-overview-card-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 0.98rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-navy);
    line-height: 1.3;
    text-align: center;
    transition: color 0.2s ease;
    flex-grow: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 4px;
  }

  /* Connector Bridge Between Cards */
  .ai-overview-bridge {
    position: relative;
    flex: 1 1 36px;
    min-width: 24px;
    max-width: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2px;
    margin-top: 51px;
    align-self: flex-start;
    z-index: 2;
    pointer-events: none;
  }

  .ai-bridge-line {
    position: absolute;
    left: -4px;
    right: -4px;
    top: 0;
    height: 2px;
    background: repeating-linear-gradient(
      to right,
      #ea580c,
      #ea580c 4px,
      transparent 4px,
      transparent 8px
    );
    opacity: 0.65;
  }

  .ai-bridge-node {
    position: relative;
    z-index: 3;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ffffff;
    border: 1.8px solid #ea580c;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 8px rgba(234, 88, 12, 0.45);
  }

  .ai-bridge-dot {
    width: 3.5px;
    height: 3.5px;
    border-radius: 50%;
    background: #ea580c;
    animation: bridgeDotPulse 2.4s ease-in-out infinite;
  }

  @keyframes bridgeDotPulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.85;
    }
    50% {
      transform: scale(1.35);
      opacity: 1;
      filter: drop-shadow(0 0 4px #ea580c);
    }
  }

  /* =========================================================
     Dynamic Visual Effects & SVG Micro-Animations
     ========================================================= */

  /* --- Card 1: Understand the Need (Bullseye Radar Sonar Waves & Arrow Strike) --- */

  /* --- Card 2: Gather the Right Information (Scanning Magnifier & Data Stream) --- */

  /* --- Card 3: Choose the Right AI Solution (AI Chip Core Glow & Circuit Signals) --- */

  /* --- Card 4: Connect Your Workflow (Gear Rotation & Accordion Stack Floating) --- */

  /* --- Card 5: Improve with Results (Metric Bars Surge & Soaring Arrow) --- */

  /* --- Universal Twinkling Sparkles --- */

  /* Responsive Layouts */
  @media (max-width: 991px) {
    .ai-overview-row {
      flex-wrap: wrap;
      gap: 1rem;
      justify-content: center;
    }
    .ai-overview-card {
      flex: 1 1 calc(33.333% - 1rem);
      max-width: 210px;
      min-width: 155px;
      min-height: 148px;
    }
    .ai-overview-bridge {
      display: none;
    }
  }

  /* Phones: the five steps become a compact list (icon, title, number), so
     the whole list and the architecture panel below it fit close together
     and a tap visibly changes the panel. */
  @media (max-width: 640px) {
    .ai-cards-hint-wrap {
      margin: -0.25rem 0 0.9rem;
      justify-content: flex-start;
      font-size: 0.8rem;
      text-align: left;
    }
    .ai-overview-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      counter-reset: ai-step;
    }
    .ai-overview-card {
      flex: none;
      flex-direction: row;
      align-items: center;
      gap: 0.85rem;
      width: 100%;
      max-width: none;
      min-width: 0;
      min-height: 0;
      padding: 0.6rem 0.9rem 0.6rem 0.7rem;
      border-radius: 14px;
      text-align: left;
      counter-increment: ai-step;
    }
    .ai-overview-card,
    .ai-overview-card:hover,
    .ai-overview-card:focus-visible,
    .ai-overview-card.is-active {
      transform: none;
    }
    /* Active marker: a bar on the left instead of the top. */
    .ai-overview-card::before {
      top: 18%;
      bottom: 18%;
      left: 0;
      right: auto;
      width: 3px;
      height: auto;
      border-radius: 0 3px 3px 0;
      transform: scaleY(0.4);
    }
    .ai-overview-card.is-active::before {
      transform: scaleY(1);
    }
    .ai-overview-card::after {
      content: counter(ai-step, decimal-leading-zero);
      margin-left: auto;
      color: var(--color-muted);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
    }
    .ai-overview-card.is-active::after {
      color: var(--color-orange-dark);
    }
    .ai-overview-icon-wrap {
      width: 44px;
      height: 44px;
      flex: none;
      margin-bottom: 0;
    }
    .ai-overview-card:hover .ai-overview-icon-wrap {
      transform: none;
    }
    .ai-overview-card-title {
      flex-grow: 0;
      justify-content: flex-start;
      padding: 0;
      font-size: 0.95rem;
      text-align: left;
    }
    .ai-overview-bridge {
      display: none;
    }
    /* Only the selected step's architecture takes space, so the panel is
       as tall as its content (no empty area under shorter steps). */
    .ai-state-card:not(.is-active) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bridge-dot,
    .ai-overview-card {
      animation: none !important;
      transform: none !important;
    }
  }

  .ai-workflow-layout {
    display: flex;
    justify-content: center;
    width: 100%;
    position: relative;
  }
  .ai-workflow-hidden-inputs {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
    opacity: 0;
    pointer-events: none;
  }
  .ai-workflow-steps {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.3rem;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .ai-workflow-legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .ai-workflow-step {
    position: relative;
    display: grid;
    min-height: 64px;
    flex: 1;
    grid-template-columns: 36px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 16px;
    background: transparent;
    cursor: pointer;
    transition:
      background 200ms ease,
      border-color 200ms ease,
      box-shadow 200ms ease;
  }
  .ai-workflow-step:hover {
    background: rgb(255 255 255 / 55%);
  }
  .ai-workflow-step input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .ai-step-number {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border: 1px solid rgb(16 27 45 / 12%);
    border-radius: 12px;
    background: #fff;
    color: var(--color-body);
    font-size: 0.78rem;
    font-weight: 750;
    font-variant-numeric: tabular-nums;
    transition:
      color 200ms ease,
      background 200ms ease,
      border-color 200ms ease;
  }
  .ai-step-copy {
    display: grid;
    gap: 0.2rem;
    min-width: 0;
  }
  .ai-step-copy strong {
    color: var(--color-ink);
    font-size: 1.02rem;
